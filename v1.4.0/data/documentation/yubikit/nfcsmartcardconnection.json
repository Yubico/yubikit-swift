 the NFCSmartCardConnection has an additional "},{"code":"close(success:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"method that will close the connection and set the alertMessage of the NFC alert to the provided message."}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"NFC is only supported on iPhones from iPhone 6 and forward. It will not work on iPads since there’s no NFC chip in these devices."}]}],"style":"note","type":"aside"},{"inlineContent":[{"type":"text","text":"NFC connection to a YubiKey (iOS only)."}],"type":"paragraph"},{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"NFCSmartCardConnection establishes a connection to a YubiKey via NFC. The connection"},{"type":"text","text":" "},{"type":"text","text":"presents the system NFC dialog and waits for the user to tap their YubiKey."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"NFC connections are short-lived due to iOS timeout constraints. Perform operations quickly"},{"type":"text","text":" "},{"type":"text","text":"and close the connection with a user-visible message."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let connection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","await connection.close(message: \"Codes retrieved\")"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/yubikit\/nfcsmartcardconnection"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A NFC connection to the YubiKey."}],"references":{"doc://wt-v140.YubiKit/documentation/YubiKit/NFCSmartCardConnection/init()":{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/init()","kind":"symbol","role
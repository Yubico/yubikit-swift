,"text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response\/rawAttestationObject","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response\/rawAuthenticatorData","isActive":true},{"type":"text","text":") are kept alongside the parsed"},{"type":"text","text":" "},{"type":"text","text":"forms so callers can ship them to the relying party verbatim."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The relying party verifies a registration by hashing "},{"type":"codeVoice","code":"clientDataJSON"},{"type":"text","text":", running"},{"type":"text","text":" "},{"type":"text","text":"the attestation statement format’s verification procedure ("},{"type":"codeVoice","code":"none"},{"type":"text","text":", "},{"type":"codeVoice","code":"packed"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"fido-u2f"},{"type":"text","text":", "},{"type":"codeVoice","code":"tpm"},{"type":"text","text":", …), and applying its attestation policy. It then stores"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response\/credentialId","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response\/publicKey","isActive":true},{"type":"text","text":" against the user account for future assertions."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response\/toJSON()","isActive":true},{"type":"text","text":" to encode the response in the "},{"type":"codeVoice","code":"PublicKeyCredential.toJSON()"},{"type":"text","text":" "},{"type":"text","text":"shape the
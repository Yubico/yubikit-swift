{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/webauthn\/client"]}],"metadata":{"role":"symbol","title":"WebAuthn.Client","symbolKind":"class","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"modules":[{"name":"YubiKit"}],"extendedModule":"YubiKit","navigatorTitle":[{"kind":"identifier","text":"Client"}],"roleHeading":"Class","externalID":"s:7YubiKit8WebAuthnO6ClientC"},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}]}],"kind":"declarations"},{"mentions":["doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/GettingStarted"],"kind":"mentions"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Provides a unified interface for passkey registration and authentication"},{"type":"text","text":" "},{"type":"text","text":"backed by a YubiKey via CTAP2 protocol (USB\/NFC)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"PIN entry and UV decisions are supplied per ceremony via the"},{"type":"text","text":" "},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","type":"reference","isActive":true},{"type":"text","text":" parameter on "},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","type":"reference","isActive":true},{"type":"text","text":". The status stream reports ceremony"},{"type":"text","text":" "},{"type":"text","text":"progress ("},{"code":".processing","type":"codeVoice"},{"type":"text","text":", "},{"code":".waitingForUser","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":".waitingForUserVerification","type":"codeVoice"},{"type":"text","text":", "},{"code":".finished","type":"codeVoice"},{"type":"text","text":") only."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let session = try await CTAP2.Session.makeSession(connection: connection)","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","\/\/ Trivial — pre-supplied PIN:","let response = try await client.makeCredential(options, authorization: .pin(\"1234\")).value","","\/\/ Custom — bridge into a UI:","let auth = WebAuthn.Authorization(providePIN: {","    guard let pin = await viewModel.askForPIN() else { return .cancel }","    return .pin(pin)","})","for try await status in await client.makeCredential(options, authorization: auth) {","    switch status {","    case .processing: showSpinner()","    case .waitingForUser(let cancel):","        showTouchPrompt(onCancel: { Task { await cancel() } })","    case .waitingForUserVerification(let cancel, let fallbackToPIN):","        showBiometricPrompt(","            onCancel: { Task { await cancel() } },","            onFallbackToPIN: fallbackToPIN.map { fallback in { Task { await fallback() } } }","        )","    case .finished(let response): return response","    }","}"]},{"inlineContent":[{"type":"text","text":"PIN attempts are one-shot: a wrong PIN throws"},{"type":"text","text":" "},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/pinRejected(retriesRemaining:source:)","type":"reference","isActive":true},{"type":"text","text":" and the caller"},{"type":"text","text":" "},{"type":"text","text":"decides whether to re-prompt and retry with a fresh "},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Returning "},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/PINReply\/cancel","type":"reference","isActive":true},{"type":"text","text":" from "},{"code":"providePIN","type":"codeVoice"},{"type":"text","text":" aborts"},{"type":"text","text":" "},{"type":"text","text":"the ceremony with "},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/cancelled(source:)","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"code":"Client","type":"codeVoice"},{"type":"text","text":" is a high-level passkey client that runs WebAuthn ceremonies against a YubiKey."}],"type":"paragraph"},{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"code":"Client","type":"codeVoice"},{"type":"text","text":" is the entry point for WebAuthn in this SDK. It wraps a "},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and translates W3C WebAuthn requests into CTAP2 protocol exchanges — building the"},{"type":"text","text":" "},{"code":"clientDataJSON","type":"codeVoice"},{"type":"text","text":", validating the relying-party identifier against the configured"},{"type":"text","text":" "},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference","isActive":true},{"type":"text","text":", selecting between PIN and built-in user verification, and"},{"type":"text","text":" "},{"type":"text","text":"processing extensions before the request reaches the authenticator."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"Client","type":"codeVoice"},{"type":"text","text":" for any app that runs passkey ceremonies. Reach for "},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"directly only when you need lower-level access — raw "},{"code":"makeCredential","type":"codeVoice"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"code":"getAssertion","type":"codeVoice"},{"type":"text","text":", credential management, or bio enrollment."}],"type":"paragraph"},{"inlineContent":[{"code":"Client","type":"codeVoice"},{"type":"text","text":" is an actor; a client’s lifetime is bound to the underlying "},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The constructor takes four parameters that shape every ceremony:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"origin","type":"codeVoice"},{"text":" — the secure origin the client is bound to. ","type":"text"},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","isActive":true,"type":"reference"},{"text":" enforces","type":"text"},{"text":" ","type":"text"},{"text":"the W3C secure-context rule; the client refuses to sign for relying parties whose","type":"text"},{"text":" ","type":"text"},{"text":"identifier doesn’t match.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"isPublicSuffix","type":"codeVoice"},{"text":" — a closure into a Public Suffix List, used to validate that","type":"text"},{"text":" ","type":"text"},{"text":"the relying-party identifier is a registrable suffix of the origin’s effective","type":"text"},{"text":" ","type":"text"},{"text":"domain.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"enterpriseRpIds","type":"codeVoice"},{"text":" — relying-party identifiers allowed to receive","type":"text"},{"text":" ","type":"text"},{"text":"platform-managed enterprise attestation. When the request specifies","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/AttestationPreference\/enterprise","isActive":true,"type":"reference"},{"text":", the client escalates to level 2","type":"text"},{"text":" ","type":"text"},{"text":"(platform-managed) for RPs in this set, and uses level 1 (vendor-facilitated)","type":"text"},{"text":" ","type":"text"},{"text":"otherwise.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"allowedExtensions","type":"codeVoice"},{"text":" — the set of WebAuthn extensions the client will process.","type":"text"},{"text":" ","type":"text"},{"text":"Anything the relying party requests outside this set is dropped before reaching","type":"text"},{"text":" ","type":"text"},{"text":"the authenticator. Defaults to ","type":"text"},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension","isActive":true,"type":"reference"},{"text":"’s standard set.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"PIN and user verification are supplied per ceremony via "},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"out-of-band from the ceremony stream. Both ceremony methods return a"},{"type":"text","text":" "},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/StatusStream","type":"reference","isActive":true},{"type":"text","text":" — drain it with "},{"code":"value()","type":"codeVoice"},{"type":"text","text":" for non-UI callers, or iterate"},{"type":"text","text":" "},{"type":"text","text":"to drive cancel buttons and biometric prompts."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","for try await status in await client.makeCredential(opts, authorization: .pin(\"1234\")) {","    switch status {","    case .processing:","        showSpinner()","    case .waitingForUser(let cancel):","        showTouchPrompt(onCancel: { Task { await cancel() } })","    case .waitingForUserVerification(let cancel, _):","        showBiometricPrompt(onCancel: { Task { await cancel() } })","    case .finished(let response):","        return response","    }","}"]},{"inlineContent":[{"type":"text","text":"The "},{"code":"clientData:","type":"codeVoice"},{"type":"text","text":" overloads accept a pre-built "},{"identifier":"doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientData","type":"reference","isActive":true},{"type":"text","text":" instead of"},{"type":"text","text":" "},{"type":"text","text":"building one from "},{"code":"origin","type":"codeVoice"},{"type":"text","text":" + challenge. Use them in iOS Credential Provider \/"},{"type":"text","text":" "},{"type":"text","text":"AutoFill flows, where the system supplies a precomputed "},{"code":"clientDataHash","type":"codeVoice"},{"type":"text","text":" rather"},{"type":"text","text":" "},{"type":"text","text":"than the full "},{"code":"clientDataJSON","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","topicSections":[{"title":"Creating a Client","identifiers":["doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/init(session:origin:enterpriseRpIds:allowedExtensions:isPublicSuffix:)"],"anchor":"Creating-a-Client"},{"title":"Registration","identifiers":["doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","doc:\/\/wt-v140.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:clientData:authorization:)"],"anchor":"Registration"},{"title":"Authentication","identifiers":["doc:\/\/wt-v140.YubiKit\/docume
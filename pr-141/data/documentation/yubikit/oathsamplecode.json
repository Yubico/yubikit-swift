{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"seeAlsoSections":[{"anchor":"Sample-code","generated":true,"title":"Sample code","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"]}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","type":"reference","overridingTitle":"View Source","isActive":true}},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode"},"kind":"article","metadata":{"roleHeading":"Sample Code","color":{"standardColorIdentifier":"green"},"modules":[{"name":"YubiKit"}],"role":"sampleCode","title":"OATHSample: Basic OATH app showcasing how to integrate the SDK"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"abstract":[{"type":"text","text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"reference","isActive":true},{"type":"text","text":" to retrieve authentication codes, and "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"reference","isActive":true},{"type":"text","text":" to get device information."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"The sample creates an authenticator app that:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Establishes connections to YubiKeys via USB, Lightning, or NFC"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Manages connection lifecycle (detecting plugged\/unplugged devices)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists TOTP codes stored on the YubiKey"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Shows device information like firmware version"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handles connection errors and user cancellations gracefully"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This sample focuses on read-only operations and doesn’t handle password-protected YubiKeys or credential management.","type":"text"}],"type":"paragraph"},{"anchor":"Connection-Management","level":2,"text":"Connection Management","type":"heading"},{"anchor":"Handling-Wired-Connections","level":3,"text":"Handling Wired Connections","type":"heading"},{"inlineContent":[{"type":"text","text":"The app uses a "},{"code":"ConnectionManager","type":"codeVoice"},{"type":"text","text":" to handle persistent connections to plugged-in YubiKeys. This approach ensures your app stays responsive when users plug and unplug their YubiKeys:"}],"type":"paragraph"},{"code":["private func startWiredConnection() {","    wiredConnectionTask = Task { @MainActor in","        while !Task.isCancelled {","            do {","                let newConnection = try await WiredSmartCardConnection.makeConnection()","                wiredConnection = newConnection","","                \/\/ Wait for disconnect","                let closeError = await newConnection.waitUntilClosed()","                wiredConnection = nil","            } catch {","                self.error = error","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The key insight here is using "},{"code":"waitUntilClosed()","type":"codeVoice"},{"type":"text","text":" to detect when the YubiKey is unplugged, then automatically waiting for the next connection."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"NFC-Connections","text":"NFC Connections"},{"inlineContent":[{"type":"text","text":"NFC connections work differently - they’re initiated by user action and are short-lived:"}],"type":"paragraph"},{"code":["func requestNFCConnection() async {","    do {","        nfcConnection = try await NFCSmartCardConnection()","    } catch {","        self.error = error","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"When an NFC connection is established, the app fetches data and immediately closes it with a user message:"}],"type":"paragraph"},{"code":["Task {","    await model.update(using: connection)","    await connection.close(message: \"Codes calculated\")","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Working-with-YubiKey-Data","type":"heading","text":"Working with YubiKey Data"},{"level":3,"anchor":"Reading-OATH-Codes","type":"heading","text":"Reading OATH Codes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once you have a connection, getting TOTP codes is straightforward:"}]},{"code":["private func calculateCodes(using connection: SmartCardConnection) async {","    do {","        let session = try await OATHSession.makeSession(connection: connection)","        let result = try await session.calculateCredentialCodes()","        accounts = result.map { credential, code in","            Account(","                label: credential.label,","                code: code?.code,","                issuer: credential.issuer,","                type: credential.type","            )","        }","    } catch {","        self.error = error","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"calculateCredentialCodes()"},{"type":"text","text":" method returns a dictionary mapping credentials to their current codes. Some codes might be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if they require touch or are password-protected."}]},{"anchor":"Getting-Device-Information","type":"heading","text":"Getting Device Information","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"Management.Session"},{"type":"text","text":" to get YubiKey information:"}]},{"type":"codeListing","syntax":"swift","code":["private func getKeyVersion(using connection: SmartCardConnection) async {","    do {","        let session: Management.Session = try await .makeSession(connection: connection)","        self.keyVersion = await session.version.description","    } catch {","        self.error = error","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"Model","type":"codeVoice"},{"type":"text","text":" class combines both operations in a single "},{"code":"update","type":"codeVoice"},{"type":"text","text":" method:"}]},{"type":"codeListing","syntax":"swift","code":["func update(using connection: SmartCardConnection) async {","    await calculateCodes(using: connection)","    await getKeyVersion(using: connection)","    connectionType = connection.connectionType","}"]},{"level":2,"anchor":"SwiftUI-Integration","type":"heading","text":"SwiftUI Integration"},{"level":3,"anchor":"Reacting-to-Connection-Changes","type":"heading","text":"Reacting to Connection Changes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app uses SwiftUI’s "},{"code":"@Published","type":"codeVoice"},{"type":"text","text":" properties and "},{"code":"onReceive","type":"codeVoice"},{"type":"text","text":" to update the UI when connections change:"}]},{"type":"codeListing","syntax":"swift","code":[".onReceive(connectionManager.$wiredConnection) { newConnection in","    guard let connection = newConnection else {","        model.clear()  \/\/ Clear UI when YubiKey unplugged","        return","    }","    Task { await model.update(using: connection) }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This pattern ensures the UI immediately updates when YubiKeys are plugged in or removed."}]},{"level":3,"anchor":"Platform-Specific-Features","type":"heading","text":"Platform-Specific Features"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app handles iOS vs macOS differences with conditional compilation:"}]},{"type":"codeListing","syntax":"swift","code":["#if os(iOS)",".refreshable {","    await connectionManager.requestNFCConnection()","}","#endif"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS users can pull-to-refresh to scan with NFC, while macOS users only see USB options."}]},{"level":3,"anchor":"Connection-Type-Detection","type":"heading","text":"Connection Type Detection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample includes a useful extension to identify connection types:"}]},{"type":"codeListing","syntax":"swift","code":["extension SmartCardConnection {","    var connectionType: String {","        switch self {","        case _ as NFCSmartCardConnection: return \"NFC\"","        case _ as LightningSmartCardConnection: return \"Lightning\"","        case _ as USBSmartCardConnection: return \"USB\"","        default: return \"Unknown\"","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is helpful because NFC connections are slower than USB, and users like to know how their YubiKey is connected."}]},{"level":2,"anchor":"Architecture-Decisions","type":"heading","text":"Architecture Decisions"},{"level":3,"anchor":"Why-the-connection-management-works-this-way","type":"heading","text":"Why the connection management works this way"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample uses a background loop that continuously waits for wired connections. This might seem unusual, but it solves a key problem: YubiKeys get plugged and unplugged frequently, but apps need to stay responsive."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you unplug your YubiKey, the app doesn’t crash or freeze - it detects the disconnection via "},{"code":"waitUntilClosed()","type":"codeVoice"},{"type":"text","text":" and immediately starts waiting for the next YubiKey. This creates a smoother user experience where the app responds when you plug \/ unplug a YubiKey."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"NFC works differently since you can’t continuously scan - the user has to explicitly initiate each scan. That’s why NFC connections are handled separately through user actions like the scan button or pull-to-refresh."}]},{"level":3,"anchor":"Error-handling-for-hardware-connections","type":"heading","text":"Error handling for hardware connections"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hardware connections are unreliable by nature. Users will unplug devices mid-operation, walk away during NFC scans, or have connectivity issues. The sample handles this gracefully:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Connection failures are caught and stored as errors"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"User cancellations (like dismissing NFC scan) are filtered out to avoid unnecessary error alerts"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Session errors are handled similarly - show the error but maintain app functionality"}],"type":"paragraph"}]}]},{"level":3,"anchor":"Working-with-Swift-actors","type":"heading","text":"Working with Swift actors"},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit sessions are Swift actors that handle their own threading. The sample shows how to integrate this with SwiftUI’s main actor requirements:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"ConnectionManager","type":"codeVoice"},{"type":"text","text":" runs on "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" so it can directly update "},{"code":"@Published","type":"codeVoice"},{"type":"text","text":" properties"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Session calls happen on the session’s actor, then results are passed back to update the UI"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Everything uses "},{"code":"async\/await","type":"codeVoice"}],"type":"paragraph"}]}]}]}],"variants":[{"paths":["\/documentation\/yubikit\/oathsamplecode"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"abstract":[{"type":"text","text":"An interface to the OATH application on the YubiKey."}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"OATHSession"}],"type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","kind":"symbol","url":"\/documentation\/yubikit\/oathsession","navigatorTitle":[{"kind":"identifier","text":"OATHSession"}],"role":"symbol","title":"OATHSession"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"abstract":[{"type":"text","text":"An interface to the PIV application on the YubiKey."}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"PIVSession"}],"type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","kind":"symbol","url":"\/documentation\/yubikit\/pivsession","navigatorTitle":[{"kind":"identifier","text":"PIVSession"}],"role":"symbol","title":"PIVSession"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","abstract":[{"text":"An interface to the Management application on the YubiKey.","type":"text"}],"navigatorTitle":[{"text":"Session","kind":"identifier"}],"type":"topic","url":"\/documentation\/yubikit\/management\/session","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Session"}],"title":"Management.Session"},"documentation-header.png":{"type":"image","identifier":"documentation-header.png","alt":"YubiKeys in a row","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"role":"collection","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"title":"YubiKit","kind":"symbol","url":"\/documentation\/yubikit","type":"topic","images":[{"identifier":"documentation-header.png","type":"icon"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"role":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"title":"WebAuthn.Client","navigatorTitle":[{"text":"Client","kind":"identifier"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/yubikit\/webauthn\/client"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","abstract":[{"text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","type":"reference","isActive":true},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}],"type":"topic","url":"\/documentation\/yubikit\/pivtoolsamplecode","role":"sampleCode","kind":"article","title":"PIVTool: Building PIV applications with YubiKey"},"https://github.com/Yubico/yubikit-swift/tree/main/Samples/OATHSample":{"type":"download","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","url":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","checksum":null},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"url":"\/documentation\/yubikit\/webauthninterceptorsamplecode","role":"sampleCode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","kind":"article","abstract":[{"type":"text","text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts "},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"type":"text","text":" calls inside a "},{"code":"WKWebView","type":"codeVoice"},{"type":"text","text":" and routes them to a YubiKey. It uses the high-level "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"type":"text","text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" companion module."}],"title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","type":"topic"}}}
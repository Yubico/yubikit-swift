{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"No setup is required. YubiKit defaults to "},{"type":"codeVoice","code":"debug"},{"type":"text","text":" on stdout when compiled with "},{"type":"codeVoice","code":"DEBUG"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"info"},{"type":"text","text":" on stderr otherwise. You can override either default:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","YubiKit.Logs.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","YubiKit.Logs.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","YubiKit.Logs.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","YubiKit.Logs.configure()"]},{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-log"},{"text":"’s ","type":"text"},{"code":"Logging","type":"codeVoice"},{"text":" product to your app target","type":"text"},{"text":" ","type":"text"},{"text":"to use its backend types. Any SwiftLog ","type":"text"},{"type":"codeVoice","code":"LogHandler"},{"text":" can be supplied by the factory.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;","type":"text"},{"text":" ","type":"text"},{"text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,","type":"text"},{"text":" ","type":"text"},{"text":"though logs already in progress may use the previous settings.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,","type":"text"},{"text":" ","type":"text"},{"text":"pass its factory explicitly; global ","type":"text"},{"type":"codeVoice","code":"LoggingSystem.bootstrap"},{"text":" does not select YubiKit’s backend.","type":"text"},{"text":" ","type":"text"},{"text":"Factories may run concurrently and must not log through YubiKit themselves.","type":"text"}]},{"anchor":"Traffic-logging","text":"Traffic logging","level":3,"type":"heading"},{"code":["YubiKit.Logs.configure(logLevel: .trace)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Raw traffic and SCP plaintext logs require ","type":"text"},{"type":"strong","inlineContent":[{"text":"YubiKit to be compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Neither configuration nor a custom backend can enable them in other builds."},{"type":"text","text":" "},{"type":"text","text":"Custom connections are responsible for their own traffic logging."}],"type":"paragraph"},{"style":"warning","content":[{"type":"paragraph","inlineContent":[{"text":"Debug logs can include account names and credential identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Trace logs can include PINs, credentials, and cryptographic keys. Protect or redact logs before sharing them.","type":"text"}]}],"name":"Warning","type":"aside"},{"anchor":"Custom-backends","text":"Custom backends","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Labels identify categories, such as "},{"type":"codeVoice","code":"com.yubico.YubiKit.OATH"},{"type":"text","text":" or "},{"type":"codeVoice","code":"com.yubico.YubiKit.FIDO"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Metadata carries details such as byte counts and error codes; the default backend displays"},{"type":"text","text":" "},{"type":"text","text":"these as "},{"code":"key=value","type":"codeVoice"},{"text":" pairs. Message wording and metadata keys are not a stable API.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/yubikit\/loggingguide"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Logging","modules":[{"name":"YubiKit"}],"roleHeading":"Article","role":"article"},"sections":[],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"abstract":[{"text":"Choose YubiKit’s log level and backend with ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)","type":"reference","isActive":true},{"text":".","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","seeAlsoSections":[{"title":"Preparing your project","generated":true,"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"anchor":"Preparing-your-project"}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/GettingStarted":{"role":"article","title":"Getting Started","url":"\/documentation\/yubikit\/gettingstarted","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","abstract":[{"type":"text","text":"Prepare your project to connect to the YubiKey via NFC, SmartCard, Lightning and USB HID."}],"kind":"article","type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logs/configure(logLevel:factory:)":{"url":"\/documentation\/yubikit\/logs\/configure(loglevel:factory:)","abstract":[{"type":"text","text":"Sets YubiKit’s log level and backend."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)","t
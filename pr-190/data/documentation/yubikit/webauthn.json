WebAuthn\/Client"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WebAuthn","kind":"identifier"}]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Contains the high-level passkey ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":" and the request, response, and","type":"text"},{"text":" ","type":"text"},{"text":"data-model types defined by the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/"},{"text":" ","type":"text"},{"text":"specification.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A passkey client and the W3C Web Authentication data model, mediated by a YubiKey.","type":"text"}]},{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"WebAuthn"},{"text":" namespace provides a high-level passkey client (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":") that runs","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/","overridingTitle":"Web Authentication Level 3","overridingTitleInlineContent":[{"text":"Web Authentication Level 3","type":"text"}]},{"text":" ceremonies against a","type":"text"},{"text":" ","type":"text"},{"text":"YubiKey, plus the request and response types defined by the WebAuthn specification.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A WebAuthn ceremony involves three parties: the ","type":"text"},{"type":"strong","inlineContent":[{"text":"authenticator","type":"text"}]},{"text":" (a YubiKey), the","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"text":"client","type":"text"}]},{"text":" (your app, via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":"), and the ","type":"text"},{"type":"strong","inlineContent":[{"text":"relying party","type":"text"}]},{"text":" (your server, which","type":"text"},{"text":" ","type":"text"},{"text":"verifies what the authenticator returns). The client is the communication path between","type":"text"},{"text":" ","type":"text"},{"text":"authenticator and relying party — and it verifies the relying party’s identity against","type":"text"},{"text":" ","type":"text"},{"text":"the origin it’s bound to, so it can refuse to sign for a fraudulent site.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"There are two ceremonies. ","type":"text"},{"type":"strong","inlineContent":[{"text":"Registration","type":"text"}]},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)"},{"text":") creates a new credential and supplies its","type":"text"},{"text":" ","type":"text"},{"text":"public key to the relying party for account association. ","type":"text"},{"type":"strong","inlineContent":[{"text":"Authentication","type":"text"}]},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)"},{"text":") proves to the relying party that the","type":"text"},{"text":" ","type":"text"},{"text":"YubiKey is the one registered for the user. Both ceremonies follow the same mechanical","type":"text"},{"text":" ","type":"text"},{"text":"shape: the relying party supplies a challenge, the authenticator signs it together","type":"text"},{"text":" ","type":"text"},{"text":"with the relying-party identifier, and the signature goes back to the relying party","type":"text"},{"text":" ","type":"text"},{"text":"for verification.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The pieces fit together as: a connection carries CTAP2 traffic, a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"text":" ","type":"text"},{"text":"sits on top, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":" runs ceremonies on that session. Connections come in","type":"text"},{"text":" ","type":"text"},{"text":"three flavours that all work for WebAuthn: ","type":"text"},{"type":"codeVoice","code":"YubiKit\/HIDFIDOConnection"},{"text":" on macOS,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection"},{"text":" for tap-to-auth on iOS, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/USBSmartCardConnection"},{"text":" on either platform. Pick the one that matches","type":"text"},{"text":" ","type":"text"},{"text":"your platform and form factor.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ macOS — USB HID FIDO","let connection = try await HIDFIDOConnection()","\/\/ iOS — tap-to-auth over NFC:","\/\/ let connection = try await NFCSmartCardConnection()","","let session = try await CTAP2.Session.makeSession(connection: connection)","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","\/\/ Register a new passkey","let registration = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value","","\/\/ Authenticate","let assertions = try await client.getAssertion(","    .init(challenge: challenge, rpId: \"example.com\"),","    authorization: .pin(\"1234\")",").value"]},{"type":"paragraph","inlineContent":[{"text":"Most apps start with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":". For lower-level CTAP2 access — raw ","type":"text"},{"code":"makeCredential","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":"getAssertion","type":"codeVoice"},{"text":", credential management, bio enrollment — use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"text":" directly.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/webauthn"]}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/UserVerificationPreference":{"abstract":[{"type":"text","text":"Preference for user verification during an operation."}],"url":"\/documentation\/yubikit\/webauthn\/userverificationpreference","navigatorTitle":[{"text":"UserVerificationPreference","kind":"identifier"}],"role":"symbol","title":"WebAuthn.UserVerificationPreference","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UserVerificationPreference","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/UserVerificationPreference","type":"topic"},"doc://yubikit-swift.YubiKit/document
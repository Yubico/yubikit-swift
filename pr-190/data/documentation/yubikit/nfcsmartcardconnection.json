og and waits for the user to tap their YubiKey.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"NFC connections are short-lived due to iOS timeout constraints. Perform operations quickly","type":"text"},{"text":" ","type":"text"},{"text":"and close the connection with a user-visible message.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let connection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","await connection.close(message: \"Codes retrieved\")"]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"NFCSmartCardConnection"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NFCSmartCardConnection","kind":"identifier"}],"modules":[{"name":"YubiKit"}],"role":"symbol","externalID":"s:7YubiKit22NFCSmartCardConnectionV","title":"NFCSmartCardConnection","symbolKind":"struct"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"kind":"symbol","seeAlsoSections":[{"anchor":"Creating-a-SmartCardConnection-to-a-YubiKey","title":"Creating a SmartCardConnection to a YubiKey","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/USBSmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LightningSmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WiredSmartCardConnection"],"generated":true}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection","interfaceLanguage":"swift"},"abstract":[{"text":"A NFC connection to the YubiKey.","type":"text"}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/NFCSmartCa
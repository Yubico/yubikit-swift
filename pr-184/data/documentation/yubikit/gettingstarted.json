ess entitlement, list of NFC"},{"type":"text","text":" "},{"type":"text","text":"application identifiers and a NFC Privacy statement to the application."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Add Wireless entitlement"}]}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the “Signing & Capabilities” tab."}]}]},{"content":[{"inlineContent":[{"text":"Click the “+”-button to add a new capability.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the “Near Field Communication Tag” capability."}]}]}]},{"inlineContent":[{"type":"image","identifier":"nfc-entitlement.png"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Add list of NFC application identifiers","type":"text"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”.","type":"text"}]}]}],"start":6,"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-identifiers.png"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the Yubico NFC application identifiers to enable communication with the different"},{"type":"text","text":" "},{"type":"text","text":"applications on the YubiKey."}]}]}],"start":8,"type":"orderedList"},{"syntax":null,"code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"],"type":"codeListing"},{"inlineContent":[{"identifier":"nfc-identifiers-list.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Add a NFC Privacy description","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in","type":"text"},{"text":" ","type":"text"},{"text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”","type":"text"}]}]}],"start":9,"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-privacy.png"}]},{"anchor":"SmartCardUSB","text":"SmartCard\/USB","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" entitlement to your application."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the application entitlements file.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" entitlement to the entitlement list.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"smart-card.png"}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"USB SmartCard supports Yubico OTP slot programming. HMAC-SHA1 challenge-response requires"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HIDOTPConnection"},{"text":" on macOS, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LightningSmartCardConnection"},{"text":", or NFC without a touch requirement.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session"},{"text":".","type":"text"}]}],"name":"Note"},{"level":3,"type":"heading","text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey","anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the "},{"code":"com.yubico.ylp","type":"codeVoice"},{"type":"text","text":" string to the list of External Accessories."}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your project."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your application target."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not present add the ","type":"text"},{"type":"codeVoice","code":"Supported external accessory protocols"},{"text":" key and insert the string ","type":"text"},{"type":"codeVoice","code":"com.yubico.ylp"},{"text":" in its list.","type":"text"}]}]}]},{"inlineContent":[{"identifier":"external-accessory.png","type":"image"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for ","type":"text"},{"code":"Supported external accessory protocols","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework.","type":"text"}],"type":"paragraph"}],"name":"Note","type":"aside"},{"anchor":"Making-Your-First-Connection","level":2,"text":"Making Your First Connection","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device."}]},{"anchor":"Understanding-Connection-Types","level":3,"text":"Understanding Connection Types","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"YubiKit provides the following connection methods:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"NFC"}]},{"type":"text","text":": Short-range wireless communication (iOS only)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"USB"}]},{"type":"text","text":": Direct USB connection via SmartCard interface"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Lightning"}]},{"text":": YubiKey 5Ci connected to Lightning port (iOS only)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"USB HID","type":"text"}]},{"type":"text","text":": Direct access to the FIDO or OTP interface (macOS only)"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each connection type works differently, so let’s explore how to use them."}]},{"level":3,"anchor":"NFC-Connections","type":"heading","text":"NFC Connections"},{"inlineContent":[{"text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"],"type":"codeListing"},{"inlineContent":[{"text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete.","type":"text"}],"type":"paragraph"},{"text":"USB and Lightning Connections","anchor":"USB-and-Lightning-Connections","level":3,"type":"heading"},{"inlineContent":[{"text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"WiredSmartCardConnection.makeConnection()","type":"codeVoice"},{"text":" method automatically detects whether you’re using USB or Lightning.","type":"text"}],"type":"paragraph"},{"anchor":"Specific-Connection-Types","text":"Specific Connection Types","level":3,"type":"heading"},{"inlineContent":[{"text":"For more control, you can connect to specific interfaces:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"],"type":"codeListing"},{"inlineContent":[{"text":"On macOS, use ","type":"text"},{"code":"HIDOTPConnection","type":"codeVoice"},{"text":" for the OTP keyboard interface or ","type":"text"},{"code":"HIDFIDOConnection","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"the FIDO interface:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let otpConnection = try await HIDOTPConnection()"],"type":"codeListing"},{"text":"Understanding Connection Lifecycle","anchor":"Understanding-Connection-Lifecycle","level":2,"type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Critical:","type":"text"}]},{"text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time.","type":"text"}],"type":"paragraph"},{"anchor":"Connection-Behavior","text":"Connection Behavior","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Exclusive access"}]},{"type":"text","text":": Only one connection can exist per YubiKey at any time"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Manual closure required"}]},{"type":"text","text":": Dropping a connection reference does NOT automatically close it - you must call "},{"type":"codeVoice","code":"close()"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Resource blocking"}]},{"type":"text","text":": An unclosed connection prevents new connections (throws "},{"type":"codeVoice","code":"SmartCardConnectionError.busy"},{"type":"text","text":")"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call ","type":"text"},{"type":"codeVoice","code":"close()"},{"type":"text","text":"."}]},{"anchor":"Working-with-Sessions","text":"Working with Sessions","level":2,"type":"heading"},{"inlineContent":[{"text":"Once you have a connection, create sessions to access different YubiKey applications:","type":"text"}],"type":"paragraph"},{"anchor":"OATH-Session-TOTPHOTP-codes","level":3,"text":"OATH Session (TOTP\/HOTP codes)","type":"heading"},{"syntax":"swift","code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"],"type":"codeListing"},{"level":3,"anchor":"Yubico-OTP-Session-OTP-slots","text":"Yubico OTP Session (OTP slots)","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","type":"reference"},{"text":" manages the two OTP slots. Create it with a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","type":"reference"},{"text":" or,","type":"text"},{"text":" ","type":"text"},{"text":"on macOS, an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OTPConnection","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let session = try await YubiOTP.Session.makeSession(connection: connection)","let state = await session.configState","print(\"Slot 2 configured: \\(try state.isConfigured(.two))\")","","\/\/ Program slot 2 for HOTP, replacing its existing configuration","try await session.putConfiguration(.hotp(key: secret), in: .two)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","type":"reference"},{"text":" for HMAC-SHA1 challenge-response, transport support, and NFC output.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"PIV-Session-Certificates-and-keys","text":"PIV Session (Certificates and keys)","type":"heading"},{"code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Management-Session-Device-information","text":"Management Session (Device information)","type":"heading"},{"code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"WebAuthn-Client-FIDO2--passkeys","text":"WebAuthn Client (FIDO2 \/ passkeys)","type":"heading"},{"inlineContent":[{"text":"For passkey registration and authentication, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":" wraps a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"code":"HIDFIDOConnection","type":"codeVoice"},{"text":" (USB HID on macOS) or any ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection"},{"text":" ","type":"text"},{"text":"(NFC \/ USB CCID).","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"],"type":"codeListing"},{"inlineContent":[{"text":"PIN and UV are supplied per ceremony via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization"},{"text":". For raw","type":"text"},{"text":" ","type":"text"},{"text":"CTAP2 access (credential management, bio enrollment, large blobs), use","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"text":" directly.","type":"text"}],"type":"paragraph"},{"anchor":"Connection-Management-Patterns","text":"Connection Management Patterns","level":2,"type":"heading"},{"level":3,"anchor":"For-UI-Applications","text":"For UI Applications","type":"heading"},{"inlineContent":[{"text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/docume
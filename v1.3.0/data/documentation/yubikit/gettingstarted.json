pleCode"},"doc://swift-sdk.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"role":"sampleCode","identifier":"doc:\/\/swift-sdk.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","type":"topic","kind":"article","abstract":[{"type":"text","text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/swift-sdk.YubiKit\/documentation\/YubiKit\/PIVSession"},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}],"title":"PIVTool: Building PIV applications with YubiKey","url":"\/documentation\/yubikit\/pivtoolsamplecode"},"add-framework-1.png":{"identifier":"add-framework-1.png","alt":"An image showing how to add the YubiKit SDK to your Xcode project.","variants":[{"traits":["2x","light"],"url":"\/images\/swift-sdk.YubiKit\/add-framework-1@2x.png"},{"traits":["2x","dark"],"url":"\/images\/swift-sdk.YubiKit\/add-framework-1~dark@2x.png"}],"type":"image"},"doc://swift-sdk.YubiKit/documentation/YubiKit/SmartCardConnection":{"title":"SmartCardConnection","kind":"symbol","identifier":"doc:\/\/swift-sdk.YubiKit\/documentation\/YubiKit\/SmartCardConnection","url":"\/documentation\/yubikit\/smartcardconnection","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SmartCardConnection","kind":"identifier"}],"navigatorTitle":[{"text":"SmartCardConnection","kind":"identifier"}],"abstract":[{"type":"text","text":"An interface defining a SmartCard based connection to a YubiKey."}],"role":"symbol","type":"topic"},"doc://swift-sdk.YubiKit/documentation/YubiKit/WebAuthn/Authorization":{"title":"WebAuthn.Authorization","kind":"symbol","identifier":"doc:\/\/swift-sdk.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","url":"\/documentation\/yubikit\/webauthn\/authorization","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Authorization","kind":"identifier"}],"navigatorTitle":[{"text":"Authorization","kind":"identifier"}],"abstract":[{"type":"text","text":"PIN\/UV policy for a single WebAuthn ceremony."}],"role":"symbol","type":"topic"},"nfc-entitlement.png":{"identifier":"nfc-entitlement.png","alt":"An image showing how to add wireless entitlements to project.","variants":[{"traits":["2x","light"],"url":"\/images\/swift-sdk.YubiKit\/nfc-entitlement@2x.png"},{"traits":["2x","dark"],"url":"\/images\/swift-sdk.YubiKit\/nfc-entitlement~dark@2x.png"}],"type":"image"},"nfc-identifiers.png":{"type":"image","identifier":"nfc-identifiers.png","alt":"An image showing how to add the nfc application identifiers.","variants":[{"url":"\/images\/swift-sdk.YubiKit\/nfc-identifiers@2x.png","traits":["2x","light"]},{"url":"\/images\/swift-sdk.YubiKit\/nfc-identifiers~dark@2x.png","traits":["2x","dark"]}]},"doc://swift-sdk.YubiKit/documentation/YubiKit/PIVSession":{"title":"PIVSession","kind":"symbol","identifier":"doc:\/\/swift-sdk.YubiKit\/documentation\/YubiKit\/PIVSession","url":"\/documentation\/yubikit\/pivsession","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"PIVSession"}],"abstract":[{"type":"text","text":"An interface to the PIV application on the YubiKey."}],"role":"symbol","type":"topic"},"nfc-privacy.png":{"variants":[{"traits":["2x","light"],"url":"\/images\/swift-sdk.YubiKit\/nfc-privacy@2x.png"},{"url":"\/images\/swift-sdk.YubiKit\/nfc-privacy~dark@2x.png","traits":["2x","dark"]}],"type":"image","alt":"An image showing how to add the NFC privacy string to a project.","identifier":"nfc-privacy.png"},"nfc-identifiers-list.png":{"type":"image","identifier":"nfc-identifiers-list.png","alt":"An image showing the list of nfc identifiers added.","variants":[{"url":"\/images\/swift-sdk.YubiKit\/nfc-identifiers-list@2x.png","traits":["2x","light"]},{"traits":["2x","dark"],"url":"\/images\/swift-sdk.YubiKit\/nfc-identifiers-list~dark@2x.png"}]},"documentation-header.png":{"type":"image","identifier":"documentation-header.png","alt":"YubiKeys in a row","variants":[{"traits":["2x","light"],"url":"\/images\/swift-sdk.YubiKit\/documentation-header@2x.png"},{"traits":["2x","dark"],"url":"\/images\/swift-sdk.YubiKit\/documentation-header~dark@2x.png"}]},"doc://swift-sdk.YubiKit/documentation/YubiKit":{"identifier":"doc:\/\/swift-sdk.YubiKit\/documentation\/YubiKit","url":"\/documentation\/yubikit","images":[{"type":"icon","identifier":"documentation-header.png"}],"type":"topic","role":"collection","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"title":"YubiKit","kind":"symbol"}}}
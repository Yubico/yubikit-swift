{"abstract":[{"text":"Prepare your project to connect to the YubiKey via NFC, SmartCard, Lightning and USB HID.","type":"text"}],"metadata":{"role":"article","modules":[{"name":"YubiKit"}],"roleHeading":"Article","title":"Getting Started"},"seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"anchor":"Preparing-your-project","generated":true,"title":"Preparing your project"}],"variants":[{"paths":["\/documentation\/yubikit\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"The YubiKit framework is distributed using the Swift Package Manager. To add the framework to your project follow these steps:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Package Dependencies” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Press the plus-button to bring up the add package dialog.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"add-framework-1.png"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Enter ","type":"text"},{"type":"codeVoice","code":"https:\/\/github.com\/Yubico\/yubikit-swift\/"},{"text":" in the search field and select the Yubico Swift Package.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Press the “Add Package” button to add the SDK to your project.","type":"text"}]}]}],"start":4,"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"add-framework-2.png"}],"type":"paragraph"},{"text":"NFC","type":"heading","anchor":"NFC","level":3},{"inlineContent":[{"type":"text","text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC"},{"type":"text","text":" "},{"type":"text","text":"application identifiers and a NFC Privacy statement to the application."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Add Wireless entitlement"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Signing & Capabilities” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Click the “+”-button to add a new capability.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the “Near Field Communication Tag” capability.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"nfc-entitlement.png"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Add list of NFC application identifiers"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”.","type":"text"}]}]}],"start":6,"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"nfc-identifiers.png"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the Yubico NFC application identifiers to enable communication with the different","type":"text"},{"text":" ","type":"text"},{"text":"applications on the YubiKey.","type":"text"}]}]}],"start":8,"type":"orderedList"},{"syntax":null,"code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"],"type":"codeListing"},{"inlineContent":[{"type":"image","identifier":"nfc-identifiers-list.png"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Add a NFC Privacy description"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in","type":"text"},{"text":" ","type":"text"},{"text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”","type":"text"}]}]}],"start":9,"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"nfc-privacy.png"}],"type":"paragraph"},{"text":"SmartCard\/USB","type":"heading","anchor":"SmartCardUSB","level":3},{"inlineContent":[{"type":"text","text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" entitlement to your application."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the application entitlements file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"text":" entitlement to the entitlement list.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"smart-card.png"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"USB SmartCard supports Yubico OTP slot programming. HMAC-SHA1 challenge-response requires"},{"type":"text","text":" "},{"code":"HIDOTPConnection","type":"codeVoice"},{"type":"text","text":" on macOS, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LightningSmartCardConnection"},{"type":"text","text":", or NFC without a touch requirement."},{"type":"text","text":" "},{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey","type":"heading","anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey","level":3},{"inlineContent":[{"type":"text","text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the "},{"type":"codeVoice","code":"com.yubico.ylp"},{"type":"text","text":" string to the list of External Accessories."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not present add the ","type":"text"},{"type":"codeVoice","code":"Supported external accessory protocols"},{"text":" key and insert the string ","type":"text"},{"type":"codeVoice","code":"com.yubico.ylp"},{"text":" in its list.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"external-accessory.png"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for "},{"code":"Supported external accessory protocols","type":"codeVoice"},{"type":"text","text":" to "},{"code":"com.yubico.ylp","type":"codeVoice"},{"type":"text","text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"text":"Making Your First Connection","type":"heading","anchor":"Making-Your-First-Connection","level":2},{"inlineContent":[{"type":"text","text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device."}],"type":"paragraph"},{"text":"Understanding Connection Types","type":"heading","anchor":"Understanding-Connection-Types","level":3},{"inlineContent":[{"type":"text","text":"YubiKit provides the following connection methods:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"NFC","type":"text"}]},{"text":": Short-range wireless communication (iOS only)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"USB","type":"text"}]},{"text":": Direct USB connection via SmartCard interface","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Lightning","type":"text"}]},{"text":": YubiKey 5Ci connected to Lightning port (iOS only)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"USB HID","type":"text"}]},{"text":": Direct access to the FIDO or OTP interface (macOS only)","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Each connection type works differently, so let’s explore how to use them."}],"type":"paragraph"},{"text":"NFC Connections","type":"heading","anchor":"NFC-Connections","level":3},{"inlineContent":[{"type":"text","text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:"}],"type":"paragraph"},{"syntax":"swift","code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete."}],"type":"paragraph"},{"text":"USB and Lightning Connections","type":"heading","anchor":"USB-and-Lightning-Connections","level":3},{"inlineContent":[{"type":"text","text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:"}],"type":"paragraph"},{"syntax":"swift","code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"WiredSmartCardConnection.makeConnection()"},{"type":"text","text":" method automatically detects whether you’re using USB or Lightning."}],"type":"paragraph"},{"text":"Specific Connection Types","type":"heading","anchor":"Specific-Connection-Types","level":3},{"inlineContent":[{"type":"text","text":"For more control, you can connect to specific interfaces:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"On macOS, use "},{"type":"codeVoice","code":"HIDOTPConnection"},{"type":"text","text":" for the OTP keyboard interface or "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the FIDO interface:"}],"type":"paragraph"},{"syntax":"swift","code":["let otpConnection = try await HIDOTPConnection()"],"type":"codeListing"},{"text":"Understanding Connection Lifecycle","type":"heading","anchor":"Understanding-Connection-Lifecycle","level":2},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Critical:"}],"type":"strong"},{"type":"text","text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time."}],"type":"paragraph"},{"text":"Connection Behavior","type":"heading","anchor":"Connection-Behavior","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Exclusive access"}],"type":"strong"},{"text":": Only one connection can exist per YubiKey at any time","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Manual closure required"}],"type":"strong"},{"text":": Dropping a connection reference does NOT automatically close it - you must call ","type":"text"},{"code":"close()","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Resource blocking"}],"type":"strong"},{"text":": An unclosed connection prevents new connections (throws ","type":"text"},{"code":"SmartCardConnectionError.busy","type":"codeVoice"},{"text":")","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call "},{"code":"close()","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Working with Sessions","type":"heading","anchor":"Working-with-Sessions","level":2},{"inlineContent":[{"type":"text","text":"Once you have a connection, create sessions to access different YubiKey applications:"}],"type":"paragraph"},{"text":"OATH Session (TOTP\/HOTP codes)","type":"heading","anchor":"OATH-Session-TOTPHOTP-codes","level":3},{"syntax":"swift","code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"],"type":"codeListing"},{"text":"Yubico OTP Session (OTP slots)","type":"heading","anchor":"Yubico-OTP-Session-OTP-slots","level":3},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session"},{"type":"text","text":" manages the two OTP slots. Create it with a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection"},{"type":"text","text":" or,"},{"type":"text","text":" "},{"type":"text","text":"on macOS, an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OTPConnection"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let session = try await YubiOTP.Session.makeSession(connection: connection)","let state = await session.configState","print(\"Slot 2 configured: \\(try state.isConfigured(.two))\")","","\/\/ Program slot 2 for HOTP, replacing its existing configuration","try await session.putConfiguration(.hotp(key: secret), in: .two)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session"},{"type":"text","text":" for HMAC-SHA1 challenge-response, transport support, and NFC output."}],"type":"paragraph"},{"text":"PIV Session (Certificates and keys)","type":"heading","anchor":"PIV-Session-Certificates-and-keys","level":3},{"syntax":"swift","code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"],"type":"codeListing"},{"text":"Management Session (Device information)","type":"heading","anchor":"Management-Session-Device-information","level":3},{"syntax":"swift","code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"],"type":"codeListing"},{"text":"WebAuthn Client (FIDO2 \/ passkeys)","type":"heading","anchor":"WebAuthn-Client-FIDO2--passkeys","level":3},{"inlineContent":[{"text":"For passkey registration and authentication, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":" wraps a","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"type":"text","text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" (USB HID on macOS) or any "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection"},{"text":" ","type":"text"},{"text":"(NFC \/ USB CCID).","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"]},{"inlineContent":[{"type":"text","text":"PIN and UV are supplied per ceremony via "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","isActive":true},{"type":"text","text":". For raw"},{"text":" ","type":"text"},{"text":"CTAP2 access (credential management, bio enrollment, large blobs), use","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"text":" directly.","type":"text"}],"type":"paragraph"},{"text":"Connection Management Patterns","type":"heading","anchor":"Connection-Management-Patterns","level":2},{"text":"For UI Applications","type":"heading","anchor":"For-UI-Applications","level":3},{"inlineContent":[{
{"seeAlsoSections":[{"title":"Sample code","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"],"anchor":"Sample-code","generated":true}],"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"sampleCodeDownload":{"kind":"sampleDownload","action":{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample","overridingTitle":"View Source"}},"abstract":[{"type":"text","text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts "},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"type":"text","text":" calls inside a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" and routes them to a YubiKey. It uses the high-level "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"type":"text","text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" companion module."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/webauthninterceptorsamplecode"]}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"The interceptor demonstrates how to:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Intercept ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.create()"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.get()"},{"text":" in a ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options","isActive":true},{"text":" \/ ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","isActive":true},{"text":" types.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Drive the SDK’s high-level ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use the bundled ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface."}],"type":"paragraph"},{"anchor":"Architecture-Overview","type":"heading","text":"Architecture Overview","level":2},{"inlineContent":[{"type":"text","text":"The sample itself is intentionally thin:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Interceptor.js","type":"text"}],"type":"strong"},{"text":" — injected into the ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" to monkey-patch ","type":"text"},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"text":" and shuttle requests\/responses through ","type":"text"},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"WebView.swift","type":"text"}]},{"text":" — ","type":"text"},{"type":"codeVoice","code":"UIViewRepresentable"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"NSViewRepresentable"},{"text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"WebAuthnHandler.swift"}],"type":"strong"},{"type":"text","text":" — decodes the JSON envelope, builds a "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","isActive":true,"type":"reference"},{"text":", and calls ","type":"text"},{"code":"FidoUI.makeCredential","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"FidoUI.getAssertion","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"ContentView.swift"}],"type":"strong"},{"text":" — minimal SwiftUI shell with a URL bar and back button.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"FidoUI","type":"text"}]},{"type":"text","text":" (separate Swift package under "},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI"},{"type":"text","text":") — the reusable UI + transport layer described below."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The end-to-end flow:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Page JS calls "},{"type":"codeVoice","code":"navigator.credentials.create()"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".get()"},{"type":"text","text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" decodes the JSON straight into the SDK’s strongly-typed "},{"code":"Options","type":"codeVoice"},{"type":"text","text":" and hands them to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" opens a transport, runs the ceremony via "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"type":"text","text":", and shows PIN \/ UV \/ error \/ success panels as needed."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The resulting "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","isActive":true,"type":"reference"},{"type":"text","text":" is serialized via its built-in "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" and posted back to JS."}],"type":"paragraph"}]}]},{"anchor":"Intercepting-WebAuthn-Calls","type":"heading","text":"Intercepting WebAuthn Calls","level":2},{"anchor":"JavaScript-Injection","type":"heading","text":"JavaScript Injection","level":3},{"inlineContent":[{"code":"Interceptor.js","type":"codeVoice"},{"text":" replaces ","type":"text"},{"code":"navigator.credentials.create","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"navigator.credentials.get","type":"codeVoice"},{"text":" with versions that forward to Swift. Binary fields (","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"user.id","type":"codeVoice"},{"text":", ","type":"text"},{"code":"rawId","type":"codeVoice"},{"text":", …) are serialized to ","type":"text"},{"inlineContent":[{"text":"base64url","type":"text"}],"type":"strong"},{"text":" strings via ","type":"text"},{"code":"JSON.stringify","type":"codeVoice"},{"text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed.","type":"text"}],"type":"paragraph"},{"syntax":"javascript","type":"codeListing","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"]},{"inlineContent":[{"text":"The script is injected at document start so it runs before any page code:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"]},{"inlineContent":[{"code":"shouldIntercept","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for any ","type":"text"},{"code":"publicKey","type":"codeVoice"},{"text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when ","type":"text"},{"code":"publicKey.hints","type":"codeVoice"},{"text":" includes ","type":"text"},{"code":"\"security-key\"","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"anchor":"Receiving-Messages-in-Swift","type":"heading","text":"Receiving Messages in Swift","level":3},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" is both "},{"type":"codeVoice","code":"WKNavigationDelegate"},{"type":"text","text":" and "},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"type":"text","text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:"}],"type":"paragraph"},{"syntax":"swift","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"shutdown()"},{"type":"text","text":" is called from "},{"type":"codeVoice","code":"dismantle{UI,NS}View"},{"type":"text","text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle."}],"type":"paragraph"},{"anchor":"Driving-the-Ceremony","level":2,"text":"Driving the Ceremony","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" is intentionally tiny — it decodes the envelope, builds a typed "},{"type":"codeVoice","code":"Origin"},{"type":"text","text":", and delegates to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself."}],"type":"paragraph"},{"syntax":"swift","code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"handleGet"},{"type":"text","text":" is the symmetric counterpart that decodes "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"fidoUI.getAssertion"},{"type":"text","text":". The response JSON produced by "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to "},{"type":"codeVoice","code":"ArrayBuffer"},{"type":"text","text":" when it materializes the credential."}],"type":"paragraph"},{"anchor":"Returning-the-Response-to-JavaScript","level":2,"text":"Returning the Response to JavaScript","type":"heading"},{"inlineContent":[{"type":"text","text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:"}],"type":"paragraph"},{"syntax":"swift","code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"JavaScript decodes the JSON and rebuilds a "},{"type":"codeVoice","code":"PublicKeyCredential"},{"type":"text","text":"-shaped object — converting the base64url binary fields back to "},{"type":"codeVoice","code":"ArrayBuffer"},{"type":"text","text":"s and wiring up "},{"type":"codeVoice","code":"getClientExtensionResults"},{"type":"text","text":", "},{"type":"codeVoice","code":"getAuthenticatorData"},{"type":"text","text":", "},{"type":"codeVoice","code":"getPublicKey"},{"type":"text","text":", "},{"type":"codeVoice","code":"toJSON"},{"type":"text","text":", and the rest. Errors travel through a parallel "},{"type":"codeVoice","code":"__webauthn_error__"},{"type":"text","text":" channel and surface to the page as a "},{"type":"codeVoice","code":"DOMException"},{"type":"text","text":" with name "},{"type":"codeVoice","code":"NotAllowedError"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"The-FidoUI-Module","level":2,"text":"The FidoUI Module","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting "},{"type":"codeVoice","code":"navigator.credentials.*"},{"type":"text","text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Transport selection."}],"type":"strong"},{"text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Ceremony serialization."}],"type":"strong"},{"text":" Concurrent calls on the same ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Cancellation."}],"type":"strong"},{"text":" A single ","type":"text"},{"code":"cancel()","type":"codeVoice"},{"text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The host code only needs to construct one "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" instance and call "},{"type":"codeVoice","code":"makeCredential"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"getAssertion"},{"type":"text","text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See "},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/"},{"type":"text","text":" for the full source."}],"type":"paragraph"},{"anchor":"Platform-Notes","level":2,"text":"Platform Notes","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"iOS."}],"type":"strong"},{"text":" The wired path goes through CryptoTokenKit (","type":"text"},{"code":"WiredSmartCardConnection","type":"codeVoice"},{"text":" — USB-C or Lightning), and the NFC path through ","type":"text"},{"code":"NFCSmartCardConnection","type":"codeVoice"},{"text":". The sample’s ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" declares ","type":"text"},{"code":"NFCReaderUsageDescription","type":"codeVoice"},{"text":" and lists the FIDO applet AID (","type":"text"},{"code":"A0000006472F0001","type":"codeVoice"},{"text":") under ","type":"text"},{"code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers","type":"codeVoice"},{"text":"; the entitlements turn on ","type":"text"},{"code":"com.apple.developer.nfc.readersession.formats","type":"codeVoice"},{"text":" (","type":"text"},{"code":"TAG","type":"codeVoice"},{"text":") and ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"macOS."}],"type":"strong"},{"text":" ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" uses ","type":"text"},{"code":"HIDFIDOConnection","type":"codeVoice"},{"text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"com.apple.security.device.usb"},{"text":" so the same target builds cleanly for both platforms.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Where-to-Customize","level":2,"text":"Where to Customize","type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Which requests get intercepted.","type":"text"}],"type":"strong"},{"type":"text","text":" Edit "},{"type":"codeVoice","code":"shouldIntercept"},{"text":" in ","type":"text"},{"code":"Interceptor.js","type":"codeVoice"},{"text":" to scope by hint, RP ID, or any other heuristic.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Origin verification.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" builds a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference","isActive":true},{"text":" from ","type":"text"},{"code":"window.location.origin","type":"codeVoice"},{"text":". Replace the ","type":"text"},{"code":"isPublicSuffix","type":"codeVoice"},{"text":" closure passed to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" with a real public-suffix-list check before shipping.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"UI.","type":"text"}],"type":"strong"},{"text":" Swap or restyle the panels in ","type":"text"},{"code":"FidoUI\/Sources\/FidoUI\/Views\/","type":"codeVoice"},{"text":" — the rest of the module is UI-agnostic.","type":"text"}]}]}]}]}],"metadata":{"modules":[{"name":"YubiKit"}],"title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","roleHeading":"Sample Code","role":"sampleCode","color":{"standardColorIdentifier":"yellow"}},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","interfaceLanguage":"swift"},"sections":[],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Session","kind":"identifier"}],"kind":"symbol","title":"Management.Session","abstract":[{"type":"text","text":"An interface to the Management application on the YubiKey."}],"role":"symbol","navigatorTitle":[{"text":"Session","kind":"identifier"}],"url":"\/documentation\/yubikit\/management\/session","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"OATHSession"}],"kind":"symbol","title":"OATHSession","abstract":[{"type":"text","text":"
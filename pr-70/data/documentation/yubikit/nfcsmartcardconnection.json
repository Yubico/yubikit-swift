{"abstract":[{"text":"A NFC connection to the YubiKey.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NFCSmartCardConnection"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The  NFCSmartCardConnection is short lived and should be closed as soon as the commands sent to the YubiKey have finished processing. It is up to the user of","type":"text"},{"text":" ","type":"text"},{"text":"the connection to close it when it no longer is needed. As long as the connection is open the NFC modal will cover the lower part of the iPhone screen.","type":"text"},{"text":" ","type":"text"},{"text":"In addition to the ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/close(error:)","isActive":true,"type":"reference"},{"text":" method defined in the SmartCardConnection protocol the NFCSmartCardConnection has an additional ","type":"text"},{"code":"close(success:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"method that will close the connection and set the alertMessage of the NFC alert to the provided message.","type":"text"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"NFC is only supported on iPhones from iPhone 6 and forward. It will not work on iPads since there’s no NFC chip in these devices."}],"type":"paragraph"}]},{"inlineContent":[{"type":"text","text":"NFC connection to a YubiKey (iOS only)."}],"type":"paragraph"},{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"NFCSmartCardConnection establishes a connection to a YubiKey via NFC. The connection"},{"type":"text","text":" "},{"type":"text","text":"presents the system NFC dialog and waits for the user to tap their YubiKey."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"NFC connections are short-lived due to iOS timeout constraints. Perform operations quickly"},{"type":"text","text":" "},{"type":"text","text":"and close the connection with a user-visible message."}],"type":"paragraph"},{"syntax":"swift","code":["let connection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","await connection.close(message: \"Codes retrieved\")"],"type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/USBSmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LightningSmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WiredSmartCardConnection"],"generated":true,"title":"Creating a SmartCardConnection to a YubiKey","anchor":"Creating-a-SmartCardConnection-to-a-YubiKey"}],"variants":[{"paths":["\/documentation\/yubikit\/nfcsmartcardconnection"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"navigatorTitle":[{"text":"NFCSmartCardConnection","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"YubiKit"}],"externalID":"s:7YubiKit22NFCSmartCardConnectionV","symbolKind":"struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NFCSmartCardConnection"}],"title":"NFCSmartCardConnection"},"topicSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/init()","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NF
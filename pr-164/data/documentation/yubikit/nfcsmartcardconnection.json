{"code":"close(success:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"method that will close the connection and set the alertMessage of the NFC alert to the provided message.","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"NFC is only supported on iPhones from iPhone 6 and forward. It will not work on iPads since there’s no NFC chip in these devices.","type":"text"}]}],"name":"Note"},{"inlineContent":[{"text":"NFC connection to a YubiKey (iOS only).","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"NFCSmartCardConnection establishes a connection to a YubiKey via NFC. The connection"},{"type":"text","text":" "},{"type":"text","text":"presents the system NFC dialog and waits for the user to tap their YubiKey."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"NFC connections are short-lived due to iOS timeout constraints. Perform operations quickly"},{"type":"text","text":" "},{"type":"text","text":"and close the connection with a user-visible message."}],"type":"paragraph"},{"type":"codeListing","code":["let connection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","await connection.close(message: \"Codes retrieved\")"],"syntax":"swift"}],"kind":"content"}],"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Connection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/s8SendableP","doc:\/\/yubikit-swift.YubiKit\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/NFCSmartCa
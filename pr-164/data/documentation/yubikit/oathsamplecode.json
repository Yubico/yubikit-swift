{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample creates an authenticator app that:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Establishes connections to YubiKeys via USB, Lightning, or NFC","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Manages connection lifecycle (detecting plugged\/unplugged devices)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists TOTP codes stored on the YubiKey"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shows device information like firmware version"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handles connection errors and user cancellations gracefully"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This sample focuses on read-only operations and doesn’t handle password-protected YubiKeys or credential management.","type":"text"}],"type":"paragraph"},{"text":"Connection Management","level":2,"anchor":"Connection-Management","type":"heading"},{"text":"Handling Wired Connections","level":3,"anchor":"Handling-Wired-Connections","type":"heading"},{"inlineContent":[{"text":"The app uses a ","type":"text"},{"code":"ConnectionManager","type":"codeVoice"},{"text":" to handle persistent connections to plugged-in YubiKeys. This approach ensures your app stays responsive when users plug and unplug their YubiKeys:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["private func startWiredConnection() {","    wiredConnectionTask = Task { @MainActor in","        while !Task.isCancelled {","            do {","                let newConnection = try await WiredSmartCardConnection.makeConnection()","                wiredConnection = newConnection","","                \/\/ Wait for disconnect","                let closeError = await newConnection.waitUntilClosed()","                wiredConnection = nil","            } catch {","                self.error = error","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The key insight here is using ","type":"text"},{"code":"waitUntilClosed()","type":"codeVoice"},{"text":" to detect when the YubiKey is unplugged, then automatically waiting for the next connection.","type":"text"}],"type":"paragraph"},{"text":"NFC Connections","level":3,"anchor":"NFC-Connections","type":"heading"},{"inlineContent":[{"text":"NFC connections work differently - they’re initiated by user action and are short-lived:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func requestNFCConnection() async {","    do {","        nfcConnection = try await NFCSmartCardConnection()","    } catch {","        self.error = error","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"When an NFC connection is established, the app fetches data and immediately closes it with a user message:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Task {","    await model.update(using: connection)","    await connection.close(message: \"Codes calculated\")","}"],"type":"codeListing"},{"text":"Working with YubiKey Data","level":2,"anchor":"Working-with-YubiKey-Data","type":"heading"},{"text":"Reading OATH Codes","level":3,"anchor":"Reading-OATH-Codes","type":"heading"},{"inlineContent":[{"type":"text","text":"Once you have a connection, getting TOTP codes is straightforward:"}],"type":"paragraph"},{"syntax":"swift","code":["private func calculateCodes(using connection: SmartCardConnection) async {","    do {","        let session = try await OATHSession.makeSession(connection: connection)","        let result = try await session.calculateCredentialCodes()","        accounts = result.map { credential, code in","            Account(","                label: credential.label,","                code: code?.code,","                issuer: credential.issuer,","                type: credential.type","            )","        }","    } catch {","        self.error = error","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"code":"calculateCredentialCodes()","type":"codeVoice"},{"type":"text","text":" method returns a dictionary mapping credentials to their current codes. Some codes might be "},{"code":"nil","type":"codeVoice"},{"text":" if they require touch or are password-protected.","type":"text"}],"type":"paragraph"},{"text":"Getting Device Information","anchor":"Getting-Device-Information","type":"heading","level":3},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"Management.Session"},{"text":" to get YubiKey information:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["private func getKeyVersion(using connection: SmartCardConnection) async {","    do {","        let session: Management.Session = try await .makeSession(connection: connection)","        self.keyVersion = await session.version.description","    } catch {","        self.error = error","    }","}"]},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Model"},{"type":"text","text":" class combines both operations in a single "},{"type":"codeVoice","code":"update"},{"type":"text","text":" method:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func update(using connection: SmartCardConnection) async {","    await calculateCodes(using: connection)","    await getKeyVersion(using: connection)","    connectionType = connection.connectionType","}"]},{"text":"SwiftUI Integration","anchor":"SwiftUI-Integration","type":"heading","level":2},{"text":"Reacting to Connection Changes","anchor":"Reacting-to-Connection-Changes","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The app uses SwiftUI’s "},{"code":"@Published","type":"codeVoice"},{"type":"text","text":" properties and "},{"code":"onReceive","type":"codeVoice"},{"type":"text","text":" to update the UI when connections change:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".onReceive(connectionManager.$wiredConnection) { newConnection in","    guard let connection = newConnection else {","        model.clear()  \/\/ Clear UI when YubiKey unplugged","        return","    }","    Task { await model.update(using: connection) }","}"]},{"inlineContent":[{"text":"This pattern ensures the UI immediately updates when YubiKeys are plugged in or removed.","type":"text"}],"type":"paragraph"},{"text":"Platform-Specific Features","anchor":"Platform-Specific-Features","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The app handles iOS vs macOS differences with conditional compilation:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["#if os(iOS)",".refreshable {","    await connectionManager.requestNFCConnection()","}","#endif"]},{"inlineContent":[{"text":"iOS users can pull-to-refresh to scan with NFC, while macOS users only see USB options.","type":"text"}],"type":"paragraph"},{"text":"Connection Type Detection","anchor":"Connection-Type-Detection","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The sample includes a useful extension to identify connection types:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension SmartCardConnection {","    var connectionType: String {","        switch self {","        case _ as NFCSmartCardConnection: return \"NFC\"","        case _ as LightningSmartCardConnection: return \"Lightning\"","        case _ as USBSmartCardConnection: return \"USB\"","        default: return \"Unknown\"","        }","    }","}"]},{"inlineContent":[{"text":"This is helpful because NFC connections are slower than USB, and users like to know how their YubiKey is connected.","type":"text"}],"type":"paragraph"},{"text":"Architecture Decisions","anchor":"Architecture-Decisions","type":"heading","level":2},{"text":"Why the connection management works this way","anchor":"Why-the-connection-management-works-this-way","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample uses a background loop that continuously waits for wired connections. This might seem unusual, but it solves a key problem: YubiKeys get plugged and unplugged frequently, but apps need to stay responsive."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you unplug your YubiKey, the app doesn’t crash or freeze - it detects the disconnection via "},{"code":"waitUntilClosed()","type":"codeVoice"},{"type":"text","text":" and immediately starts waiting for the next YubiKey. This creates a smoother user experience where the app responds when you plug \/ unplug a YubiKey."}]},{"type":"paragraph","inlineContent":[{"text":"NFC works differently since you can’t continuously scan - the user has to explicitly initiate each scan. That’s why NFC connections are handled separately through user actions like the scan button or pull-to-refresh.","type":"text"}]},{"text":"Error handling for hardware connections","anchor":"Error-handling-for-hardware-connections","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Hardware connections are unreliable by nature. Users will unplug devices mid-operation, walk away during NFC scans, or have connectivity issues. The sample handles this gracefully:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Connection failures are caught and stored as errors","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"User cancellations (like dismissing NFC scan) are filtered out to avoid unnecessary error alerts","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Session errors are handled similarly - show the error but maintain app functionality","type":"text"}]}]}]},{"text":"Working with Swift actors","anchor":"Working-with-Swift-actors","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit sessions are Swift actors that handle their own threading. The sample shows how to integrate this with SwiftUI’s main actor requirements:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ConnectionManager"},{"type":"text","text":" runs on "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" so it can directly update "},{"type":"codeVoice","code":"@Published"},{"type":"text","text":" properties"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Session calls happen on the session’s actor, then results are passed back to update the UI","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Everything uses ","type":"text"},{"type":"codeVoice","code":"async\/await"}],"type":"paragraph"}]}]}],"kind":"content"}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"overridingTitle":"View Source","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","isActive":true,"type":"reference"}},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode"},"metadata":{"title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","modules":[{"name":"YubiKit"}],"color":{"standardColorIdentifier":"green"},"role":"sampleCode","roleHeading":"Sample Code"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/oathsamplecode"]}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"kind":"article","abstract":[{"type":"text","text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"reference","isActive":true},{"type":"text","text":" to retrieve authentication codes, and "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"reference","isActive":true},{"type":"text","text":" to get device information."}],"seeAlsoSections":[{"generated":true,"anchor":"Sample-code","title":"Sample code","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"]}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"title":"OATHSession","url":"\/documentation\/yubikit\/oathsession","kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"OATHSession"}],"navigatorTitle":[{"kind":"identifier","text":"OATHSession"}],"type":"topic","role":"symbol","abstract":[{"text":"An interface to the OATH application on the YubiKey.","type":"text"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"title":"WebAuthn.Client","url":"\/documentation\/yubikit\/webauthn\/client","kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"navigatorTitle":[{"kind":"identifier","text":"Client"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"url":"\/documentation\/yubikit\/pivsession","role":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","title":"PIVSession","abstract":[{"type":"text","text":"An interface to the PIV application on the YubiKey."}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"text":"PIVSession","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"PIVSession"}],"type":"topic","kind":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"title":"PIVTool: Building PIV applications with YubiKey","url":"\/documentation\/yubikit\/pivtoolsamplecode","kind":"article","type":"topic","role":"sampleCode","abstract":[{"type":"text","text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession"},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","abstract":[{"text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB.","type":"text"}],"title":"YubiKit","kind":"symbol","type":"topic","url":"\/documentation\/yubikit","images":[{"identifier":"documentation-header.png","type":"icon"}],"role":"collection"},"documentation-header.png":{"identifier":"documentation-header.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png"}],"alt":"YubiKeys in a row"},"https://github.com/Yubico/yubikit-swift/tree/main/Samples/OATHSample":{"type":"download","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","checksum":null,"url":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","role":"sampleCode","kind":"article","abstract":[{"type":"text","text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts "},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"type":"text","text":" calls inside a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" and routes them to a YubiKey. It uses the high-level "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" companion module."}],"url":"\/documentation\/yubikit\/webauthninterceptorsamplecode","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"url":"\/documentation\/yubikit\/management\/session","role":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","abstract":[{"type":"text","text":"An interface to the Management application on the YubiKey."}],"title":"Management.Session","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}],"navigatorTitle":[{"kind":"identifier","text":"Session"}],"type":"topic","kind":"symbol"}}}
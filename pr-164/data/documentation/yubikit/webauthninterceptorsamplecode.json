{"metadata":{"title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","color":{"standardColorIdentifier":"yellow"},"modules":[{"name":"YubiKit"}],"roleHeading":"Sample Code","role":"sampleCode"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The interceptor demonstrates how to:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Intercept ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.create()"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.get()"},{"text":" in a ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options","type":"reference","isActive":true},{"text":" \/ ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","type":"reference","isActive":true},{"text":" types.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Drive the SDK’s high-level ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use the bundled ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface."}]},{"type":"heading","anchor":"Architecture-Overview","text":"Architecture Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample itself is intentionally thin:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Interceptor.js"}],"type":"strong"},{"text":" — injected into the ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":" to monkey-patch ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"text":" and shuttle requests\/responses through ","type":"text"},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"WebView.swift"}],"type":"strong"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"UIViewRepresentable"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"NSViewRepresentable"},{"text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"WebAuthnHandler.swift"}],"type":"strong"},{"text":" — decodes the JSON envelope, builds a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference","isActive":true},{"text":", and calls ","type":"text"},{"type":"codeVoice","code":"FidoUI.makeCredential"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"FidoUI.getAssertion"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"ContentView.swift"}],"type":"strong"},{"text":" — minimal SwiftUI shell with a URL bar and back button.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"FidoUI"}],"type":"strong"},{"text":" (separate Swift package under ","type":"text"},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI"},{"text":") — the reusable UI + transport layer described below.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The end-to-end flow:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Page JS calls ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.create()"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":".get()"},{"text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"text":" decodes the JSON straight into the SDK’s strongly-typed ","type":"text"},{"type":"codeVoice","code":"Options"},{"text":" and hands them to ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"text":" opens a transport, runs the ceremony via ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"text":", and shows PIN \/ UV \/ error \/ success panels as needed.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The resulting ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","type":"reference","isActive":true},{"text":" is serialized via its built-in ","type":"text"},{"type":"codeVoice","code":"toJSON()"},{"text":" and posted back to JS.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Intercepting-WebAuthn-Calls","text":"Intercepting WebAuthn Calls","level":2},{"type":"heading","anchor":"JavaScript-Injection","text":"JavaScript Injection","level":3},{"type":"paragraph","inlineContent":[{"code":"Interceptor.js","type":"codeVoice"},{"type":"text","text":" replaces "},{"code":"navigator.credentials.create","type":"codeVoice"},{"type":"text","text":" and "},{"code":"navigator.credentials.get","type":"codeVoice"},{"type":"text","text":" with versions that forward to Swift. Binary fields ("},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", "},{"code":"user.id","type":"codeVoice"},{"type":"text","text":", "},{"code":"rawId","type":"codeVoice"},{"type":"text","text":", …) are serialized to "},{"inlineContent":[{"text":"base64url","type":"text"}],"type":"strong"},{"type":"text","text":" strings via "},{"code":"JSON.stringify","type":"codeVoice"},{"type":"text","text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed."}]},{"type":"codeListing","syntax":"javascript","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The script is injected at document start so it runs before any page code:"}]},{"type":"codeListing","syntax":"swift","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"]},{"type":"paragraph","inlineContent":[{"code":"shouldIntercept","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"type":"text","text":" for any "},{"code":"publicKey","type":"codeVoice"},{"type":"text","text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when "},{"code":"publicKey.hints","type":"codeVoice"},{"type":"text","text":" includes "},{"code":"\"security-key\"","type":"codeVoice"},{"type":"text","text":")."}]},{"type":"heading","anchor":"Receiving-Messages-in-Swift","text":"Receiving Messages in Swift","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"Coordinator","type":"codeVoice"},{"type":"text","text":" is both "},{"code":"WKNavigationDelegate","type":"codeVoice"},{"type":"text","text":" and "},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"type":"text","text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:"}]},{"type":"codeListing","syntax":"swift","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shutdown()"},{"type":"text","text":" is called from "},{"code":"dismantle{UI,NS}View","type":"codeVoice"},{"type":"text","text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle."}]},{"type":"heading","anchor":"Driving-the-Ceremony","text":"Driving the Ceremony","level":2},{"inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" is intentionally tiny — it decodes the envelope, builds a typed "},{"type":"codeVoice","code":"Origin"},{"type":"text","text":", and delegates to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself."}],"type":"paragraph"},{"syntax":"swift","code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"handleGet","type":"codeVoice"},{"type":"text","text":" is the symmetric counterpart that decodes "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","type":"reference","isActive":true},{"type":"text","text":" and calls "},{"code":"fidoUI.getAssertion","type":"codeVoice"},{"text":". The response JSON produced by ","type":"text"},{"code":"toJSON()","type":"codeVoice"},{"text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to ","type":"text"},{"code":"ArrayBuffer","type":"codeVoice"},{"text":" when it materializes the credential.","type":"text"}]},{"type":"heading","text":"Returning the Response to JavaScript","anchor":"Returning-the-Response-to-JavaScript","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:"}]},{"syntax":"swift","code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"JavaScript decodes the JSON and rebuilds a "},{"type":"codeVoice","code":"PublicKeyCredential"},{"text":"-shaped object — converting the base64url binary fields back to ","type":"text"},{"type":"codeVoice","code":"ArrayBuffer"},{"text":"s and wiring up ","type":"text"},{"type":"codeVoice","code":"getClientExtensionResults"},{"type":"text","text":", "},{"type":"codeVoice","code":"getAuthenticatorData"},{"text":", ","type":"text"},{"code":"getPublicKey","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"toJSON"},{"type":"text","text":", and the rest. Errors travel through a parallel "},{"code":"__webauthn_error__","type":"codeVoice"},{"type":"text","text":" channel and surface to the page as a "},{"code":"DOMException","type":"codeVoice"},{"text":" with name ","type":"text"},{"code":"NotAllowedError","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","anchor":"The-FidoUI-Module","text":"The FidoUI Module","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"text":" is a ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.*"},{"type":"text","text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Transport selection.","type":"text"}],"type":"strong"},{"text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Ceremony serialization.","type":"text"}],"type":"strong"},{"text":" Concurrent calls on the same ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Cancellation."}],"type":"strong"},{"text":" A single ","type":"text"},{"code":"cancel()","type":"codeVoice"},{"text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The host code only needs to construct one "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" instance and call "},{"type":"codeVoice","code":"makeCredential"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"getAssertion"},{"type":"text","text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See "},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/"},{"type":"text","text":" for the full source."}],"type":"paragraph"},{"level":2,"text":"Platform Notes","anchor":"Platform-Notes","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"iOS."}],"type":"strong"},{"type":"text","text":" The wired path goes through CryptoTokenKit ("},{"code":"WiredSmartCardConnection","type":"codeVoice"},{"text":" — USB-C or Lightning), and the NFC path through ","type":"text"},{"code":"NFCSmartCardConnection","type":"codeVoice"},{"type":"text","text":". The sample’s "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" declares "},{"code":"NFCReaderUsageDescription","type":"codeVoice"},{"type":"text","text":" and lists the FIDO applet AID ("},{"code":"A0000006472F0001","type":"codeVoice"},{"type":"text","text":") under "},{"code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers","type":"codeVoice"},{"type":"text","text":"; the entitlements turn on "},{"code":"com.apple.developer.nfc.readersession.formats","type":"codeVoice"},{"text":" (","type":"text"},{"code":"TAG","type":"codeVoice"},{"text":") and ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"macOS."}],"type":"strong"},{"text":" ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" uses ","type":"text"},{"code":"HIDFIDOConnection","type":"codeVoice"},{"text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"com.apple.security.device.usb","type":"codeVoice"},{"text":" so the same target builds cleanly for both platforms.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Where to Customize","anchor":"Where-to-Customize","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Which requests get intercepted.","type":"text"}],"type":"strong"},{"text":" Edit ","type":"text"},{"code":"shouldIntercept","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"Interceptor.js","type":"codeVoice"},{"text":" to scope by hint, RP ID, or any other heuristic.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Origin verification.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" builds a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","isActive":true,"type":"reference"},{"text":" from ","type":"text"},{"code":"window.location.origin","type":"codeVoice"},{"text":". Replace the ","type":"text"},{"code":"isPublicSuffix","type":"codeVoice"},{"text":" closure passed to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" with a real public-suffix-list check before shipping.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"UI.","type":"text"}],"type":"strong"},{"text":" Swap or restyle the panels in ","type":"text"},{"type":"codeVoice","code":"FidoUI\/Sources\/FidoUI\/Views\/"},{"text":" — the rest of the module is UI-agnostic.","type":"text"}],"type":"paragraph"}]}]}]}],"sections":[],"variants":[{"paths":["\/documentation\/yubikit\/webauthninterceptorsamplecode"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts "},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"type":"text","text":" calls inside a "},{
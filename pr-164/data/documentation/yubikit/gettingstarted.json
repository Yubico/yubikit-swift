{"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"The YubiKit framework is distributed using the Swift Package Manager. To add the framework to your project follow these steps:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Package Dependencies” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Press the plus-button to bring up the add package dialog.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"add-framework-1.png","type":"image"}],"type":"paragraph"},{"start":4,"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Enter ","type":"text"},{"type":"codeVoice","code":"https:\/\/github.com\/Yubico\/yubikit-swift\/"},{"text":" in the search field and select the Yubico Swift Package.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Press the “Add Package” button to add the SDK to your project.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"add-framework-2.png","type":"image"}],"type":"paragraph"},{"level":3,"text":"NFC","anchor":"NFC","type":"heading"},{"inlineContent":[{"text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC","type":"text"},{"text":" ","type":"text"},{"text":"application identifiers and a NFC Privacy statement to the application.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Add Wireless entitlement"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Signing & Capabilities” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Click the “+”-button to add a new capability.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the “Near Field Communication Tag” capability.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"nfc-entitlement.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Add list of NFC application identifiers"}],"type":"strong"}],"type":"paragraph"},{"start":6,"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"nfc-identifiers.png","type":"image"}],"type":"paragraph"},{"start":8,"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the Yubico NFC application identifiers to enable communication with the different","type":"text"},{"text":" ","type":"text"},{"text":"applications on the YubiKey.","type":"text"}]}]}],"type":"orderedList"},{"code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"identifier":"nfc-identifiers-list.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Add a NFC Privacy description"}],"type":"strong"}],"type":"paragraph"},{"start":9,"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in","type":"text"},{"text":" ","type":"text"},{"text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"nfc-privacy.png","type":"image"}],"type":"paragraph"},{"level":3,"text":"SmartCard\/USB","anchor":"SmartCardUSB","type":"heading"},{"inlineContent":[{"text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the","type":"text"},{"text":" ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" entitlement to your application.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the application entitlements file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"text":" entitlement to the entitlement list.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"smart-card.png","type":"image"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"USB SmartCard supports Yubico OTP slot programming. HMAC-SHA1 challenge-response requires"},{"type":"text","text":" "},{"code":"HIDOTPConnection","type":"codeVoice"},{"type":"text","text":" on macOS, "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LightningSmartCardConnection","type":"reference","isActive":true},{"type":"text","text":", or NFC without a touch requirement."},{"type":"text","text":" "},{"type":"text","text":"See "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside"},{"level":3,"text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey","anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey","type":"heading"},{"inlineContent":[{"text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" string to the list of External Accessories.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not present add the ","type":"text"},{"type":"codeVoice","code":"Supported external accessory protocols"},{"text":" key and insert the string ","type":"text"},{"type":"codeVoice","code":"com.yubico.ylp"},{"text":" in its list.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"external-accessory.png","type":"image"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for "},{"code":"Supported external accessory protocols","type":"codeVoice"},{"type":"text","text":" to "},{"code":"com.yubico.ylp","type":"codeVoice"},{"type":"text","text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework."}],"type":"paragraph"}],"type":"aside"},{"level":2,"text":"Making Your First Connection","anchor":"Making-Your-First-Connection","type":"heading"},{"inlineContent":[{"text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Understanding Connection Types","anchor":"Understanding-Connection-Types","type":"heading"},{"inlineContent":[{"text":"YubiKit provides the following connection methods:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"NFC"}],"type":"strong"},{"text":": Short-range wireless communication (iOS only)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"USB"}],"type":"strong"},{"text":": Direct USB connection via SmartCard interface","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Lightning"}],"type":"strong"},{"text":": YubiKey 5Ci connected to Lightning port (iOS only)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"USB HID"}],"type":"strong"},{"text":": Direct access to the FIDO or OTP interface (macOS only)","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Each connection type works differently, so let’s explore how to use them.","type":"text"}],"type":"paragraph"},{"level":3,"text":"NFC Connections","anchor":"NFC-Connections","type":"heading"},{"inlineContent":[{"text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:","type":"text"}],"type":"paragraph"},{"code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete.","type":"text"}],"type":"paragraph"},{"level":3,"text":"USB and Lightning Connections","anchor":"USB-and-Lightning-Connections","type":"heading"},{"inlineContent":[{"text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:","type":"text"}],"type":"paragraph"},{"code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"WiredSmartCardConnection.makeConnection()","type":"codeVoice"},{"text":" method automatically detects whether you’re using USB or Lightning.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Specific Connection Types","anchor":"Specific-Connection-Types","type":"heading"},{"inlineContent":[{"text":"For more control, you can connect to specific interfaces:","type":"text"}],"type":"paragraph"},{"code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"On macOS, use ","type":"text"},{"code":"HIDOTPConnection","type":"codeVoice"},{"text":" for the OTP keyboard interface or ","type":"text"},{"code":"HIDFIDOConnection","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"the FIDO interface:","type":"text"}],"type":"paragraph"},{"code":["let otpConnection = try await HIDOTPConnection()"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Understanding Connection Lifecycle","anchor":"Understanding-Connection-Lifecycle","type":"heading"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Critical:"}],"type":"strong"},{"text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Connection Behavior","anchor":"Connection-Behavior","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Exclusive access"}],"type":"strong"},{"text":": Only one connection can exist per YubiKey at any time","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Manual closure required"}],"type":"strong"},{"text":": Dropping a connection reference does NOT automatically close it - you must call ","type":"text"},{"type":"codeVoice","code":"close()"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Resource blocking"}],"type":"strong"},{"text":": An unclosed connection prevents new connections (throws ","type":"text"},{"type":"codeVoice","code":"SmartCardConnectionError.busy"},{"text":")","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call ","type":"text"},{"code":"close()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Working with Sessions","anchor":"Working-with-Sessions","type":"heading"},{"inlineContent":[{"text":"Once you have a connection, create sessions to access different YubiKey applications:","type":"text"}],"type":"paragraph"},{"level":3,"text":"OATH Session (TOTP\/HOTP codes)","anchor":"OATH-Session-TOTPHOTP-codes","type":"heading"},{"code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Yubico OTP Session (OTP slots)","anchor":"Yubico-OTP-Session-OTP-slots","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","isActive":true,"type":"reference"},{"text":" manages the two OTP slots. Create it with a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","isActive":true,"type":"reference"},{"text":" or,","type":"text"},{"text":" ","type":"text"},{"text":"on macOS, an ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OTPConnection","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let session = try await YubiOTP.Session.makeSession(connection: connection)","let state = await session.configState","print(\"Slot 2 configured: \\(try state.isConfigured(.two))\")","","\/\/ Program slot 2 for HOTP, replacing its existing configuration","try await session.putConfiguration(.hotp(key: secret), in: .two)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","isActive":true,"type":"reference"},{"text":" for HMAC-SHA1 challenge-response, transport support, and NFC output.","type":"text"}],"type":"paragraph"},{"level":3,"text":"PIV Session (Certificates and keys)","anchor":"PIV-Session-Certificates-and-keys","type":"heading"},{"code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Management Session (Device information)","anchor":"Management-Session-Device-information","type":"heading"},{"code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"WebAuthn Client (FIDO2 \/ passkeys)","anchor":"WebAuthn-Client-FIDO2--passkeys","type":"heading"},{"inlineContent":[{"type":"text","text":"For passkey registration and authentication, "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"type":"text","text":" wraps a"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference","isActive":true},{"type":"text","text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can"},{"type":"text","text":" "},{"type":"text","text":"use "},{"code":"HIDFIDOConnection","type":"codeVoice"},{"type":"text","text":" (USB HID on macOS) or any "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"(NFC \/ USB CCID)."}],"type":"paragraph"},{"code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"PIN and UV are supplied per ceremony via "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","type":"reference","isActive":true},{"type":"text","text":". For raw"},{"type":"text","text":" "},{"type":"text","text":"CTAP2 access (credential management, bio enrollment, large blobs), use"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference","isActive":true},{"type":"text","text":" directly."}],"type":"paragraph"},{"level":2,"text":"Connection Management Patterns","anchor":"Connection-Management-Patterns","type":"heading"},{"level":3,"text":"For UI Applications","anchor":"For-UI-Applications","type":"heading"},{"inlineContent":[{"type":"text","text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","type":"reference","isActive":true},{"type":"text","text":" for complete examples of reactive connection management patterns that automatically update your UI when YubiKeys are plugged in or removed."}],"type":"paragraph"},{"level":3,"text":"For Command-Line Tools","anchor":"For-Command-Line-Tools","type":"heading"},{"inlineContent":[{"type":"text","text":"CLI applications often use a simpler approach with a single connection per operation. See "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","type":"reference","isActive":true},{"type":"text","text":" for examples of how command-line tools handle connections for one-time operations."}],"type":"paragraph"},{"level":2,"text":"Next Steps","anchor":"Next-Steps","type":"heading"},{"inlineContent":[{"type":"text","text":"Now you’re ready to build YubiKey applications! Check out the sample projects to see complete implementations:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"OATHSample","type":"text"}]},{"type":"text","text":": Shows how to build a TOTP authenticator app with SwiftUI"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"PIVTool","type":"text"}]},{"type":"text","text":": Demonstrates PIV operations for certificates and digital signatures"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"WebAuthnInterceptorSample","type":"text"}]},{"type":"text","text":": Routes WebAuthn calls from a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" through "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" to a YubiKey"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Build SDK documentation","anchor":"Build-SDK-documentation","type":"heading"},{"inlineContent":[{"type":"text","text":"You can also build the complete SDK documentation by selecting “Product” -> “Build Documentation” in Xcode. This gives you access to the full YubiKit API reference."}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Select an iOS target to include NFC and Lightning connections, or a macOS target to include","type":"text"},{"text":" ","type":"text"},{"text":"USB 
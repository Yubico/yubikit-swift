{"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HmacSecret","kind":"identifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This extension allows a relying party to derive symmetric keys from a credential"},{"type":"text","text":" "},{"type":"text","text":"using HMAC-SHA-256 with user-provided salts. The derived keys can be used for"},{"type":"text","text":" "},{"type":"text","text":"encryption or other cryptographic operations."}]},{"type":"heading","level":2,"text":"MakeCredential Usage","anchor":"MakeCredential-Usage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Request hmac-secret support when creating a credential:"}]},{"type":"codeListing","code":["let hmacSecret = CTAP2.Extension.HmacSecret()","let ext = hmacSecret.makeCredential.input()","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    \/\/ hmac-secret is enabled","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Or derive secrets at registration time (CTAP 2.2 hmac-secret-mc):","type":"text"}]},{"type":"codeListing","code":["let hmacSecret = try await CTAP2.Extension.HmacSecret(session: session)","let ext = try hmacSecret.makeCredential.input(salt1: salt, salt2: salt2)","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    switch result {","    case .enabled:","        \/\/ hmac-secret-mc not supported, but hmac-secret is enabled","    case .secrets(let secrets):","        \/\/ Use derived keys (secrets.first, secrets.second)","    }","}"],"syntax":"swift"},{"type":"heading","level":2,"text":"GetAssertion Usage","anchor":"GetAssertion-Usage"},{"type":"paragraph","inlineContent":[{"text":"Derive keys during authentication:","type":"text"}]},{"type":"codeListing","code":["let hmacSecret = try await CTAP2.Extension.HmacSecret(session: session)","let ext = try hmacSecret.getAssertion.input(salt1: salt)","let params = CTAP2.GetAssertion.Parameters(..., extensions: [ext])","let response = try await session.getAssertion(params)","if let secrets = try hmacSecret.getAssertion.output(from: response) {","    \/\/ Use derived keys (secrets.first, secrets.second)","}"],"syntax":"swift"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"https:\/\/fidoalliance.org\/specs\/fido-v2.2-ps-20250714\/fido-client-to-authenticator-protocol-v2.2-ps-20250714.html#sctn-hmac-secret-extension"}],"type":"paragraph"}],"name":"See Also","style":"note"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"https:\/\/fidoalliance.org\/specs\/fido-v2.2-ps-20250714\/fido-client-to-authenticator-protocol-v2.2-ps-20250714.html#sctn-hmac-secret-make-cred-extension"}],"type":"paragraph"}],"name":"See Also","style":"note"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/yubikit\/ctap2\/extension\/hmacsecret"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/yubikit-swift.YubiKit\/s8SendableP","doc:\/\/yubikit-swift.YubiKit\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"topicSections":[{"generated":true,"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Extension\/HmacSecret\/GetAssertionOperations","doc:\/\/yubikit-swift.YubiKit\/documentation
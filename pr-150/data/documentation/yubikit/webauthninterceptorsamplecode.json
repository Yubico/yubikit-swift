{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","abstract":[{"text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"text":" calls inside a ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":" and routes them to a YubiKey. It uses the high-level ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" companion module.","type":"text"}],"seeAlsoSections":[{"title":"Sample code","generated":true,"anchor":"Sample-code","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"]}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"overridingTitle":"View Source","type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample"}},"variants":[{"paths":["\/documentation\/yubikit\/webauthninterceptorsamplecode"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The interceptor demonstrates how to:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Intercept ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.create()"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.get()"},{"text":" in a ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options"},{"text":" \/ ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options"},{"text":" types.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Drive the SDK’s high-level ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use the bundled ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface."}]},{"level":2,"text":"Architecture Overview","anchor":"Architecture-Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample itself is intentionally thin:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Interceptor.js"}],"type":"strong"},{"text":" — injected into the ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":" to monkey-patch ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"text":" and shuttle requests\/responses through ","type":"text"},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"WebView.swift"}],"type":"strong"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"UIViewRepresentable"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"NSViewRepresentable"},{"text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"WebAuthnHandler.swift"}],"type":"strong"},{"text":" — decodes the JSON envelope, builds a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin"},{"text":", and calls ","type":"text"},{"type":"codeVoice","code":"FidoUI.makeCredential"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"FidoUI.getAssertion"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"ContentView.swift"}],"type":"strong"},{"text":" — minimal SwiftUI shell with a URL bar and back button.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"FidoUI"}],"type":"strong"},{"text":" (separate Swift package under ","type":"text"},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI"},{"text":") — the reusable UI + transport layer described below.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The end-to-end flow:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Page JS calls ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.create()"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":".get()"},{"text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"text":" decodes the JSON straight into the SDK’s strongly-typed ","type":"text"},{"type":"codeVoice","code":"Options"},{"text":" and hands them to ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"text":" opens a transport, runs the ceremony via ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":", and shows PIN \/ UV \/ error \/ success panels as needed.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The resulting ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response"},{"text":" or ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response"},{"text":" is serialized via its built-in ","type":"text"},{"type":"codeVoice","code":"toJSON()"},{"text":" and posted back to JS.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"text":"Intercepting WebAuthn Calls","anchor":"Intercepting-WebAuthn-Calls","type":"heading"},{"level":3,"text":"JavaScript Injection","anchor":"JavaScript-Injection","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" replaces "},{"type":"codeVoice","code":"navigator.credentials.create"},{"type":"text","text":" and "},{"type":"codeVoice","code":"navigator.credentials.get"},{"type":"text","text":" with versions that forward to Swift. Binary fields ("},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", "},{"type":"codeVoice","code":"user.id"},{"type":"text","text":", "},{"type":"codeVoice","code":"rawId"},{"type":"text","text":", …) are serialized to "},{"type":"strong","inlineContent":[{"type":"text","text":"base64url"}]},{"type":"text","text":" strings via "},{"type":"codeVoice","code":"JSON.stringify"},{"type":"text","text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed."}]},{"syntax":"javascript","type":"codeListing","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The script is injected at document start so it runs before any page code:"}]},{"syntax":"swift","type":"codeListing","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shouldIntercept"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for any "},{"type":"codeVoice","code":"publicKey"},{"type":"text","text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when "},{"type":"codeVoice","code":"publicKey.hints"},{"type":"text","text":" includes "},{"type":"codeVoice","code":"\"security-key\""},{"type":"text","text":")."}]},{"level":3,"text":"Receiving Messages in Swift","anchor":"Receiving-Messages-in-Swift","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" is both "},{"type":"codeVoice","code":"WKNavigationDelegate"},{"type":"text","text":" and "},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"type":"text","text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:"}]},{"syntax":"swift","type":"codeListing","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shutdown()"},{"type":"text","text":" is called from "},{"type":"codeVoice","code":"dismantle{UI,NS}View"},{"type":"text","text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle."}]},{"level":2,"text":"Driving the Ceremony","anchor":"Driving-the-Ceremony","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" is intentionally tiny — it decodes the envelope, builds a typed "},{"type":"codeVoice","code":"Origin"},{"type":"text","text":", and delegates to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself."}]},{"syntax":"swift","type":"codeListing","code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"handleGet"},{"type":"text","text":" is the symmetric counterpart that decodes "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","isActive":true},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"fidoUI.getAssertion"},{"type":"text","text":". The response JSON produced by "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to "},{"type":"codeVoice","code":"ArrayBuffer"},{"type":"text","text":" when it materializes the credential."}]},{"level":2,"text":"Returning the Response to JavaScript","anchor":"Returning-the-Response-to-JavaScript","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:"}]},{"syntax":"swift","type":"codeListing","code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"JavaScript decodes the JSON and rebuilds a "},{"type":"codeVoice","code":"PublicKeyCredential"},{"type":"text","text":"-shaped object — converting the base64url binary fields back to "},{"type":"codeVoice","code":"ArrayBuffer"},{"type":"text","text":"s and wiring up "},{"type":"codeVoice","code":"getClientExtensionResults"},{"type":"text","text":", "},{"type":"codeVoice","code":"getAuthenticatorData"},{"type":"text","text":", "},{"type":"codeVoice","code":"getPublicKey"},{"type":"text","text":", "},{"type":"codeVoice","code":"toJSON"},{"type":"text","text":", and the rest. Errors travel through a parallel "},{"type":"codeVoice","code":"__webauthn_error__"},{"type":"text","text":" channel and surface to the page as a "},{"type":"codeVoice","code":"DOMException"},{"type":"text","text":" with name "},{"type":"codeVoice","code":"NotAllowedError"},{"type":"text","text":"."}]},{"level":2,"text":"The FidoUI Module","anchor":"The-FidoUI-Module","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting "},{"type":"codeVoice","code":"navigator.credentials.*"},{"type":"text","text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Transport selection."}],"type":"strong"},{"text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Ceremony serialization."}],"type":"strong"},{"text":" Concurrent calls on the same ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Cancellation."}],"type":"strong"},{"text":" A single ","type":"text"},{"type":"codeVoice","code":"cancel()"},{"text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The host code only needs to construct one "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" instance and call "},{"type":"codeVoice","code":"makeCredential"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"getAssertion"},{"type":"text","text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See "},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/"},{"type":"text","text":" for the full source."}]},{"level":2,"text":"Platform Notes","anchor":"Platform-Notes","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"iOS."}],"type":"strong"},{"text":" The wired path goes through CryptoTokenKit (","type":"text"},{"type":"codeVoice","code":"WiredSmartCardConnection"},{"text":" — USB-C or Lightning), and the NFC path through ","type":"text"},{"type":"codeVoice","code":"NFCSmartCardConnection"},{"text":". The sample’s ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":" declares ","type":"text"},{"type":"codeVoice","code":"NFCReaderUsageDescription"},{"text":" and lists the FIDO applet AID (","type":"text"},{"type":"codeVoice","code":"A0000006472F0001"},{"text":") under ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers"},{"text":"; the entitlements turn on ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.formats"},{"text":" (","type":"text"},{"type":"codeVoice","code":"TAG"},{"text":") and ","type":"text"},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"macOS."}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" uses ","type":"text"},{"type":"codeVoice","code":"HIDFIDOConnection"},{"text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables ","type":"text"},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"com.apple.security.device.usb"},{"text":" so the same target builds cleanly for both platforms.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"text":"Where to Customize","anchor":"Where-to-Customize","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Which requests get intercepted."}],"type":"strong"},{"text":" Edit ","type":"text"},{"type":"codeVoice","code":"shouldIntercept"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"Interceptor.js"},{"text":" to scope by hint, RP ID, or any other heuristic.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Origin verification."}],"type":"strong"},{"text":" ","type":"text"},{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" builds a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin"},{"type":"text","text":" from "},{"code":"window.location.origin","type":"codeVoice"},{"type":"text","text":". Replace the "},{"code":"isPublicSuffix","type":"codeVoice"},{"type":"text","text":" closure passed to "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" with a real public-suffix-list check before shipping."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"UI."}]},{"type":"text","text":" Swap or restyle the panels in "},{"type":"codeVoice","code":"FidoUI\/Sources\/FidoUI\/Views\/"},{"type":"text","text":" — the rest of the module is UI-agnostic."}],"type":"paragraph"}]}]}],"kind":"content"}],"sections":[],"metadata":{"color":{"standardColorIdentifier":"yellow"},"roleHeading":"Sample Code","role":"sampleCode","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","modules":[{"name":"YubiKit"}]},"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Origin":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Origin","kind":"identifier"}],"navigatorTitle":[{"text":"Origin","kind":"identifier"}],"url":"\/documentation\/yubikit\/webauthn\/origin","title":"WebAuthn.Origin","abstract":[{"text":"A validated WebAuthn origin.","type":"text"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","kind":"symbol","type":"topic","role":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Session","kind":"identifier"}],"navigatorTitle":[{"text":"Session","kind":"identifier"}],"url":"\/documentation\/yubikit\/management\/session","title":"Management.Session","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"topic","abstract":[{"text":"An interface to the Management application on the YubiKey.","type":"text"}],"kind":"symbol","role":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","role":"sampleCode","type":"topic","kind":"article","title":"PIVTool: Building PIV applications with YubiKey","abstract":[{"type":"text","text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession"},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}],"url":"\/documentation\/yubikit\/pivtoolsamplecode"},"https://github.com/Yubico/yubikit-swift/tree/main/Samples/WebAuthnInterceptorSample":{"checksum":null,"url":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample","type":"download"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","role":"symbol","type":"topic","kind":"symbol","title":"WebAuthn.Client","navigatorTitle":[{"text":"Client","kind":"identifier"}],"url":"\/documentation\/yubikit\/webauthn\/client","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Registration/Options":{"url":"\/documentation\/yubikit\/webauthn\/registr
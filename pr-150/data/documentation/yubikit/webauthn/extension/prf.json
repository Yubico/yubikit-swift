xt"},{"text":"The SDK transforms each PRF input with ","type":"text"},{"type":"codeVoice","code":"SHA-256(\"WebAuthn PRF\\0\" || input)"},{"text":" before","type":"text"},{"text":" ","type":"text"},{"text":"sending it to the authenticator — that domain separation is mandated by the spec.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In a high-level WebAuthn flow, configure ","type":"text"},{"code":"PRF","type":"codeVoice"},{"type":"text","text":" per ceremony via"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/RegistrationInputs\/prf","type":"reference","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/AuthenticationInputs\/prf","type":"reference","isActive":true},{"type":"text","text":"; outputs come back on"},{"type":"text","text":" "},{"code":"clientExtensionResults","type":"codeVoice"},{"type":"text","text":" of the corresponding "},{"code":"Response","type":"codeVoice"},{"type":"text","text":". Registration enables"},{"type":"text","text":" "},{"type":"text","text":"PRF on a credential, optionally deriving secrets at the same time on"},{"type":"text","text":" "},{"type":"text","text":"authenticators that support hmac-secret-mc. Authentication evaluates the PRF at"},{"type":"text","text":" "},{"type":"text","text":"one or more inputs and returns the derived bytes."}]},{"code":["\/\/ Registration: enable PRF on the new credential","let regOpts = WebAuthn.Registration.Options(","    challenge: challenge,","    rp: .init(id: \"example.com\", name: \"Example\"),","    user: .init(id: userId, name: \"alice@example.com\"),","    extensions: .init(prf: .enable)",")","let registration = try await client.makeCredential(regOpts, authorization: auth).value","","\/\/ Authentication: derive a secret bound to the credential","let authOpts = WebAuthn.Authentication.Options(","
xt"},{"type":"text","text":"directly only when you need lower-level access — raw "},{"code":"makeCredential","type":"codeVoice"},{"text":" \/","type":"text"},{"type":"text","text":" "},{"code":"getAssertion","type":"codeVoice"},{"text":", credential management, or bio enrollment.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"Client","type":"codeVoice"},{"text":" is an actor; a client’s lifetime is bound to the underlying ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The constructor takes four parameters that shape every ceremony:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"origin","type":"codeVoice"},{"type":"text","text":" — the secure origin the client is bound to. "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference"},{"text":" enforces","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the W3C secure-context rule; the client refuses to sign for relying parties whose"},{"type":"text","text":" "},{"type":"text","text":"identifier doesn’t match."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"isPublicSuffix","type":"codeVoice"},{"text":" — a closure into a Public Suffix List, used to validate that","type":"text"},{"text":" ","type":"text"},{"text":"the relying-party identifier is a registrable suffix of the origin’s effective","type":"text"},{"text":" ","type":"text"},{"text":"domain.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"enterpriseRpIds","type":"codeVoice"},{"text":" — relying-party identifiers allowed to receive","type":"text"},{"text":" ","type":"text"},{"text":"platform-managed enterprise attestation. When the request specifies","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifie
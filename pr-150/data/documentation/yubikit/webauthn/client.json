{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}]}]},{"kind":"mentions","mentions":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted"]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Provides a unified interface for passkey registration and authentication"},{"type":"text","text":" "},{"type":"text","text":"backed by a YubiKey via CTAP2 protocol (USB\/NFC)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"PIN entry and UV decisions are supplied per ceremony via the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","isActive":true},{"type":"text","text":" parameter on "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","isActive":true},{"type":"text","text":". The status stream reports ceremony"},{"type":"text","text":" "},{"type":"text","text":"progress ("},{"type":"codeVoice","code":".processing"},{"type":"text","text":", "},{"type":"codeVoice","code":".waitingForUser"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":".waitingForUserVerification"},{"type":"text","text":", "},{"type":"codeVoice","code":".finished"},{"type":"text","text":") only."}],"type":"paragraph"},{"syntax":"swift","code":["let session = try await CTAP2.Session.makeSession(connection: connection)","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","\/\/ Trivial — pre-supplied PIN:","let response = try await client.makeCredential(options, authorization: .pin(\"1234\")).value","","\/\/ Custom — bridge into a UI:","let auth = WebAuthn.Authorization(providePIN: {","    guard let pin = await viewModel.askForPIN() else { return .cancel }","    return .pin(pin)","})","for try await status in await client.makeCredential(options, authorization: auth) {","    switch status {","    case .processing: showSpinner()","    case .waitingForUser(let cancel):","        showTouchPrompt(onCancel: { Task { await cancel() } })","    case .waitingForUserVerification(let cancel, let fallbackToPIN):","        showBiometricPrompt(","            onCancel: { Task { await cancel() } },","            onFallbackToPIN: fallbackToPIN.map { fallback in { Task { await fallback() } } }","        )","    case .finished(let response): return response","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"PIN attempts are one-shot: a wrong PIN throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/pinRejected(retriesRemaining:source:)","isActive":true},{"type":"text","text":" and the caller"},{"type":"text","text":" "},{"type":"text","text":"decides whether to re-prompt and retry with a fresh "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Returning "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/PINReply\/cancel","isActive":true},{"type":"text","text":" from "},{"type":"codeVoice","code":"providePIN"},{"type":"text","text":" aborts"},{"type":"text","text":" "},{"type":"text","text":"the ceremony with "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/cancelled(source:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Client"},{"type":"text","text":" is a high-level passkey client that runs WebAuthn ceremonies against a YubiKey."}],"type":"paragraph"},{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"Client"},{"type":"text","text":" is the entry point for WebAuthn in this SDK. It wraps a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and translates W3C WebAuthn requests into CTAP2 protocol exchanges — building the"},{"type":"text","text":" "},{"type":"codeVoice","code":"clientDataJSON"},{"type":"text","text":", validating the relying-party identifier against the configured"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","isActive":true},{"type":"text","text":", selecting between PIN and built-in user verification, and"},{"type":"text","text":" "},{"type":"text","text":"processing extensions before the request reaches the authenticator."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"Client"},{"type":"text","text":" for any app that runs passkey ceremonies. Reach for "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"type":"text","text":" "},{"type":"text","text":"directly only when you need lower-level access — raw "},{"type":"codeVoice","code":"makeCredential"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"getAssertion"},{"type":"text","text":", credential management, or bio enrollment."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Client"},{"type":"text","text":" is an actor; a client’s lifetime is bound to the underlying "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The constructor takes four parameters that shape every ceremony:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"origin","type":"codeVoice"},{"text":" — the secure origin the client is bound to. ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","isActive":true,"type":"reference"},{"text":" enforces","type":"text"},{"text":" ","type":"text"},{"text":"the W3C secure-context rule; the client refuses to sign for relying parties whose","type":"text"},{"text":" ","type":"text"},{"text":"identifier doesn’t match.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"isPublicSuffix"},{"type":"text","text":" — a closure into a Public Suffix List, used to validate that"},{"type":"text","text":" "},{"type":"text","text":"the relying-party identifier is a registrable suffix of the origin’s effective"},{"type":"text","text":" "},{"type":"text","text":"domain."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"enterpriseRpIds","type":"codeVoice"},{"text":" — relying-party identifiers allowed to receive","type":"text"},{"text":" ","type":"text"},{"text":"platform-managed enterprise attestation. When the request specifies","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/AttestationPreference\/enterprise","isActive":true,"type":"reference"},{"text":", the client escalates to level 2","type":"text"},{"text":" ","type":"text"},{"text":"(platform-managed) for RPs in this set, and uses level 1 (vendor-facilitated)","type":"text"},{"text":" ","type":"text"},{"text":"otherwise.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"allowedExtensions"},{"type":"text","text":" — the set of WebAuthn extensions the client will process."},{"type":"text","text":" "},{"type":"text","text":"Anything the relying party requests outside this set is dropped before reaching"},{"type":"text","text":" "},{"type":"text","text":"the authenticator. Defaults to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension"},{"type":"text","text":"’s standard set."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"PIN and user verification are supplied per ceremony via "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"out-of-band from the ceremony stream. Both ceremony methods return a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/StatusStream","isActive":true},{"type":"text","text":" — drain it with "},{"type":"codeVoice","code":"value()"},{"type":"text","text":" for non-UI callers, or iterate"},{"type":"text","text":" "},{"type":"text","text":"to drive cancel buttons and biometric prompts."}],"type":"paragraph"},{"syntax":"swift","code":["let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","for try await status in await client.makeCredential(opts, authorization: .pin(\"1234\")) {","    switch status {","    case .processing:","        showSpinner()","    case .waitingForUser(let cancel):","        showTouchPrompt(onCancel: { Task { await cancel() } })","    case .waitingForUserVerification(let cancel, _):","        showBiometricPrompt(onCancel: { Task { await cancel() } })","    case .finished(let response):","        return response","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"clientData:"},{"type":"text","text":" overloads accept a pre-built "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientData","isActive":true},{"type":"text","text":" instead of"},{"type":"text","text":" "},{"type":"text","text":"building one from "},{"type":"codeVoice","code":"origin"},{"type":"text","text":" + challenge. Use them in iOS Credential Provider \/"},{"type":"text","text":" "},{"type":"text","text":"AutoFill flows, where the system supplies a precomputed "},{"type":"codeVoice","code":"clientDataHash"},{"type":"text","text":" rather"},{"type":"text","text":" "},{"type":"text","text":"than the full "},{"type":"codeVoice","code":"clientDataJSON"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/webauthn\/client"]}],"topicSections":[{"anchor":"Creating-a-Client","title":"Creating a Client","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/init(session:origin:enterpriseRpIds:allowedExtensions:isPublicSuffix:)"]},{"anchor":"Registration","title":"Registration","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:clientData:authorization:)"]},{"anchor":"Authentication","title":"Authentication","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:clientData:authorization:)"]},{"anchor":"Configuration","title":"Configuration","iden
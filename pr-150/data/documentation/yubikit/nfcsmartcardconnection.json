s:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"method that will close the connection and set the alertMessage of the NFC alert to the provided message."}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"NFC is only supported on iPhones from iPhone 6 and forward. It will not work on iPads since there’s no NFC chip in these devices.","type":"text"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"NFC connection to a YubiKey (iOS only)."}]},{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"NFCSmartCardConnection establishes a connection to a YubiKey via NFC. The connection"},{"type":"text","text":" "},{"type":"text","text":"presents the system NFC dialog and waits for the user to tap their YubiKey."}]},{"type":"paragraph","inlineContent":[{"text":"NFC connections are short-lived due to iOS timeout constraints. Perform operations quickly","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and close the connection with a user-visible message."}]},{"type":"codeListing","code":["let connection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","await connection.close(message: \"Codes retrieved\")"],"syntax":"swift"}],"kind":"content"}],"sections":[],"metadata":{"roleHeading":"Structure","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NFCSmartCardConnection","kind":"identifier"}],"role":"symbol","modules":[{"name":"YubiKit"}],"title":"NFCSmartCardConnection","externalID":"s:7YubiKit22NFCSmartCardConnectionV","navigatorTitle":[{"text":"NFCSmartCardConnection","kind":"identifier"}]},"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/LightningS
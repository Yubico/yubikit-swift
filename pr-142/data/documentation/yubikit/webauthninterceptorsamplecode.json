{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/webauthninterceptorsamplecode"]}],"abstract":[{"text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"text":" calls inside a ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":" and routes them to a YubiKey. It uses the high-level ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" companion module.","type":"text"}],"metadata":{"color":{"standardColorIdentifier":"yellow"},"roleHeading":"Sample Code","modules":[{"name":"YubiKit"}],"role":"sampleCode","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The interceptor demonstrates how to:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Intercept ","type":"text"},{"code":"navigator.credentials.create()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"navigator.credentials.get()","type":"codeVoice"},{"text":" in a ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options","isActive":true,"type":"reference"},{"text":" \/ ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","isActive":true,"type":"reference"},{"text":" types.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Drive the SDK’s high-level ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Use the bundled ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface.","type":"text"}]},{"type":"heading","level":2,"text":"Architecture Overview","anchor":"Architecture-Overview"},{"type":"paragraph","inlineContent":[{"text":"The sample itself is intentionally thin:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Interceptor.js","type":"text"}],"type":"strong"},{"text":" — injected into the ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" to monkey-patch ","type":"text"},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"text":" and shuttle requests\/responses through ","type":"text"},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"WebView.swift","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"UIViewRepresentable","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"NSViewRepresentable","type":"codeVoice"},{"text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"WebAuthnHandler.swift","type":"text"}],"type":"strong"},{"text":" — decodes the JSON envelope, builds a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference"},{"text":", and calls ","type":"text"},{"code":"FidoUI.makeCredential","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"FidoUI.getAssertion","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"ContentView.swift","type":"text"}],"type":"strong"},{"text":" — minimal SwiftUI shell with a URL bar and back button.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"FidoUI","type":"text"}],"type":"strong"},{"text":" (separate Swift package under ","type":"text"},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI","type":"codeVoice"},{"text":") — the reusable UI + transport layer described below.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The end-to-end flow:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Page JS calls ","type":"text"},{"code":"navigator.credentials.create()","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".get()","type":"codeVoice"},{"text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" decodes the JSON straight into the SDK’s strongly-typed ","type":"text"},{"code":"Options","type":"codeVoice"},{"text":" and hands them to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"FidoUI","type":"codeVoice"},{"text":" opens a transport, runs the ceremony via ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":", and shows PIN \/ UV \/ error \/ success panels as needed.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The resulting ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","isActive":true,"type":"reference"},{"text":" is serialized via its built-in ","type":"text"},{"code":"toJSON()","type":"codeVoice"},{"text":" and posted back to JS.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"heading","level":2,"text":"Intercepting WebAuthn Calls","anchor":"Intercepting-WebAuthn-Calls"},{"type":"heading","level":3,"text":"JavaScript Injection","anchor":"JavaScript-Injection"},{"type":"paragraph","inlineContent":[{"code":"Interceptor.js","type":"codeVoice"},{"text":" replaces ","type":"text"},{"code":"navigator.credentials.create","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"navigator.credentials.get","type":"codeVoice"},{"text":" with versions that forward to Swift. Binary fields (","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"user.id","type":"codeVoice"},{"text":", ","type":"text"},{"code":"rawId","type":"codeVoice"},{"text":", …) are serialized to ","type":"text"},{"inlineContent":[{"text":"base64url","type":"text"}],"type":"strong"},{"text":" strings via ","type":"text"},{"code":"JSON.stringify","type":"codeVoice"},{"text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed.","type":"text"}]},{"syntax":"javascript","type":"codeListing","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"]},{"type":"paragraph","inlineContent":[{"text":"The script is injected at document start so it runs before any page code:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"]},{"type":"paragraph","inlineContent":[{"code":"shouldIntercept","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for any ","type":"text"},{"code":"publicKey","type":"codeVoice"},{"text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when ","type":"text"},{"code":"publicKey.hints","type":"codeVoice"},{"text":" includes ","type":"text"},{"code":"\"security-key\"","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"heading","level":3,"text":"Receiving Messages in Swift","anchor":"Receiving-Messages-in-Swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"Coordinator","type":"codeVoice"},{"text":" is both ","type":"text"},{"code":"WKNavigationDelegate","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"shutdown()","type":"codeVoice"},{"text":" is called from ","type":"text"},{"code":"dismantle{UI,NS}View","type":"codeVoice"},{"text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle.","type":"text"}]},{"type":"heading","level":2,"text":"Driving the Ceremony","anchor":"Driving-the-Ceremony"},{"type":"paragraph","inlineContent":[{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" is intentionally tiny — it decodes the envelope, builds a typed ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":", and delegates to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"]},{"type":"paragraph","inlineContent":[{"code":"handleGet","type":"codeVoice"},{"text":" is the symmetric counterpart that decodes ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","type":"reference"},{"text":" and calls ","type":"text"},{"code":"fidoUI.getAssertion","type":"codeVoice"},{"text":". The response JSON produced by ","type":"text"},{"code":"toJSON()","type":"codeVoice"},{"text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to ","type":"text"},{"code":"ArrayBuffer","type":"codeVoice"},{"text":" when it materializes the credential.","type":"text"}]},{"type":"heading","level":2,"text":"Returning the Response to JavaScript","anchor":"Returning-the-Response-to-JavaScript"},{"type":"paragraph","inlineContent":[{"text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"]},{"type":"paragraph","inlineContent":[{"text":"JavaScript decodes the JSON and rebuilds a ","type":"text"},{"code":"PublicKeyCredential","type":"codeVoice"},{"text":"-shaped object — converting the base64url binary fields back to ","type":"text"},{"code":"ArrayBuffer","type":"codeVoice"},{"text":"s and wiring up ","type":"text"},{"code":"getClientExtensionResults","type":"codeVoice"},{"text":", ","type":"text"},{"code":"getAuthenticatorData","type":"codeVoice"},{"text":", ","type":"text"},{"code":"getPublicKey","type":"codeVoice"},{"text":", ","type":"text"},{"code":"toJSON","type":"codeVoice"},{"text":", and the rest. Errors travel through a parallel ","type":"text"},{"code":"__webauthn_error__","type":"codeVoice"},{"text":" channel and surface to the page as a ","type":"text"},{"code":"DOMException","type":"codeVoice"},{"text":" with name ","type":"text"},{"code":"NotAllowedError","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","level":2,"text":"The FidoUI Module","anchor":"The-FidoUI-Module"},{"type":"paragraph","inlineContent":[{"code":"FidoUI","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting ","type":"text"},{"code":"navigator.credentials.*","type":"codeVoice"},{"text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Transport selection.","type":"text"}],"type":"strong"},{"text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Ceremony serialization.","type":"text"}],"type":"strong"},{"text":" Concurrent calls on the same ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Cancellation.","type":"text"}],"type":"strong"},{"text":" A single ","type":"text"},{"code":"cancel()","type":"codeVoice"},{"text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The host code only needs to construct one ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" instance and call ","type":"text"},{"code":"makeCredential","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"getAssertion","type":"codeVoice"},{"text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See ","type":"text"},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/","type":"codeVoice"},{"text":" for the full source.","type":"text"}]},{"type":"heading","level":2,"text":"Platform Notes","anchor":"Platform-Notes"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"iOS.","type":"text"}],"type":"strong"},{"text":" The wired path goes through CryptoTokenKit (","type":"text"},{"code":"WiredSmartCardConnection","type":"codeVoice"},{"text":" — USB-C or Lightning), and the NFC path through ","type":"text"},{"code":"NFCSmartCardConnection","type":"codeVoice"},{"text":". The sample’s ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" declares ","type":"text"},{"code":"NFCReaderUsageDescription","type":"codeVoice"},{"text":" and lists the FIDO applet AID (","type":"text"},{"code":"A0000006472F0001","type":"codeVoice"},{"text":") under ","type":"text"},{"code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers","type":"codeVoice"},{"text":"; the entitlements turn on ","type":"text"},{"code":"com.apple.developer.nfc.readersession.formats","type":"codeVoice"},{"text":" (","type":"text"},{"code":"TAG","type":"codeVoice"},{"text":") and ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"macOS.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" uses ","type":"text"},{"code":"HIDFIDOConnection","type":"codeVoice"},{"text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"com.apple.security.device.usb","type":"codeVoice"},{"text":" so the same target builds cleanly for both platforms.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Where to Customize","anchor":"Where-to-Customize"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Which requests get intercepted.","type":"text"}],"type":"strong"},{"text":" Edit ","type":"text"},{"code":"shouldIntercept","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"Interceptor.js","type":"codeVoice"},{"text":" to scope by hint, RP ID, or any other heuristic.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Origin verification.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" builds a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","isActive":true,"type":"reference"},{"text":" from ","type":"text"},{"code":"window.location.origin","type":"codeVoice"},{"text":". Replace the ","type":"text"},{"code":"isPublicSuffix","type":"codeVoice"},{"text":" closure passed to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" with a real public-suffix-list check before shipping.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"UI.","type":"text"}],"type":"strong"},{"text":" Swap or restyle the panels in ","type":"text"},{"code":"FidoUI\/Sources\/FidoUI\/Views\/","type":"codeVoice"},{"text":" — the rest of the module is UI-agnostic.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"sections":[],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"sampleCodeDownload":{"action":{"isActive":true,"type":"reference","overridingTitle":"View Source","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample"},"kind":"sampleDownload"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"seeAlsoSections":[{"title":"Sample code","generated":true,"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"],"anchor":"Sample-code"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"},"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Registration/Options":{"url":"\/documentation\/yubikit\/webauthn\/registration\/options","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options","title":"WebAuthn.Registration.Options","abstract":[{"text":"Options for registering a new passkey credential.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Options","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Options"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Registration/Response":{"abstract":[{"type":"text","text":"Authenticator response from a successful credential creation."}],"role":"symbol","navigatorTitle":[
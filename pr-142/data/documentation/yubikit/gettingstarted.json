{"abstract":[{"text":"Prepare your project to connect to the YubiKey via NFC, SmartCard and Lightning.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"The YubiKit framework is distributed using the Swift Package Manager. To add the framework to your project follow these steps:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Package Dependencies” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Press the plus-button to bring up the add package dialog.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"add-framework-1.png","type":"image"}],"type":"paragraph"},{"start":4,"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Enter ","type":"text"},{"code":"https:\/\/github.com\/Yubico\/yubikit-swift\/","type":"codeVoice"},{"text":" in the search field and select the Yubico Swift Package.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Press the “Add Package” button to add the SDK to your project.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"add-framework-2.png","type":"image"}],"type":"paragraph"},{"level":3,"text":"NFC","type":"heading","anchor":"NFC"},{"inlineContent":[{"text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC","type":"text"},{"text":" ","type":"text"},{"text":"application identifiers and a NFC Privacy statement to the application.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Add Wireless entitlement"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Signing & Capabilities” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Click the “+”-button to add a new capability.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the “Near Field Communication Tag” capability.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"nfc-entitlement.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Add list of NFC application identifiers"}],"type":"strong"}],"type":"paragraph"},{"start":6,"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"nfc-identifiers.png","type":"image"}],"type":"paragraph"},{"start":8,"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the Yubico NFC application identifiers to enable communication with the different","type":"text"},{"text":" ","type":"text"},{"text":"applications on the YubiKey.","type":"text"}]}]}],"type":"orderedList"},{"syntax":null,"type":"codeListing","code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"]},{"inlineContent":[{"identifier":"nfc-identifiers-list.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Add a NFC Privacy description"}],"type":"strong"}],"type":"paragraph"},{"start":9,"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in","type":"text"},{"text":" ","type":"text"},{"text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"nfc-privacy.png"}],"type":"paragraph"},{"level":3,"text":"SmartCard\/USB","type":"heading","anchor":"SmartCardUSB"},{"inlineContent":[{"type":"text","text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" entitlement to your application."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the application entitlements file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" entitlement to the entitlement list."}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"smart-card.png","type":"image"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SmartCard\/USB connection only support the CCID based applications on the YubiKey and does not support U2F, FIDO2 or OTP."}]}],"type":"aside","style":"note","name":"Note"},{"text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey","type":"heading","level":3,"anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey"},{"inlineContent":[{"text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" string to the list of External Accessories.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not present add the ","type":"text"},{"type":"codeVoice","code":"Supported external accessory protocols"},{"text":" key and insert the string ","type":"text"},{"type":"codeVoice","code":"com.yubico.ylp"},{"text":" in its list.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"external-accessory.png"}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for "},{"type":"codeVoice","code":"Supported external accessory protocols"},{"type":"text","text":" to "},{"type":"codeVoice","code":"com.yubico.ylp"},{"type":"text","text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework."}]}],"style":"note","type":"aside"},{"level":2,"text":"Making Your First Connection","anchor":"Making-Your-First-Connection","type":"heading"},{"inlineContent":[{"type":"text","text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device."}],"type":"paragraph"},{"level":3,"text":"Understanding Connection Types","anchor":"Understanding-Connection-Types","type":"heading"},{"inlineContent":[{"text":"YubiKit handles three different connection methods:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"NFC","type":"text"}]},{"type":"text","text":": Short-range wireless communication (iOS only)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"USB","type":"text"}]},{"type":"text","text":": Direct USB connection via SmartCard interface"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Lightning","type":"text"}]},{"type":"text","text":": YubiKey 5Ci connected to Lightning port (iOS only)"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Each connection type works differently, so let’s explore how to use them.","type":"text"}],"type":"paragraph"},{"level":3,"text":"NFC Connections","anchor":"NFC-Connections","type":"heading"},{"inlineContent":[{"text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:","type":"text"}],"type":"paragraph"},{"code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete."}],"type":"paragraph"},{"level":3,"text":"USB and Lightning Connections","anchor":"USB-and-Lightning-Connections","type":"heading"},{"inlineContent":[{"type":"text","text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:"}],"type":"paragraph"},{"code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"WiredSmartCardConnection.makeConnection()"},{"type":"text","text":" method automatically detects whether you’re using USB or Lightning."}],"type":"paragraph"},{"level":3,"text":"Specific Connection Types","anchor":"Specific-Connection-Types","type":"heading"},{"inlineContent":[{"type":"text","text":"For more control, you can connect to specific interfaces:"}],"type":"paragraph"},{"code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Understanding Connection Lifecycle","anchor":"Understanding-Connection-Lifecycle","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Critical:"}]},{"type":"text","text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time."}],"type":"paragraph"},{"level":3,"text":"Connection Behavior","anchor":"Connection-Behavior","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Exclusive access"}],"type":"strong"},{"text":": Only one connection can exist per YubiKey at any time","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Manual closure required"}],"type":"strong"},{"text":": Dropping a connection reference does NOT automatically close it - you must call ","type":"text"},{"type":"codeVoice","code":"close()"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Resource blocking"}],"type":"strong"},{"text":": An unclosed connection prevents new connections (throws ","type":"text"},{"type":"codeVoice","code":"SmartCardConnectionError.busy"},{"text":")","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call "},{"type":"codeVoice","code":"close()"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Working with Sessions","anchor":"Working-with-Sessions","type":"heading"},{"inlineContent":[{"type":"text","text":"Once you have a connection, create sessions to access different YubiKey applications:"}],"type":"paragraph"},{"level":3,"text":"OATH Session (TOTP\/HOTP codes)","anchor":"OATH-Session-TOTPHOTP-codes","type":"heading"},{"code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"PIV Session (Certificates and keys)","anchor":"PIV-Session-Certificates-and-keys","type":"heading"},{"code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Management Session (Device information)","anchor":"Management-Session-Device-information","type":"heading"},{"code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"WebAuthn Client (FIDO2 \/ passkeys)","anchor":"WebAuthn-Client-FIDO2--passkeys","type":"heading"},{"inlineContent":[{"type":"text","text":"For passkey registration and authentication, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"type":"text","text":" wraps a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" (USB HID on macOS) or any "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection"},{"type":"text","text":" "},{"type":"text","text":"(NFC \/ USB CCID)."}],"type":"paragraph"},{"code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"PIN and UV are supplied per ceremony via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization"},{"type":"text","text":". For raw"},{"type":"text","text":" "},{"type":"text","text":"CTAP2 access (credential management, bio enrollment, large blobs), use"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":" directly."}],"type":"paragraph"},{"level":2,"text":"Connection Management Patterns","anchor":"Connection-Management-Patterns","type":"heading"},{"level":3,"text":"For UI Applications","anchor":"For-UI-Applications","type":"heading"},{"inlineContent":[{"type":"text","text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode"},{"type":"text","text":" for complete examples of reactive connection management patterns that automatically update your UI when YubiKeys are plugged in or removed."}],"type":"paragraph"},{"level":3,"text":"For Command-Line Tools","anchor":"For-Command-Line-Tools","type":"heading"},{"inlineContent":[{"type":"text","text":"CLI applications often use a simpler approach with a single connection per operation. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"},{"type":"text","text":" for examples of how command-line tools handle connections for one-time operations."}],"type":"paragraph"},{"level":2,"text":"Next Steps","anchor":"Next-Steps","type":"heading"},{"inlineContent":[{"type":"text","text":"Now you’re ready to build YubiKey applications! Check out the sample projects to see complete implementations:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"OATHSample","type":"text"}]},{"type":"text","text":": Shows how to build a TOTP authenticator app with SwiftUI"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"PIVTool","type":"text"}]},{"type":"text","text":": Demonstrates PIV operations for certificates and digital signatures"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"WebAuthnInterceptorSample","type":"text"}]},{"type":"text","text":": Routes WebAuthn calls from a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" through "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" to a YubiKey"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Build SDK documentation","anchor":"Build-SDK-documentation","type":"heading"},{"inlineContent":[{"type":"text","text":"You can also build the complete SDK documentation by selecting “Product” -> “Build Documentation” in Xcode. This gives you access to the full YubiKit API reference."}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Select an iOS target when building documentation to include all connection types.","type":"text"}]}],"style":"note","type":"aside"}]}],"metadata":{"title":"Getting Started","roleHeading":"Article","role":"article","modules":[{"name":"YubiKit"}]},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/gettingstarted"]}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/SmartCardConnection":{"navigatorTitle":[{"text":"SmartCardConnection","kind":"identifier"}],"url":"\/documentation\/yubikit\/smartcardconnection","type":"topic","role":"symbol","title":"SmartCardConnection","abstract":[{"type":"text","text":"An interface defining a SmartCard based connection to a YubiKey."}],"kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SmartCardConnection","kind":"identifier"}]},"smart-card.png":{"type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/smart-card@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/smart-card~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to add NFC privacy string to project.","identifier":"smart-card.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","abstract":[{"type":"text","text":"An interface to the Management application on the YubiKey."}],"type":"topic","title":"Management.Session","role":"symbol","navigatorTitle":[{"text":"Session","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/yubikit\/management\/session","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Session","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","abstract":[{"text":"An interface to the OATH application on the YubiKey.","type":"text"}],"type":"topic","title":"OATHSession","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OATHSession"}],"kind":"symbol","url":"\/documentation\/yubikit\/oathsession","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"OATHSession"}]},"add-framework-1.png":{"type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to add the YubiKit SDK to your Xcode project.","identifier":"add-framework-1.png"},"external-accessory.png":{"type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to support for lightning YubiKeys.","identifier":"external-accessory.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"title":"PIVTool: Building PIV applications with YubiKey","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","role":"sampleCode","url":"\/documentation\/yubikit\/pivtoolsamplecode","abstract":[{"type":"text","text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","isActive":true},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}],"kind":"article","type":"topic"},"nfc-identifiers.png":{"type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers~dark@2x.png"}],"alt":"An image showing how to add the nfc application identifiers.","identifier":"nfc-identifiers.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSampleCode":{"title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","role":"sampleCode","url":"\/documentation\/yubikit\/oathsamplecode","abstract":[{"type":"text","text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","isActive":true},{"type":"text","text":" to retrieve authentication codes, and "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","isActive":true},{"type":"text","text":" to get device information."}],"kind":"article","type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"navigatorTitle":[{"kind":"identifier","text":"Client"}],"title":"WebAuthn.Client","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","role":"symbol","url":"\/documentation\/yubikit\/webauthn\/client","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"kind":"symbol","type":"topic"},"documentation-header.png":{"type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}],"alt":"YubiKeys in a row","identifier":"documentation-header.png"},"nfc-entitlement.png":{"variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement~dark@2x.png","traits":["2x","dark"]}],"identifier":"nfc-entitlement.png","alt":"An image showing how to add wireless entitlements to project.","type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authorization":{"navigatorTitle":[{"kind":"identifier","text":"Authorization"}],"title":"WebAuthn.Authorization","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Authorization"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","role":"symbol","url":"\/documentation\/yubikit\/webauthn\/authorization","abstract":[{"type":"text","text":"PIN\/UV policy for a single WebAuthn ceremony."}],"kind":"symbol","type":"topic"},"nfc-privacy.png":{"identifier":"nfc-privacy.png","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy~dark@2x.png"}],"alt":"An image showing how to add the NFC privacy string to a project.","type":"image"},"nfc-identifiers-list.png":{"identifier":"nfc-identifiers-list.png","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list~dark@2x.png"}],"alt":"An image showing the list of nfc identifiers added.","type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"abstract":[{"type":"text","text":"An interface to the PIV application on the YubiKey."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","type":"topic","kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}],"navigatorTitle":[{"text":"PIVSession","kind":"identifier"}],"title":"PIVSession","role":"symbol","url":"\/documentation\/yubikit\/pivsession"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","type":"topic","kind":"symbol","images":[{"type":"icon","identifier":"documentation-header.png"}],"title":"YubiKit","role":"collection","url":"\/documentation\/yubikit"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/CTAP2/Session":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","abstract":[{"type":"text","text":"Interface to the FIDO2\/CTAP authenticator on the YubiKey."}],"type":"topic","title":"CTAP2.Session","role":"symbol","navigatorTitle":[{"text":"Session","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/yubikit\/ctap2\/session","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Session","kind":"identifier"}]},"add-framework-2.png":{"variants":[{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-2@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-2~dark@2x.png","traits":["2x","dark"]}],"identifier":"add-framework-2.png","alt":"An image showing how to add the YubiKit SDK to your Xcode project.","type":"image"}}}
t-swift.YubiKit\/nfc-entitlement@2x.png"},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement~dark@2x.png","traits":["2x","dark"]}],"type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authorization":{"abstract":[{"text":"PIN\/UV policy for a single WebAuthn ceremony.","type":"text"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","title":"WebAuthn.Authorization","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Authorization","kind":"identifier"}],"navigatorTitle":[{"text":"Authorization","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/yubikit\/webauthn\/authorization","type":"topic"},"add-framework-1.png":{"type":"image","identifier":"add-framework-1.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to add the YubiKit SDK to your Xcode project."},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSampleCode":{"title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","abstract":[{"text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","isActive":true,"type":"reference"},{"text":" to retrieve authentication codes, and ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","isActive":true,"type":"reference"},{"text":" to get device information.","type":"text"}],"role":"sampleCode","kind":"article","url":"\/documentation\/yubikit\/oathsamplecode","type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"title":"PIVTool: Building PIV applications with YubiKey","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","url":"\/documentation\/yubikit\/pivtoolsamplecode","type":"topic","role":"sampleCode","kind":"article","abstract":[{"type":"text","text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession"},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}]},"nfc-privacy.png":{"type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy~dark@2x.png","traits":["2x","dark"]}],"identifier":"nfc-privacy.png","alt":"An image showing how to add the NFC privacy string to a project."}}}
text":" ","kind":"text"},{"text":"Client","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"WebAuthn.Client","type":"topic"},"documentation-header.png":{"alt":"YubiKeys in a row","identifier":"documentation-header.png","type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}],"navigatorTitle":[{"text":"PIVSession","kind":"identifier"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","role":"symbol","type":"topic","url":"\/documentation\/yubikit\/pivsession","kind":"symbol","title":"PIVSession","abstract":[{"type":"text","text":"An interface to the PIV application on the YubiKey."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/SmartCardConnection":{"title":"SmartCardConnection","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"SmartCardConnection"}],"navigatorTitle":[{"text":"SmartCardConnection","kind":"identifier"}],"abstract":[{"text":"An interface defining a SmartCard based connection to a YubiKey.","type":"text"}],"url":"\/documentation\/yubikit\/smartcardconnection","type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSampleCode":{"abstract":[{"text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","isActive":true},{"text":" to retrieve authentication codes, and ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","isActive":true},{"text":" to get device information.","type":"text"}],"kind":"article","url":"\/documentation\/yubikit\/oathsamplecode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","type":"topic","role":"sampleCode","title":"OATHSample: Basic OATH app showcasing how to integrate the SDK"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"title":"Management.Session","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","kind":"symbol","abstract":[{"type":"text","text":"An interface to the Management application on the YubiKey."}],"type":"topic","role":"symbol","url":"\/documentation\/yubikit\/management\/session","navigatorTitle":[{"kind":"identifier","text":"Session"}]}}}
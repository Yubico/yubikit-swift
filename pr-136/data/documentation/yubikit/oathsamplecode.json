{"metadata":{"title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","role":"sampleCode","modules":[{"name":"YubiKit"}],"color":{"standardColorIdentifier":"green"},"roleHeading":"Sample Code"},"seeAlsoSections":[{"title":"Sample code","anchor":"Sample-code","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"],"generated":true}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/oathsamplecode"]}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"overridingTitle":"View Source","type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample"}},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The sample creates an authenticator app that:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Establishes connections to YubiKeys via USB, Lightning, or NFC","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Manages connection lifecycle (detecting plugged\/unplugged devices)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists TOTP codes stored on the YubiKey","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Shows device information like firmware version","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Handles connection errors and user cancellations gracefully","type":"text"}]}]}]},{"inlineContent":[{"text":"This sample focuses on read-only operations and doesn’t handle password-protected YubiKeys or credential management.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Connection Management","anchor":"Connection-Management"},{"type":"heading","level":3,"text":"Handling Wired Connections","anchor":"Handling-Wired-Connections"},{"inlineContent":[{"text":"The app uses a ","type":"text"},{"code":"ConnectionManager","type":"codeVoice"},{"text":" to handle persistent connections to plugged-in YubiKeys. This approach ensures your app stays responsive when users plug and unplug their YubiKeys:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["private func startWiredConnection() {","    wiredConnectionTask = Task { @MainActor in","        while !Task.isCancelled {","            do {","                let newConnection = try await WiredSmartCardConnection.makeConnection()","                wiredConnection = newConnection","","                \/\/ Wait for disconnect","                let closeError = await newConnection.waitUntilClosed()","                wiredConnection = nil","            } catch {","                self.error = error","            }","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The key insight here is using ","type":"text"},{"type":"codeVoice","code":"waitUntilClosed()"},{"text":" to detect when the YubiKey is unplugged, then automatically waiting for the next connection.","type":"text"}]},{"anchor":"NFC-Connections","type":"heading","level":3,"text":"NFC Connections"},{"type":"paragraph","inlineContent":[{"text":"NFC connections work differently - they’re initiated by user action and are short-lived:","type":"text"}]},{"type":"codeListing","code":["func requestNFCConnection() async {","    do {","        nfcConnection = try await NFCSmartCardConnection()","    } catch {","        self.error = error","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"When an NFC connection is established, the app fetches data and immediately closes it with a user message:","type":"text"}]},{"type":"codeListing","code":["Task {","    await model.update(using: connection)","    await connection.close(message: \"Codes calculated\")","}"],"syntax":"swift"},{"anchor":"Working-with-YubiKey-Data","type":"heading","level":2,"text":"Working with YubiKey Data"},{"anchor":"Reading-OATH-Codes","type":"heading","level":3,"text":"Reading OATH Codes"},{"type":"paragraph","inlineContent":[{"text":"Once you have a connection, getting TOTP codes is straightforward:","type":"text"}]},{"type":"codeListing","code":["private func calculateCodes(using connection: SmartCardConnection) async {","    do {","        let session = try await OATHSession.makeSession(connection: connection)","        let result = try await session.calculateCredentialCodes()","        accounts = result.map { credential, code in","            Account(","                label: credential.label,","                code: code?.code,","                issuer: credential.issuer,","                type: credential.type","            )","        }","    } catch {","        self.error = error","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"calculateCredentialCodes()","type":"codeVoice"},{"text":" method returns a dictionary mapping credentials to their current codes. Some codes might be ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if they require touch or are password-protected.","type":"text"}]},{"anchor":"Getting-Device-Information","type":"heading","level":3,"text":"Getting Device Information"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"Management.Session"},{"type":"text","text":" to get YubiKey information:"}]},{"type":"codeListing","code":["private func getKeyVersion(using connection: SmartCardConnection) async {","    do {","        let session: Management.Session = try await .makeSession(connection: connection)","        self.keyVersion = await session.version.description","    } catch {","        self.error = error","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"Model","type":"codeVoice"},{"text":" class combines both operations in a single ","type":"text"},{"code":"update","type":"codeVoice"},{"text":" method:","type":"text"}]},{"type":"codeListing","code":["func update(using connection: SmartCardConnection) async {","    await calculateCodes(using: connection)","    await getKeyVersion(using: connection)","    connectionType = connection.connectionType","}"],"syntax":"swift"},{"anchor":"SwiftUI-Integration","type":"heading","level":2,"text":"SwiftUI Integration"},{"anchor":"Reacting-to-Connection-Changes","type":"heading","level":3,"text":"Reacting to Connection Changes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app uses SwiftUI’s "},{"type":"codeVoice","code":"@Published"},{"type":"text","text":" properties and "},{"type":"codeVoice","code":"onReceive"},{"type":"text","text":" to update the UI when connections change:"}]},{"type":"codeListing","code":[".onReceive(connectionManager.$wiredConnection) { newConnection in","    guard let connection = newConnection else {","        model.clear()  \/\/ Clear UI when YubiKey unplugged","        return","    }","    Task { await model.update(using: connection) }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This pattern ensures the UI immediately updates when YubiKeys are plugged in or removed.","type":"text"}]},{"anchor":"Platform-Specific-Features","type":"heading","level":3,"text":"Platform-Specific Features"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app handles iOS vs macOS differences with conditional compilation:"}]},{"type":"codeListing","code":["#if os(iOS)",".refreshable {","    await connectionManager.requestNFCConnection()","}","#endif"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS users can pull-to-refresh to scan with NFC, while macOS users only see USB options."}]},{"anchor":"Connection-Type-Detection","type":"heading","level":3,"text":"Connection Type Detection"},{"type":"paragraph","inlineContent":[{"text":"The sample includes a useful extension to identify connection types:","type":"text"}]},{"type":"codeListing","code":["extension SmartCardConnection {","    var connectionType: String {","        switch self {","        case _ as NFCSmartCardConnection: return \"NFC\"","        case _ as LightningSmartCardConnection: return \"Lightning\"","        case _ as USBSmartCardConnection: return \"USB\"","        default: return \"Unknown\"","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is helpful because NFC connections are slower than USB, and users like to know how their YubiKey is connected."}]},{"anchor":"Architecture-Decisions","type":"heading","level":2,"text":"Architecture Decisions"},{"anchor":"Why-the-connection-management-works-this-way","type":"heading","level":3,"text":"Why the connection management works this way"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample uses a background loop that continuously waits for wired connections. This might seem unusual, but it solves a key problem: YubiKeys get plugged and unplugged frequently, but apps need to stay responsive."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you unplug your YubiKey, the app doesn’t crash or freeze - it detects the disconnection via "},{"type":"codeVoice","code":"waitUntilClosed()"},{"text":" and immediately starts waiting for the next YubiKey. This creates a smoother user experience where the app responds when you plug \/ unplug a YubiKey.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"NFC works differently since you can’t continuously scan - the user has to explicitly initiate each scan. That’s why NFC connections are handled separately through user actions like the scan button or pull-to-refresh."}]},{"level":3,"type":"heading","text":"Error handling for hardware connections","anchor":"Error-handling-for-hardware-connections"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hardware connections are unreliable by nature. Users will unplug devices mid-operation, walk away during NFC scans, or have connectivity issues. The sample handles this gracefully:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Connection failures are caught and stored as errors","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"User cancellations (like dismissing NFC scan) are filtered out to avoid unnecessary error alerts"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Session errors are handled similarly - show the error but maintain app functionality"}],"type":"paragraph"}]}]},{"level":3,"type":"heading","text":"Working with Swift actors","anchor":"Working-with-Swift-actors"},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit sessions are Swift actors that handle their own threading. The sample shows how to integrate this with SwiftUI’s main actor requirements:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ConnectionManager"},{"text":" runs on ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" so it can directly update ","type":"text"},{"type":"codeVoice","code":"@Published"},{"text":" properties","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Session calls happen on the session’s actor, then results are passed back to update the UI"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Everything uses "},{"type":"codeVoice","code":"async\/await"}],"type":"paragraph"}]}]}],"kind":"content"}],"sections":[],"abstract":[{"type":"text","text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","isActive":true},{"type":"text","text":" to retrieve authentication codes, and "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","isActive":true},{"type":"text","text":" to get device information."}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Client"}],"title":"WebAuthn.Client","role":"symbol","abstract":[{"text":"Client for performing WebAuthn passkey operations.","type":"text"}],"url":"\/documentation\/yubikit\/webauthn\/client","type":"topic"},"documentation-header.png":{"alt":"YubiKeys in a row","type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}],"identifier":"documentation-header.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"role":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"PIVSession"}],"abstract":[{"text":"An interface to the PIV application on the YubiKey.","type":"text"}],"title":"PIVSession","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PIVSession"}],"type":"topic","url":"\/documentatio
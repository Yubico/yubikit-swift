n\/Client","isActive":true},{"type":"text","text":" and the request, response, and"},{"type":"text","text":" "},{"type":"text","text":"data-model types defined by the"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/","isActive":true},{"type":"text","text":" "},{"text":"specification.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A passkey client and the W3C Web Authentication data model, mediated by a YubiKey."}]},{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"WebAuthn"},{"text":" namespace provides a high-level passkey client (","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"text":") that runs","type":"text"},{"text":" ","type":"text"},{"type":"reference","overridingTitle":"Web Authentication Level 3","identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Web Authentication Level 3"}]},{"text":" ceremonies against a","type":"text"},{"text":" ","type":"text"},{"text":"YubiKey, plus the request and response types defined by the WebAuthn specification.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A WebAuthn ceremony involves three parties: the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"authenticator"}]},{"text":" (a YubiKey), the","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"text":"client","type":"text"}]},{"text":" (your app, via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":"), and the ","type":"text"},{"type":"strong","inlineContent":[{"text":"relying party","type":"text"}]},{"text":" (your server, which","type":"text"},{"text":" ","type":"text"},{"text":"verifies what the authenticator returns). The client is the communication path between","type":"text"},{"text":" ","type":"text"},{"text":"authenticator and relying party — and it verifies the relying party’s identity against","type":"text"},{"text":" ","type":"text"},{"text":"the origin it’s bound to, so it can refuse to sign for a fraudulent site.","type":"text"}]},{"inlineContent":[{"text":"There are two ceremonies. ","type":"text"},{"inlineContent":[{"text":"Registration","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","isActive":true},{"text":") creates a new credential and supplies its","type":"text"},{"text":" ","type":"text"},{"text":"public key to the relying party for account association. ","type":"text"},{"inlineContent":[{"type":"text","text":"Authentication"}],"type":"strong"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","isActive":true},{"text":") proves to the relying party that the","type":"text"},{"text":" ","type":"text"},{"text":"YubiKey is the one registered for the user. Both ceremonies follow the same mechanical","type":"text"},{"text":" ","type":"text"},{"text":"shape: the relying party supplies a challenge, the authenticator signs it together","type":"text"},{"text":" ","type":"text"},{"text":"with the relying-party identifier, and the signature goes back to the relying party","type":"text"},{"text":" ","type":"text"},{"text":"for verification.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The pieces fit together as: a connection carries CTAP2 traffic, a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"sits on top, and ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"text":" runs ceremonies on that session. Connections come in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"three flavours that all work for WebAuthn: "},{"type":"codeVoice","code":"YubiKit\/HIDFIDOConnection"},{"type":"text","text":" on macOS,"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection","type":"reference","isActive":true},{"type":"text","text":" for tap-to-auth on iOS, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/USBSmartCardConnection","type":"reference","isActive":true},{"type":"text","text":" on either platform. Pick the one that matches"},{"type":"text","text":" "},{"type":"text","text":"your platform and form factor."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ macOS — USB HID FIDO","let connection = try await HIDFIDOConnection()","\/\/ iOS — tap-to-auth over NFC:","\/\/ let connection = try await NFCSmartCardConnection()","","let session = try await CTAP2.Session.makeSession(connection: connection)","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","\/\/ Register a new passkey","let registration = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value","","\/\/ Authenticate","let assertions = try await client.getAssertion(","    .init(challenge: challenge, rpId: \"example.com\"),","    authorization: .pin(\"1234\")",").value"]},{"inlineContent":[{"text":"Most apps start with ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":". For lower-level CTAP2 access — raw ","type":"text"},{"code":"makeCredential","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":"getAssertion","type":"codeVoice"},{"text":", credential management, bio enrollment — use ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true,"type":"reference"},{"text":" directly.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/yubikit\/webauthn"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"generated":true,"anchor":"WebAuthn-Client","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"],"title":"WebAuthn Client"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/CredentialDescriptor":{"title":"WebAuthn.CredentialDescriptor","abstract":[{"text":"Public key credential descriptor identifying a specific credential.","type":"text"}],"url":"\/documentation\/yubikit\/webauthn\/credentialdescriptor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CredentialDescriptor"}],"navigatorTitle":[{"kind":"identifier","text":"CredentialDescriptor"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/CredentialDescriptor","type":"topic","role":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/USBSmartCardConnection":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/USB
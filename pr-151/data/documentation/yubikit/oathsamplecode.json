{"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"sampleCodeDownload":{"action":{"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","type":"reference","overridingTitle":"View Source","isActive":true},"kind":"sampleDownload"},"metadata":{"roleHeading":"Sample Code","color":{"standardColorIdentifier":"green"},"title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","role":"sampleCode","modules":[{"name":"YubiKit"}]},"seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"],"generated":true,"title":"Sample code","anchor":"Sample-code"}],"abstract":[{"type":"text","text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"reference","isActive":true},{"type":"text","text":" to retrieve authentication codes, and "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"reference","isActive":true},{"type":"text","text":" to get device information."}],"primaryContentSections":[{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"The sample creates an authenticator app that:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Establishes connections to YubiKeys via USB, Lightning, or NFC"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Manages connection lifecycle (detecting plugged\/unplugged devices)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists TOTP codes stored on the YubiKey"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shows device information like firmware version"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handles connection errors and user cancellations gracefully"}]}]}]},{"inlineContent":[{"type":"text","text":"This sample focuses on read-only operations and doesn’t handle password-protected YubiKeys or credential management."}],"type":"paragraph"},{"anchor":"Connection-Management","type":"heading","level":2,"text":"Connection Management"},{"anchor":"Handling-Wired-Connections","type":"heading","level":3,"text":"Handling Wired Connections"},{"inlineContent":[{"type":"text","text":"The app uses a "},{"code":"ConnectionManager","type":"codeVoice"},{"type":"text","text":" to handle persistent connections to plugged-in YubiKeys. This approach ensures your app stays responsive when users plug and unplug their YubiKeys:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["private func startWiredConnection() {","    wiredConnectionTask = Task { @MainActor in","        while !Task.isCancelled {","            do {","                let newConnection = try await WiredSmartCardConnection.makeConnection()","                wiredConnection = newConnection","","                \/\/ Wait for disconnect","                let closeError = await newConnection.waitUntilClosed()","                wiredConnection = nil","            } catch {","                self.error = error","            }","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"The key insight here is using "},{"code":"waitUntilClosed()","type":"codeVoice"},{"type":"text","text":" to detect when the YubiKey is unplugged, then automatically waiting for the next connection."}],"type":"paragraph"},{"anchor":"NFC-Connections","type":"heading","level":3,"text":"NFC Connections"},{"inlineContent":[{"type":"text","text":"NFC connections work differently - they’re initiated by user action and are short-lived:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func requestNFCConnection() async {","    do {","        nfcConnection = try await NFCSmartCardConnection()","    } catch {","        self.error = error","    }","}"]},{"inlineContent":[{"type":"text","text":"When an NFC connection is established, the app fetches data and immediately closes it with a user message:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Task {","    await model.update(using: connection)","    await connection.close(message: \"Codes calculated\")","}"]},{"anchor":"Working-with-YubiKey-Data","type":"heading","level":2,"text":"Working with YubiKey Data"},{"anchor":"Reading-OATH-Codes","type":"heading","level":3,"text":"Reading OATH Codes"},{"inlineContent":[{"type":"text","text":"Once you have a connection, getting TOTP codes is straightforward:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["private func calculateCodes(using connection: SmartCardConnection) async {","    do {","        let session = try await OATHSession.makeSession(connection: connection)","        let result = try await session.calculateCredentialCodes()","        accounts = result.map { credential, code in","            Account(","                label: credential.label,","                code: code?.code,","                issuer: credential.issuer,","                type: credential.type","            )","        }","    } catch {","        self.error = error","    }","}"]},{"inlineContent":[{"type":"text","text":"The "},{"code":"calculateCredentialCodes()","type":"codeVoice"},{"type":"text","text":" method returns a dictionary mapping credentials to their current codes. Some codes might be "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if they require touch or are password-protected."}],"type":"paragraph"},{"anchor":"Getting-Device-Information","type":"heading","level":3,"text":"Getting Device Information"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"Management.Session","type":"codeVoice"},{"type":"text","text":" to get YubiKey information:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["private func getKeyVersion(using connection: SmartCardConnection) async {","    do {","        let session: Management.Session = try await .makeSession(connection: connection)","        self.keyVersion = await session.version.description","    } catch {","        self.error = error","    }","}"]},{"inlineContent":[{"type":"text","text":"The "},{"code":"Model","type":"codeVoice"},{"type":"text","text":" class combines both operations in a single "},{"code":"update","type":"codeVoice"},{"type":"text","text":" method:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func update(using connection: SmartCardConnection) async {","    await calculateCodes(using: connection)","    await getKeyVersion(using: connection)","    connectionType = connection.connectionType","}"]},{"anchor":"SwiftUI-Integration","type":"heading","level":2,"text":"SwiftUI Integration"},{"anchor":"Reacting-to-Connection-Changes","type":"heading","level":3,"text":"Reacting to Connection Changes"},{"inlineContent":[{"type":"text","text":"The app uses SwiftUI’s "},{"code":"@Published","type":"codeVoice"},{"type":"text","text":" properties and "},{"code":"onReceive","type":"codeVoice"},{"type":"text","text":" to update the UI when connections change:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".onReceive(connectionManager.$wiredConnection) { newConnection in","    guard let connection = newConnection else {","        model.clear()  \/\/ Clear UI when YubiKey unplugged","        return","    }","    Task { await model.update(using: connection) }","}"]},{"inlineContent":[{"type":"text","text":"This pattern ensures the UI immediately updates when YubiKeys are plugged in or removed."}],"type":"paragraph"},{"anchor":"Platform-Specific-Features","type":"heading","level":3,"text":"Platform-Specific Features"},{"inlineContent":[{"type":"text","text":"The app handles iOS vs macOS differences with conditional compilation:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["#if os(iOS)",".refreshable {","    await connectionManager.requestNFCConnection()","}","#endif"]},{"inlineContent":[{"type":"text","text":"iOS users can pull-to-refresh to scan with NFC, while macOS users only see USB options."}],"type":"paragraph"},{"anchor":"Connection-Type-Detection","type":"heading","level":3,"text":"Connection Type Detection"},{"inlineContent":[{"type":"text","text":"The sample includes a useful extension to identify connection types:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension SmartCardConnection {","    var connectionType: String {","        switch self {","        case _ as NFCSmartCardConnection: return \"NFC\"","        case _ as LightningSmartCardConnection: return \"Lightning\"","        case _ as USBSmartCardConnection: return \"USB\"","        default: return \"Unknown\"","        }","    }","}"]},{"inlineContent":[{"text":"This is helpful because NFC connections are slower than USB, and users like to know how their YubiKey is connected.","type":"text"}],"type":"paragraph"},{"anchor":"Architecture-Decisions","type":"heading","level":2,"text":"Architecture Decisions"},{"anchor":"Why-the-connection-management-works-this-way","type":"heading","level":3,"text":"Why the connection management works this way"},{"inlineContent":[{"text":"The sample uses a background loop that continuously waits for wired connections. This might seem unusual, but it solves a key problem: YubiKeys get plugged and unplugged frequently, but apps need to stay responsive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When you unplug your YubiKey, the app doesn’t crash or freeze - it detects the disconnection via ","type":"text"},{"type":"codeVoice","code":"waitUntilClosed()"},{"text":" and immediately starts waiting for the next YubiKey. This creates a smoother user experience where the app responds when you plug \/ unplug a YubiKey.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"NFC works differently since you can’t continuously scan - the user has to explicitly initiate each scan. That’s why NFC connections are handled separately through user actions like the scan button or pull-to-refresh.","type":"text"}],"type":"paragraph"},{"anchor":"Error-handling-for-hardware-connections","type":"heading","level":3,"text":"Error handling for hardware connections"},{"inlineContent":[{"text":"Hardware connections are unreliable by nature. Users will unplug devices mid-operation, walk away during NFC scans, or have connectivity issues. The sample handles this gracefully:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Connection failures are caught and stored as errors"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"User cancellations (like dismissing NFC scan) are filtered out to avoid unnecessary error alerts"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Session errors are handled similarly - show the error but maintain app functionality"}]}]}]},{"anchor":"Working-with-Swift-actors","type":"heading","level":3,"text":"Working with Swift actors"},{"inlineContent":[{"text":"YubiKit sessions are Swift actors that handle their own threading. The sample shows how to integrate this with SwiftUI’s main actor requirements:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ConnectionManager"},{"type":"text","text":" runs on "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" so it can directly update "},{"type":"codeVoice","code":"@Published"},{"type":"text","text":" properties"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Session calls happen on the session’s actor, then results are passed back to update the UI"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Everything uses "},{"type":"codeVoice","code":"async\/await"}]}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/oathsamplecode"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/yubikit\/webauthn\/client","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","navigatorTitle":[{"kind":"identifier","text":"Client"}],"title":"WebAuthn.Client","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/yubikit\/pivsession","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","navigatorTitle":[{"kind":"identifier","text":"PIVSession"}],"title":"PIVSession","abstract":[{"type":"text","text":"An interface to the PIV application on the YubiKey."}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"PIVSession"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/yubikit\/management\/session","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","navigatorTitle":[{"kind":"identifier","text":"Session"}],"title":"Management.Session","abstract":[{"type":"text","text":"An interface to the Management application on the YubiKey."}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"type":"topic","role":"sampleCode","kind":"article","url":"\/documentation\/yubikit\/webauthninterceptorsamplecode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","abstract":[{"type":"text","text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts "},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"type":"text","text":" calls inside a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" and routes them to a YubiKey. It uses the high-level "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"type":"text","text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" companion module."}]},"documentation-header.png":{"variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}],"alt":"YubiKeys in a row","type":"image","identifier":"documentation-header.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"type":"topic","role":"sampleCode","kind":"article","url":"\/documentation\/yubikit\/pivtoolsamplecode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","title":"PIVTool: Building PIV applications with YubiKey","abstract":[{"type":"text","text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","type":"reference"},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/yubikit\/oathsession","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","navigatorTitle":[{"kind":"identifier","text":"OATHSession"}],"title":"OATHSession","abstract":[{"type":"text","text":"An interface to the OATH application on the YubiKey."}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"OATHSession"}]},"https://github.com/Yubico/yubikit-swift/tree/main/Samples/OATHSample":{"checksum":null,"url":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","type":"download","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"title":"YubiKit","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"images":[{"identifier":"documentation-header.png","type":"icon"}],"role":"collection","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","url":"\/documentation\/yubikit"}}}
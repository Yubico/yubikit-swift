text","text":" product to your app target"},{"type":"text","text":" "},{"type":"text","text":"to use its backend types. Any SwiftLog "},{"code":"LogHandler","type":"codeVoice"},{"text":" can be supplied by the factory.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;","type":"text"},{"text":" ","type":"text"},{"text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,","type":"text"},{"text":" ","type":"text"},{"text":"though logs already in progress may use the previous settings.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,"},{"type":"text","text":" "},{"text":"pass its factory explicitly; global ","type":"text"},{"code":"LoggingSystem.bootstrap","type":"codeVoice"},{"text":" does not select YubiKit’s backend.","type":"text"},{"text":" ","type":"text"},{"text":"Factories may run concurrently and must not log through YubiKit themselves.","type":"text"}],"type":"paragraph"},{"anchor":"Traffic-logging","level":3,"text":"Traffic logging","type":"heading"},{"type":"codeListing","code":["YubiKit.Logs.configure(logLevel: .trace)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Raw traffic and SCP plaintext logs require ","type":"text"},{"inlineContent":[{"type":"text","text":"YubiKit to be compiled with "},{"code":"DEBUG","type":"codeVoice"}],"type":"strong"},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Neither configuration nor a custom backend can enable them in other builds."},{"type":"text","text":" "},{"type":"text","text":"Custom connections are responsible for their own traffic logging."}]},{"type":"aside","style":"warning","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Debug logs can include account names and credential iden
{"kind":"article","identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","interfaceLanguage":"swift"},"abstract":[{"text":"Prepare your project to connect to the YubiKey via NFC, SmartCard, Lightning and USB HID.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"anchor":"Preparing-your-project","generated":true,"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"title":"Preparing your project"}],"metadata":{"roleHeading":"Article","modules":[{"name":"YubiKit"}],"role":"article","title":"Getting Started"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The YubiKit framework is distributed using the Swift Package Manager. To add the framework to your project follow these steps:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Package Dependencies” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Press the plus-button to bring up the add package dialog.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"add-framework-1.png"}]},{"start":4,"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter "},{"type":"codeVoice","code":"https:\/\/github.com\/Yubico\/yubikit-swift\/"},{"type":"text","text":" in the search field and select the Yubico Swift Package."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Press the “Add Package” button to add the SDK to your project."}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"add-framework-2.png","type":"image"}],"type":"paragraph"},{"text":"NFC","type":"heading","level":3,"anchor":"NFC"},{"inlineContent":[{"type":"text","text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC"},{"type":"text","text":" "},{"type":"text","text":"application identifiers and a NFC Privacy statement to the application."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Add Wireless entitlement"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your project."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your application target."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the “Signing & Capabilities” tab."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Click the “+”-button to add a new capability."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the “Near Field Communication Tag” capability."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"nfc-entitlement.png"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Add list of NFC application identifiers"}]}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the “Info” tab."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”."}]}]}],"start":6},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-identifiers.png"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the Yubico NFC application identifiers to enable communication with the different"},{"type":"text","text":" "},{"type":"text","text":"applications on the YubiKey."}]}]}],"start":8},{"type":"codeListing","syntax":null,"code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"]},{"type":"paragraph","inlineContent":[{"identifier":"nfc-identifiers-list.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Add a NFC Privacy description","type":"text"}]}]},{"start":9,"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in"},{"type":"text","text":" "},{"type":"text","text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-privacy.png"}]},{"text":"SmartCard\/USB","level":3,"type":"heading","anchor":"SmartCardUSB"},{"type":"paragraph","inlineContent":[{"text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" entitlement to your application."}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the application entitlements file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" entitlement to the entitlement list."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"smart-card.png"}]},{"content":[{"inlineContent":[{"type":"text","text":"USB SmartCard supports Yubico OTP slot programming. HMAC-SHA1 challenge-response requires"},{"type":"text","text":" "},{"code":"HIDOTPConnection","type":"codeVoice"},{"text":" on macOS, ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LightningSmartCardConnection","isActive":true,"type":"reference"},{"text":", or NFC without a touch requirement.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey","type":"heading","level":3,"anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey"},{"inlineContent":[{"text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" string to the list of External Accessories.","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Select your project.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select your application target.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not present add the ","type":"text"},{"code":"Supported external accessory protocols","type":"codeVoice"},{"text":" key and insert the string ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" in its list.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"identifier":"external-accessory.png","type":"image"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for ","type":"text"},{"code":"Supported external accessory protocols","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework.","type":"text"}]}],"style":"note","name":"Note"},{"text":"Making Your First Connection","level":2,"type":"heading","anchor":"Making-Your-First-Connection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device."}]},{"text":"Understanding Connection Types","level":3,"type":"heading","anchor":"Understanding-Connection-Types"},{"type":"paragraph","inlineContent":[{"text":"YubiKit provides the following connection methods:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"NFC"}]},{"type":"text","text":": Short-range wireless communication (iOS only)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"USB"}],"type":"strong"},{"text":": Direct USB connection via SmartCard interface","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Lightning"}]},{"type":"text","text":": YubiKey 5Ci connected to Lightning port (iOS only)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"USB HID"}]},{"text":": Direct access to the FIDO or OTP interface (macOS only)","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Each connection type works differently, so let’s explore how to use them.","type":"text"}]},{"text":"NFC Connections","level":3,"type":"heading","anchor":"NFC-Connections"},{"type":"paragraph","inlineContent":[{"text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:","type":"text"}]},{"code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete.","type":"text"}]},{"text":"USB and Lightning Connections","anchor":"USB-and-Lightning-Connections","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:","type":"text"}]},{"code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"WiredSmartCardConnection.makeConnection()","type":"codeVoice"},{"text":" method automatically detects whether you’re using USB or Lightning.","type":"text"}]},{"text":"Specific Connection Types","anchor":"Specific-Connection-Types","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"For more control, you can connect to specific interfaces:","type":"text"}]},{"code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"On macOS, use ","type":"text"},{"code":"HIDOTPConnection","type":"codeVoice"},{"type":"text","text":" for the OTP keyboard interface or "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the FIDO interface:"}]},{"code":["let otpConnection = try await HIDOTPConnection()"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Understanding-Connection-Lifecycle","level":2,"text":"Understanding Connection Lifecycle"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Critical:","type":"text"}],"type":"strong"},{"text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time.","type":"text"}]},{"type":"heading","anchor":"Connection-Behavior","level":3,"text":"Connection Behavior"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Exclusive access","type":"text"}]},{"type":"text","text":": Only one connection can exist per YubiKey at any time"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Manual closure required","type":"text"}]},{"text":": Dropping a connection reference does NOT automatically close it - you must call ","type":"text"},{"type":"codeVoice","code":"close()"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Resource blocking"}]},{"text":": An unclosed connection prevents new connections (throws ","type":"text"},{"code":"SmartCardConnectionError.busy","type":"codeVoice"},{"text":")","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call "},{"type":"codeVoice","code":"close()"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Working-with-Sessions","level":2,"text":"Working with Sessions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once you have a connection, create sessions to access different YubiKey applications:"}]},{"type":"heading","anchor":"OATH-Session-TOTPHOTP-codes","level":3,"text":"OATH Session (TOTP\/HOTP codes)"},{"type":"codeListing","syntax":"swift","code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"]},{"type":"heading","anchor":"Yubico-OTP-Session-OTP-slots","level":3,"text":"Yubico OTP Session (OTP slots)"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","isActive":true},{"type":"text","text":" manages the two OTP slots. Create it with a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","isActive":true},{"type":"text","text":" or,"},{"type":"text","text":" "},{"type":"text","text":"on macOS, an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OTPConnection"},{"type":"text","text":":"}]},{"code":["let session = try await YubiOTP.Session.makeSession(connection: connection)","let state = await session.configState","print(\"Slot 2 configured: \\(try state.isConfigured(.two))\")","","\/\/ Program slot 2 for HOTP, replacing its existing configuration","try await session.putConfiguration(.hotp(key: secret), in: .two)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","type":"reference"},{"text":" for HMAC-SHA1 challenge-response, transport support, and NFC output.","type":"text"}]},{"type":"heading","level":3,"text":"PIV Session (Certificates and keys)","anchor":"PIV-Session-Certificates-and-keys"},{"type":"codeListing","syntax":"swift","code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"]},{"type":"heading","anchor":"Management-Session-Device-information","level":3,"text":"Management Session (Device information)"},{"type":"codeListing","syntax":"swift","code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"]},{"type":"heading","anchor":"WebAuthn-Client-FIDO2--passkeys","level":3,"text":"WebAuthn Client (FIDO2 \/ passkeys)"},{"type":"paragraph","inlineContent":[{"text":"For passkey registration and authentication, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"type":"text","text":" wraps a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" (USB HID on macOS) or any "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection"},{"type":"text","text":" "},{"type":"text","text":"(NFC \/ USB CCID)."}]},{"type":"codeListing","syntax":"swift","code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"PIN and UV are supplied per ceremony via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization"},{"type":"text","text":". For raw"},{"type":"text","text":" "},{"type":"text","text":"CTAP2 access (credential management, bio enrollment, large blobs), use"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":" directly."}]},{"type":"heading","anchor":"Connection-Management-Patterns","level":2,"text":"Connection Management Patterns"},{"type":"heading","anchor":"For-UI-Applications","level":3,"text":"For UI Applications"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode"},{"type":"text","text":" for complete examples of reactive connection management patterns that automatically update your UI when YubiKeys are plugged in or removed."}]},{"type":"heading","anchor":"For-Command-Line-Tools","level":3,"text":"For Command-Line Tools"},{"type":"paragraph","inlineContent":[{"type":"text","text":"CLI applications often use a simpler approach with a single connection per operation. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"},{"type":"text","text":" for examples of how command-line tools handle connections for one-time operations."}]},{"type":"heading","anchor":"Next-Steps","level":2,"text":"Next Steps"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Now you’re ready to build YubiKey applications! Check out the sample projects to see complete implementations:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"OATHSample"}],"type":"strong"},{"text":": Shows how to build a TOTP authenticator app with SwiftUI","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"PIVTool"}],"type":"strong"},{"text":": Demonstrates PIV operations for certificates and digital signatures","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"WebAuthnInterceptorSample"}],"type":"strong"},{"type":"text","text":": Routes WebAuthn calls from a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" through "},{"type":"reference","isActive":true,"
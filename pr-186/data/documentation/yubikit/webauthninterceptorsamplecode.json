hnMessage(name: message.name, data: data, generation: generation)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shutdown()"},{"text":" is called from ","type":"text"},{"type":"codeVoice","code":"dismantle{UI,NS}View"},{"text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle.","type":"text"}]},{"type":"heading","anchor":"Driving-the-Ceremony","level":2,"text":"Driving the Ceremony"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"text":" is intentionally tiny — it decodes the envelope, builds a typed ","type":"text"},{"type":"codeVoice","code":"Origin"},{"text":", and delegates to ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"handleGet"},{"text":" is the symmetric counterpart that decodes ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options"},{"text":" and calls ","type":"text"},{"type":"codeVoice","code":"fidoUI.getAssertion"},{"text":". The response JSON produced by ","type":"text"},{"type":"codeVoice","code":"toJSON()"},{"text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to ","type":"text"},{"type":"codeVoice","code":"ArrayBuffer"},{"text":" when it materializes the credential.","type":"text"}]},{"type":"heading","anchor":"Returning-the-Response-to-JavaScript","level":2,"text":"Returning the Response to JavaScript"},{"type":"paragraph","inlineContent":[{"text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"]},{"type":"paragraph","inlineContent":[{"text":"JavaScript decodes the JSON and rebuilds a ","type":"text"},{"type":"codeVoice","code":"PublicKeyCredential"},{"text":"-shaped object — converting the base64url binary fields back to ","type":"text"},{"type":"codeVoice","code":"ArrayBuffer"},{"text":"s and wiring up ","type":"text"},{"type":"codeVoice","code":"getClientExtensionResults"},{"text":", ","type":"text"},{"type":"codeVoice","code":"getAuthenticatorData"},{"text":", ","type":"text"},{"type":"codeVoice","code":"getPublicKey"},{"text":", ","type":"text"},{"type":"codeVoice","code":"toJSON"},{"text":", and the rest. Errors travel through a parallel ","type":"text"},{"type":"codeVoice","code":"__webauthn_error__"},{"text":" channel and surface to the page as a ","type":"text"},{"type":"codeVoice","code":"DOMException"},{"text":" with name ","type":"text"},{"type":"codeVoice","code":"NotAllowedError"},{"text":".","type":"text"}]},{"type":"heading","anchor":"The-FidoUI-Module","level":2,"text":"The FidoUI Module"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.*"},{"text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Transport selection."}]},{"type":"text","text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Ceremony serialization.","type":"text"}]},{"text":" Concurrent calls on the same ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Cancellation.","type":"text"}]},{"type":"text","text":" A single "},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The host code only needs to construct one "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" instance and call "},{"type":"codeVoice","code":"makeCredential"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"getAssertion"},{"text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See ","type":"text"},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/"},{"type":"text","text":" for the full source."}]},{"anchor":"Platform-Notes","level":2,"text":"Platform Notes","type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS."}]},{"type":"text","text":" The wired path goes through CryptoTokenKit ("},{"type":"codeVoice","code":"WiredSmartCardConnection"},{"type":"text","text":" — USB-C or Lightning), and the NFC path through "},{"type":"codeVoice","code":"NFCSmartCardConnection"},{"type":"text","text":". The sample’s "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"NFCReaderUsageDescription"},{"type":"text","text":" and lists the FIDO applet AID ("},{"type":"codeVoice","code":"A0000006472F0001"},{"type":"text","text":") under "},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers"},{"text":"; the entitlements turn on ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.formats"},{"text":" (","type":"text"},{"type":"codeVoice","code":"TAG"},{"text":") and ","type":"text"},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"macOS."}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" uses "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"com.apple.security.device.usb","type":"codeVoice"},{"text":" so the same target builds cleanly for both platforms.","type":"text"}]}]}]},{"text":"Where to Customize","anchor":"Where-to-Customize","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Which requests get intercepted."}]},{"type":"text","text":" Edit "},{"type":"codeVoice","code":"shouldIntercept"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" to scope by hint, RP ID, or any other heuristic."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Origin verification.","type":"text"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"WebAuthnHandler"},{"text":" builds a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference"},{"text":" from ","type":"text"},{"code":"window.location.origin","type":"codeVoice"},{"text":". Replace the ","type":"text"},{"code":"isPublicSuffix","type":"codeVoice"},{"text":" closure passed to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" with a real public-suffix-list check before shipping.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"UI."}]},{"type":"text","text":" Swap or restyle the panels in "},{"type":"codeVoice","code":"FidoUI\/Sources\/FidoUI\/Views\/"},{"type":"text","text":" — the rest of the module is UI-agnostic."}]}]}]}]}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"This sample shows how to build a FIDO2\/WebAuthn client tha
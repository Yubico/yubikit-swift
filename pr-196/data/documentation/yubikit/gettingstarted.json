ence.","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select an iOS target to include NFC and Lightning connections, or a macOS target to include"},{"type":"text","text":" "},{"type":"text","text":"USB HID connections."}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"}],"kind":"content"}],"sections":[],"metadata":{"modules":[{"name":"YubiKit"}],"roleHeading":"Article","role":"article","title":"Getting Started"},"seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"generated":true,"anchor":"Preparing-your-project","title":"Preparing your project"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSampleCode":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","kind":"article","title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","abstract":[{"type":"text","text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","isActive":true},{"type":"text","text":" to retrieve authentication codes, and "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","isActive":true},{"type":"text","text":" to get device information."}],"type":"topic","role":"sampleCode","url":"\/documentation\/yubikit\/oathsamplecode"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"kind":"symbol","url":"\/documentation\/yubikit\/webauthn\/client",
:"specification."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A passkey client and the W3C Web Authentication data model, mediated by a YubiKey."}]},{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"WebAuthn","type":"codeVoice"},{"text":" namespace provides a high-level passkey client (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":") that runs","type":"text"},{"text":" ","type":"text"},{"isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Web Authentication Level 3"}],"overridingTitle":"Web Authentication Level 3","type":"reference","identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/"},{"text":" ceremonies against a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"YubiKey, plus the request and response types defined by the WebAuthn specification."}]},{"type":"paragraph","inlineContent":[{"text":"A WebAuthn ceremony involves three parties: the ","type":"text"},{"inlineContent":[{"text":"authenticator","type":"text"}],"type":"strong"},{"type":"text","text":" (a YubiKey), the"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"client","type":"text"}]},{"type":"text","text":" (your app, via "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"type":"text","text":"), and the "},{"inlineContent":[{"type":"text","text":"relying party"}],"type":"strong"},{"type":"text","text":" (your server, which"},{"type":"text","text":" "},{"type":"text","text":"verifies what the authenticator returns). The client is the communication path between"},{"type":"text","text":" "},{"type":"text","text":"authenticator and relying party — and it verifies the relying party’s identity against"},{"type":"text","text":" "},{"type":"text","text":"the origin it’s bound to, so it can refuse to sign for a fraudulent site."}]},{"inlineContent":[{"type":"text","text":"There are two ceremonies. "},{"inlineContent":[{"text":"Registration","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","isActive":true,"type":"reference"},{"text":") creates a new credential and supplies its","type":"text"},{"text":" ","type":"text"},{"text":"public key to the relying party for account association. ","type":"text"},{"inlineContent":[{"text":"Authentication","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","type":"reference","isActive":true},{"text":") proves to the relying party that the","type":"text"},{"text":" ","type":"text"},{"text":"YubiKey is the one registered for the user. Both ceremonies follow the same mechanical","type":"text"},{"text":" ","type":"text"},{"text":"shape: the relying party supplies a challenge, the authenticator signs it together","type":"text"},{"type":"text","text":" "},{"type":"text","text":"with the relying-party identifier, and the signature goes back to the relying party"},{"type":"text","text":" "},{"type":"text","text":"for verification."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The pieces fit together as: a connection carries CTAP2 traffic, a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"type":"text","text":" "},{"type":"text","text":"sits on top, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"type":"text","text":" runs ceremonies on that session. Connections come in"},{"type":"text","text":" "},{"type":"text","text":"three flavours that all work for WebAuthn: "},{"type":"codeVoice","code":"YubiKit\/HIDFIDOConnection"},{"type":"text","text":" on macOS,"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection"},{"type":"text","text":" for tap-to-auth on iOS, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/USBSmartCardConnection"},{"type":"text","text":" on either platform. Pick the one that matches"},{"type":"text","text":" "},{"type":"text","text":"your platform and form factor."}],"type":"paragraph"},{"code":["\/\/ macOS — USB HID FIDO","let connection = try await HIDFIDOConnection()","\/\/ iOS — tap-to-auth over NFC:","\/\/ let connection = try await NFCSmartCardConnection()","","let session = try await CTAP2.Session.makeSession(connection: connection)","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","\/\/ Register a new passkey","let registration = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value","","\/\/ Authenticate","let assertions = try await client.getAssertion(","    .init(challenge: challenge, rpId: \"example.com\"),","    authorization: .pin(\"1234\")",").value"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Most apps start with ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":". For lower-level CTAP2 access — raw ","type":"text"},{"type":"codeVoice","code":"makeCredential"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"getAssertion"},{"text":", credential management, bio enrollment — use ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true,"type":"reference"},{"text":" directly.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"title":"WebAuthn Client","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"],"generated":true,"anchor":"WebAuthn-Client"}],"metadata":{"roleHeading":"Enumeration","symbolKind":"enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"WebAuthn"}],"externalID":"s:7YubiKit8WebAuthnO","title":"WebAuthn","role":"symbol","modules":[{"name":"YubiKit"}],"navigatorTitle":[{"kind":"identifier","text":"WebAuthn"}]},"variants":[{"paths":["\/documentation\/yubikit\/webauthn"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"sections":[],"abstract":[{"type":"text","text":"WebAuthn (Web Authentication) namespace."}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/AttestedCredentialData":{"url":"\/documentation\/yubikit\/webauthn\/attestedcredentialdata","abstract":[{"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/#sctn-attested-credential-data","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"included in authenticator data during credential creation.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AttestedCredentialData","kind":"identifier"}],"navigatorTitle":[{"text":"AttestedCredentialData","kind":"identifier"}],"title":"WebAuthn.AttestedCredentialData","role":"symbol","identifier":"doc:\/\/yub
{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Prepare your project to connect to the YubiKey via NFC, SmartCard, Lightning and USB HID."}],"variants":[{"paths":["\/documentation\/yubikit\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Preparing your project","anchor":"Preparing-your-project","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"generated":true}],"kind":"article","metadata":{"role":"article","title":"Getting Started","modules":[{"name":"YubiKit"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The YubiKit framework is distributed using the Swift Package Manager. To add the framework to your project follow these steps:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your project."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the “Package Dependencies” tab."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Press the plus-button to bring up the add package dialog."}]}]}]},{"inlineContent":[{"identifier":"add-framework-1.png","type":"image"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Enter "},{"type":"codeVoice","code":"https:\/\/github.com\/Yubico\/yubikit-swift\/"},{"type":"text","text":" in the search field and select the Yubico Swift Package."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Press the “Add Package” button to add the SDK to your project.","type":"text"}]}]}],"start":4,"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"add-framework-2.png"}],"type":"paragraph"},{"anchor":"NFC","type":"heading","level":3,"text":"NFC"},{"inlineContent":[{"text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC","type":"text"},{"text":" ","type":"text"},{"text":"application identifiers and a NFC Privacy statement to the application.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Add Wireless entitlement","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Select your project.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your application target."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Choose the “Signing & Capabilities” tab."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Click the “+”-button to add a new capability."}]}]},{"content":[{"inlineContent":[{"text":"Select the “Near Field Communication Tag” capability.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"nfc-entitlement.png"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Add list of NFC application identifiers"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”.","type":"text"}]}]}],"type":"orderedList","start":6},{"inlineContent":[{"identifier":"nfc-identifiers.png","type":"image"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the Yubico NFC application identifiers to enable communication with the different","type":"text"},{"text":" ","type":"text"},{"text":"applications on the YubiKey.","type":"text"}]}]}],"type":"orderedList","start":8},{"syntax":null,"code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"],"type":"codeListing"},{"inlineContent":[{"type":"image","identifier":"nfc-identifiers-list.png"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Add a NFC Privacy description"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in"},{"type":"text","text":" "},{"text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”","type":"text"}]}]}],"type":"orderedList","start":9},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-privacy.png"}]},{"anchor":"SmartCardUSB","type":"heading","level":3,"text":"SmartCard\/USB"},{"type":"paragraph","inlineContent":[{"text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the","type":"text"},{"text":" ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" entitlement to your application.","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the application entitlements file.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" entitlement to the entitlement list."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"smart-card.png"}]},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"text":"USB SmartCard supports Yubico OTP slot programming. HMAC-SHA1 challenge-response requires","type":"text"},{"text":" ","type":"text"},{"code":"HIDOTPConnection","type":"codeVoice"},{"text":" on macOS, ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LightningSmartCardConnection","type":"reference","isActive":true},{"text":", or NFC without a touch requirement.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey","type":"heading","level":3,"text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey"},{"type":"paragraph","inlineContent":[{"text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"type":"text","text":" string to the list of External Accessories."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your project."}]}]},{"content":[{"inlineContent":[{"text":"Select your application target.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the “Info” tab."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If not present add the "},{"code":"Supported external accessory protocols","type":"codeVoice"},{"type":"text","text":" key and insert the string "},{"code":"com.yubico.ylp","type":"codeVoice"},{"type":"text","text":" in its list."}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"identifier":"external-accessory.png","type":"image"}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for "},{"type":"codeVoice","code":"Supported external accessory protocols"},{"type":"text","text":" to "},{"type":"codeVoice","code":"com.yubico.ylp"},{"type":"text","text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework."}]}]},{"level":2,"type":"heading","anchor":"Making-Your-First-Connection","text":"Making Your First Connection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device."}]},{"level":3,"type":"heading","anchor":"Understanding-Connection-Types","text":"Understanding Connection Types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit provides the following connection methods:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"NFC","type":"text"}]},{"type":"text","text":": Short-range wireless communication (iOS only)"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"USB"}]},{"type":"text","text":": Direct USB connection via SmartCard interface"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Lightning"}]},{"text":": YubiKey 5Ci connected to Lightning port (iOS only)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"USB HID"}],"type":"strong"},{"text":": Direct access to the FIDO or OTP interface (macOS only)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Each connection type works differently, so let’s explore how to use them.","type":"text"}]},{"type":"heading","text":"NFC Connections","anchor":"NFC-Connections","level":3},{"type":"paragraph","inlineContent":[{"text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete."}]},{"type":"heading","text":"USB and Lightning Connections","anchor":"USB-and-Lightning-Connections","level":3},{"type":"paragraph","inlineContent":[{"text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"WiredSmartCardConnection.makeConnection()"},{"type":"text","text":" method automatically detects whether you’re using USB or Lightning."}]},{"type":"heading","text":"Specific Connection Types","anchor":"Specific-Connection-Types","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more control, you can connect to specific interfaces:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"]},{"type":"paragraph","inlineContent":[{"text":"On macOS, use ","type":"text"},{"type":"codeVoice","code":"HIDOTPConnection"},{"text":" for the OTP keyboard interface or ","type":"text"},{"type":"codeVoice","code":"HIDFIDOConnection"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"the FIDO interface:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let otpConnection = try await HIDOTPConnection()"]},{"type":"heading","text":"Understanding Connection Lifecycle","anchor":"Understanding-Connection-Lifecycle","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Critical:","type":"text"}]},{"type":"text","text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time."}]},{"type":"heading","text":"Connection Behavior","anchor":"Connection-Behavior","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Exclusive access","type":"text"}],"type":"strong"},{"text":": Only one connection can exist per YubiKey at any time","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Manual closure required","type":"text"}],"type":"strong"},{"type":"text","text":": Dropping a connection reference does NOT automatically close it - you must call "},{"code":"close()","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Resource blocking","type":"text"}],"type":"strong"},{"type":"text","text":": An unclosed connection prevents new connections (throws "},{"type":"codeVoice","code":"SmartCardConnectionError.busy"},{"type":"text","text":")"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call ","type":"text"},{"code":"close()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Working with Sessions","level":2,"anchor":"Working-with-Sessions","type":"heading"},{"inlineContent":[{"text":"Once you have a connection, create sessions to access different YubiKey applications:","type":"text"}],"type":"paragraph"},{"text":"OATH Session (TOTP\/HOTP codes)","level":3,"anchor":"OATH-Session-TOTPHOTP-codes","type":"heading"},{"syntax":"swift","code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"],"type":"codeListing"},{"text":"Yubico OTP Session (OTP slots)","level":3,"anchor":"Yubico-OTP-Session-OTP-slots","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session"},{"text":" manages the two OTP slots. Create it with a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection"},{"text":" or,","type":"text"},{"text":" ","type":"text"},{"text":"on macOS, an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OTPConnection"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let session = try await YubiOTP.Session.makeSession(connection: connection)","let state = await session.configState","print(\"Slot 2 configured: \\(try state.isConfigured(.two))\")","","\/\/ Program slot 2 for HOTP, replacing its existing configuration","try await session.putConfiguration(.hotp(key: secret), in: .two)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session"},{"type":"text","text":" for HMAC-SHA1 challenge-response, transport support, and NFC output."}],"type":"paragraph"},{"text":"PIV Session (Certificates and keys)","level":3,"anchor":"PIV-Session-Certificates-and-keys","type":"heading"},{"syntax":"swift","code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"],"type":"codeListing"},{"text":"Management Session (Device information)","level":3,"anchor":"Management-Session-Device-information","type":"heading"},{"syntax":"swift","code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"],"type":"codeListing"},{"text":"WebAuthn Client (FIDO2 \/ passkeys)","level":3,"anchor":"WebAuthn-Client-FIDO2--passkeys","type":"heading"},{"inlineContent":[{"text":"For passkey registration and authentication, ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" wraps a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"code":"HIDFIDOConnection","type":"codeVoice"},{"text":" (USB HID on macOS) or any ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"(NFC \/ USB CCID).","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"PIN and UV are supplied per ceremony via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization"},{"type":"text","text":". For raw"},{"type":"text","text":" "},{"type":"text","text":"CTAP2 access (credential management, bio enrollment, large blobs), use"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":" directly."}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Connection-Management-Patterns","text":"Connection Management Patterns"},{"type":"heading","level":3,"anchor":"For-UI-Applications","text":"For UI Applications"},{"inlineContent":[{"text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","isActive":true,"type":"reference"},{"text":" for complete examples of reactive connection management patterns that automatically update your UI when YubiKeys are plugged in or removed.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"For-Command-Line-Tools","text":"For Command-Line Tools"},{"inlineContent":[{"text":"CLI applications often use a simpler approach with a single connection per operation. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"},{"text":" for examples of how command-line tools handle connections for one-time operations.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Next-Steps","text":"Next Steps"},{"inlineContent":[{"type":"text","text":"Now you’re ready to build YubiKey applications! Check out the sample projects to see complete implementations:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"OATHSample"}],"type":"strong"},{"type":"text","text":": Shows how to build a TOTP authenticator app with SwiftUI"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"PIVTool","type":"text"}]},{"type":"text","text":": Demonstrates PIV operations for certificates and digital signatures"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"WebAuthnInterceptorSample","type":"text"}],"type":"strong"},{"text":": Routes WebAuthn calls from a ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":" through ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":" to a YubiKey","type":"text"}]}]}]},{"anchor":"Build-SDK-documentation","text":"Build SDK documentation","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also build the complete SDK documentation by selecting “Product” -> “Build Documentation” in Xcode. This gives you access to the full YubiKit API reference."}]},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select an iOS target to include NFC and Lightning connections, or a macOS target to include"},{"type":"text","text":" "},{"type":"text","text":"USB HID connections."}]}],"type":"aside","style":"note"}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted"},"references":{"nfc-identifiers.png":{"type":"image","alt":"An image showing how to add the nfc application identifiers.","identifier":"nfc-identifiers.png","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers~dark@2x.png"}]},"documentation-header.png":{"type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png"}],"alt":"YubiKeys in a row","identifier":"documentation-header.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logs":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Configures logging for YubiKit connections and sessions."}],"navigatorTitle":[{"kind":"identifier","text":"Logs"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs","role":"symbol","title":"Logs","url":"\/documentation\/yubikit\/logs","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identi
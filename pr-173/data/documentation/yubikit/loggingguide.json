ype":"text","text":"Add "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/apple\/swift-log"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"Logging"},{"type":"text","text":" product to your app target"},{"type":"text","text":" "},{"type":"text","text":"to use its backend types. Any SwiftLog "},{"type":"codeVoice","code":"LogHandler"},{"type":"text","text":" can be supplied by the factory."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;"},{"type":"text","text":" "},{"type":"text","text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,"},{"type":"text","text":" "},{"type":"text","text":"though logs already in progress may use the previous settings."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,"},{"type":"text","text":" "},{"type":"text","text":"pass its factory explicitly; global "},{"type":"codeVoice","code":"LoggingSystem.bootstrap"},{"type":"text","text":" does not select YubiKit’s backend."},{"type":"text","text":" "},{"type":"text","text":"Factories may run concurrently and must not log through YubiKit themselves."}]},{"level":3,"type":"heading","text":"Traffic logging","anchor":"Traffic-logging"},{"type":"codeListing","code":["YubiKit.Logs.configure(logLevel: .trace)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Raw traffic and SCP plaintext logs require "},{"inlineContent":[{"type":"text","text":"YubiKit to be compiled with "},{"type":"codeVoice","code":"DEBUG"}],"type":"strong"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"Neither configuration nor a custom backend can enable them in other builds.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Custom connections are responsible for their own traffic logging."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Debug logs can include account names and credential identifiers."},{"type":"text","text":" "},{"text":"Trace logs can include PINs, credentials, and cryptographic keys. Protect or redact logs before sharing them.","type":"text"}]}],"name":"Warning","style":"warning"},{"type":"heading","level":3,"text":"Custom backends","anchor":"Custom-backends"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Labels identify categories, such as "},{"type":"codeVoice","code":"com.yubico.YubiKit.OATH"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"com.yubico.YubiKit.FIDO"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Metadata carries details such as byte counts and error codes; the default backend displays"},{"type":"text","text":" "},{"text":"these as ","type":"text"},{"type":"codeVoice","code":"key=value"},{"type":"text","text":" pairs. Message wording and metadata keys are not a stable API."}]},{"inlineContent":[{"type":"text","text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","sections":[],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logs":{"kind":"symbol","url":"\/documentation\/yubikit\/logs","title":"Logs","role":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Logs"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Logs"}],"abstract":[{"text":"Configures logging for YubiKit connections and sessions.","type":"text"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/GettingStarted":{"kind":"article","url":"\/documentation\/yubikit\/gettingstarted","title":"Getting Started","role":"article","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Gett
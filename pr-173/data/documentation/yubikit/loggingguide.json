{"abstract":[{"text":"Choose YubiKit’s log level and backend with ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"No setup is required. YubiKit defaults to ","type":"text"},{"type":"codeVoice","code":"debug"},{"text":" on stdout when compiled with ","type":"text"},{"type":"codeVoice","code":"DEBUG"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"type":"codeVoice","code":"info"},{"text":" on stderr otherwise. You can override either default:","type":"text"}],"type":"paragraph"},{"code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","YubiKit.Logs.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","YubiKit.Logs.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","YubiKit.Logs.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","YubiKit.Logs.configure()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Add ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-log","isActive":true},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"Logging"},{"text":" product to your app target","type":"text"},{"text":" ","type":"text"},{"text":"to use its backend types. Any SwiftLog ","type":"text"},{"type":"codeVoice","code":"LogHandler"},{"text":" can be supplied by the factory.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;","type":"text"},{"text":" ","type":"text"},{"text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,","type":"text"},{"text":" ","type":"text"},{"text":"though logs already in progress may use the previous settings.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,","type":"text"},{"text":" ","type":"text"},{"text":"pass its factory explicitly; global ","type":"text"},{"type":"codeVoice","code":"LoggingSystem.bootstrap"},{"text":" does not select YubiKit’s backend.","type":"text"},{"text":" ","type":"text"},{"text":"Factories may run concurrently and must not log through YubiKit themselves.","type":"text"}],"type":"paragraph"},{"text":"Traffic logging","type":"heading","level":3,"anchor":"Traffic-logging"},{"type":"codeListing","syntax":"swift","code":["YubiKit.Logs.configure(logLevel: .trace)"]},{"inlineContent":[{"type":"text","text":"Raw traffic and SCP plaintext logs require "},{"type":"strong","inlineContent":[{"text":"YubiKit to be compiled with ","type":"text"},{"type":"codeVoice","code":"DEBUG"}]},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Neither configuration nor a custom backend can enable them in other builds.","type":"text"},{"text":" ","type":"text"},{"text":"Custom connections are responsible for their own traffic logging.","type":"text"}],"type":"paragraph"},{"type":"aside","content":[{"inlineContent":[{"text":"Debug logs can include account names and credential identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Trace logs can include PINs, credentials, and cryptographic keys. Protect or redact logs before sharing them.","type":"text"}],"type":"paragraph"}],"name":"Warning","style":"warning"},{"level":3,"type":"heading","text":"Custom backends","anchor":"Custom-backends"},{"inlineContent":[{"text":"Labels identify categories, such as ","type":"text"},{"type":"codeVoice","code":"com.yubico.YubiKit.OATH"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"com.yubico.YubiKit.FIDO"},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Metadata carries details such as byte counts and error codes; the default backend displays"},{"type":"text","text":" "},{"type":"text","text":"these as "},{"type":"codeVoice","code":"key=value"},{"type":"text","text":" pairs. Message wording and metadata keys are not a stable API."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"article","title":"Logging","roleHeading":"Article","modules":[{"name":"YubiKit"}]},"kind":"article","identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"anchor":"Preparing-your-project","title":"Preparing your project"}],"variants":[{"paths":["\/documentation\/yubikit\/loggingguide"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"documentation-header.png":{"variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}],"alt":"YubiKeys in a row","type":"image","identifier":"documentation-header.png"},"https://github.com/apple/swift-log":{"titleInlineContent":[{"type":"text","text":"SwiftLog"}],"type":"link","identifier":"https:\/\/github.com\/apple\/swift-log","title":"SwiftLog","url":"https:\/\/github.com\/apple\/swift-log"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"abstract":[{"text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning a
verview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"This extension allows a relying party to derive symmetric keys from a credential"},{"type":"text","text":" "},{"type":"text","text":"using HMAC-SHA-256 with user-provided salts. The derived keys can be used for"},{"type":"text","text":" "},{"type":"text","text":"encryption or other cryptographic operations."}],"type":"paragraph"},{"type":"heading","level":2,"text":"MakeCredential Usage","anchor":"MakeCredential-Usage"},{"inlineContent":[{"type":"text","text":"Request hmac-secret support when creating a credential:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let hmacSecret = CTAP2.Extension.HmacSecret()","let ext = hmacSecret.makeCredential.input()","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    \/\/ hmac-secret is enabled","}"]},{"type":"paragraph","inlineContent":[{"text":"Or derive secrets at registration time (CTAP 2.2 hmac-secret-mc):","type":"text"}]},{"code":["let hmacSecret = try await CTAP2.Extension.HmacSecret(session: session)","let ext = try hmacSecret.makeCredential.input(salt1: salt, salt2: salt2)","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    switch result {","    case .enabled:","        \/\/ hmac-secret-mc not supported, but hmac-secret is enabled","    case .secrets(let secrets):","        \/\/ Use derived keys (secrets.first, secrets.second)","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"GetAssertion-Usage","type":"heading","text":"GetAssertion Usage","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Derive keys during authentication:"}]},{"code":["let hmacSecret = try await CTAP2.Extension.HmacSecre
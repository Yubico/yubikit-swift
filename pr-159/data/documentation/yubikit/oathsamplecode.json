{"sections":[],"metadata":{"role":"sampleCode","modules":[{"name":"YubiKit"}],"title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","color":{"standardColorIdentifier":"green"},"roleHeading":"Sample Code"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/oathsamplecode"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"reference"},{"text":" to retrieve authentication codes, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},{"text":" to get device information.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The sample creates an authenticator app that:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Establishes connections to YubiKeys via USB, Lightning, or NFC","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Manages connection lifecycle (detecting plugged\/unplugged devices)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Lists TOTP codes stored on the YubiKey","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Shows device information like firmware version","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Handles connection errors and user cancellations gracefully","type":"text"}]}]}]},{"inlineContent":[{"text":"This sample focuses on read-only operations and doesn’t handle password-protected YubiKeys or credential management.","type":"text"}],"type":"paragraph"},{"text":"Connection Management","anchor":"Connection-Management","type":"heading","level":2},{"text":"Handling Wired Connections","anchor":"Handling-Wired-Connections","type":"heading","level":3},{"inlineContent":[{"text":"The app uses a ","type":"text"},{"code":"ConnectionManager","type":"codeVoice"},{"type":"text","text":" to handle persistent connections to plugged-in YubiKeys. This approach ensures your app stays responsive when users plug and unplug their YubiKeys:"}],"type":"paragraph"},{"code":["private func startWiredConnection() {","    wiredConnectionTask = Task { @MainActor in","        while !Task.isCancelled {","            do {","                let newConnection = try await WiredSmartCardConnection.makeConnection()","                wiredConnection = newConnection","","                \/\/ Wait for disconnect","                let closeError = await newConnection.waitUntilClosed()","                wiredConnection = nil","            } catch {","                self.error = error","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The key insight here is using "},{"code":"waitUntilClosed()","type":"codeVoice"},{"type":"text","text":" to detect when the YubiKey is unplugged, then automatically waiting for the next connection."}]},{"text":"NFC Connections","anchor":"NFC-Connections","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"NFC connections work differently - they’re initiated by user action and are short-lived:"}]},{"code":["func requestNFCConnection() async {","    do {","        nfcConnection = try await NFCSmartCardConnection()","    } catch {","        self.error = error","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When an NFC connection is established, the app fetches data and immediately closes it with a user message:"}]},{"type":"codeListing","syntax":"swift","code":["Task {","    await model.update(using: connection)","    await connection.close(message: \"Codes calculated\")","}"]},{"text":"Working with YubiKey Data","level":2,"type":"heading","anchor":"Working-with-YubiKey-Data"},{"text":"Reading OATH Codes","level":3,"type":"heading","anchor":"Reading-OATH-Codes"},{"inlineContent":[{"type":"text","text":"Once you have a connection, getting TOTP codes is straightforward:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["private func calculateCodes(using connection: SmartCardConnection) async {","    do {","        let session = try await OATHSession.makeSession(connection: connection)","        let result = try await session.calculateCredentialCodes()","        accounts = result.map { credential, code in","            Account(","                label: credential.label,","                code: code?.code,","                issuer: credential.issuer,","                type: credential.type","            )","        }","    } catch {","        self.error = error","    }","}"]},{"inlineContent":[{"type":"text","text":"The "},{"code":"calculateCredentialCodes()","type":"codeVoice"},{"text":" method returns a dictionary mapping credentials to their current codes. Some codes might be ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if they require touch or are password-protected.","type":"text"}],"type":"paragraph"},{"text":"Getting Device Information","level":3,"type":"heading","anchor":"Getting-Device-Information"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"Management.Session","type":"codeVoice"},{"text":" to get YubiKey information:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["private func getKeyVersion(using connection: SmartCardConnection) async {","    do {","        let session: Management.Session = try await .makeSession(connection: connection)","        self.keyVersion = await session.version.description","    } catch {","        self.error = error","    }","}"]},{"inlineContent":[{"text":"The ","type":"text"},{"code":"Model","type":"codeVoice"},{"text":" class combines both operations in a single ","type":"text"},{"code":"update","type":"codeVoice"},{"text":" method:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func update(using connection: SmartCardConnection) async {","    await calculateCodes(using: connection)","    await getKeyVersion(using: connection)","    connectionType = connection.connectionType","}"]},{"text":"SwiftUI Integration","level":2,"type":"heading","anchor":"SwiftUI-Integration"},{"text":"Reacting to Connection Changes","level":3,"type":"heading","anchor":"Reacting-to-Connection-Changes"},{"inlineContent":[{"text":"The app uses SwiftUI’s ","type":"text"},{"code":"@Published","type":"codeVoice"},{"text":" properties and ","type":"text"},{"code":"onReceive","type":"codeVoice"},{"text":" to update the UI when connections change:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":[".onReceive(connectionManager.$wiredConnection) { newConnection in","    guard let connection = newConnection else {","        model.clear()  \/\/ Clear UI when YubiKey unplugged","        return","    }","    Task { await model.update(using: connection) }","}"]},{"inlineContent":[{"text":"This pattern ensures the UI immediately updates when YubiKeys are plugged in or removed.","type":"text"}],"type":"paragraph"},{"text":"Platform-Specific Features","level":3,"type":"heading","anchor":"Platform-Specific-Features"},{"inlineContent":[{"text":"The app handles iOS vs macOS differences with conditional compilation:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["#if os(iOS)",".refreshable {","    await connectionManager.requestNFCConnection()","}","#endif"]},{"inlineContent":[{"type":"text","text":"iOS users can pull-to-refresh to scan with NFC, while macOS users only see USB options."}],"type":"paragraph"},{"text":"Connection Type Detection","level":3,"type":"heading","anchor":"Connection-Type-Detection"},{"inlineContent":[{"type":"text","text":"The sample includes a useful extension to identify connection types:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension SmartCardConnection {","    var connectionType: String {","        switch self {","        case _ as NFCSmartCardConnection: return \"NFC\"","        case _ as LightningSmartCardConnection: return \"Lightning\"","        case _ as USBSmartCardConnection: return \"USB\"","        default: return \"Unknown\"","        }","    }","}"]},{"inlineContent":[{"text":"This is helpful because NFC connections are slower than USB, and users like to know how their YubiKey is connected.","type":"text"}],"type":"paragraph"},{"text":"Architecture Decisions","level":2,"type":"heading","anchor":"Architecture-Decisions"},{"text":"Why the connection management works this way","level":3,"type":"heading","anchor":"Why-the-connection-management-works-this-way"},{"inlineContent":[{"text":"The sample uses a background loop that continuously waits for wired connections. This might seem unusual, but it solves a key problem: YubiKeys get plugged and unplugged frequently, but apps need to stay responsive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When you unplug your YubiKey, the app doesn’t crash or freeze - it detects the disconnection via ","type":"text"},{"code":"waitUntilClosed()","type":"codeVoice"},{"text":" and immediately starts waiting for the next YubiKey. This creates a smoother user experience where the app responds when you plug \/ unplug a YubiKey.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"NFC works differently since you can’t continuously scan - the user has to explicitly initiate each scan. That’s why NFC connections are handled separately through user actions like the scan button or pull-to-refresh.","type":"text"}],"type":"paragraph"},{"text":"Error handling for hardware connections","level":3,"type":"heading","anchor":"Error-handling-for-hardware-connections"},{"inlineContent":[{"type":"text","text":"Hardware connections are unreliable by nature. Users will unplug devices mid-operation, walk away during NFC scans, or have connectivity issues. The sample handles this gracefully:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Connection failures are caught and stored as errors","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"User cancellations (like dismissing NFC scan) are filtered out to avoid unnecessary error alerts","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Session errors are handled similarly - show the error but maintain app functionality","type":"text"}]}]}],"type":"unorderedList"},{"text":"Working with Swift actors","level":3,"type":"heading","anchor":"Working-with-Swift-actors"},{"inlineContent":[{"text":"YubiKit sessions are Swift actors that handle their own threading. The sample shows how to integrate this with SwiftUI’s main actor requirements:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ConnectionManager","type":"codeVoice"},{"text":" runs on ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" so it can directly update ","type":"text"},{"code":"@Published","type":"codeVoice"},{"text":" properties","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Session calls happen on the session’s actor, then results are passed back to update the UI","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Everything uses ","type":"text"},{"code":"async\/await","type":"codeVoice"}]}]}],"type":"unorderedList"}],"kind":"content"}],"sampleCodeDownload":{"action":{"overridingTitle":"View Source","isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample"},"kind":"sampleDownload"},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","interfaceLanguage":"swift"},"kind":"article","seeAlsoSections":[{"generated":true,"title":"Sample code","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"],"anchor":"Sample-code"}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"kind":"article","title":"PIVTool: Building PIV applications with YubiKey","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","role":"sampleCode","abstract":[{"text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","type":"reference"},{"text":" for cryptographic operations, certificate management, and access control.","type":"text"}],"url":"\/documentation\/yubikit\/pivtoolsamplecode"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"kind":"article","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","role":"sampleCode","abstract":[{"text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts ","type":"text"},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"text":" calls inside a ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" and routes them to a YubiKey. It uses the high-level ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" companion module.","type":"text"}],"url":"\/documentation\/yubikit\/webauthninterceptorsamplecode"},"https://github.com/Yubico/yubikit-swift/tree/main/Samples/OATHSample":{"checksum":null,"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","type":"download","url":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"url":"\/documentation\/yubikit\/webauthn\/client","abstract":[{"text":"Client for performing WebAuthn passkey operations.","type":"text"}],"role":"symbol","title":"WebAuthn.Client","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Client"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"type":"topic","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OATHSession","kind":"identifier"}],"url":"\/documentation\/yubikit\/oathsession","abstract":[{"text":"An interface to the OATH application on the YubiKey.","type":"text"}],"role":"symbol","title":"OATHSession","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","kind":"symbol","navigatorTitle":[{"text":"OATHSession","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"type":"topic","url":"\/documentation\/yubikit","abstract":[{"text":"Connect and run commands on the different applications on a YubiKey. The framework support connect
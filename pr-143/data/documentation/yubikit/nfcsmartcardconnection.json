{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NFCSmartCardConnection"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The  NFCSmartCardConnection is short lived and should be closed as soon as the commands sent to the YubiKey have finished processing. It is up to the user of"},{"type":"text","text":" "},{"type":"text","text":"the connection to close it when it no longer is needed. As long as the connection is open the NFC modal will cover the lower part of the iPhone screen."},{"type":"text","text":" "},{"type":"text","text":"In addition to the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/close(error:)"},{"type":"text","text":" method defined in the SmartCardConnection protocol the NFCSmartCardConnection has an additional "},{"type":"codeVoice","code":"close(success:)"},{"type":"text","text":" "},{"type":"text","text":"method that will close the connection and set the alertMessage of the NFC alert to the provided message."}]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"NFC is only supported on iPhones from iPhone 6 and forward. It will not work on iPads since there’s no NFC chip in these devices."}]}],"style":"note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"NFC connection to a YubiKey (iOS only)."}]},{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"NFCSmartCardConnection establishes a connection to a YubiKey via NFC. The connection"},{"type":"text","text":" "},{"type":"text","text":"presents the system NFC dialog and waits for the user to tap their YubiKey."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"NFC connections are short-lived due to iOS timeout constraints. Perform operations quickly"},{"type":"text","text":" "},{"type":"text","text":"and close the connection with a user-visible message."}]},{"type":"codeListing","syntax":"swift","code":["let connection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","await connection.close(message: \"Codes retrieved\")"]}]}],"variants":[{"paths":["\/documentation\/yubikit\/nfcsmartcardconnection"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:7YubiKit22NFCSmartCardConnectionV","roleHeading":"Structure","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NFCSmartCardConnection","kind":"identifier"}],"title":"NFCSmartCardConnection","modules":[{"name":"YubiKit"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"NFCSmartCardConnection"}]},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A NFC connection to the YubiKey."}],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/init()","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/init(alertMessage:)","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/setAlertMessage(_:)"],"anchor":"Creating-a-Connection","title":"Creating a Connection"},{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/close(error:)","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/close(message:)","doc:\/\/yubikit-swift.YubiKit\
":"text","text":"Labels identify categories, such as "},{"type":"codeVoice","code":"com.yubico.YubiKit.OATH"},{"type":"text","text":" or "},{"type":"codeVoice","code":"com.yubico.YubiKit.FIDO"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Metadata carries details such as byte counts and error codes; the default backend displays"},{"type":"text","text":" "},{"type":"text","text":"these as "},{"type":"codeVoice","code":"key=value"},{"type":"text","text":" pairs. Message wording and metadata keys are not a stable API."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","interfaceLanguage":"swift"},"abstract":[{"text":"Choose YubiKit’s log level and backend with ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)","isActive":true},{"text":".","type":"text"}],"metadata":{"modules":[{"name":"YubiKit"}],"roleHeading":"Article","title":"Logging","role":"article"},"sections":[],"references":{"documentation-header.png":{"alt":"YubiKeys in a row","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png"}],"identifier":"documentation-header.png","type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","type":"topic","title":"YubiKit","kind":"symbol","role":"collection","images":[{"type":"icon","identifier":"documentation-header.png"}],"url":"\/documentation\/yubikit","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting 
{"sections":[],"metadata":{"role":"article","title":"Logging","modules":[{"name":"YubiKit"}],"roleHeading":"Article"},"kind":"article","abstract":[{"text":"Choose YubiKit’s log level and backend with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)","type":"reference"},{"text":".","type":"text"}],"seeAlsoSections":[{"anchor":"Preparing-your-project","title":"Preparing your project","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"generated":true}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"variants":[{"paths":["\/documentation\/yubikit\/loggingguide"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"No setup is required. YubiKit defaults to "},{"type":"codeVoice","code":"debug"},{"type":"text","text":" on stdout when compiled with "},{"type":"codeVoice","code":"DEBUG"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"info"},{"type":"text","text":" on stderr otherwise. You can override either default:"}],"type":"paragraph"},{"code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","YubiKit.Logs.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","YubiKit.Logs.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","YubiKit.Logs.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","YubiKit.Logs.configure()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Add "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-log"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"Logging"},{"type":"text","text":" product to your app target"},{"type":"text","text":" "},{"type":"text","text":"to use its backend types. Any SwiftLog "},{"type":"codeVoice","code":"LogHandler"},{"type":"text","text":" can be supplied by the factory."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;"},{"type":"text","text":" "},{"type":"text","text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,"},{"type":"text","text":" "},{"type":"text","text":"though logs already in progress may use the previous settings."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,"},{"type":"text","text":" "},{"type":"text","text":"pass its factory explicitly; global "},{"type":"codeVoice","code":"LoggingSystem.bootstrap"},{"type":"text","text":" does not select YubiKit’s backend."},{"type":"text","text":" "},{"type":"text","text":"Factories may run concurrently and must not log through YubiKit themselves."}],"type":"paragraph"},{"anchor":"Traffic-logging","text":"Traffic logging","level":3,"type":"heading"},{"code":["YubiKit.Logs.configure(logLevel: .trace)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Raw traffic and SCP plaintext logs require "},{"type":"strong","inlineContent":[{"type":"text","text":"YubiKit to be compiled with "},{"type":"codeVoice","code":"DEBUG"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Neither configuration nor a custom backend can enable them in other builds."},{"type":"text","text":" "},{"type":"text","text":"Custom connections are responsible for their own traffic logging."}],"type":"paragraph"},{"name":"Warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Debug logs can include account names and credential identifiers."},{"type":"text","text":" "},{"type":"text","text":"Trace logs can include PINs, credentials, and cryptographic keys. Protect or redact logs before sharing them."}]}],"style":"warning","type":"aside"},{"anchor":"Custom-backends","text":"Custom backends","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Labels identify categories, such as "},{"type":"codeVoice","code":"com.yubico.YubiKit.OATH"},{"type":"text","text":" or "},{"type":"codeVoice","code":"com.yubico.YubiKit.FIDO"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Metadata carries details such as byte counts and error codes; the default backend displays"},{"type":"text","text":" "},{"type":"text","text":"these as "},{"type":"codeVoice","code":"key=value"},{"type":"text","text":" pairs. Message wording and metadata keys are not a stable API."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","type":"topic","abstract":[{"text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB.","type":"text"}],"url":"\/documentation\/yubikit","role":"collection","title":"YubiKit","images":[{"type":"icon","identifier":"documentation-header.png"}],"kind":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logs/configure(logLevel:factory:)":{"url":"\/documentation\/yubikit\/logs\/configure(loglevel:factory:)","title":"configure(logLevel:factory:)","kind":"symbol","abstract":[{"text":"Sets YubiKit’s log level and backend.","type":"text
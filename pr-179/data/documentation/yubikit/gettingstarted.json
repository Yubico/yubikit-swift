"text":": An unclosed connection prevents new connections (throws "},{"code":"SmartCardConnectionError.busy","type":"codeVoice"},{"type":"text","text":")"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call ","type":"text"},{"code":"close()","type":"codeVoice"},{"type":"text","text":"."}]},{"anchor":"Working-with-Sessions","type":"heading","level":2,"text":"Working with Sessions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once you have a connection, create sessions to access different YubiKey applications:"}]},{"anchor":"OATH-Session-TOTPHOTP-codes","type":"heading","level":3,"text":"OATH Session (TOTP\/HOTP codes)"},{"type":"codeListing","syntax":"swift","code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"]},{"anchor":"Yubico-OTP-Session-OTP-slots","type":"heading","level":3,"text":"Yubico OTP Session (OTP slots)"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","isActive":true},{"type":"text","text":" manages the two OTP slots. Create it with a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","isActive":true},{"type":"text","text":" or,"},{"type":"text","text":" "},{"type":"text","text":"on macOS, an "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OTPConnection","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let session = try await YubiOTP.Session.makeSession(connection: connectio
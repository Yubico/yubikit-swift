{"metadata":{"role":"article","modules":[{"name":"YubiKit"}],"title":"Getting Started","roleHeading":"Article"},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Prepare your project to connect to the YubiKey via NFC, SmartCard, Lightning and USB HID."}],"seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"title":"Preparing your project","generated":true,"anchor":"Preparing-your-project"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/gettingstarted"]}],"kind":"article","primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The YubiKit framework is distributed using the Swift Package Manager. To add the framework to your project follow these steps:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the “Package Dependencies” tab."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Press the plus-button to bring up the add package dialog.","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"add-framework-1.png"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Enter "},{"type":"codeVoice","code":"https:\/\/github.com\/Yubico\/yubikit-swift\/"},{"type":"text","text":" in the search field and select the Yubico Swift Package."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Press the “Add Package” button to add the SDK to your project.","type":"text"}]}]}],"type":"orderedList","start":4},{"type":"paragraph","inlineContent":[{"identifier":"add-framework-2.png","type":"image"}]},{"level":3,"type":"heading","anchor":"NFC","text":"NFC"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC"},{"type":"text","text":" "},{"type":"text","text":"application identifiers and a NFC Privacy statement to the application."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Add Wireless entitlement","type":"text"}],"type":"strong"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Select your project."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your application target."}]}]},{"content":[{"inlineContent":[{"text":"Choose the “Signing & Capabilities” tab.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Click the “+”-button to add a new capability.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Select the “Near Field Communication Tag” capability."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"nfc-entitlement.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Add list of NFC application identifiers","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"orderedList","start":6,"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the “Info” tab."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”."}]}]}]},{"inlineContent":[{"type":"image","identifier":"nfc-identifiers.png"}],"type":"paragraph"},{"type":"orderedList","start":8,"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the Yubico NFC application identifiers to enable communication with the different"},{"type":"text","text":" "},{"type":"text","text":"applications on the YubiKey."}]}]}]},{"code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"],"type":"codeListing","syntax":null},{"inlineContent":[{"identifier":"nfc-identifiers-list.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Add a NFC Privacy description"}]}],"type":"paragraph"},{"type":"orderedList","start":9,"items":[{"content":[{"inlineContent":[{"type":"text","text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in"},{"type":"text","text":" "},{"text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"image","identifier":"nfc-privacy.png"}],"type":"paragraph"},{"anchor":"SmartCardUSB","text":"SmartCard\/USB","type":"heading","level":3},{"inlineContent":[{"text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the","type":"text"},{"text":" ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" entitlement to your application.","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the application entitlements file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" entitlement to the entitlement list."}]}]}]},{"inlineContent":[{"type":"image","identifier":"smart-card.png"}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"USB SmartCard supports Yubico OTP slot programming. HMAC-SHA1 challenge-response requires"},{"type":"text","text":" "},{"type":"codeVoice","code":"HIDOTPConnection"},{"type":"text","text":" on macOS, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LightningSmartCardConnection"},{"type":"text","text":", or NFC without a touch requirement."},{"type":"text","text":" "},{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session"},{"type":"text","text":"."}]}],"type":"aside"},{"anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey","text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the "},{"type":"codeVoice","code":"com.yubico.ylp"},{"type":"text","text":" string to the list of External Accessories."}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"If not present add the ","type":"text"},{"type":"codeVoice","code":"Supported external accessory protocols"},{"text":" key and insert the string ","type":"text"},{"type":"codeVoice","code":"com.yubico.ylp"},{"text":" in its list.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"external-accessory.png"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for "},{"type":"codeVoice","code":"Supported external accessory protocols"},{"type":"text","text":" to "},{"type":"codeVoice","code":"com.yubico.ylp"},{"type":"text","text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework."}]}],"style":"note","name":"Note","type":"aside"},{"text":"Making Your First Connection","level":2,"type":"heading","anchor":"Making-Your-First-Connection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device."}]},{"text":"Understanding Connection Types","level":3,"type":"heading","anchor":"Understanding-Connection-Types"},{"type":"paragraph","inlineContent":[{"text":"YubiKit provides the following connection methods:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"NFC","type":"text"}],"type":"strong"},{"text":": Short-range wireless communication (iOS only)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"USB"}],"type":"strong"},{"text":": Direct USB connection via SmartCard interface","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Lightning"}],"type":"strong"},{"text":": YubiKey 5Ci connected to Lightning port (iOS only)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"USB HID"}]},{"text":": Direct access to the FIDO or OTP interface (macOS only)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each connection type works differently, so let’s explore how to use them."}]},{"text":"NFC Connections","type":"heading","level":3,"anchor":"NFC-Connections"},{"type":"paragraph","inlineContent":[{"text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:","type":"text"}]},{"code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete.","type":"text"}]},{"text":"USB and Lightning Connections","type":"heading","level":3,"anchor":"USB-and-Lightning-Connections"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:"}]},{"code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"WiredSmartCardConnection.makeConnection()"},{"type":"text","text":" method automatically detects whether you’re using USB or Lightning."}]},{"anchor":"Specific-Connection-Types","type":"heading","level":3,"text":"Specific Connection Types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more control, you can connect to specific interfaces:"}]},{"type":"codeListing","code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS, use "},{"code":"HIDOTPConnection","type":"codeVoice"},{"type":"text","text":" for the OTP keyboard interface or "},{"code":"HIDFIDOConnection","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the FIDO interface:"}]},{"type":"codeListing","syntax":"swift","code":["let otpConnection = try await HIDOTPConnection()"]},{"level":2,"text":"Understanding Connection Lifecycle","type":"heading","anchor":"Understanding-Connection-Lifecycle"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Critical:","type":"text"}],"type":"strong"},{"text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time.","type":"text"}]},{"level":3,"text":"Connection Behavior","type":"heading","anchor":"Connection-Behavior"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Exclusive access","type":"text"}],"type":"strong"},{"type":"text","text":": Only one connection can exist per YubiKey at any time"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Manual closure required","type":"text"}],"type":"strong"},{"text":": Dropping a connection reference does NOT automatically close it - you must call ","type":"text"},{"code":"close()","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Resource blocking"}]},{"text":": An unclosed connection prevents new connections (throws ","type":"text"},{"type":"codeVoice","code":"SmartCardConnectionError.busy"},{"text":")","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call "},{"type":"codeVoice","code":"close()"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Working-with-Sessions","level":2,"text":"Working with Sessions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once you have a connection, create sessions to access different YubiKey applications:"}]},{"type":"heading","anchor":"OATH-Session-TOTPHOTP-codes","level":3,"text":"OATH Session (TOTP\/HOTP codes)"},{"code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Yubico-OTP-Session-OTP-slots","level":3,"text":"Yubico OTP Session (OTP slots)"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session"},{"text":" manages the two OTP slots. Create it with a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection"},{"text":" or,","type":"text"},{"text":" ","type":"text"},{"text":"on macOS, an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OTPConnection"},{"text":":","type":"text"}]},{"code":["let session = try await YubiOTP.Session.makeSession(connection: connection)","let state = await session.configState","print(\"Slot 2 configured: \\(try state.isConfigured(.two))\")","","\/\/ Program slot 2 for HOTP, replacing its existing configuration","try await session.putConfiguration(.hotp(key: secret), in: .two)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","type":"reference"},{"text":" for HMAC-SHA1 challenge-response, transport support, and NFC output.","type":"text"}]},{"type":"heading","anchor":"PIV-Session-Certificates-and-keys","level":3,"text":"PIV Session (Certificates and keys)"},{"code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Management-Session-Device-information","level":3,"text":"Management Session (Device information)"},{"code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"WebAuthn-Client-FIDO2--passkeys","level":3,"text":"WebAuthn Client (FIDO2 \/ passkeys)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For passkey registration and authentication, "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" wraps a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"type":"text","text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" (USB HID on macOS) or any "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","isActive":true},{"type":"text","text":" "},{"type":"text","text":"(NFC \/ USB CCID)."}]},{"type":"codeListing","code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"],"syntax":"swift"},{"inlineContent":[{"text":"PIN and UV are supplied per ceremony via ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","isActive":true,"type":"reference"},{"text":". For raw","type":"text"},{"text":" ","type":"text"},{"text":"CTAP2 access (credential management, bio enrollment, large blobs), use","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true,"type":"reference"},{"text":" directly.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Connection-Management-Patterns","text":"Connection Management Patterns"},{"type":"heading","level":3,"anchor":"For-UI-Applications","text":"For UI Applications"},{"inlineContent":[{"type":"text","text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","type":"reference"},{"type":"text","text":" for complete examples of reactive connection management patterns that automatically update your UI when YubiKeys are plugged in or removed."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"For-Command-Line-Tools","text":"For Command-Line Tools"},{"inlineContent":[{"text":"CLI applications often use a simpler approach with a single connection per operation. See ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","isActive":true,"type":"reference"},{"text":" for examples of how command-line tools handle connections for one-time operations.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Next-Steps","text":"Next Steps"},{"inlineContent":[{"type":"text","text":"Now you’re ready to build YubiKey applications! Check out the sample projects to see complete implementations:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"OATHSample","type":"text"}]},{"text":": Shows how to build a TOTP authenticator app with SwiftUI","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"PIVTool"}]},{"type":"text","text":": Demonstrates PIV operations for certificates and digital signatures"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"WebAuthnInterceptorSample","type":"text"}]},{"type":"text","text":": Routes WebAuthn calls from a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"type":"text","text":" to a YubiKey"}]}]}]},{"level":3,"text":"Build SDK documentation","type":"heading","anchor":"Build-SDK-documentation"},{"inlineContent":[{"type":"text","text":"You can also build the complete SDK documentation by selecting “Product” -> “Build Documentation” in Xcode. This gives you access to the full YubiKit API reference."}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select an iOS target to include NFC and Lightning connections, or a macOS target to include"},{"type":"text","text":" "},{"type":"text","text":"USB HID connections."}]}],"name":"Note"}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"references":{"nfc-privacy.png":{"type":"image","alt":"An image showing how to add the NFC privacy string to a project.","identifier":"nfc-privacy.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy~dark@2x.png","traits":["2x","dark"]}]},"nfc-entitlement.png":{"identifier":"nfc-entitlement.png","type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to add wireless entitlements to project."},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"navigatorTitle":[{"text":"OATHSession","kind":"identifier"}],"type":"topic","title":"OATHSession","role":"symbol","kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OATHSession","kind":"identifier"}],"abstract":[{"type":"text","text":"An interface to the OATH application on the YubiKey."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentat
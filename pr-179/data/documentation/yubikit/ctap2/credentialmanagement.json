,{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"CredentialManagement allows listing, inspecting, and deleting discoverable credentials.","type":"text"},{"text":" ","type":"text"},{"text":"It requires a PIN\/UV auth token with the ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/ClientPin\/Permission\/credentialManagement","type":"reference","isActive":true},{"text":" permission.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let token = try await session.getPinUVToken(","    using: .pin(\"123456\"),","    permissions: [.credentialManagement]",")","let credMgmt = try await session.credentialManagement(token: token)","","\/\/ Get storage metadata","let metadata = try await credMgmt.getMetadata()","print(\"Stored: \\(metadata.existingCredentialsCount)\")","print(\"Remaining: \\(metadata.maxRemainingCredentialsCount)\")","","\/\/ List credentials by relying party","for try await rp in credMgmt.rps {","    print(\"RP: \\(rp.rp.id)\")","    for try await cred in credMgmt.credentials(for: rp.rpIdHash) {","        print(\"  - \\(cred.user.name ?? \"unknown\")\")","    }","}","","\/\/ Delete a credential","try await credMgmt.deleteCredential(credentialDescriptor)"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/ctap2\/credentialmanagement"]}],"metadata":{"externalID":"s:7YubiKit5CTAP2O20CredentialManagementV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CredentialManagement","kind":"identifier"}],"role":"symbol","title":"CTAP2.CredentialManagement","modules":[{"name":"YubiKit"}],"extendedModule":"YubiKit","symbolKind":"struct","roleHeading":"Structure","navigatorTitle":[{"text":"CredentialManagement","kind":"identifier"}]},"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/CTAP2/StatusStream":{"url":"\/documentation\/yubikit\/ctap2\/statusstream","r
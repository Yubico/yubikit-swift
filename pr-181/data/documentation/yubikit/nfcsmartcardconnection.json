{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NFCSmartCardConnection","kind":"identifier"}]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The  NFCSmartCardConnection is short lived and should be closed as soon as the commands sent to the YubiKey have finished processing. It is up to the user of","type":"text"},{"text":" ","type":"text"},{"text":"the connection to close it when it no longer is needed. As long as the connection is open the NFC modal will cover the lower part of the iPhone screen.","type":"text"},{"text":" ","type":"text"},{"text":"In addition to the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/close(error:)","type":"reference"},{"text":" method defined in the SmartCardConnection protocol the NFCSmartCardConnection has an additional ","type":"text"},{"code":"close(success:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"method that will close the connection and set the alertMessage of the NFC alert to the provided message.","type":"text"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"NFC is only supported on iPhones from iPhone 6 and forward. It will not work on iPads since there’s no NFC chip in these devices."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"NFC connection to a YubiKey (iOS only).","type":"text"}]},{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"NFCSmartCardConnection establishes a connection to a YubiKey via NFC. The connection","type":"text"},{"text":" ","type":"text"},{"text":"presents the system NFC dialog and waits for the user to tap their YubiKey.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"NFC connections are short-lived due to iOS timeout constraints. Perform operations quickly","type":"text"},{"text":" ","type":"text"},{"text":"and close the connection with a user-visible message.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let connection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","await connection.close(message: \"Codes retrieved\")"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/nfcsmartcardconnection"]}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Structure","role":"symbol","title":"NFCSmartCardConnection","externalID":"s:7YubiKit22NFCSmartCardConnectionV","symbolKind":"struct","navigatorTitle":[{"text":"NFCSmartCardConnection","kind":"identifier"}],"modules":[{"name":"YubiKit"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NFCSmartCardConnection","kind":"identifier"}]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Connection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/s8SendableP","doc:\/\/yubikit-swift.YubiKit\/s16SendableMetatypeP"]}],"abstract":[{"type":"text","text":"A NFC connection to the YubiKey."}],"seeAlsoSections":[{"title":"Creating a SmartCardConnection to a YubiKey","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Sma
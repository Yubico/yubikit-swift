"},{"type":"codeVoice","code":"FidoUI.getAssertion"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"ContentView.swift","type":"text"}]},{"type":"text","text":" — minimal SwiftUI shell with a URL bar and back button."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"FidoUI","type":"text"}]},{"type":"text","text":" (separate Swift package under "},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI"},{"type":"text","text":") — the reusable UI + transport layer described below."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The end-to-end flow:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Page JS calls "},{"type":"codeVoice","code":"navigator.credentials.create()"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".get()"},{"type":"text","text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" decodes the JSON straight into the SDK’s strongly-typed "},{"type":"codeVoice","code":"Options"},{"type":"text","text":" and hands them to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" opens a transport, runs the ceremony via "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":", and shows PIN \/ UV \/ error \/ success panels as needed."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The resulting "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","isActive":true},{"type":"text","text":" is serialized via its built-in "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" and posted back to JS."}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Intercepting-WebAuthn-Calls","level":2,"type":"heading","text":"Intercepting WebAuthn Calls"},{"anchor":"JavaScript-Injection","level":3,"type":"heading","text":"JavaScript Injection"},{"inlineContent":[{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" replaces "},{"type":"codeVoice","code":"navigator.credentials.create"},{"type":"text","text":" and "},{"type":"codeVoice","code":"navigator.credentials.get"},{"type":"text","text":" with versions that forward to Swift. Binary fields ("},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", "},{"type":"codeVoice","code":"user.id"},{"type":"text","text":", "},{"type":"codeVoice","code":"rawId"},{"type":"text","text":", …) are serialized to "},{"inlineContent":[{"text":"base64url","type":"text"}],"type":"strong"},{"type":"text","text":" strings via "},{"type":"codeVoice","code":"JSON.stringify"},{"type":"text","text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed."}],"type":"paragraph"},{"syntax":"javascript","type":"codeListing","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request 
{"metadata":{"modules":[{"name":"YubiKit"}],"roleHeading":"Article","role":"article","title":"Logging"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No setup is required. YubiKit defaults to "},{"type":"codeVoice","code":"debug"},{"type":"text","text":" on stdout when compiled with "},{"type":"codeVoice","code":"DEBUG"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"info"},{"type":"text","text":" on stderr otherwise. You can override either default:"}]},{"type":"codeListing","syntax":"swift","code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","YubiKit.Logs.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","YubiKit.Logs.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","YubiKit.Logs.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","YubiKit.Logs.configure()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-log"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"Logging"},{"type":"text","text":" product to your app target"},{"type":"text","text":" "},{"type":"text","text":"to use its backend types. Any SwiftLog "},{"type":"codeVoice","code":"LogHandler"},{"type":"text","text":" can be supplied by the factory."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;"},{"type":"text","text":" "},{"type":"text","text":"omitting the level uses the selected handler’s level. 
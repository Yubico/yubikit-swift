riants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list~dark@2x.png","traits":["2x","dark"]}],"type":"image","identifier":"nfc-identifiers-list.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/CTAP2/Session":{"role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}],"title":"CTAP2.Session","url":"\/documentation\/yubikit\/ctap2\/session","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","navigatorTitle":[{"kind":"identifier","text":"Session"}],"abstract":[{"type":"text","text":"Interface to the FIDO2\/CTAP authenticator on the YubiKey."}]},"nfc-privacy.png":{"alt":"An image showing how to add the NFC privacy string to a project.","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy~dark@2x.png","traits":["2x","dark"]}],"type":"image","identifier":"nfc-privacy.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}],"title":"PIVSession","url":"\/documentation\/yubikit\/pivsession","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","navigatorTitle":[{"text":"PIVSession","kind":"identifier"}],"abstract":[{"type":"text","text":"An interface to the PIV application on the YubiKey."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"role":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","url":"\/documentation\/yubikit\/management\/session","type":"topic","title":"Management.Session","navigatorTitle":[{"text":"Session","kind":"identifier"}],"fragment
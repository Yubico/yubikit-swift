xt"},{"text":"presents the system NFC dialog and waits for the user to tap their YubiKey.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"NFC connections are short-lived due to iOS timeout constraints. Perform operations quickly","type":"text"},{"text":" ","type":"text"},{"text":"and close the connection with a user-visible message.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let connection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","await connection.close(message: \"Codes retrieved\")"]}],"kind":"content"}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"seeAlsoSections":[{"anchor":"Creating-a-SmartCardConnection-to-a-YubiKey","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/USBSmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LightningSmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WiredSmartCardConnection"],"title":"Creating a SmartCardConnection to a YubiKey","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/nfcsmartcardconnection"]}],"metadata":{"externalID":"s:7YubiKit22NFCSmartCardConnectionV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NFCSmartCardConnection","kind":"identifier"}],"symbolKind":"struct","modules":[{"name":"YubiKit"}],"navigatorTitle":[{"kind":"identifier","text":"NFCSmartCardConnection"}],"title":"NFCSmartCardConnection","roleHeading":"Structure","role":"symbol"},"sections":[],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/LightningSmartCardConnection":{"id
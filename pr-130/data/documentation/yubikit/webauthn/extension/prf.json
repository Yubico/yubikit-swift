":"text","text":"Pseudo-random function extension for deriving symmetric secrets bound to a credential."}]},{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PRF"},{"type":"text","text":" lets a relying party derive deterministic symmetric secrets from a credential"},{"type":"text","text":" "},{"type":"text","text":"— the same input produces the same output every time the user authenticates with"},{"type":"text","text":" "},{"type":"text","text":"that credential. It’s the "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/#prf-extension"},{"type":"text","text":" "},{"type":"text","text":"for credential-bound key derivation, built on the CTAP2 "},{"type":"codeVoice","code":"hmac-secret"},{"type":"text","text":" extension."},{"type":"text","text":" "},{"type":"text","text":"The SDK transforms each PRF input with "},{"type":"codeVoice","code":"SHA-256(\"WebAuthn PRF\\0\" || input)"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"text","text":"sending it to the authenticator — that domain separation is mandated by the spec."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In a high-level WebAuthn flow, configure "},{"type":"codeVoice","code":"PRF"},{"type":"text","text":" per ceremony via"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/RegistrationInputs\/prf"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/AuthenticationInputs\/prf"},{"type":"text","text":"; outputs come back on"},{"type":"text","text":" "},{"type":"codeVoice","code":"clientExtensionResults"},{"type":"text","text":" of the corresponding "},{"type":"codeVoice","code":"Response"},{"type":"text","text":". Registration enables"},{"type":"text","text":" "},{"type":"text","text":"PRF on a credential, optionally deriving secrets at the same time on"},{"type":"text","text":" "},{"text":"authenticators that support hmac-secret-mc. Authentication evaluates the PRF at","type":"text"},{"text":" ","type":"text"},{"text":"one or more inputs and returns the derived bytes.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Registration: enable PRF on the new credential","let regOpts = WebAuthn.Registration.Options(","    challenge: challenge,","    rp: .init(id: \"example.com\", name: \"Example\"),","    user: .init(id: userId, name: \"alice@example.com\"),","    extensions: .init(prf: .enable)",")","let registration = try await client.makeCredential(regOpts, authorization: auth).value","","\/\/ Authentication: derive a secret bound to the credential","let authOpts = WebAuthn.Authentication.Options(","    challenge: challenge,","    rpId: \"example.com\",","    allowCredentials: [.init(id: storedCredentialId)],","    extensions: .init(prf: .eval(first: encryptionSeed))",")","let assertions = try await client.getAssertion(authOpts, authorization: auth).value","let derived = assertions.first?.clientExtensionResults.prf?.results.first"]},{"type":"paragraph","inlineContent":[{"text":"For multi-credential flows where each credential needs different inputs, populate","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PRF\/Authentication\/Input\/evalByCredential","isActive":true,"type":"reference"},{"text":" with secrets keyed by credential id, with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PRF\/Authentication\/Input\/eval","type":"reference"},{"text":" as the default for credentials not in the map.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"PRF","type":"codeVoice"}
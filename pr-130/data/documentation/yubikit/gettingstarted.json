ants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list~dark@2x.png","traits":["2x","dark"]}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/CTAP2/Session":{"abstract":[{"text":"Interface to the FIDO2\/CTAP authenticator on the YubiKey.","type":"text"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Session","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","navigatorTitle":[{"text":"Session","kind":"identifier"}],"role":"symbol","url":"\/documentation\/yubikit\/ctap2\/session","title":"CTAP2.Session","kind":"symbol"},"external-accessory.png":{"alt":"An image showing how to support for lightning YubiKeys.","type":"image","identifier":"external-accessory.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory~dark@2x.png","traits":["2x","dark"]}]},"add-framework-1.png":{"alt":"An image showing how to add the YubiKit SDK to your Xcode project.","type":"image","identifier":"add-framework-1.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1~dark@2x.png","traits":["2x","dark"]}]},"nfc-identifiers.png":{"alt":"An image showing how to add the nfc application identifiers.","type":"image","identifier":"nfc-identifiers.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers@2x.png","traits":["2x","light"]},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers~dark@2x.png"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"url":"\/documentation\/yubikit\/oathsession","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","kind":"symbol","title":"OATH
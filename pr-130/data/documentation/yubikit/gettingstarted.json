{"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"The YubiKit framework is distributed using the Swift Package Manager. To add the framework to your project follow these steps:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Select your project.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Choose the “Package Dependencies” tab.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Press the plus-button to bring up the add package dialog."}],"type":"paragraph"}]}]},{"inlineContent":[{"identifier":"add-framework-1.png","type":"image"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Enter "},{"code":"https:\/\/github.com\/Yubico\/yubikit-swift\/","type":"codeVoice"},{"type":"text","text":" in the search field and select the Yubico Swift Package."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Press the “Add Package” button to add the SDK to your project."}],"type":"paragraph"}]}],"start":4},{"inlineContent":[{"identifier":"add-framework-2.png","type":"image"}],"type":"paragraph"},{"text":"NFC","type":"heading","anchor":"NFC","level":3},{"inlineContent":[{"text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC","type":"text"},{"text":" ","type":"text"},{"text":"application identifiers and a NFC Privacy statement to the application.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Add Wireless entitlement"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application target.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Choose the “Signing & Capabilities” tab."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Click the “+”-button to add a new capability.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the “Near Field Communication Tag” capability.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"nfc-entitlement.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Add list of NFC application identifiers"}],"type":"strong"}],"type":"paragraph"},{"start":6,"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"nfc-identifiers.png"}],"type":"paragraph"},{"start":8,"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the Yubico NFC application identifiers to enable communication with the different","type":"text"},{"text":" ","type":"text"},{"text":"applications on the YubiKey.","type":"text"}]}]}],"type":"orderedList"},{"code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"],"type":"codeListing","syntax":null},{"inlineContent":[{"identifier":"nfc-identifiers-list.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Add a NFC Privacy description","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in","type":"text"},{"type":"text","text":" "},{"text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”","type":"text"}]}]}],"start":9,"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"nfc-privacy.png"}],"type":"paragraph"},{"anchor":"SmartCardUSB","level":3,"type":"heading","text":"SmartCard\/USB"},{"inlineContent":[{"text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"text":" entitlement to your application.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Select the application entitlements file.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" entitlement to the entitlement list.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"smart-card.png"}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The SmartCard\/USB connection only support the CCID based applications on the YubiKey and does not support U2F, FIDO2 or OTP.","type":"text"}]}]},{"anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey","level":3,"type":"heading","text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey"},{"inlineContent":[{"text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the ","type":"text"},{"type":"codeVoice","code":"com.yubico.ylp"},{"text":" string to the list of External Accessories.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Select your project.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select your application target.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not present add the ","type":"text"},{"code":"Supported external accessory protocols","type":"codeVoice"},{"text":" key and insert the string ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" in its list.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"external-accessory.png"}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for ","type":"text"},{"type":"codeVoice","code":"Supported external accessory protocols"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"com.yubico.ylp"},{"text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework.","type":"text"}],"type":"paragraph"}]},{"anchor":"Making-Your-First-Connection","level":2,"type":"heading","text":"Making Your First Connection"},{"inlineContent":[{"type":"text","text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device."}],"type":"paragraph"},{"anchor":"Understanding-Connection-Types","level":3,"type":"heading","text":"Understanding Connection Types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit handles three different connection methods:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"NFC"}],"type":"strong"},{"type":"text","text":": Short-range wireless communication (iOS only)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"USB","type":"text"}]},{"type":"text","text":": Direct USB connection via SmartCard interface"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Lightning","type":"text"}]},{"type":"text","text":": YubiKey 5Ci connected to Lightning port (iOS only)"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Each connection type works differently, so let’s explore how to use them.","type":"text"}]},{"anchor":"NFC-Connections","text":"NFC Connections","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:"}],"type":"paragraph"},{"code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete.","type":"text"}],"type":"paragraph"},{"anchor":"USB-and-Lightning-Connections","text":"USB and Lightning Connections","level":3,"type":"heading"},{"inlineContent":[{"text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"]},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"WiredSmartCardConnection.makeConnection()"},{"type":"text","text":" method automatically detects whether you’re using USB or Lightning."}],"type":"paragraph"},{"anchor":"Specific-Connection-Types","text":"Specific Connection Types","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"For more control, you can connect to specific interfaces:"}],"type":"paragraph"},{"code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Understanding-Connection-Lifecycle","text":"Understanding Connection Lifecycle","type":"heading","level":2},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Critical:"}],"type":"strong"},{"type":"text","text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time."}],"type":"paragraph"},{"anchor":"Connection-Behavior","level":3,"type":"heading","text":"Connection Behavior"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Exclusive access"}],"type":"strong"},{"text":": Only one connection can exist per YubiKey at any time","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Manual closure required"}],"type":"strong"},{"text":": Dropping a connection reference does NOT automatically close it - you must call ","type":"text"},{"code":"close()","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Resource blocking"}]},{"type":"text","text":": An unclosed connection prevents new connections (throws "},{"code":"SmartCardConnectionError.busy","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call "},{"code":"close()","type":"codeVoice"},{"type":"text","text":"."}]},{"anchor":"Working-with-Sessions","text":"Working with Sessions","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Once you have a connection, create sessions to access different YubiKey applications:"}],"type":"paragraph"},{"anchor":"OATH-Session-TOTPHOTP-codes","text":"OATH Session (TOTP\/HOTP codes)","level":3,"type":"heading"},{"code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"],"syntax":"swift","type":"codeListing"},{"anchor":"PIV-Session-Certificates-and-keys","text":"PIV Session (Certificates and keys)","level":3,"type":"heading"},{"code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"],"syntax":"swift","type":"codeListing"},{"anchor":"Management-Session-Device-information","text":"Management Session (Device information)","level":3,"type":"heading"},{"code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"],"syntax":"swift","type":"codeListing"},{"anchor":"WebAuthn-Client-FIDO2--passkeys","text":"WebAuthn Client (FIDO2 \/ passkeys)","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"For passkey registration and authentication, "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"type":"text","text":" wraps a"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"code":"HIDFIDOConnection","type":"codeVoice"},{"text":" (USB HID on macOS) or any ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","isActive":true},{"text":" ","type":"text"},{"text":"(NFC \/ USB CCID).","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"]},{"inlineContent":[{"text":"PIN and UV are supplied per ceremony via ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","type":"reference"},{"text":". For raw","type":"text"},{"text":" ","type":"text"},{"text":"CTAP2 access (credential management, bio enrollment, large blobs), use","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true,"type":"reference"},{"type":"text","text":" directly."}],"type":"paragraph"},{"anchor":"Connection-Management-Patterns","level":2,"type":"heading","text":"Connection Management Patterns"},{"anchor":"For-UI-Applications","level":3,"type":"heading","text":"For UI Applications"},{"inlineContent":[{"type":"text","text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","isActive":true,"type":"reference"},{"type":"text","text":" for complete examples of reactive connection management patterns that automatically update your UI when YubiKeys are plugged in or removed."}],"type":"paragraph"},{"anchor":"For-Command-Line-Tools","text":"For Command-Line Tools","level":3,"type":"heading"},{"inlineContent":[{"text":"CLI applications often use a simpler approach with a single connection per operation. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","type":"reference"},{"text":" for examples of how command-line tools handle connections for one-time operations.","type":"text"}],"type":"paragraph"},{"anchor":"Next-Steps","text":"Next Steps","type":"heading","level":2},{"inlineContent":[{"text":"Now you’re ready to build YubiKey applications! Check out the sample projects to see complete implementations:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"OATHSample"}]},{"type":"text","text":": Shows how to build a TOTP authenticator app with SwiftUI"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"PIVTool","type":"text"}]},{"type":"text","text":": Demonstrates PIV operations for certificates and digital signatures"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"WebAuthnInterceptorSample","type":"text"}],"type":"strong"},{"text":": Routes WebAuthn calls from a ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" through ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":" to a YubiKey","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Build SDK documentation","type":"heading","anchor":"Build-SDK-documentation","level":3},{"inlineContent":[{"text":"You can also build the complete SDK documentation by selecting “Product” -> “Build Documentation” in Xcode. This gives you access to the full YubiKit API reference.","type":"text"}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Select an iOS target when building documentation to include all connection types."}],"type":"paragraph"}]}],"kind":"content"}],"sections":[],"abstract":[{"type":"text","text":"Prepare your project to connect to the YubiKey via NFC, SmartCard and Lightning."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"article","roleHeading":"Article","title":"Getting Started","modules":[{"name":"YubiKit"}]},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/gettingstarted"]}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","interfaceLang
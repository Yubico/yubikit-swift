":"reference"},{"text":" for cryptographic operations, certificate management, and access control.","type":"text"}],"role":"sampleCode","kind":"article","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","url":"\/documentation\/yubikit\/pivtoolsamplecode","title":"PIVTool: Building PIV applications with YubiKey","type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"navigatorTitle":[{"kind":"identifier","text":"Session"}],"abstract":[{"text":"An interface to the Management application on the YubiKey.","type":"text"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}],"role":"symbol","kind":"symbol","url":"\/documentation\/yubikit\/management\/session","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","title":"Management.Session","type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSampleCode":{"role":"sampleCode","title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","url":"\/documentation\/yubikit\/oathsamplecode","kind":"article","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","abstract":[{"type":"text","text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"reference","isActive":true},{"type":"text","text":" to retrieve authentication codes, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},{"type":"text","text":" to get device information."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authentication/Response":{"role":"symbol","title":"WebAuthn.Authentication.Response","url":"\/documentation\/yubikit\/webauthn\/authentication\/response","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Response","kind":"identifier"}],"navigatorTitle":[{"text":"Response","kind":"identifier"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","abstract":[{"type":"text","text":"Authenticator response from a successful credential authentication."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Registration/Response":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Response"}],"title":"WebAuthn.Registration.Response","abstract":[{"type":"text","text":"Authenticator response from a successful credential creation."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Response"}],"type":"topic","url":"\/documentation\/yubikit\/webauthn\/registration\/response"}}}
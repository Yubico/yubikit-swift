{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"The sample creates an authenticator app that:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Establishes connections to YubiKeys via USB, Lightning, or NFC","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Manages connection lifecycle (detecting plugged\/unplugged devices)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Lists TOTP codes stored on the YubiKey","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Shows device information like firmware version","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Handles connection errors and user cancellations gracefully","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This sample focuses on read-only operations and doesn’t handle password-protected YubiKeys or credential management."}],"type":"paragraph"},{"level":2,"anchor":"Connection-Management","type":"heading","text":"Connection Management"},{"level":3,"anchor":"Handling-Wired-Connections","type":"heading","text":"Handling Wired Connections"},{"inlineContent":[{"type":"text","text":"The app uses a "},{"code":"ConnectionManager","type":"codeVoice"},{"type":"text","text":" to handle persistent connections to plugged-in YubiKeys. This approach ensures your app stays responsive when users plug and unplug their YubiKeys:"}],"type":"paragraph"},{"code":["private func startWiredConnection() {","    wiredConnectionTask = Task { @MainActor in","        while !Task.isCancelled {","            do {","                let newConnection = try await WiredSmartCardConnection.makeConnection()","                wiredConnection = newConnection","","                \/\/ Wait for disconnect","                let closeError = await newConnection.waitUntilClosed()","                wiredConnection = nil","            } catch {","                self.error = error","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The key insight here is using "},{"code":"waitUntilClosed()","type":"codeVoice"},{"type":"text","text":" to detect when the YubiKey is unplugged, then automatically waiting for the next connection."}],"type":"paragraph"},{"level":3,"anchor":"NFC-Connections","type":"heading","text":"NFC Connections"},{"inlineContent":[{"type":"text","text":"NFC connections work differently - they’re initiated by user action and are short-lived:"}],"type":"paragraph"},{"code":["func requestNFCConnection() async {","    do {","        nfcConnection = try await NFCSmartCardConnection()","    } catch {","        self.error = error","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"When an NFC connection is established, the app fetches data and immediately closes it with a user message:"}],"type":"paragraph"},{"code":["Task {","    await model.update(using: connection)","    await connection.close(message: \"Codes calculated\")","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Working-with-YubiKey-Data","type":"heading","text":"Working with YubiKey Data"},{"level":3,"anchor":"Reading-OATH-Codes","type":"heading","text":"Reading OATH Codes"},{"inlineContent":[{"type":"text","text":"Once you have a connection, getting TOTP codes is straightforward:"}],"type":"paragraph"},{"code":["private func calculateCodes(using connection: SmartCardConnection) async {","    do {","        let session = try await OATHSession.makeSession(connection: connection)","        let result = try await session.calculateCredentialCodes()","        accounts = result.map { credential, code in","            Account(","                label: credential.label,","                code: code?.code,","                issuer: credential.issuer,","                type: credential.type","            )","        }","    } catch {","        self.error = error","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"code":"calculateCredentialCodes()","type":"codeVoice"},{"type":"text","text":" method returns a dictionary mapping credentials to their current codes. Some codes might be "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if they require touch or are password-protected."}],"type":"paragraph"},{"level":3,"anchor":"Getting-Device-Information","type":"heading","text":"Getting Device Information"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"Management.Session","type":"codeVoice"},{"type":"text","text":" to get YubiKey information:"}],"type":"paragraph"},{"code":["private func getKeyVersion(using connection: SmartCardConnection) async {","    do {","        let session: Management.Session = try await .makeSession(connection: connection)","        self.keyVersion = await session.version.description","    } catch {","        self.error = error","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"code":"Model","type":"codeVoice"},{"type":"text","text":" class combines both operations in a single "},{"code":"update","type":"codeVoice"},{"type":"text","text":" method:"}],"type":"paragraph"},{"code":["func update(using connection: SmartCardConnection) async {","    await calculateCodes(using: connection)","    await getKeyVersion(using: connection)","    connectionType = connection.connectionType","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"SwiftUI-Integration","type":"heading","text":"SwiftUI Integration"},{"level":3,"anchor":"Reacting-to-Connection-Changes","type":"heading","text":"Reacting to Connection Changes"},{"inlineContent":[{"type":"text","text":"The app uses SwiftUI’s "},{"code":"@Published","type":"codeVoice"},{"type":"text","text":" properties and "},{"code":"onReceive","type":"codeVoice"},{"type":"text","text":" to update the UI when connections change:"}],"type":"paragraph"},{"code":[".onReceive(connectionManager.$wiredConnection) { newConnection in","    guard let connection = newConnection else {","        model.clear()  \/\/ Clear UI when YubiKey unplugged","        return","    }","    Task { await model.update(using: connection) }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This pattern ensures the UI immediately updates when YubiKeys are plugged in or removed."}],"type":"paragraph"},{"level":3,"anchor":"Platform-Specific-Features","type":"heading","text":"Platform-Specific Features"},{"inlineContent":[{"type":"text","text":"The app handles iOS vs macOS differences with conditional compilation:"}],"type":"paragraph"},{"code":["#if os(iOS)",".refreshable {","    await connectionManager.requestNFCConnection()","}","#endif"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"iOS users can pull-to-refresh to scan with NFC, while macOS users only see USB options."}],"type":"paragraph"},{"level":3,"anchor":"Connection-Type-Detection","type":"heading","text":"Connection Type Detection"},{"inlineContent":[{"type":"text","text":"The sample includes a useful extension to identify connection types:"}],"type":"paragraph"},{"code":["extension SmartCardConnection {","    var connectionType: String {","        switch self {","        case _ as NFCSmartCardConnection: return \"NFC\"","        case _ as LightningSmartCardConnection: return \"Lightning\"","        case _ as USBSmartCardConnection: return \"USB\"","        default: return \"Unknown\"","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This is helpful because NFC connections are slower than USB, and users like to know how their YubiKey is connected."}],"type":"paragraph"},{"level":2,"anchor":"Architecture-Decisions","type":"heading","text":"Architecture Decisions"},{"level":3,"anchor":"Why-the-connection-management-works-this-way","type":"heading","text":"Why the connection management works this way"},{"inlineContent":[{"type":"text","text":"The sample uses a background loop that continuously waits for wired connections. This might seem unusual, but it solves a key problem: YubiKeys get plugged and unplugged frequently, but apps need to stay responsive."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When you unplug your YubiKey, the app doesn’t crash or freeze - it detects the disconnection via "},{"code":"waitUntilClosed()","type":"codeVoice"},{"type":"text","text":" and immediately starts waiting for the next YubiKey. This creates a smoother user experience where the app responds when you plug \/ unplug a YubiKey."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"NFC works differently since you can’t continuously scan - the user has to explicitly initiate each scan. That’s why NFC connections are handled separately through user actions like the scan button or pull-to-refresh."}],"type":"paragraph"},{"level":3,"anchor":"Error-handling-for-hardware-connections","type":"heading","text":"Error handling for hardware connections"},{"inlineContent":[{"type":"text","text":"Hardware connections are unreliable by nature. Users will unplug devices mid-operation, walk away during NFC scans, or have connectivity issues. The sample handles this gracefully:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Connection failures are caught and stored as errors","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"User cancellations (like dismissing NFC scan) are filtered out to avoid unnecessary error alerts","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Session errors are handled similarly - show the error but maintain app functionality","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"anchor":"Working-with-Swift-actors","type":"heading","text":"Working with Swift actors"},{"inlineContent":[{"type":"text","text":"YubiKit sessions are Swift actors that handle their own threading. The sample shows how to integrate this with SwiftUI’s main actor requirements:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"ConnectionManager","type":"codeVoice"},{"text":" runs on ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" so it can directly update ","type":"text"},{"code":"@Published","type":"codeVoice"},{"text":" properties","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Session calls happen on the session’s actor, then results are passed back to update the UI","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Everything uses ","type":"text"},{"code":"async\/await","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"abstract":[{"type":"text","text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"reference"},{"type":"text","text":" to retrieve authentication codes, and "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"reference"},{"type":"text","text":" to get device information."}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"isActive":true,"overridingTitle":"View Source","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","type":"reference"}},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/oathsamplecode"]}],"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"],"title":"Sample code","generated":true,"anchor":"Sample-code"}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"YubiKit"}],"color":{"standardColorIdentifier":"green"},"roleHeading":"Sample Code","title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","role":"sampleCode"},"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"navigatorTitle":[{"text":"PIVSession","kind":"identifier"}],"kind":"symbol","title":"PIVSession","url":"\/documentation\/yubikit\/pivsession","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","type":"topic","abstract":[{"type":"text","text":"An interface to the PIV application on the YubiKey."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"url":"\/documentation\/yubikit\/management\/session","role":"symbol","abstract":[{"type":"text","text":"An interface to the Management application on the YubiKey."}],"type":"topic","kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Session","kind":"identifier"}],"navigatorTitle":[{"text":"Session","kind":"identifier"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","title":"Management.Session"},"documentation-header.png":{"type":"image","alt":"YubiKeys in a row","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}],"identifier":"documentation-header.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Client"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","navigatorTitle":[{"kind":"identifier","text":"Client"}],"url":"\/documentation\/yubikit\/webauthn\/client","title":"WebAuthn.Client","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"type":"topic","kind":"symbol","images":[{"identifier":"documentation-header.png","type":"icon"}],"role":"collection","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"title":"YubiKit","url":"\/documentation\/yubikit"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"navigatorTitle":[{"kind":"identifier","text":"OATHSession"}],"url":"\/documentation\/yubikit\/oathsession","role":"symbol","title":"OATHSession","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An interface to the OATH application on the YubiKey."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"OATHSession"}]},"https://github.com/Yubico/yubikit-swift/tree/main/Samples/OATHSample":{"type":"download","checksum":null,"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","url":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"url":"\/documentation\/yubikit\/webauthninterceptorsamplecode","role":"sampleCode","abstract":[{"type":"text","text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts "},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"type":"text","text":" calls inside a "},{"code":"WKWebView","type":"codeVoice"},{"type":"text","text":" and routes them to a YubiKey. It uses the high-level "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"type":"text","text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" companion module."}],"type":"topic","kind":"article","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"type":"topic","url":"\/documentation\/yubikit\/pivtoolsamplecode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","role":"sampleCode","kind":"article","abstract":[{"text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","type":"reference","isActive":true},{"text":" for cryptographic operations, certificate management, and access control.","type":"text"}],"title":"PIVTool: Building PIV applications with YubiKey"}}}
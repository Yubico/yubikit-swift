{"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The YubiKit framework is distributed using the Swift Package Manager. To add the framework to your project follow these steps:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your project."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Package Dependencies” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Press the plus-button to bring up the add package dialog.","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"add-framework-1.png"}]},{"start":4,"items":[{"content":[{"inlineContent":[{"type":"text","text":"Enter "},{"type":"codeVoice","code":"https:\/\/github.com\/Yubico\/yubikit-swift\/"},{"type":"text","text":" in the search field and select the Yubico Swift Package."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Press the “Add Package” button to add the SDK to your project.","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"identifier":"add-framework-2.png","type":"image"}]},{"text":"NFC","anchor":"NFC","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC"},{"type":"text","text":" "},{"type":"text","text":"application identifiers and a NFC Privacy statement to the application."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Add Wireless entitlement"}]}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Select your project."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select your application target.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Signing & Capabilities” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Click the “+”-button to add a new capability.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the “Near Field Communication Tag” capability.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"identifier":"nfc-entitlement.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Add list of NFC application identifiers"}],"type":"strong"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the “Info” tab."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”."}]}]}],"start":6},{"inlineContent":[{"identifier":"nfc-identifiers.png","type":"image"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the Yubico NFC application identifiers to enable communication with the different"},{"type":"text","text":" "},{"type":"text","text":"applications on the YubiKey."}]}]}],"start":8},{"syntax":null,"type":"codeListing","code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"]},{"inlineContent":[{"type":"image","identifier":"nfc-identifiers-list.png"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Add a NFC Privacy description"}]}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in","type":"text"},{"text":" ","type":"text"},{"text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”","type":"text"}]}]}],"start":9},{"inlineContent":[{"identifier":"nfc-privacy.png","type":"image"}],"type":"paragraph"},{"anchor":"SmartCardUSB","level":3,"type":"heading","text":"SmartCard\/USB"},{"inlineContent":[{"type":"text","text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" entitlement to your application."}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Select the application entitlements file."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" entitlement to the entitlement list.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"smart-card.png"}]},{"content":[{"inlineContent":[{"text":"USB SmartCard supports Yubico OTP slot programming. HMAC-SHA1 challenge-response requires","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HIDOTPConnection"},{"text":" on macOS, ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LightningSmartCardConnection","isActive":true},{"text":", or NFC without a touch requirement.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"},{"level":3,"type":"heading","text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey","anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the "},{"code":"com.yubico.ylp","type":"codeVoice"},{"type":"text","text":" string to the list of External Accessories."}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your project."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your application target."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the “Info” tab."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If not present add the "},{"code":"Supported external accessory protocols","type":"codeVoice"},{"type":"text","text":" key and insert the string "},{"type":"codeVoice","code":"com.yubico.ylp"},{"type":"text","text":" in its list."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"identifier":"external-accessory.png","type":"image"}]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for "},{"code":"Supported external accessory protocols","type":"codeVoice"},{"type":"text","text":" to "},{"code":"com.yubico.ylp","type":"codeVoice"},{"type":"text","text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework."}]}],"style":"note"},{"level":2,"type":"heading","text":"Making Your First Connection","anchor":"Making-Your-First-Connection"},{"type":"paragraph","inlineContent":[{"text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device.","type":"text"}]},{"level":3,"type":"heading","text":"Understanding Connection Types","anchor":"Understanding-Connection-Types"},{"type":"paragraph","inlineContent":[{"text":"YubiKit provides the following connection methods:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"NFC","type":"text"}],"type":"strong"},{"text":": Short-range wireless communication (iOS only)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"USB","type":"text"}]},{"type":"text","text":": Direct USB connection via SmartCard interface"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Lightning"}]},{"type":"text","text":": YubiKey 5Ci connected to Lightning port (iOS only)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"USB HID"}],"type":"strong"},{"text":": Direct access to the FIDO or OTP interface (macOS only)","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Each connection type works differently, so let’s explore how to use them."}],"type":"paragraph"},{"text":"NFC Connections","anchor":"NFC-Connections","type":"heading","level":3},{"inlineContent":[{"text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"]},{"inlineContent":[{"text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete.","type":"text"}],"type":"paragraph"},{"text":"USB and Lightning Connections","anchor":"USB-and-Lightning-Connections","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"]},{"inlineContent":[{"text":"The ","type":"text"},{"code":"WiredSmartCardConnection.makeConnection()","type":"codeVoice"},{"text":" method automatically detects whether you’re using USB or Lightning.","type":"text"}],"type":"paragraph"},{"text":"Specific Connection Types","anchor":"Specific-Connection-Types","type":"heading","level":3},{"inlineContent":[{"text":"For more control, you can connect to specific interfaces:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"]},{"inlineContent":[{"text":"On macOS, use ","type":"text"},{"code":"HIDOTPConnection","type":"codeVoice"},{"text":" for the OTP keyboard interface or ","type":"text"},{"code":"HIDFIDOConnection","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"the FIDO interface:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let otpConnection = try await HIDOTPConnection()"]},{"text":"Understanding Connection Lifecycle","anchor":"Understanding-Connection-Lifecycle","type":"heading","level":2},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Critical:","type":"text"}]},{"type":"text","text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time."}],"type":"paragraph"},{"type":"heading","text":"Connection Behavior","level":3,"anchor":"Connection-Behavior"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Exclusive access"}]},{"type":"text","text":": Only one connection can exist per YubiKey at any time"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Manual closure required","type":"text"}]},{"type":"text","text":": Dropping a connection reference does NOT automatically close it - you must call "},{"code":"close()","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Resource blocking"}]},{"type":"text","text":": An unclosed connection prevents new connections (throws "},{"type":"codeVoice","code":"SmartCardConnectionError.busy"},{"type":"text","text":")"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call "},{"code":"close()","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","text":"Working with Sessions","level":2,"anchor":"Working-with-Sessions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once you have a connection, create sessions to access different YubiKey applications:"}]},{"type":"heading","text":"OATH Session (TOTP\/HOTP codes)","level":3,"anchor":"OATH-Session-TOTPHOTP-codes"},{"type":"codeListing","code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"],"syntax":"swift"},{"type":"heading","text":"Yubico OTP Session (OTP slots)","level":3,"anchor":"Yubico-OTP-Session-OTP-slots"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","isActive":true},{"type":"text","text":" manages the two OTP slots. Create it with a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","isActive":true},{"type":"text","text":" or,"},{"text":" ","type":"text"},{"text":"on macOS, an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OTPConnection"},{"text":":","type":"text"}]},{"code":["let session = try await YubiOTP.Session.makeSession(connection: connection)","let state = await session.configState","print(\"Slot 2 configured: \\(try state.isConfigured(.two))\")","","\/\/ Program slot 2 for HOTP, replacing its existing configuration","try await session.putConfiguration(.hotp(key: secret), in: .two)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","isActive":true},{"text":" for HMAC-SHA1 challenge-response, transport support, and NFC output.","type":"text"}]},{"type":"heading","level":3,"text":"PIV Session (Certificates and keys)","anchor":"PIV-Session-Certificates-and-keys"},{"code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"Management Session (Device information)","anchor":"Management-Session-Device-information"},{"code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"WebAuthn Client (FIDO2 \/ passkeys)","anchor":"WebAuthn-Client-FIDO2--passkeys"},{"type":"paragraph","inlineContent":[{"text":"For passkey registration and authentication, ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":" wraps a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true,"type":"reference"},{"text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"type":"codeVoice","code":"HIDFIDOConnection"},{"text":" (USB HID on macOS) or any ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"(NFC \/ USB CCID).","type":"text"}]},{"code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"PIN and UV are supplied per ceremony via ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","type":"reference","isActive":true},{"text":". For raw","type":"text"},{"text":" ","type":"text"},{"text":"CTAP2 access (credential management, bio enrollment, large blobs), use","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":" directly."}]},{"level":2,"text":"Connection Management Patterns","anchor":"Connection-Management-Patterns","type":"heading"},{"level":3,"text":"For UI Applications","anchor":"For-UI-Applications","type":"heading"},{"inlineContent":[{"type":"text","text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","isActive":true,"type":"reference"},{"type":"text","text":" for complete examples of reactive connection management patterns that automatically update your UI when YubiKeys are plugged in or removed."}],"type":"paragraph"},{"level":3,"text":"For Command-Line Tools","anchor":"For-Command-Line-Tools","type":"heading"},{"inlineContent":[{"text":"CLI applications often use a simpler approach with a single connection per operation. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","type":"reference"},{"text":" for examples of how command-line tools handle connections for one-time operations.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Next Steps","anchor":"Next-Steps","type":"heading"},{"inlineContent":[{"type":"text","text":"Now you’re ready to build YubiKey applications! Check out the sample projects to see complete implementations:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"OATHSample"}]},{"type":"text","text":": Shows how to build a TOTP authenticator app with SwiftUI"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"PIVTool"}]},{"text":": Demonstrates PIV operations for certificates and digital signatures","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"WebAuthnInterceptorSample"}]},{"type":"text","text":": Routes WebAuthn calls from a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" through "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"text":" to a YubiKey","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Build-SDK-documentation","type":"heading","level":3,"text":"Build SDK documentation"},{"inlineContent":[{"text":"You can also build the complete SDK documentation by selecting “Product” -> “Build Documentation” in Xcode. This gives you access to the full YubiKit API reference.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select an iOS target to include NFC and Lightning connections, or a macOS target to include"},{"type":"text","text":" "},{"type":"text","text":"US
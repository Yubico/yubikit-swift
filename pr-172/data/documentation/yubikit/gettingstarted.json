{"sections":[],"abstract":[{"type":"text","text":"Prepare your project to connect to the YubiKey via NFC, SmartCard, Lightning and USB HID."}],"kind":"article","primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The YubiKit framework is distributed using the Swift Package Manager. To add the framework to your project follow these steps:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your project."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the “Package Dependencies” tab."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Press the plus-button to bring up the add package dialog."}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"identifier":"add-framework-1.png","type":"image"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter "},{"code":"https:\/\/github.com\/Yubico\/yubikit-swift\/","type":"codeVoice"},{"type":"text","text":" in the search field and select the Yubico Swift Package."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Press the “Add Package” button to add the SDK to your project."}]}]}],"type":"orderedList","start":4},{"type":"paragraph","inlineContent":[{"identifier":"add-framework-2.png","type":"image"}]},{"level":3,"type":"heading","text":"NFC","anchor":"NFC"},{"type":"paragraph","inlineContent":[{"text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC","type":"text"},{"text":" ","type":"text"},{"text":"application identifiers and a NFC Privacy statement to the application.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Add Wireless entitlement"}],"type":"strong"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your project."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your application target."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the “Signing & Capabilities” tab."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Click the “+”-button to add a new capability."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the “Near Field Communication Tag” capability."}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"identifier":"nfc-entitlement.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Add list of NFC application identifiers"}],"type":"strong"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the “Info” tab."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”."}]}]}],"type":"orderedList","start":6},{"type":"paragraph","inlineContent":[{"identifier":"nfc-identifiers.png","type":"image"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the Yubico NFC application identifiers to enable communication with the different"},{"type":"text","text":" "},{"type":"text","text":"applications on the YubiKey."}]}]}],"type":"orderedList","start":8},{"syntax":null,"type":"codeListing","code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"]},{"type":"paragraph","inlineContent":[{"identifier":"nfc-identifiers-list.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Add a NFC Privacy description"}],"type":"strong"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in"},{"type":"text","text":" "},{"type":"text","text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”"}]}]}],"type":"orderedList","start":9},{"type":"paragraph","inlineContent":[{"identifier":"nfc-privacy.png","type":"image"}]},{"level":3,"type":"heading","text":"SmartCard\/USB","anchor":"SmartCardUSB"},{"type":"paragraph","inlineContent":[{"text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the","type":"text"},{"text":" ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" entitlement to your application.","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the application entitlements file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"type":"text","text":" entitlement to the entitlement list."}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"identifier":"smart-card.png","type":"image"}]},{"content":[{"inlineContent":[{"type":"text","text":"USB SmartCard supports Yubico OTP slot programming. HMAC-SHA1 challenge-response requires"},{"type":"text","text":" "},{"type":"codeVoice","code":"HIDOTPConnection"},{"type":"text","text":" on macOS, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LightningSmartCardConnection"},{"type":"text","text":", or NFC without a touch requirement."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"},{"level":3,"type":"heading","text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey","anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey"},{"type":"paragraph","inlineContent":[{"text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" string to the list of External Accessories.","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your project."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your application target."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the “Info” tab."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If not present add the "},{"code":"Supported external accessory protocols","type":"codeVoice"},{"type":"text","text":" key and insert the string "},{"code":"com.yubico.ylp","type":"codeVoice"},{"type":"text","text":" in its list."}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"identifier":"external-accessory.png","type":"image"}]},{"content":[{"inlineContent":[{"type":"text","text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for "},{"type":"codeVoice","code":"Supported external accessory protocols"},{"type":"text","text":" to "},{"type":"codeVoice","code":"com.yubico.ylp"},{"type":"text","text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework."}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"},{"level":2,"type":"heading","text":"Making Your First Connection","anchor":"Making-Your-First-Connection"},{"type":"paragraph","inlineContent":[{"text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device.","type":"text"}]},{"level":3,"type":"heading","text":"Understanding Connection Types","anchor":"Understanding-Connection-Types"},{"type":"paragraph","inlineContent":[{"text":"YubiKit provides the following connection methods:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"NFC","type":"text"}]},{"type":"text","text":": Short-range wireless communication (iOS only)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"USB","type":"text"}]},{"type":"text","text":": Direct USB connection via SmartCard interface"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Lightning","type":"text"}]},{"type":"text","text":": YubiKey 5Ci connected to Lightning port (iOS only)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"USB HID","type":"text"}]},{"type":"text","text":": Direct access to the FIDO or OTP interface (macOS only)"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Each connection type works differently, so let’s explore how to use them.","type":"text"}]},{"level":3,"type":"heading","text":"NFC Connections","anchor":"NFC-Connections"},{"type":"paragraph","inlineContent":[{"text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"]},{"type":"paragraph","inlineContent":[{"text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete.","type":"text"}]},{"level":3,"type":"heading","text":"USB and Lightning Connections","anchor":"USB-and-Lightning-Connections"},{"type":"paragraph","inlineContent":[{"text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"WiredSmartCardConnection.makeConnection()","type":"codeVoice"},{"text":" method automatically detects whether you’re using USB or Lightning.","type":"text"}]},{"level":3,"type":"heading","text":"Specific Connection Types","anchor":"Specific-Connection-Types"},{"type":"paragraph","inlineContent":[{"text":"For more control, you can connect to specific interfaces:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"]},{"type":"paragraph","inlineContent":[{"text":"On macOS, use ","type":"text"},{"code":"HIDOTPConnection","type":"codeVoice"},{"text":" for the OTP keyboard interface or ","type":"text"},{"code":"HIDFIDOConnection","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"the FIDO interface:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let otpConnection = try await HIDOTPConnection()"]},{"level":2,"type":"heading","text":"Understanding Connection Lifecycle","anchor":"Understanding-Connection-Lifecycle"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Critical:"}],"type":"strong"},{"text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time.","type":"text"}]},{"level":3,"type":"heading","text":"Connection Behavior","anchor":"Connection-Behavior"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Exclusive access","type":"text"}]},{"type":"text","text":": Only one connection can exist per YubiKey at any time"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Manual closure required","type":"text"}]},{"type":"text","text":": Dropping a connection reference does NOT automatically close it - you must call "},{"code":"close()","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Resource blocking","type":"text"}]},{"type":"text","text":": An unclosed connection prevents new connections (throws "},{"code":"SmartCardConnectionError.busy","type":"codeVoice"},{"type":"text","text":")"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call ","type":"text"},{"code":"close()","type":"codeVoice"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Working with Sessions","anchor":"Working-with-Sessions"},{"type":"paragraph","inlineContent":[{"text":"Once you have a connection, create sessions to access different YubiKey applications:","type":"text"}]},{"level":3,"type":"heading","text":"OATH Session (TOTP\/HOTP codes)","anchor":"OATH-Session-TOTPHOTP-codes"},{"syntax":"swift","type":"codeListing","code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"]},{"level":3,"type":"heading","text":"Yubico OTP Session (OTP slots)","anchor":"Yubico-OTP-Session-OTP-slots"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","type":"reference"},{"text":" manages the two OTP slots. Create it with a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","type":"reference"},{"text":" or,","type":"text"},{"text":" ","type":"text"},{"text":"on macOS, an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OTPConnection","type":"reference"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let session = try await YubiOTP.Session.makeSession(connection: connection)","let state = await session.configState","print(\"Slot 2 configured: \\(try state.isConfigured(.two))\")","","\/\/ Program slot 2 for HOTP, replacing its existing configuration","try await session.putConfiguration(.hotp(key: secret), in: .two)"]},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","type":"reference"},{"text":" for HMAC-SHA1 challenge-response, transport support, and NFC output.","type":"text"}]},{"level":3,"type":"heading","text":"PIV Session (Certificates and keys)","anchor":"PIV-Session-Certificates-and-keys"},{"syntax":"swift","type":"codeListing","code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"]},{"level":3,"type":"heading","text":"Management Session (Device information)","anchor":"Management-Session-Device-information"},{"syntax":"swift","type":"codeListing","code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"]},{"level":3,"type":"heading","text":"WebAuthn Client (FIDO2 \/ passkeys)","anchor":"WebAuthn-Client-FIDO2--passkeys"},{"type":"paragraph","inlineContent":[{"text":"For passkey registration and authentication, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":" wraps a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference"},{"text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"code":"HIDFIDOConnection","type":"codeVoice"},{"text":" (USB HID on macOS) or any ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","type":"reference"},{"text":" ","type":"text"},{"text":"(NFC \/ USB CCID).","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"]},{"type":"paragraph","inlineContent":[{"text":"PIN and UV are supplied per ceremony via ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","type":"reference"},{"text":". For raw","type":"text"},{"text":" ","type":"text"},{"text":"CTAP2 access (credential management, bio enrollment, large blobs), use","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference"},{"text":" directly.","type":"text"}]},{"level":2,"type":"heading","text":"Connection Management Patterns","anchor":"Connection-Management-Patterns"},{"level":3,"type":"heading","text":"For UI Applications","anchor":"For-UI-Applications"},{"type":"paragraph","inlineContent":[{"text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","type":"reference"},{"text":" for complete examples of reactive connection management patterns that automatically update your UI when YubiKeys are plugged in or removed.","type":"text"}]},{"level":3,"type":"heading","text":"For Command-Line Tools","anchor":"For-Command-Line-Tools"},{"type":"paragraph","inlineConte
YubiKit\/documentation\/YubiKit","kind":"symbol","url":"\/documentation\/yubikit","abstract":[{"text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB.","type":"text"}],"title":"YubiKit","role":"collection","images":[{"identifier":"documentation-header.png","type":"icon"}],"type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"type":"topic","abstract":[{"text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","type":"reference"},{"text":" for cryptographic operations, certificate management, and access control.","type":"text"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","title":"PIVTool: Building PIV applications with YubiKey","role":"sampleCode","url":"\/documentation\/yubikit\/pivtoolsamplecode","kind":"article"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"navigatorTitle":[{"kind":"identifier","text":"Client"}],"kind":"symbol","url":"\/documentation\/yubikit\/webauthn\/client","title":"WebAuthn.Client","type":"topic","role":"symbol"}}}
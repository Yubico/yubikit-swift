{"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"No setup is required. YubiKit defaults to ","type":"text"},{"type":"codeVoice","code":"debug"},{"text":" on stdout when compiled with ","type":"text"},{"type":"codeVoice","code":"DEBUG"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"type":"codeVoice","code":"info"},{"text":" on stderr otherwise. You can override either default:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","YubiKit.Logs.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","YubiKit.Logs.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","YubiKit.Logs.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","YubiKit.Logs.configure()"],"type":"codeListing"},{"inlineContent":[{"text":"Add ","type":"text"},{"identifier":"https:\/\/github.com\/apple\/swift-log","isActive":true,"type":"reference"},{"text":"’s ","type":"text"},{"code":"Logging","type":"codeVoice"},{"text":" product to your app target","type":"text"},{"text":" ","type":"text"},{"text":"to use its backend types. Any SwiftLog ","type":"text"},{"code":"LogHandler","type":"codeVoice"},{"text":" can be supplied by the factory.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;","type":"text"},{"text":" ","type":"text"},{"text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,","type":"text"},{"text":" ","type":"text"},{"text":"though logs already in progress may use the previous settings.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,","type":"text"},{"text":" ","type":"text"},{"text":"pass its factory explicitly; global ","type":"text"},{"type":"codeVoice","code":"LoggingSystem.bootstrap"},{"type":"text","text":" does not select YubiKit’s backend."},{"text":" ","type":"text"},{"text":"Factories may run concurrently and must not log through YubiKit themselves.","type":"text"}],"type":"paragraph"},{"anchor":"Traffic-logging","text":"Traffic logging","type":"heading","level":3},{"syntax":"swift","code":["YubiKit.Logs.configure(logLevel: .trace)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Raw traffic and SCP plaintext logs require "},{"type":"strong","inlineContent":[{"text":"YubiKit to be compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Neither configuration nor a custom backend can enable them in other builds."},{"type":"text","text":" "},{"type":"text","text":"Custom connections are responsible for their own traffic logging."}],"type":"paragraph"},{"name":"Warning","type":"aside","style":"warning","content":[{"inlineContent":[{"text":"Debug logs can include account names and credential identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Trace logs can include PINs, credentials, and cryptographic keys. Protect or redact logs before sharing them.","type":"text"}],"type":"paragraph"}]},{"anchor":"Custom-backends","text":"Custom backends","type":"heading","level":3},{"inlineContent":[{"text":"Labels identify categories, such as ","type":"text"},{"type":"codeVoice","code":"com.yubico.YubiKit.OATH"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"com.yubico.YubiKit.FIDO"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Metadata carries details such as byte counts and error codes; the default backend displays","type":"text"},{"text":" ","type":"text"},{"text":"these as ","type":"text"},{"type":"codeVoice","code":"key=value"},{"text":" pairs. Message wording and metadata keys are not a stable API.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/loggingguide"]}],"seeAlsoSections":[{"anchor":"Preparing-your-project","title":"Preparing your project","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"generated":true}],"metadata":{"title":"Logging","modules":[{"name":"YubiKit"}],"role":"article","roleHeading":"Article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Choose YubiKit’s log level and backend with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)"},{"type":"text","text":"."}],"references":{"https://github.com/apple/swift-log":{"titleInlineContent":[{"type":"text","text":"SwiftLog"}],"url":"https:\/\/github.com\/apple\/swift-log","type":"link","identifier":"https:\/\/github.com\/apple\/swift-log","title":"SwiftLog"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/GettingStarted":{"type":"topic","kind":"article","url":"\/documentation\/yubikit\/gettingstarted","role":"article","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","title":"Getting Started","abstract":[{"type":"text","text":"Prepare your project to connect to the YubiKey via NFC, SmartCard, Lightning and USB HID."}]},"documentation-header.png":{"type":"image","alt":"YubiKeys in a row","identifier":"documentation-header.png",
{"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"text":"Client for performing WebAuthn passkey operations.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn"]]},"metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"externalID":"s:7YubiKit8WebAuthnO6ClientC","symbolKind":"class","roleHeading":"Class","navigatorTitle":[{"kind":"identifier","text":"Client"}],"title":"WebAuthn.Client","extendedModule":"YubiKit","modules":[{"name":"YubiKit"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted"]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Provides a unified interface for passkey registration and authentication","type":"text"},{"text":" ","type":"text"},{"text":"backed by a YubiKey via CTAP2 protocol (USB\/NFC).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"PIN entry and UV decisions are supplied per ceremony via the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","isActive":true,"type":"reference"},{"text":" parameter on ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:
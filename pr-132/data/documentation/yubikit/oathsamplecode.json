{"sections":[],"metadata":{"role":"sampleCode","modules":[{"name":"YubiKit"}],"title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","color":{"standardColorIdentifier":"green"},"roleHeading":"Sample Code"},"primaryContentSections":[{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The sample creates an authenticator app that:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Establishes connections to YubiKeys via USB, Lightning, or NFC"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Manages connection lifecycle (detecting plugged\/unplugged devices)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists TOTP codes stored on the YubiKey"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Shows device information like firmware version"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handles connection errors and user cancellations gracefully"}]}]}]},{"inlineContent":[{"type":"text","text":"This sample focuses on read-only operations and doesn’t handle password-protected YubiKeys or credential management."}],"type":"paragraph"},{"text":"Connection Management","anchor":"Connection-Management","level":2,"type":"heading"},{"type":"heading","level":3,"text":"Handling Wired Connections","anchor":"Handling-Wired-Connections"},{"inlineContent":[{"type":"text","text":"The app uses a "},{"type":"codeVoice","code":"ConnectionManager"},{"type":"text","text":" to handle persistent connections to plugged-in YubiKeys. This approach ensures your app stays responsive when users plug and unplug their YubiKeys:"}],"type":"paragraph"},{"code":["private func startWiredConnection() {","    wiredConnectionTask = Task { @MainActor in","        while !Task.isCancelled {","            do {","                let newConnection = try await WiredSmartCardConnection.makeConnection()","                wiredConnection = newConnection","","                \/\/ Wait for disconnect","                let closeError = await newConnection.waitUntilClosed()","                wiredConnection = nil","            } catch {","                self.error = error","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The key insight here is using ","type":"text"},{"type":"codeVoice","code":"waitUntilClosed()"},{"type":"text","text":" to detect when the YubiKey is unplugged, then automatically waiting for the next connection."}],"type":"paragraph"},{"level":3,"anchor":"NFC-Connections","type":"heading","text":"NFC Connections"},{"type":"paragraph","inlineContent":[{"text":"NFC connections work differently - they’re initiated by user action and are short-lived:","type":"text"}]},{"syntax":"swift","code":["func requestNFCConnection() async {","    do {","        nfcConnection = try await NFCSmartCardConnection()","    } catch {","        self.error = error","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When an NFC connection is established, the app fetches data and immediately closes it with a user message:"}]},{"syntax":"swift","code":["Task {","    await model.update(using: connection)","    await connection.close(message: \"Codes calculated\")","}"],"type":"codeListing"},{"level":2,"anchor":"Working-with-YubiKey-Data","type":"heading","text":"Working with YubiKey Data"},{"level":3,"anchor":"Reading-OATH-Codes","type":"heading","text":"Reading OATH Codes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once you have a connection, getting TOTP codes is straightforward:"}]},{"syntax":"swift","code":["private func calculateCodes(using connection: SmartCardConnection) async {","    do {","        let session = try await OATHSession.makeSession(connection: connection)","        let result = try await session.calculateCredentialCodes()","        accounts = result.map { credential, code in","            Account(","                label: credential.label,","                code: code?.code,","                issuer: credential.issuer,","                type: credential.type","            )","        }","    } catch {","        self.error = error","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"calculateCredentialCodes()"},{"type":"text","text":" method returns a dictionary mapping credentials to their current codes. Some codes might be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if they require touch or are password-protected."}]},{"level":3,"anchor":"Getting-Device-Information","type":"heading","text":"Getting Device Information"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"Management.Session"},{"type":"text","text":" to get YubiKey information:"}]},{"syntax":"swift","code":["private func getKeyVersion(using connection: SmartCardConnection) async {","    do {","        let session: Management.Session = try await .makeSession(connection: connection)","        self.keyVersion = await session.version.description","    } catch {","        self.error = error","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Model"},{"type":"text","text":" class combines both operations in a single "},{"type":"codeVoice","code":"update"},{"type":"text","text":" method:"}]},{"type":"codeListing","syntax":"swift","code":["func update(using connection: SmartCardConnection) async {","    await calculateCodes(using: connection)","    await getKeyVersion(using: connection)","    connectionType = connection.connectionType","}"]},{"type":"heading","text":"SwiftUI Integration","anchor":"SwiftUI-Integration","level":2},{"type":"heading","text":"Reacting to Connection Changes","anchor":"Reacting-to-Connection-Changes","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app uses SwiftUI’s "},{"type":"codeVoice","code":"@Published"},{"type":"text","text":" properties and "},{"type":"codeVoice","code":"onReceive"},{"type":"text","text":" to update the UI when connections change:"}]},{"type":"codeListing","syntax":"swift","code":[".onReceive(connectionManager.$wiredConnection) { newConnection in","    guard let connection = newConnection else {","        model.clear()  \/\/ Clear UI when YubiKey unplugged","        return","    }","    Task { await model.update(using: connection) }","}"]},{"inlineContent":[{"type":"text","text":"This pattern ensures the UI immediately updates when YubiKeys are plugged in or removed."}],"type":"paragraph"},{"level":3,"anchor":"Platform-Specific-Features","text":"Platform-Specific Features","type":"heading"},{"inlineContent":[{"type":"text","text":"The app handles iOS vs macOS differences with conditional compilation:"}],"type":"paragraph"},{"syntax":"swift","code":["#if os(iOS)",".refreshable {","    await connectionManager.requestNFCConnection()","}","#endif"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"iOS users can pull-to-refresh to scan with NFC, while macOS users only see USB options."}],"type":"paragraph"},{"level":3,"anchor":"Connection-Type-Detection","text":"Connection Type Detection","type":"heading"},{"inlineContent":[{"text":"The sample includes a useful extension to identify connection types:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["extension SmartCardConnection {","    var connectionType: String {","        switch self {","        case _ as NFCSmartCardConnection: return \"NFC\"","        case _ as LightningSmartCardConnection: return \"Lightning\"","        case _ as USBSmartCardConnection: return \"USB\"","        default: return \"Unknown\"","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is helpful because NFC connections are slower than USB, and users like to know how their YubiKey is connected."}],"type":"paragraph"},{"anchor":"Architecture-Decisions","level":2,"type":"heading","text":"Architecture Decisions"},{"anchor":"Why-the-connection-management-works-this-way","level":3,"type":"heading","text":"Why the connection management works this way"},{"inlineContent":[{"type":"text","text":"The sample uses a background loop that continuously waits for wired connections. This might seem unusual, but it solves a key problem: YubiKeys get plugged and unplugged frequently, but apps need to stay responsive."}],"type":"paragraph"},{"inlineContent":[{"text":"When you unplug your YubiKey, the app doesn’t crash or freeze - it detects the disconnection via ","type":"text"},{"code":"waitUntilClosed()","type":"codeVoice"},{"text":" and immediately starts waiting for the next YubiKey. This creates a smoother user experience where the app responds when you plug \/ unplug a YubiKey.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"NFC works differently since you can’t continuously scan - the user has to explicitly initiate each scan. That’s why NFC connections are handled separately through user actions like the scan button or pull-to-refresh.","type":"text"}],"type":"paragraph"},{"anchor":"Error-handling-for-hardware-connections","level":3,"type":"heading","text":"Error handling for hardware connections"},{"inlineContent":[{"text":"Hardware connections are unreliable by nature. Users will unplug devices mid-operation, walk away during NFC scans, or have connectivity issues. The sample handles this gracefully:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Connection failures are caught and stored as errors"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"User cancellations (like dismissing NFC scan) are filtered out to avoid unnecessary error alerts","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Session errors are handled similarly - show the error but maintain app functionality","type":"text"}]}]}]},{"type":"heading","level":3,"text":"Working with Swift actors","anchor":"Working-with-Swift-actors"},{"inlineContent":[{"type":"text","text":"YubiKit sessions are Swift actors that handle their own threading. The sample shows how to integrate this with SwiftUI’s main actor requirements:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ConnectionManager"},{"text":" runs on ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" so it can directly update ","type":"text"},{"type":"codeVoice","code":"@Published"},{"text":" properties","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Session calls happen on the session’s actor, then results are passed back to update the UI","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Everything uses "},{"type":"codeVoice","code":"async\/await"}],"type":"paragraph"}]}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"],"anchor":"Sample-code","title":"Sample code"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/oathsamplecode"]}],"sampleCodeDownload":{"action":{"type":"reference","isActive":true,"overridingTitle":"View Source","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample"},"kind":"sampleDownload"},"abstract":[{"type":"text","text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","isActive":true},{"type":"text","text":" to retrieve authentication codes, and "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","isActive":true},{"type":"text","text":" to get device information."}],"kind":"article","references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"title":"Management.Session","kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","url":"\/documentation\/yubikit\/management\/session","type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"text":"Session","kind":"identifier"}],"abstract":[{"type":"text","text":"An interface to the Management application on the YubiKey."}],"role":"symbol","navigatorTitle":[{"text":"Session","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"type":"topic","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"url":"\/documentation\/yubikit","kind":"symbol","role":"collection","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","images":[{"type":"icon","identifier":"documentation-header.png"}],"title":"YubiKit"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","abstract":[{"type":"text","text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts "},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"type":"text","text":" calls inside a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" and routes them to a YubiKey. It uses the high-level "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" companion module."}],"url":"\/documentation\/yubikit\/webauthninterceptorsamplecode","type":"topic","kind":"article","role":"sampleCode"},"documentation-header.png":{"type":"image","alt":"YubiKeys in a row","identifier":"documentation-header.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"title":"OATHSession","kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","url":"\/documentation\/yubikit\/oathsession","type":"topic","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OATHSession","kind":"identifier"}],"abstract":[{"type":"text","text":"An interface to the OATH application on the YubiKey."}],"role":"symbol","navigatorTitle":[{"text":"OATHSession","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"type":"topic","abstract":[{"type":"text","text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession"},{"type":"text","text":" for cryptographi
"url":"\/documentation\/yubikit\/oathsession","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","abstract":[{"text":"An interface to the OATH application on the YubiKey.","type":"text"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OATHSession","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"kind":"symbol","images":[{"type":"icon","identifier":"documentation-header.png"}],"title":"YubiKit","role":"collection","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","url":"\/documentation\/yubikit","abstract":[{"text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB.","type":"text"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","role":"sampleCode","abstract":[{"type":"text","text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts "},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"text":" calls inside a ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":" and routes them to a YubiKey. It uses the high-level ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" companion module."}],"kind":"article","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","url":"\/documentation\/yubikit\/webauthninterceptorsamplecode"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"type":"topic","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"tex
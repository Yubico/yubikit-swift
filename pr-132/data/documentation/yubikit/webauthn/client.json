"text","text":" "},{"type":"text","text":"directly only when you need lower-level access — raw "},{"type":"codeVoice","code":"makeCredential"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"getAssertion"},{"type":"text","text":", credential management, or bio enrollment."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Client"},{"type":"text","text":" is an actor; a client’s lifetime is bound to the underlying "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The constructor takes four parameters that shape every ceremony:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"origin","type":"codeVoice"},{"text":" — the secure origin the client is bound to. ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference","isActive":true},{"text":" enforces","type":"text"},{"text":" ","type":"text"},{"text":"the W3C secure-context rule; the client refuses to sign for relying parties whose","type":"text"},{"text":" ","type":"text"},{"text":"identifier doesn’t match.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"isPublicSuffix","type":"codeVoice"},{"type":"text","text":" — a closure into a Public Suffix List, used to validate that"},{"type":"text","text":" "},{"type":"text","text":"the relying-party identifier is a registrable suffix of the origin’s effective"},{"type":"text","text":" "},{"type":"text","text":"domain."}]}]},{"content":[{"inlineContent":[{"code":"enterpriseRpIds","type":"codeVoice"},{"text":" — relying-party identifiers allowed to receive","type":"text"},{"text":" ","type":"text"},{"text":"platform-managed enterprise attestation. When the request specifies","type":"text"},{"text":" ","type":"text"},{"isActive":t
d","type":"codeVoice"},{"text":") only.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let session = try await CTAP2.Session.makeSession(connection: connection)","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","\/\/ Trivial — pre-supplied PIN:","let response = try await client.makeCredential(options, authorization: .pin(\"1234\")).value","","\/\/ Custom — bridge into a UI:","let auth = WebAuthn.Authorization(providePIN: {","    guard let pin = await viewModel.askForPIN() else { return .cancel }","    return .pin(pin)","})","for try await status in await client.makeCredential(options, authorization: auth) {","    switch status {","    case .processing: showSpinner()","    case .waitingForUser(let cancel):","        showTouchPrompt(onCancel: { Task { await cancel() } })","    case .waitingForUserVerification(let cancel, let fallbackToPIN):","        showBiometricPrompt(","            onCancel: { Task { await cancel() } },","            onFallbackToPIN: fallbackToPIN.map { fallback in { Task { await fallback() } } }","        )","    case .finished(let response): return response","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"PIN attempts are one-shot: a wrong PIN throws"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/pinRejected(retriesRemaining:source:)","type":"reference"},{"type":"text","text":" and the caller"},{"text":" ","type":"text"},{"text":"decides whether to re-prompt and retry with a fresh ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Returning "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/PINReply\/cancel"},{"type":"text","text":" from "},{"code":"providePIN","type":"codeVoice"},{"type":"text","text":" aborts"},{"type":"text","text":" "},{"type":"text","text":"the ceremony with "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/cancelled(source:)","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Client"},{"type":"text","text":" is a high-level passkey client that runs WebAuthn ceremonies against a YubiKey."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"code":"Client","type":"codeVoice"},{"type":"text","text":" is the entry point for WebAuthn in this SDK. It wraps a "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and translates W3C WebAuthn requests into CTAP2 protocol exchanges — building the"},{"type":"text","text":" "},{"type":"codeVoice","code":"clientDataJSON"},{"type":"text","text":", validating the relying-party identifier against the configured"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference"},{"type":"text","text":", selecting between PIN and built-in user verification, and"},{"type":"text","text":" "},{"type":"text","text":"processing extensions before the request reaches the authenticator."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"Client"},{"type":"text","text":" for any app that runs passkey ceremonies. Reach for "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"directly only when you need lower-level access — raw "},{"type":"codeVoice","code":"makeCredential"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"getAssertion"},{"type":"text","text":", credential management, or bio enrollment."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Client"},{"type":"text","text":" is an actor; a client’s lifetime is bound to the underlying "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The constructor takes four parameters that shape every ceremony:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"origin"},{"type":"text","text":" — the secure origin the client is bound to. "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","isActive":true},{"text":" enforces","type":"text"},{"type":"text","text":" "},{"text":"the W3C secure-context rule; the client refuses to sign for relying parties whose","type":"text"},{"text":" ","type":"text"},{"text":"identifier doesn’t match.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"isPublicSuffix","type":"codeVoice"},{"type":"text","text":" — a closure into a Public Suffix List, used to validate that"},{"type":"text","text":" "},{"type":"text","text":"the relying-party identifier is a registrable suffix of the origin’s effective"},{"type":"text","text":" "},{"type":"text","text":"domain."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"enterpriseRpIds"},{"type":"text","text":" — relying-party identifiers allowed to receive"},{"type":"text","text":" "},{"type":"text","text":"platform-managed enterprise attestation. When the request specifies"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/AttestationPreference\/enterprise","type":"reference"},{"type":"text","text":", the client escalates to level 2"},{"type":"text","text":" "},{"type":"text","text":"(platform-managed) for RPs in this set, and uses level 1 (vendor-facilitated)"},{"type":"text","text":" "},{"type":"text","text":"otherwise."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"allowedExtensions"},{"type":"text","text":" — the set of WebAuthn extensions the client will process."},{"type":"text","text":" "},{"type":"text","text":"Anything the relying party requests outside this set is dropped before reaching"},{"type":"text","text":" "},{"type":"text","text":"the authenticator. Defaults to "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension","type":"reference"},{"type":"text","text":"’s standard set."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"PIN and user verification are supplied per ceremony via "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"out-of-band from the ceremony stream. Both ceremony methods return a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/StatusStream","isActive":true},{"type":"text","text":" — drain it with "},{"type":"codeVoice","code":"value()"},{"type":"text","text":" for non-UI callers, or iterate"},{"type":"text","text":" "},{"type":"text","text":"to drive cancel buttons and biometric prompts."}],"type":"paragraph"},{"syntax":"swift","code":["let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","for try await status in await client.makeCredential(opts, authorization: .pin(\"1
{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PRF"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"This WebAuthn extension wraps the CTAP2 hmac-secret extension, transforming","type":"text"},{"text":" ","type":"text"},{"text":"PRF secrets into hmac-secret salts using ","type":"text"},{"code":"SHA-256(\"WebAuthn PRF\\0\" + secret)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Simple Usage (single credential)","anchor":"Simple-Usage-single-credential","type":"heading"},{"syntax":"swift","code":["let prf = try await WebAuthn.Extension.PRF(session: session)","let ext = try prf.getAssertion.input(first: userSecret)","let params = CTAP2.GetAssertion.Parameters(..., extensions: [ext])","let response = try await session.getAssertion(parameters: params)","if let secrets = try prf.getAssertion.output(from: response) {","    \/\/ Use derived keys","}"],"type":"codeListing"},{"level":2,"text":"Multi-credential Usage (evalByCredential)","anchor":"Multi-credential-Usage-evalByCredential","type":"heading"},{"syntax":"swift","code":["let prf = try await WebAuthn.Extension.PRF(","    first: defaultSecret,","    evalByCredential: [credIdA: (secretA, nil), credIdB: (secretB, nil)],","    session: session",")","","\/\/ After credential selection:","let ext = try prf.getAssertion.input(for: selectedCredentialId)","let params = CTAP2.GetAssertion.Parameters(..., extensions: [ext])","let response = try await session.getAssertion(parameters: params)","if let secrets = try prf.getAssertion.output(from: response) {","    \/\/ Use derived keys","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Pseudo-random function extension for deriving symmetric secrets bound to a credential."}],"type":"paragraph"},{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"PRF"},{"type":"text","text":" lets a relying party derive deterministic symmetric secrets from a credential"},{"type":"text","text":" "},{"type":"text","text":"— the same input produces the same output every time the user authenticates with"},{"type":"text","text":" "},{"type":"text","text":"that credential. It’s the "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/#prf-extension"},{"type":"text","text":" "},{"type":"text","text":"for credential-bound key derivation, built on the CTAP2 "},{"type":"codeVoice","code":"hmac-secret"},{"type":"text","text":" extension."},{"type":"text","text":" "},{"type":"text","text":"The SDK transforms each PRF input with "},{"type":"codeVoice","code":"SHA-256(\"WebAuthn PRF\\0\" || input)"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"text","text":"sending it to the authenticator — that domain separation is mandated by the spec."}],"type":"paragraph"},{"inlineContent":[{"text":"In a high-level WebAuthn flow, configure ","type":"text"},{"type":"codeVoice","code":"PRF"},{"text":" per ceremony via","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/RegistrationInputs\/prf","isActive":true},{"text":" or","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/AuthenticationInputs\/prf","isActive":true},{"text":"; outputs come back on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"clientExtensionResults"},{"text":" of the corresponding ","type":"text"},{"type":"codeVoice","code":"Response"},{"type":"text","text":". Registration enables"},{"type":"text","text":" "},{"type":"text","text":"PRF on a credential, optionally deriving secrets at the same time on"},{"type":"text","text":" "},{"type":"text","text":"authenticators that support hmac-secret-mc. Authentication evaluates the PRF at"},{"type":"text","text":" "},{"type":"text","text":"one or more inputs and returns the derived bytes."}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Registration: enable PRF on the new credential","let regOpts = WebAuthn.Registration.Options(","    challenge: challenge,","    rp: .init(id: \"example.com\", name: \"Example\"),","    user: .init(id: userId, name: \"alice@example.com\"),","    extensions: .init(prf: .enable)",")","let registration = try await client.makeCredential(regOpts, authorization: auth).value","","\/\/ Authentication: derive a secret bound to the credential","let authOpts = WebAuthn.Authentication.Options(","    challenge: challenge,","    rpId: \"example.com\",","    allowCredentials: [.init(id: storedCredentialId)],","    extensions: .init(prf: .eval(first: encryptionSeed))",")","let assertions = try await client.getAssertion(authOpts, authorization: auth).value","let derived = assertions.first?.clientExtensionResults.prf?.results.first"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"For multi-credential flows where each credential needs different inputs, populate","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PRF\/Authentication\/Input\/evalByCredential","isActive":true,"type":"reference"},{"text":" with secrets keyed by credential id, with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PRF\/Authentication\/Input\/eval","isActive":true,"type":"reference"},{"text":" as the default for credentials not in the map.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PRF"},{"type":"text","text":" can also be used directly against a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":" — bypassing"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"type":"text","text":" — for callers that drive CTAP2 themselves. Construct an"},{"type":"text","text":" "},{"type":"text","text":"instance with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PRF\/init(session:)"},{"type":"text","text":" (or one of the secret-carrying initialisers),"},{"type":"text","text":" "},{"type":"text","text":"then use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PRF\/makeCredential"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PRF\/getAssertion"},{"text":" to build CTAP2 extension inputs","type":"text"},{"text":" ","type":"text"},{"text":"and parse outputs.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PRF","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension"]]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/yubikit-swift.YubiKit\/s8SendableP","doc:\/\/yubikit-swift.YubiKit\/s16SendableMetatypeP"],"type":"conformsTo"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/#prf-extension"},{"type":"text","text":" "},{"type":"text","text":"fo
ion","isActive":true},{"text":" ","type":"text"},{"text":"for credential-bound key derivation, built on the CTAP2 ","type":"text"},{"type":"codeVoice","code":"hmac-secret"},{"text":" extension.","type":"text"},{"text":" ","type":"text"},{"text":"The SDK transforms each PRF input with ","type":"text"},{"type":"codeVoice","code":"SHA-256(\"WebAuthn PRF\\0\" || input)"},{"text":" before","type":"text"},{"text":" ","type":"text"},{"text":"sending it to the authenticator — that domain separation is mandated by the spec.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In a high-level WebAuthn flow, configure ","type":"text"},{"type":"codeVoice","code":"PRF"},{"text":" per ceremony via","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/RegistrationInputs\/prf","isActive":true},{"text":" or","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/AuthenticationInputs\/prf","isActive":true},{"text":"; outputs come back on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"clientExtensionResults"},{"text":" of the corresponding ","type":"text"},{"type":"codeVoice","code":"Response"},{"text":". Registration enables","type":"text"},{"text":" ","type":"text"},{"text":"PRF on a credential, optionally deriving secrets at the same time on","type":"text"},{"text":" ","type":"text"},{"text":"authenticators that support hmac-secret-mc. Authentication evaluates the PRF at","type":"text"},{"text":" ","type":"text"},{"text":"one or more inputs and returns the derived bytes.","type":"text"}]},{"code":["\/\/ Registration: enable PRF on the new credential","let regOpts = WebAuthn.Registration.Options(","    challenge: challenge,","    rp: .init(id: \"example.com\", name: \"Example\"),","    user: .init(id: userId, name: \"alice@example.com\"),","    extensions:
erties","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Extension\/HmacSecret\/getAssertion","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Extension\/HmacSecret\/makeCredential"],"anchor":"Instance-Properties","generated":true},{"title":"Type Methods","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Extension\/HmacSecret\/isSupported(by:)"],"anchor":"Type-Methods","generated":true}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HmacSecret"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This extension allows a relying party to derive symmetric keys from a credential","type":"text"},{"text":" ","type":"text"},{"text":"using HMAC-SHA-256 with user-provided salts. The derived keys can be used for","type":"text"},{"text":" ","type":"text"},{"text":"encryption or other cryptographic operations.","type":"text"}]},{"anchor":"MakeCredential-Usage","type":"heading","level":2,"text":"MakeCredential Usage"},{"type":"paragraph","inlineContent":[{"text":"Request hmac-secret support when creating a credential:","type":"text"}]},{"code":["let hmacSecret = CTAP2.Extension.HmacSecret()","let ext = hmacSecret.makeCredential.input()","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    \/\/ hmac-secret is enabled","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Or derive secrets at registration time (CTAP 2.2 hmac-secret-mc):","type":"text"}]},{"code":["let hmacSecret = try await CTAP2.Extension.HmacSecret(session: session)","let ext = try hmacSecret.makeCredential.input(salt1: salt, salt2: salt2)","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    switch result {","    case .enabled:","        \/\/ hmac-secret-mc not supported, but hmac-secret is enabled","    case .secrets(let secrets):","        \/\/ Use derived keys (secrets.first, secrets.second)","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"GetAssertion-Usage","type":"heading","level":2,"text":"GetAssertion Usage"},{"type":"paragraph","inlineContent":[{"text":"Derive keys during authentication:","type":"text"}]},{"code":["let hmacSecret = try await CTAP2.Extension.HmacSecret(session: session)","let ext = try hmacSecret.getAssertion.input(salt1: salt)","let params = CTAP2.GetAssertion.Parameters(..., extensions: [ext])","let response = try await session.getAssertion(params)","if let secrets = try hmacSecret.getAssertion.output(from: response) {","    \/\/ Use derived keys (secrets.first, secrets.second)","}"],"type":"codeListing","syntax":"swift"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"https:\/\/fidoalliance.org\/specs\/fido-v2.2-ps-20250714\/fido-client-to-authenticator-protocol-v2.2-ps-20250714.html#sctn-hmac-secret-extension","isActive":true}],"type":"paragraph"}],"type":"aside","name":"See Also"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"https:\/\/fidoalliance.org\/specs\/fido-v2.2-ps-20250714\/fido-client-to-authenticator-protocol-v2.2-ps-20250714.html#sctn-hmac-secret-make-cred-extension","isActive":true}],"type":"paragraph"}],"type":"aside","name":"See Also"}]}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2","doc:\/\/yubikit-swift.Y
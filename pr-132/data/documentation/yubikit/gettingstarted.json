erface to the OATH application on the YubiKey.","type":"text"}],"url":"\/documentation\/yubikit\/oathsession","title":"OATHSession","kind":"symbol","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession"},"add-framework-1.png":{"variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1~dark@2x.png"}],"alt":"An image showing how to add the YubiKit SDK to your Xcode project.","type":"image","identifier":"add-framework-1.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","type":"topic","abstract":[{"type":"text","text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","type":"reference","isActive":true},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}],"url":"\/documentation\/yubikit\/pivtoolsamplecode","title":"PIVTool: Building PIV applications with YubiKey","kind":"article","role":"sampleCode"},"nfc-entitlement.png":{"identifier":"nfc-entitlement.png","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement@2x.png"},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to add wireless entitlements to project.","type":"image"},"smart-card.png":{"identifier":"smart-card.png","alt":"An image showing how to add NFC privacy string to project.","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/smart-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/smart-card~dark@2x.png"}]},"doc://yubikit
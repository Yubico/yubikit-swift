:2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"code":"Authorization","type":"codeVoice"},{"type":"text","text":" carries the PIN-providing closure and the UV"},{"type":"text","text":" "},{"type":"text","text":"policy for one ceremony. It is supplied per call to"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use a built-in factory for trivial cases:"}],"type":"paragraph"},{"syntax":"swift","code":["let r = try await client.makeCredential(opts, authorization: .pin(\"1234\")).value"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or build a custom instance to bridge into a UI:"}],"type":"paragraph"},{"syntax":"swift","code":["let auth = WebAuthn.Authorization(providePIN: {","    guard let pin = await viewModel.askForPIN() else { return .cancel }","    return .pin(pin)","})","let r = try await client.makeCredential(opts, authorization: auth).value"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"PIN attempts are one-shot: a wrong PIN throws"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/pinRejected(retriesRemaining:source:)","type":"reference","isActive":true},{"type":"text","text":" and the caller"},{"type":"text","text":" "},{"type":"text","text":"decides whether to re-prompt and retry the ceremony with a fresh"},{"type":"text","text":" "},{"code":"Authorization","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"PIN and user-verification policy for a single WebAuthn ceremony."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"code":"Authorization","type":"codeVoice"},{"type":"text","text":" is supplied per ceremony to"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","type":"reference","isActive":true},{"type":"text","text":". It carries a "},{"code":"providePIN","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"closure the SDK invokes when a PIN is needed, and a "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/UVPolicy","type":"reference","isActive":true},{"type":"text","text":" deciding whether"},{"type":"text","text":" "},{"type":"text","text":"built-in user verification (e.g. fingerprint on a YubiKey Bio) is attempted."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"PIN entry happens out-of-band: the SDK never surfaces a PIN prompt on the"},{"type":"text","text":" "},{"type":"text","text":"ceremony’s "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/StatusStream","type":"reference","isActive":true},{"type":"text","text":". The closure is invoked when the ceremony"},{"type":"text","text":" "},{"type":"text","text":"requires user verification and the PIN path is chosen — when built-in UV isn’t"},{"type":"text","text":" "},{"type":"text","text":"available, has been blocked, or is ruled out by the "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/UVPolicy","type":"reference","isActive":true},{"type":"text","text":" on this"},{"type":"text","text":" "},{"code":"Authorization","type":"codeVoice"},{"type":"text","text":". If built-in UV succeeds, the closure is never called. PIN"},{"type":"text","text":" "},{"type":"text","text":"attempts are one-shot: a wrong PIN throws"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/pinRejected(retriesRemaining:source:)","type":"reference","isActive":true},{"type":"text","text":" and the caller"},{"type":"text","text":" "},{"type":"text","text":"re-invokes the ceremony with a fresh "},{"code":"Authorization","type":"codeVoice"},{"type":"text","text":". Returning "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/PINReply\/cancel","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"aborts with "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/cancelled(source:)","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Pre-supplied PIN — skips built-in UV.","let r = try await client.makeCredential(opts, authorization: .pin(\"1234\")).value","","\/\/ Built-in UV only — the PIN closure is never invoked.","let r = try await client.makeCredential(opts, authorization: .uvOnly).value","","\/\/ Custom — bridge into a UI.","let auth = WebAuthn.Authorization(providePIN: {","    guard let pin = await viewModel.askForPIN() else { return .cancel }","    return .pin(pin)","}, uv: .preferred)"],"type":"codeListing"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/s8SendableP","doc:\/\/yubikit-swift.YubiKit\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError
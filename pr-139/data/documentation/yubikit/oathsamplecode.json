t":" and routes them to a YubiKey. It uses the high-level "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"type":"text","text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" companion module."}],"url":"\/documentation\/yubikit\/webauthninterceptorsamplecode","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","kind":"article"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"navigatorTitle":[{"kind":"identifier","text":"Session"}],"abstract":[{"type":"text","text":"An interface to the Management application on the YubiKey."}],"url":"\/documentation\/yubikit\/management\/session","title":"Management.Session","kind":"symbol","role":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}],"type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"OATHSession"}],"abstract":[{"text":"An interface to the OATH application on the YubiKey.","type":"text"}],"url":"\/documentation\/yubikit\/oathsession","navigatorTitle":[{"kind":"identifier","text":"OATHSession"}],"title":"OATHSession","kind":"symbol","role":"symbol"}}}
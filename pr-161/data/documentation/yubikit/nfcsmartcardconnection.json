{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NFCSmartCardConnection","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The  NFCSmartCardConnection is short lived and should be closed as soon as the commands sent to the YubiKey have finished processing. It is up to the user of"},{"type":"text","text":" "},{"type":"text","text":"the connection to close it when it no longer is needed. As long as the connection is open the NFC modal will cover the lower part of the iPhone screen."},{"type":"text","text":" "},{"type":"text","text":"In addition to the "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/close(error:)","type":"reference"},{"type":"text","text":" method defined in the SmartCardConnection protocol the NFCSmartCardConnection has an additional "},{"type":"codeVoice","code":"close(success:)"},{"type":"text","text":" "},{"type":"text","text":"method that will close the connection and set the alertMessage of the NFC alert to the provided message."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"NFC is only supported on iPhones from iPhone 6 and forward. It will not work on iPads since there’s no NFC chip in these devices."}]}],"style":"note","type":"aside","name":"Note"},{"inlineContent":[{"type":"text","text":"NFC connection to a YubiKey (iOS only)."}],"type":"paragraph"},{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"NFCSmartCardConnection establishes a connection to a YubiKey via NFC. The connection"},{"type":"text","text":" "},{"type":"text","text":"presents the system NFC dialog and waits for the user to tap their YubiKey."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"NFC connections are short-lived due to iOS timeout constraints. Perform operations quickly"},{"type":"text","text":" "},{"type":"text","text":"and close the connection with a user-visible message."}],"type":"paragraph"},{"code":["let connection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","await connection.close(message: \"Codes retrieved\")"],"syntax":"swift","type":"codeListing"}]}],"variants":[{"paths":["\/documentation\/yubikit\/nfcsmartcardconnection"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"A NFC connection to the YubiKey.","type":"text"}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection","interfaceLanguage":"swift"},"metadata":{"navigatorTitle":[{"text":"NFCSmartCardConnection","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"YubiKit"}],"symbolKind":"struct","role":"symbol","title":"NFCSmartCardConnection","externalID":"s:7YubiKit22NFCSmartCardConnectionV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NFCSmartCardConnection","kind":"identifier"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"sections":[],"topicSections":[{"title":"Creating a Connection","anchor":"Creating-a-Connection","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/init()","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/init(alertMessage:)","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/setAlertMessage(_:)"]},{"title":"Connection Lifecycle","anchor":"Connection-Lifecycle","identifiers":["doc:\/\/yubikit
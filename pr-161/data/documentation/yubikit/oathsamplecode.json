{"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The sample creates an authenticator app that:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Establishes connections to YubiKeys via USB, Lightning, or NFC","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Manages connection lifecycle (detecting plugged\/unplugged devices)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists TOTP codes stored on the YubiKey","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Shows device information like firmware version","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Handles connection errors and user cancellations gracefully","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This sample focuses on read-only operations and doesn’t handle password-protected YubiKeys or credential management."}],"type":"paragraph"},{"anchor":"Connection-Management","text":"Connection Management","type":"heading","level":2},{"anchor":"Handling-Wired-Connections","text":"Handling Wired Connections","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The app uses a "},{"type":"codeVoice","code":"ConnectionManager"},{"type":"text","text":" to handle persistent connections to plugged-in YubiKeys. This approach ensures your app stays responsive when users plug and unplug their YubiKeys:"}],"type":"paragraph"},{"code":["private func startWiredConnection() {","    wiredConnectionTask = Task { @MainActor in","        while !Task.isCancelled {","            do {","                let newConnection = try await WiredSmartCardConnection.makeConnection()","                wiredConnection = newConnection","","                \/\/ Wait for disconnect","                let closeError = await newConnection.waitUntilClosed()","                wiredConnection = nil","            } catch {","                self.error = error","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The key insight here is using "},{"type":"codeVoice","code":"waitUntilClosed()"},{"type":"text","text":" to detect when the YubiKey is unplugged, then automatically waiting for the next connection."}],"type":"paragraph"},{"anchor":"NFC-Connections","text":"NFC Connections","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"NFC connections work differently - they’re initiated by user action and are short-lived:"}],"type":"paragraph"},{"code":["func requestNFCConnection() async {","    do {","        nfcConnection = try await NFCSmartCardConnection()","    } catch {","        self.error = error","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"When an NFC connection is established, the app fetches data and immediately closes it with a user message:"}],"type":"paragraph"},{"code":["Task {","    await model.update(using: connection)","    await connection.close(message: \"Codes calculated\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Working-with-YubiKey-Data","text":"Working with YubiKey Data","type":"heading","level":2},{"anchor":"Reading-OATH-Codes","text":"Reading OATH Codes","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Once you have a connection, getting TOTP codes is straightforward:"}],"type":"paragraph"},{"code":["private func calculateCodes(using connection: SmartCardConnection) async {","    do {","        let session = try await OATHSession.makeSession(connection: connection)","        let result = try await session.calculateCredentialCodes()","        accounts = result.map { credential, code in","            Account(","                label: credential.label,","                code: code?.code,","                issuer: credential.issuer,","                type: credential.type","            )","        }","    } catch {","        self.error = error","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"calculateCredentialCodes()"},{"type":"text","text":" method returns a dictionary mapping credentials to their current codes. Some codes might be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if they require touch or are password-protected."}],"type":"paragraph"},{"anchor":"Getting-Device-Information","text":"Getting Device Information","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"Management.Session"},{"type":"text","text":" to get YubiKey information:"}],"type":"paragraph"},{"code":["private func getKeyVersion(using connection: SmartCardConnection) async {","    do {","        let session: Management.Session = try await .makeSession(connection: connection)","        self.keyVersion = await session.version.description","    } catch {","        self.error = error","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Model"},{"type":"text","text":" class combines both operations in a single "},{"type":"codeVoice","code":"update"},{"type":"text","text":" method:"}],"type":"paragraph"},{"code":["func update(using connection: SmartCardConnection) async {","    await calculateCodes(using: connection)","    await getKeyVersion(using: connection)","    connectionType = connection.connectionType","}"],"type":"codeListing","syntax":"swift"},{"anchor":"SwiftUI-Integration","text":"SwiftUI Integration","type":"heading","level":2},{"anchor":"Reacting-to-Connection-Changes","text":"Reacting to Connection Changes","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The app uses SwiftUI’s "},{"type":"codeVoice","code":"@Published"},{"type":"text","text":" properties and "},{"type":"codeVoice","code":"onReceive"},{"type":"text","text":" to update the UI when connections change:"}],"type":"paragraph"},{"code":[".onReceive(connectionManager.$wiredConnection) { newConnection in","    guard let connection = newConnection else {","        model.clear()  \/\/ Clear UI when YubiKey unplugged","        return","    }","    Task { await model.update(using: connection) }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This pattern ensures the UI immediately updates when YubiKeys are plugged in or removed."}],"type":"paragraph"},{"anchor":"Platform-Specific-Features","text":"Platform-Specific Features","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The app handles iOS vs macOS differences with conditional compilation:"}],"type":"paragraph"},{"code":["#if os(iOS)",".refreshable {","    await connectionManager.requestNFCConnection()","}","#endif"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"iOS users can pull-to-refresh to scan with NFC, while macOS users only see USB options."}],"type":"paragraph"},{"anchor":"Connection-Type-Detection","text":"Connection Type Detection","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The sample includes a useful extension to identify connection types:"}],"type":"paragraph"},{"code":["extension SmartCardConnection {","    var connectionType: String {","        switch self {","        case _ as NFCSmartCardConnection: return \"NFC\"","        case _ as LightningSmartCardConnection: return \"Lightning\"","        case _ as USBSmartCardConnection: return \"USB\"","        default: return \"Unknown\"","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This is helpful because NFC connections are slower than USB, and users like to know how their YubiKey is connected."}],"type":"paragraph"},{"anchor":"Architecture-Decisions","text":"Architecture Decisions","type":"heading","level":2},{"anchor":"Why-the-connection-management-works-this-way","text":"Why the connection management works this way","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The sample uses a background loop that continuously waits for wired connections. This might seem unusual, but it solves a key problem: YubiKeys get plugged and unplugged frequently, but apps need to stay responsive."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When you unplug your YubiKey, the app doesn’t crash or freeze - it detects the disconnection via "},{"type":"codeVoice","code":"waitUntilClosed()"},{"type":"text","text":" and immediately starts waiting for the next YubiKey. This creates a smoother user experience where the app responds when you plug \/ unplug a YubiKey."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"NFC works differently since you can’t continuously scan - the user has to explicitly initiate each scan. That’s why NFC connections are handled separately through user actions like the scan button or pull-to-refresh."}],"type":"paragraph"},{"anchor":"Error-handling-for-hardware-connections","text":"Error handling for hardware connections","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Hardware connections are unreliable by nature. Users will unplug devices mid-operation, walk away during NFC scans, or have connectivity issues. The sample handles this gracefully:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Connection failures are caught and stored as errors","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"User cancellations (like dismissing NFC scan) are filtered out to avoid unnecessary error alerts","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Session errors are handled similarly - show the error but maintain app functionality","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Working-with-Swift-actors","text":"Working with Swift actors","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"YubiKit sessions are Swift actors that handle their own threading. The sample shows how to integrate this with SwiftUI’s main actor requirements:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ConnectionManager","type":"codeVoice"},{"text":" runs on ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" so it can directly update ","type":"text"},{"code":"@Published","type":"codeVoice"},{"text":" properties","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Session calls happen on the session’s actor, then results are passed back to update the UI","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Everything uses ","type":"text"},{"code":"async\/await","type":"codeVoice"}]}]}],"type":"unorderedList"}]}],"variants":[{"paths":["\/documentation\/yubikit\/oathsamplecode"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"sampleCodeDownload":{"action":{"isActive":true,"overridingTitle":"View Source","type":"reference","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample"},"kind":"sampleDownload"},"metadata":{"role":"sampleCode","color":{"standardColorIdentifier":"green"},"modules":[{"name":"YubiKit"}],"roleHeading":"Sample Code","title":"OATHSample: Basic OATH app showcasing how to integrate the SDK"},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession"},{"text":" to retrieve authentication codes, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},{"text":" to get device information.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"title":"Sample code","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"],"generated":true,"anchor":"Sample-code"}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"OATHSession"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"OATHSession"}],"abstract":[{"text":"An interface to the OATH application on the YubiKey.","type":"text"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","kind":"symbol","url":"\/documentation\/yubikit\/oathsession","title":"OATHSession","role":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Session","kind":"identifier"}],"type":"topic","url":"\/documentation\/yubikit\/management\/session","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","kind":"symbol","navigatorTitle":[{"text":"Session","kind":"identifier"}],"title":"Management.Session","abstract":[{"type":"text","text":"An interface to the Management application on the YubiKey."}],"role":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"An interface to the PIV application on the YubiKey."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","navigatorTitle":[{"text":"PIVSession","kind":"identifier"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}],"title":"PIVSession","kind":"symbol","url":"\/documentation\/yubikit\/pivsession"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}],"type":"topic","url":"\/documentation\/yubikit\/webauthn\/client","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","kind":"symbol","navigatorTitle":[{"text":"Client","kind":"identifier"}],"title":"WebAuthn.Client","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"role":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"role":"sampleCode","type":"topic","abstract":[{"text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts ","type":"text"},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"text":" calls inside a ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" and routes them to a YubiKey. It uses the high-level ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"type":"text","text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" companion module."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","kind":"article","url":"\/documentation\/yubikit\/webauthninterceptorsamplecode"},"https://github.com/Yubico/yubikit-swift/tree/main/Samples/OATHSample":{"checksum":null,"type":"download","url":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"role":"sampleCode","type":"topic","abstract":[{"type":"text","text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","isActive":true},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","title":"PIVTool: Building PIV applications with YubiKey","kind":"article","url":"\/documentation\/yubikit\/pivtoolsamplecode"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"role":"collection","images":[{"identifier":"documentation-header.png","type":"icon"}],"title":"YubiKit","url":"\/documentation\/yubikit","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","type":"topic","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"kind":"symbol"},"documentation-header.png":{"type":"image","alt":"YubiKeys in a row","identifier":"documentation-header.png","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png"}]}}}
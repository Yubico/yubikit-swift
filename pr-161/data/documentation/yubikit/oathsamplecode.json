yword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"url":"\/documentation\/yubikit\/webauthn\/client","title":"WebAuthn.Client"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"role":"collection","images":[{"type":"icon","identifier":"documentation-header.png"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"url":"\/documentation\/yubikit","title":"YubiKit"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"role":"sampleCode","kind":"article","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","abstract":[{"type":"text","text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession"},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}],"url":"\/documentation\/yubikit\/pivtoolsamplecode","title":"PIVTool: Building PIV applications with YubiKey"},"https://github.com/Yubico/yubikit-swift/tree/main/Samples/OATHSample":{"url":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","checksum":null,"type":"download","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample"}}}
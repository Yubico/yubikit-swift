ive":true,"identifier":"https:\/\/github.com\/apple\/swift-log","type":"reference"},{"text":"’s ","type":"text"},{"code":"Logging","type":"codeVoice"},{"text":" product to your app target","type":"text"},{"text":" ","type":"text"},{"text":"to use its backend types. Any SwiftLog ","type":"text"},{"code":"LogHandler","type":"codeVoice"},{"text":" can be supplied by the factory.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;"},{"type":"text","text":" "},{"type":"text","text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,"},{"type":"text","text":" "},{"type":"text","text":"though logs already in progress may use the previous settings."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,"},{"type":"text","text":" "},{"type":"text","text":"pass its factory explicitly; global "},{"code":"LoggingSystem.bootstrap","type":"codeVoice"},{"type":"text","text":" does not select YubiKit’s backend."},{"type":"text","text":" "},{"type":"text","text":"Factories may run concurrently and must not log through YubiKit themselves."}],"type":"paragraph"},{"text":"Traffic logging","level":3,"anchor":"Traffic-logging","type":"heading"},{"syntax":"swift","code":["YubiKit.Logs.configure(logLevel: .trace)"],"type":"codeListing"},{"inlineContent":[{"text":"Raw traffic and SCP plaintext logs require ","type":"text"},{"inlineContent":[{"text":"YubiKit to be compiled with ","type":"text"},{"type":"codeVoice","code":"DEBUG"}],"type":"strong"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Neither configuration nor a custom backend can enable them in other builds.","type":"text"},{"text":" ","type":"text"},{"text":"Custom connections are responsible for their own traffic logging.","type":"text"}],"type":"paragraph"},{"style":"warning","name":"Warning","
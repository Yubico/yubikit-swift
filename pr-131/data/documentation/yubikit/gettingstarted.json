raits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-2~dark@2x.png"}],"identifier":"add-framework-2.png","alt":"An image showing how to add the YubiKit SDK to your Xcode project.","type":"image"},"nfc-identifiers.png":{"variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers~dark@2x.png"}],"identifier":"nfc-identifiers.png","alt":"An image showing how to add the nfc application identifiers.","type":"image"},"add-framework-1.png":{"alt":"An image showing how to add the YubiKit SDK to your Xcode project.","type":"image","identifier":"add-framework-1.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1@2x.png","traits":["2x","light"]},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1~dark@2x.png"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"url":"\/documentation\/yubikit","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","role":"collection","type":"topic","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"images":[{"type":"icon","identifier":"documentation-header.png"}],"title":"YubiKit","kind":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/SmartCardConnection":{"type":"topic","abstract":[{"type":"text","text":"An interface defining a SmartCard based connection to a YubiKey."}],"url":"\/documentation\/yubikit\/smartcardconnection","title":"SmartCardConnection","kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SmartCardConnection","kind":"identifier"}],"navigatorTitle":[{"text":"SmartCardConnection","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/CTAP2/Session":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","url":"\/documentation\/yubikit\/ctap2\/session","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}],"type":"topic","abstract":[{"type":"text","text":"Interface to the FIDO2\/CTAP authenticator on the YubiKey."}],"navigatorTitle":[{"kind":"identifier","text":"Session"}],"title":"CTAP2.Session","kind":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"type":"topic","abstract":[{"text":"Client for performing WebAuthn passkey operations.","type":"text"}],"url":"\/documentation\/yubikit\/webauthn\/client","kind":"symbol","title":"WebAuthn.Client","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"navigatorTitle":[{"kind":"identifier","text":"Client"}]}}}
sion"},{"type":"text","text":" to retrieve authentication codes, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},{"type":"text","text":" to get device information."}],"url":"\/documentation\/yubikit\/oathsamplecode"},"smart-card.png":{"type":"image","alt":"An image showing how to add NFC privacy string to project.","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/smart-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/smart-card~dark@2x.png"}],"identifier":"smart-card.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"kind":"article","title":"PIVTool: Building PIV applications with YubiKey","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","url":"\/documentation\/yubikit\/pivtoolsamplecode","abstract":[{"text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","type":"reference","isActive":true},{"text":" for cryptographic operations, certificate management, and access control.","type":"text"}],"role":"sampleCode","type":"topic"},"external-accessory.png":{"type":"image","alt":"An image showing how to support for lightning YubiKeys.","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/external-accessory@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/external-accessory~dark@2x.png"}],"identifier":"external-accessory.png"},"add-framework-2.png":{"type":"image","alt":"An image showing how to add the YubiKit SDK to your Xcode project.","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-2@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-2~dark@2x.png"}],"identifier":"add-framework-2.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","title":"WebAuthn.Client","fragments":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"url":"\/documentation\/yubikit\/webauthn\/client","abstract":[{"text":"Client for performing WebAuthn passkey operations.","type":"text"}],"navigatorTitle":[{"text":"Client","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/SmartCardConnection":{"url":"\/documentation\/yubikit\/smartcardconnection","title":"SmartCardConnection","abstract":[{"text":"An interface defining a SmartCard based connection to a YubiKey.","type":"text"}],"type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","role":"symbol","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SmartCardConnection","kind":"identifier"}],"navigatorTitle":[{"text":"SmartCardConnection","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/CTAP2/Session":{"kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","navigatorTitle":[{"kind":"identifier","text":"Session"}],"role":"symbol","title":"CTAP2.Session","type":"topic","abstract":[{"type":"text","text":"Interface to the FIDO2\/CTAP authenticator on the YubiKey."}],"url":"\/documentation\/yubikit\/ctap2\/session","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"url":"\/documentation\/yubikit","title":"YubiKit","type":"topic","kind":"symbol","abstract":[{"text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB.","type":"text"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","role":"collection","images":[{"type":"icon","identifier":"documentation-header.png"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","role":"symbol","url":"\/documentation\/yubikit\/pivsession","title":"PIVSession","abstract":[{"text":"An interface to the PIV application on the YubiKey.","type":"text"}],"type":"topic","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}],"navigatorTitle":[{"text":"PIVSession","kind":"identifier"}]},"nfc-privacy.png":{"type":"image","alt":"An image showing how to add the NFC privacy string to a project.","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy~dark@2x.png"}],"identifier":"nfc-privacy.png"}}}
{"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"metadata":{"title":"Getting Started","modules":[{"name":"YubiKit"}],"role":"article","roleHeading":"Article"},"abstract":[{"type":"text","text":"Prepare your project to connect to the YubiKey via NFC, SmartCard and Lightning."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"The YubiKit framework is distributed using the Swift Package Manager. To add the framework to your project follow these steps:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Choose the “Package Dependencies” tab."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Press the plus-button to bring up the add package dialog."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"add-framework-1.png"}]},{"type":"orderedList","start":4,"items":[{"content":[{"inlineContent":[{"text":"Enter ","type":"text"},{"code":"https:\/\/github.com\/Yubico\/yubikit-swift\/","type":"codeVoice"},{"text":" in the search field and select the Yubico Swift Package.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Press the “Add Package” button to add the SDK to your project."}]}]}]},{"type":"paragraph","inlineContent":[{"identifier":"add-framework-2.png","type":"image"}]},{"level":3,"type":"heading","text":"NFC","anchor":"NFC"},{"type":"paragraph","inlineContent":[{"text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC","type":"text"},{"text":" ","type":"text"},{"text":"application identifiers and a NFC Privacy statement to the application.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Add Wireless entitlement"}],"type":"strong"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your project."}]}]},{"content":[{"inlineContent":[{"text":"Select your application target.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Signing & Capabilities” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Click the “+”-button to add a new capability.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Select the “Near Field Communication Tag” capability.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"identifier":"nfc-entitlement.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Add list of NFC application identifiers","type":"text"}],"type":"strong"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the “Info” tab."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”."}],"type":"paragraph"}]}],"start":6},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-identifiers.png"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Add the Yubico NFC application identifiers to enable communication with the different"},{"type":"text","text":" "},{"type":"text","text":"applications on the YubiKey."}],"type":"paragraph"}]}],"start":8},{"type":"codeListing","syntax":null,"code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-identifiers-list.png"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Add a NFC Privacy description"}],"type":"strong"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in","type":"text"},{"text":" ","type":"text"},{"text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”","type":"text"}],"type":"paragraph"}]}],"start":9},{"type":"paragraph","inlineContent":[{"identifier":"nfc-privacy.png","type":"image"}]},{"text":"SmartCard\/USB","type":"heading","level":3,"anchor":"SmartCardUSB"},{"type":"paragraph","inlineContent":[{"text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the","type":"text"},{"text":" ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" entitlement to your application.","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the application entitlements file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" entitlement to the entitlement list."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"smart-card.png"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SmartCard\/USB connection only support the CCID based applications on the YubiKey and does not support U2F, FIDO2 or OTP."}]}],"style":"note","type":"aside","name":"Note"},{"text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey","type":"heading","level":3,"anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey"},{"type":"paragraph","inlineContent":[{"text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" string to the list of External Accessories.","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your project."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not present add the ","type":"text"},{"type":"codeVoice","code":"Supported external accessory protocols"},{"text":" key and insert the string ","type":"text"},{"type":"codeVoice","code":"com.yubico.ylp"},{"text":" in its list.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"external-accessory.png"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for ","type":"text"},{"code":"Supported external accessory protocols","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework.","type":"text"}]}],"style":"note","name":"Note"},{"type":"heading","level":2,"anchor":"Making-Your-First-Connection","text":"Making Your First Connection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device."}]},{"type":"heading","level":3,"anchor":"Understanding-Connection-Types","text":"Understanding Connection Types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit handles three different connection methods:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"NFC","type":"text"}],"type":"strong"},{"text":": Short-range wireless communication (iOS only)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"USB"}],"type":"strong"},{"text":": Direct USB connection via SmartCard interface","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Lightning"}],"type":"strong"},{"text":": YubiKey 5Ci connected to Lightning port (iOS only)","type":"text"}]}]}]},{"inlineContent":[{"text":"Each connection type works differently, so let’s explore how to use them.","type":"text"}],"type":"paragraph"},{"anchor":"NFC-Connections","level":3,"text":"NFC Connections","type":"heading"},{"inlineContent":[{"type":"text","text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:"}],"type":"paragraph"},{"syntax":"swift","code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete."}],"type":"paragraph"},{"anchor":"USB-and-Lightning-Connections","level":3,"text":"USB and Lightning Connections","type":"heading"},{"inlineContent":[{"text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"code":"WiredSmartCardConnection.makeConnection()","type":"codeVoice"},{"type":"text","text":" method automatically detects whether you’re using USB or Lightning."}],"type":"paragraph"},{"anchor":"Specific-Connection-Types","level":3,"text":"Specific Connection Types","type":"heading"},{"inlineContent":[{"type":"text","text":"For more control, you can connect to specific interfaces:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"],"type":"codeListing"},{"anchor":"Understanding-Connection-Lifecycle","level":2,"text":"Understanding Connection Lifecycle","type":"heading"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Critical:"}],"type":"strong"},{"text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time.","type":"text"}],"type":"paragraph"},{"anchor":"Connection-Behavior","level":3,"text":"Connection Behavior","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Exclusive access"}],"type":"strong"},{"text":": Only one connection can exist per YubiKey at any time","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Manual closure required"}]},{"text":": Dropping a connection reference does NOT automatically close it - you must call ","type":"text"},{"type":"codeVoice","code":"close()"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Resource blocking","type":"text"}],"type":"strong"},{"text":": An unclosed connection prevents new connections (throws ","type":"text"},{"type":"codeVoice","code":"SmartCardConnectionError.busy"},{"text":")","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call "},{"type":"codeVoice","code":"close()"},{"type":"text","text":"."}]},{"level":2,"text":"Working with Sessions","anchor":"Working-with-Sessions","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once you have a connection, create sessions to access different YubiKey applications:"}]},{"level":3,"text":"OATH Session (TOTP\/HOTP codes)","anchor":"OATH-Session-TOTPHOTP-codes","type":"heading"},{"syntax":"swift","code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"],"type":"codeListing"},{"level":3,"text":"PIV Session (Certificates and keys)","anchor":"PIV-Session-Certificates-and-keys","type":"heading"},{"syntax":"swift","code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"],"type":"codeListing"},{"level":3,"text":"Management Session (Device information)","anchor":"Management-Session-Device-information","type":"heading"},{"syntax":"swift","code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"],"type":"codeListing"},{"level":3,"text":"WebAuthn Client (FIDO2 \/ passkeys)","anchor":"WebAuthn-Client-FIDO2--passkeys","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For passkey registration and authentication, "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" wraps a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can"},{"type":"text","text":" "},{"type":"text","text":"use "},{"code":"HIDFIDOConnection","type":"codeVoice"},{"type":"text","text":" (USB HID on macOS) or any "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection"},{"type":"text","text":" "},{"type":"text","text":"(NFC \/ USB CCID)."}]},{"code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"PIN and UV are supplied per ceremony via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization"},{"text":". For raw","type":"text"},{"text":" ","type":"text"},{"text":"CTAP2 access (credential management, bio enrollment, large blobs), use","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"text":" directly.","type":"text"}],"type":"paragraph"},{"text":"Connection Management Patterns","anchor":"Connection-Management-Patterns","type":"heading","level":2},{"text":"For UI Applications","anchor":"For-UI-Applications","type":"heading","level":3},{"inlineContent":[{"text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","type":"reference"},{"text":" for complete examples of reactive connection management patterns that automatically update your UI when YubiKeys are plugged in or removed.","type":"text"}],"type":"paragraph"},{"text":"For Command-Line Tools","anchor":"For-Command-Line-Tools","type":"heading","level":3},{"inlineContent":[{"text":"CLI applications often use a simpler approach with a single connection per operation. See ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","isActive":true,"type":"reference"},{"text":" for examples of how command-line tools handle connections for one-time operations.","type":"text"}],"type":"paragraph"},{"text":"Next Steps","anchor":"Next-Steps","type":"heading","level":2},{"inlineContent":[{"text":"Now you’re ready to build YubiKey applications! Check out the sample projects to see complete implementations:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"OATHSample","type":"text"}]},{"type":"text","text":": Shows how to build a TOTP authenticator app with SwiftUI"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"PIVTool"}]},{"type":"text","text":": Demonstrates PIV operations for certificates and digital signatures"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"WebAuthnInterceptorSample"}]},{"type":"text","text":": Routes WebAuthn calls from a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" through "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" to a YubiKey"}]}]}]},{"text":"Build SDK documentation","anchor":"Build-SDK-documentation","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"You can also build the complete SDK documentation by selecting “Product” -> “Build Documentation” in Xcode. This gives you access to the full YubiKit API reference."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select an iOS target when building documentation to include all connection types.","type":"text"}]}],"name":"Note","style":"note","type":"aside"}]}],"variants":[{"paths":["\/documentation\/yubikit\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted"},"references":{"add-framework-1.png":{"type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1~dark@2x.png","traits":["2x","dark"]}],"identifier":"add-framework-1.png","alt":"An image showing how to add the YubiKit SDK to your Xcode project."},"nfc-entitlement.png":{"type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement~dark@2x.png"}],"identifier":"nfc-entitlement.png","alt":"An image showing how to add wireless entitlements to project."},"external-accessory.png":{"alt":"An image showing how to support for lightning YubiKeys.","type":"image","identifier":"external-accessory.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory~dark@2x.png","traits":["2x","dark"]}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authorization":{"navigatorTitle":[{"text":"Authorization","kind":"identifier"}],"url":"\/documentation\/yubikit\/webauthn\/authorization","kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","type":"topic","title":"WebAuthn.Authorization","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Authorization","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"PIN\/UV policy for a single WebAuthn ceremony."}]},"add-framework-2.png":{"type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-2@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-2~dark@2x.png","traits":["2x","dark"]}],"identifier":"add-framework-2.png","alt":"An image showing how to add the YubiKit SDK to your Xcode project."},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"title":"YubiKit","role":"collection","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","kind":"symbol","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"type":"topic","images":[{"identifier":"documentation-header.png","type":"icon"}],"url":"\/documentation\/yubikit"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"OATHSession"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","url":"\/documentation\/yubikit\/oathsession","role":"symbol","abstract":[{"text":"An interface to the OATH application on the YubiKey.","type":"text"}],"title":"OATHSession","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"OATHSession"}],"type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"kind":"article","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","url":"\/documentation\/yubikit\/pivtoolsamplecode","role":"sampleCode","abstract":[{"text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","type":"reference"},{"text":" for cryptographic operations, certificate management, and access control.","type":"text"}],"title":"PIVTool: Building PIV applications with YubiKey","type":"topic"},"nfc-identifiers.png":{"type":"image","alt":"An image showing how to add the nfc application identifiers.","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers~dark@2x.png"}],"identifier":"nfc-identifiers.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"navigatorTitle":[{"kind":"identifier","text":"Client"}],"url":"\/documentation\/yubikit\/webauthn\/client","kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","title":"WebAuthn.Client","type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Client"}],"role":"symbol","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PIVSession"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","url":"\/documentation\/yubikit\/pivsession","role":"symbol","abstract":[{"type":"text","text":"An interface to the PIV application on the YubiKey."}],"title":"PIVSession","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"PIVSession"}],"type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"kind":"symbol","url":"\/documentation\/yubikit\/management\/session","abstract":[{"text":"An interface to the Management application on the YubiKey.","type":"text"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}],"navigatorTitle":[{"text":"Session","kind":"identifier"}],"type":"topic","role":"symbol","title":"Management.Session","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSampleCode":{"url":"\/documentation\/yubikit\/oathsamplecode","kind":"article","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","type":"topic","title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","role":"sampleCode","abstract":[{"type":"text","text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"reference","isActive":true},{"type":"text","text":" to retrieve authentication codes, and "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"reference"},{"type":"text","text":" to get device information."}]},"documentation-header.png":{"type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}],"identifier":"documentation-header.png","alt":"YubiKeys in a row"},"smart-card.png":{"type":"image","alt":"An image showing how to add NFC privacy string to project.","identifier":"smart-card.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/smart-card@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/smart-card~dark@2x.png","traits":["2x","dark"]}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/CTAP2/Session":{"kind":"symbol","url":"\/documentation\/yubikit\/ctap2\/session","abstract":[{"text":"Interface to the FIDO2\/CTAP authenticator on the YubiKey.","type":"text"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}],"navigatorTitle":[{"text":"Session","kind":"identifier"}],"type":"topic","role":"symbol","title":"CTAP2.Session","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},"nfc-privacy.png":{"type":"image","alt":"An image showing how to add the NFC privacy string to a project.","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy~dark@2x.png"}],"identifier":"nfc-privacy.png"},"nfc-identifiers-list.png":{"type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list~dark@2x.png","traits":["2x","dark"]}],"identifier":"nfc-identifiers-list.png","alt":"An image showing the list of nfc identifiers added."},"doc://yubikit-swift.YubiKit/documentation/YubiKit/SmartCardConnection":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SmartCardConnection"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","url":"\/documentation\/yubikit\/smartcardconnection","role":"symbol","abstract":[{"text":"An interface defining a SmartCard based connection to a YubiKey.","type":"text"}],"title":"SmartCardConnection","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SmartCardConnection"}],"type":"topic"}}}
{"abstract":[{"text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"reference"},{"text":" to retrieve authentication codes, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"reference"},{"text":" to get device information.","type":"text"}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","interfaceLanguage":"swift"},"sections":[],"sampleCodeDownload":{"kind":"sampleDownload","action":{"isActive":true,"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","type":"reference","overridingTitle":"View Source"}},"metadata":{"color":{"standardColorIdentifier":"green"},"roleHeading":"Sample Code","role":"sampleCode","modules":[{"name":"YubiKit"}],"title":"OATHSample: Basic OATH app showcasing how to integrate the SDK"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/oathsamplecode"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"],"anchor":"Sample-code","generated":true,"title":"Sample code"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"The sample creates an authenticator app that:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Establishes connections to YubiKeys via USB, Lightning, or NFC","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Manages connection lifecycle (detecting plugged\/unplugged devices)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists TOTP codes stored on the YubiKey","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Shows device information like firmware version","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Handles connection errors and user cancellations gracefully"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"This sample focuses on read-only operations and doesn’t handle password-protected YubiKeys or credential management.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Connection Management","anchor":"Connection-Management"},{"type":"heading","level":3,"text":"Handling Wired Connections","anchor":"Handling-Wired-Connections"},{"inlineContent":[{"type":"text","text":"The app uses a "},{"type":"codeVoice","code":"ConnectionManager"},{"type":"text","text":" to handle persistent connections to plugged-in YubiKeys. This approach ensures your app stays responsive when users plug and unplug their YubiKeys:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["private func startWiredConnection() {","    wiredConnectionTask = Task { @MainActor in","        while !Task.isCancelled {","            do {","                let newConnection = try await WiredSmartCardConnection.makeConnection()","                wiredConnection = newConnection","","                \/\/ Wait for disconnect","                let closeError = await newConnection.waitUntilClosed()","                wiredConnection = nil","            } catch {","                self.error = error","            }","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"The key insight here is using "},{"type":"codeVoice","code":"waitUntilClosed()"},{"type":"text","text":" to detect when the YubiKey is unplugged, then automatically waiting for the next connection."}],"type":"paragraph"},{"type":"heading","level":3,"text":"NFC Connections","anchor":"NFC-Connections"},{"inlineContent":[{"text":"NFC connections work differently - they’re initiated by user action and are short-lived:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func requestNFCConnection() async {","    do {","        nfcConnection = try await NFCSmartCardConnection()","    } catch {","        self.error = error","    }","}"]},{"inlineContent":[{"type":"text","text":"When an NFC connection is established, the app fetches data and immediately closes it with a user message:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Task {","    await model.update(using: connection)","    await connection.close(message: \"Codes calculated\")","}"]},{"type":"heading","level":2,"text":"Working with YubiKey Data","anchor":"Working-with-YubiKey-Data"},{"type":"heading","level":3,"text":"Reading OATH Codes","anchor":"Reading-OATH-Codes"},{"inlineContent":[{"text":"Once you have a connection, getting TOTP codes is straightforward:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["private func calculateCodes(using connection: SmartCardConnection) async {","    do {","        let session = try await OATHSession.makeSession(connection: connection)","        let result = try await session.calculateCredentialCodes()","        accounts = result.map { credential, code in","            Account(","                label: credential.label,","                code: code?.code,","                issuer: credential.issuer,","                type: credential.type","            )","        }","    } catch {","        self.error = error","    }","}"]},{"inlineContent":[{"type":"text","text":"The "},{"code":"calculateCredentialCodes()","type":"codeVoice"},{"type":"text","text":" method returns a dictionary mapping credentials to their current codes. Some codes might be "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if they require touch or are password-protected."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Getting Device Information","anchor":"Getting-Device-Information"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"Management.Session","type":"codeVoice"},{"text":" to get YubiKey information:","type":"text"}]},{"type":"codeListing","code":["private func getKeyVersion(using connection: SmartCardConnection) async {","    do {","        let session: Management.Session = try await .makeSession(connection: connection)","        self.keyVersion = await session.version.description","    } catch {","        self.error = error","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Model"},{"type":"text","text":" class combines both operations in a single "},{"type":"codeVoice","code":"update"},{"type":"text","text":" method:"}]},{"type":"codeListing","code":["func update(using connection: SmartCardConnection) async {","    await calculateCodes(using: connection)","    await getKeyVersion(using: connection)","    connectionType = connection.connectionType","}"],"syntax":"swift"},{"anchor":"SwiftUI-Integration","type":"heading","level":2,"text":"SwiftUI Integration"},{"anchor":"Reacting-to-Connection-Changes","type":"heading","level":3,"text":"Reacting to Connection Changes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app uses SwiftUI’s "},{"type":"codeVoice","code":"@Published"},{"type":"text","text":" properties and "},{"type":"codeVoice","code":"onReceive"},{"type":"text","text":" to update the UI when connections change:"}]},{"type":"codeListing","code":[".onReceive(connectionManager.$wiredConnection) { newConnection in","    guard let connection = newConnection else {","        model.clear()  \/\/ Clear UI when YubiKey unplugged","        return","    }","    Task { await model.update(using: connection) }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This pattern ensures the UI immediately updates when YubiKeys are plugged in or removed."}]},{"anchor":"Platform-Specific-Features","type":"heading","level":3,"text":"Platform-Specific Features"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app handles iOS vs macOS differences with conditional compilation:"}]},{"type":"codeListing","code":["#if os(iOS)",".refreshable {","    await connectionManager.requestNFCConnection()","}","#endif"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS users can pull-to-refresh to scan with NFC, while macOS users only see USB options."}]},{"anchor":"Connection-Type-Detection","type":"heading","level":3,"text":"Connection Type Detection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample includes a useful extension to identify connection types:"}]},{"type":"codeListing","code":["extension SmartCardConnection {","    var connectionType: String {","        switch self {","        case _ as NFCSmartCardConnection: return \"NFC\"","        case _ as LightningSmartCardConnection: return \"Lightning\"","        case _ as USBSmartCardConnection: return \"USB\"","        default: return \"Unknown\"","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This is helpful because NFC connections are slower than USB, and users like to know how their YubiKey is connected.","type":"text"}]},{"anchor":"Architecture-Decisions","type":"heading","level":2,"text":"Architecture Decisions"},{"anchor":"Why-the-connection-management-works-this-way","type":"heading","level":3,"text":"Why the connection management works this way"},{"type":"paragraph","inlineContent":[{"text":"The sample uses a background loop that continuously waits for wired connections. This might seem unusual, but it solves a key problem: YubiKeys get plugged and unplugged frequently, but apps need to stay responsive.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you unplug your YubiKey, the app doesn’t crash or freeze - it detects the disconnection via "},{"type":"codeVoice","code":"waitUntilClosed()"},{"type":"text","text":" and immediately starts waiting for the next YubiKey. This creates a smoother user experience where the app responds when you plug \/ unplug a YubiKey."}]},{"type":"paragraph","inlineContent":[{"text":"NFC works differently since you can’t continuously scan - the user has to explicitly initiate each scan. That’s why NFC connections are handled separately through user actions like the scan button or pull-to-refresh.","type":"text"}]},{"text":"Error handling for hardware connections","type":"heading","level":3,"anchor":"Error-handling-for-hardware-connections"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hardware connections are unreliable by nature. Users will unplug devices mid-operation, walk away during NFC scans, or have connectivity issues. The sample handles this gracefully:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Connection failures are caught and stored as errors","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"User cancellations (like dismissing NFC scan) are filtered out to avoid unnecessary error alerts"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Session errors are handled similarly - show the error but maintain app functionality"}],"type":"paragraph"}]}]},{"text":"Working with Swift actors","type":"heading","level":3,"anchor":"Working-with-Swift-actors"},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit sessions are Swift actors that handle their own threading. The sample shows how to integrate this with SwiftUI’s main actor requirements:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ConnectionManager"},{"type":"text","text":" runs on "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" so it can directly update "},{"type":"codeVoice","code":"@Published"},{"type":"text","text":" properties"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Session calls happen on the session’s actor, then results are passed back to update the UI"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Everything uses ","type":"text"},{"code":"async\/await","type":"codeVoice"}]}]}]}],"kind":"content"}],"references":{"documentation-header.png":{"type":"image","identifier":"documentation-header.png","alt":"YubiKeys in a row","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"kind":"symbol","url":"\/documentation\/yubikit\/management\/session","abstract":[{"text":"An interface to the Management application on the YubiKey.","type":"text"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}],"navigatorTitle":[{"text":"Session","kind":"identifier"}],"type":"topic","role":"symbol","title":"Management.Session","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"OATHSession"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","url":"\/documentation\/yubikit\/oathsession","role":"symbol","abstract":[{"text":"An interface to the OATH application on the YubiKey.","type":"text"}],"title":"OATHSession","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"OATHSession"}],"type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"navigatorTitle":[{"kind":"identifier","text":"Client"}],"url":"\/documentation\/yubikit\/webauthn\/client","kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","title":"WebAuthn.Client","type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Client"}],"role":"symbol","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"title":"YubiKit","role":"collection","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","kind":"symbol","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"type":"topic","images":[{"identifier":"documentation-header.png","type":"icon"}],"url":"\/documentation\/yubikit"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"type":"topic","url":"\/documentation\/yubikit\/webauthninterceptorsamplecode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","abstract":[{"text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"text":" calls inside a ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":" and routes them to a YubiKey. It uses the high-level ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small ","type":"text"},{"code":"FidoUI","
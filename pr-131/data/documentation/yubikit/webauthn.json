rview"},{"type":"paragraph","inlineContent":[{"text":"Contains the high-level passkey ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":" and the request, response, and","type":"text"},{"text":" ","type":"text"},{"text":"data-model types defined by the","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"specification.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A passkey client and the W3C Web Authentication data model, mediated by a YubiKey.","type":"text"}]},{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"WebAuthn","type":"codeVoice"},{"text":" namespace provides a high-level passkey client (","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":") that runs","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/","overridingTitle":"Web Authentication Level 3","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Web Authentication Level 3"}],"type":"reference"},{"text":" ceremonies against a","type":"text"},{"text":" ","type":"text"},{"text":"YubiKey, plus the request and response types defined by the WebAuthn specification.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A WebAuthn ceremony involves three parties: the ","type":"text"},{"inlineContent":[{"type":"text","text":"authenticator"}],"type":"strong"},{"text":" (a YubiKey), the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"client"}],"type":"strong"},{"text":" (your app, via ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":"), and the ","type":"text"},{"inlineContent":[{"type":"text","text":"relying party"}],"type":"strong"},{"text":" (your server, which","type":"text"},{"text":" ","type":"text"},{"text":"verifies what the authenticator returns). The client is the communication path between","type":"text"},{"text":" ","type":"text"},{"text":"authenticator and relying party — and it verifies the relying party’s identity against","type":"text"},{"text":" ","type":"text"},{"text":"the origin it’s bound to, so it can refuse to sign for a fraudulent site.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"There are two ceremonies. ","type":"text"},{"inlineContent":[{"type":"text","text":"Registration"}],"type":"strong"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","isActive":true,"type":"reference"},{"text":") creates a new credential and supplies its","type":"text"},{"text":" ","type":"text"},{"text":"public key to the relying party for account association. ","type":"text"},{"inlineContent":[{"type":"text","text":"Authentication"}],"type":"strong"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","isActive":true,"type":"reference"},{"text":") proves to the relying party that the","type":"text"},{"text":" ","type":"text"},{"text":"YubiKey is the one registered for the user. Both ceremonies follow the same mechanical","type":"text"},{"text":" ","type":"text"},{"text":"shape: the relying party supplies a challenge, the authenticator signs it together","type":"text"},{"text":" ","type":"text"},{"text":"with the relying-party identifier, and the signature goes back to the relying party","type":"text"},{"text":" ","type":"text"},{"text":"for verification.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The pieces fit together as: a connection carries CTAP2 traffic, a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"sits on top, and ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":" runs ceremonies on that session. Connections come in","type":"text"},{"text":" ","type":"text"},{"text":"three flavours that all work for WebAuthn: ","type":"text"},{"code":"YubiKit\/HIDFIDOConnection","type":"codeVoice"},{"text":" on macOS,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection","isActive":true,"type":"reference"},{"text":" for tap-to-auth on iOS, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/USBSmartCardConnection","isActive":true,"type":"reference"},{"text":" on either platform. Pick the one that matches","type":"text"},{"text":" ","type":"text"},{"text":"your platform and form factor.","type":"text"}]},{"type":"codeListing","code":["\/\/ macOS — USB HID FIDO","let connection = try await HIDFIDOConnection()","\/\/ iOS — tap-to-auth over NFC:","\/\/ let connection = try await NFCSmartCardConnection()","","let session = try await CTAP2.Session.makeSession(connection: connection)","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","\/\/ Register a new passkey","let registration = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value","","\/\/ Authenticate","let assertions = try await client.getAssertion(","    .init(challenge: challenge, rpId: \"example.com\"),","    authorization: .pin(\"1234\")",").value"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Most apps start with ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":". For lower-level CTAP2 access — raw ","type":"text"},{"code":"makeCredential","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":"getAssertion","type":"codeVoice"},{"text":", credential management, bio enrollment — use ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true,"type":"reference"},{"text":" directly.","type":"text"}]}],"kind":"content"}],"metadata":{"symbolKind":"enum","title":"WebAuthn","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WebAuthn","kind":"identifier"}],"externalID":"s:7YubiKit8WebAuthnO","role":"symbol","roleHeading":"Enumeration","navigatorTitle":[{"text":"WebAuthn","kind":"identifier"}],"modules":[{"name":"YubiKit"}]},"sections":[],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/ClientData":{"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ClientData"}],"title":"WebAuthn.ClientData","abstract":[{"type":"text","text":"Client data for WebAuthn operations."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientData","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientData"}],"url":"\/documentation\/yubikit\/webauthn\/clientdata"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client/getAssertion(_:authorization:)":{"type":"topic","title":"getAssertion(_:authorization:)","url":"\/documentation\/yubikit\/webauthn\/client\/getassertion(_:authorization:)",
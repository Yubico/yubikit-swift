{"sections":[],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"anchor":"Sample-code","generated":true,"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"],"title":"Sample code"}],"primaryContentSections":[{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The interceptor demonstrates how to:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Intercept "},{"type":"codeVoice","code":"navigator.credentials.create()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"navigator.credentials.get()"},{"type":"text","text":" in a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options"},{"text":" \/ ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options"},{"text":" types.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Drive the SDK’s high-level ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the bundled "},{"code":"FidoUI","type":"codeVoice"},{"text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface."}],"type":"paragraph"},{"type":"heading","text":"Architecture Overview","level":2,"anchor":"Architecture-Overview"},{"inlineContent":[{"type":"text","text":"The sample itself is intentionally thin:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Interceptor.js","type":"text"}]},{"type":"text","text":" — injected into the "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" to monkey-patch "},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"type":"text","text":" and shuttle requests\/responses through "},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"WebView.swift"}]},{"type":"text","text":" — "},{"code":"UIViewRepresentable","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"NSViewRepresentable","type":"codeVoice"},{"type":"text","text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"WebAuthnHandler.swift","type":"text"}],"type":"strong"},{"type":"text","text":" — decodes the JSON envelope, builds a "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference","isActive":true},{"text":", and calls ","type":"text"},{"type":"codeVoice","code":"FidoUI.makeCredential"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"FidoUI.getAssertion"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"ContentView.swift","type":"text"}]},{"text":" — minimal SwiftUI shell with a URL bar and back button.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"FidoUI","type":"text"}]},{"type":"text","text":" (separate Swift package under "},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI"},{"type":"text","text":") — the reusable UI + transport layer described below."}]}]}]},{"inlineContent":[{"text":"The end-to-end flow:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Page JS calls "},{"code":"navigator.credentials.create()","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":".get()","type":"codeVoice"},{"type":"text","text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" decodes the JSON straight into the SDK’s strongly-typed "},{"type":"codeVoice","code":"Options"},{"type":"text","text":" and hands them to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"text":" opens a transport, runs the ceremony via ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":", and shows PIN \/ UV \/ error \/ success panels as needed.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The resulting ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","isActive":true,"type":"reference"},{"text":" is serialized via its built-in ","type":"text"},{"code":"toJSON()","type":"codeVoice"},{"text":" and posted back to JS.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"heading","level":2,"anchor":"Intercepting-WebAuthn-Calls","text":"Intercepting WebAuthn Calls"},{"type":"heading","level":3,"anchor":"JavaScript-Injection","text":"JavaScript Injection"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" replaces "},{"type":"codeVoice","code":"navigator.credentials.create"},{"type":"text","text":" and "},{"type":"codeVoice","code":"navigator.credentials.get"},{"type":"text","text":" with versions that forward to Swift. Binary fields ("},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", "},{"type":"codeVoice","code":"user.id"},{"type":"text","text":", "},{"type":"codeVoice","code":"rawId"},{"type":"text","text":", …) are serialized to "},{"type":"strong","inlineContent":[{"text":"base64url","type":"text"}]},{"type":"text","text":" strings via "},{"type":"codeVoice","code":"JSON.stringify"},{"type":"text","text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed."}]},{"type":"codeListing","syntax":"javascript","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The script is injected at document start so it runs before any page code:"}]},{"type":"codeListing","syntax":"swift","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"]},{"type":"paragraph","inlineContent":[{"code":"shouldIntercept","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for any ","type":"text"},{"code":"publicKey","type":"codeVoice"},{"text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when ","type":"text"},{"code":"publicKey.hints","type":"codeVoice"},{"text":" includes ","type":"text"},{"code":"\"security-key\"","type":"codeVoice"},{"text":").","type":"text"}]},{"level":3,"anchor":"Receiving-Messages-in-Swift","type":"heading","text":"Receiving Messages in Swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Coordinator"},{"text":" is both ","type":"text"},{"type":"codeVoice","code":"WKNavigationDelegate"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"shutdown()","type":"codeVoice"},{"type":"text","text":" is called from "},{"code":"dismantle{UI,NS}View","type":"codeVoice"},{"type":"text","text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle."}]},{"level":2,"anchor":"Driving-the-Ceremony","type":"heading","text":"Driving the Ceremony"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"text":" is intentionally tiny — it decodes the envelope, builds a typed ","type":"text"},{"type":"codeVoice","code":"Origin"},{"text":", and delegates to ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"handleGet"},{"type":"text","text":" is the symmetric counterpart that decodes "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"fidoUI.getAssertion"},{"type":"text","text":". The response JSON produced by "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to "},{"type":"codeVoice","code":"ArrayBuffer"},{"type":"text","text":" when it materializes the credential."}]},{"text":"Returning the Response to JavaScript","level":2,"type":"heading","anchor":"Returning-the-Response-to-JavaScript"},{"inlineContent":[{"text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"],"type":"codeListing"},{"inlineContent":[{"text":"JavaScript decodes the JSON and rebuilds a ","type":"text"},{"code":"PublicKeyCredential","type":"codeVoice"},{"text":"-shaped object — converting the base64url binary fields back to ","type":"text"},{"code":"ArrayBuffer","type":"codeVoice"},{"text":"s and wiring up ","type":"text"},{"code":"getClientExtensionResults","type":"codeVoice"},{"text":", ","type":"text"},{"code":"getAuthenticatorData","type":"codeVoice"},{"text":", ","type":"text"},{"code":"getPublicKey","type":"codeVoice"},{"text":", ","type":"text"},{"code":"toJSON","type":"codeVoice"},{"text":", and the rest. Errors travel through a parallel ","type":"text"},{"code":"__webauthn_error__","type":"codeVoice"},{"text":" channel and surface to the page as a ","type":"text"},{"code":"DOMException","type":"codeVoice"},{"text":" with name ","type":"text"},{"code":"NotAllowedError","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"The FidoUI Module","level":2,"type":"heading","anchor":"The-FidoUI-Module"},{"inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting "},{"type":"codeVoice","code":"navigator.credentials.*"},{"type":"text","text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Transport selection."}],"type":"strong"},{"text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Ceremony serialization.","type":"text"}]},{"type":"text","text":" Concurrent calls on the same "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Cancellation.","type":"text"}],"type":"strong"},{"type":"text","text":" A single "},{"code":"cancel()","type":"codeVoice"},{"type":"text","text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The host code only needs to construct one ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" instance and call ","type":"text"},{"type":"codeVoice","code":"makeCredential"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"getAssertion"},{"text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See ","type":"text"},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/","type":"codeVoice"},{"text":" for the full source.","type":"text"}]},{"anchor":"Platform-Notes","type":"heading","text":"Platform Notes","level":2},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"iOS."}],"type":"strong"},{"type":"text","text":" The wired path goes through CryptoTokenKit ("},{"type":"codeVoice","code":"WiredSmartCardConnection"},{"type":"text","text":" — USB-C or Lightning), and the NFC path through "},{"type":"codeVoice","code":"NFCSmartCardConnection"},{"type":"text","text":". The sample’s "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"NFCReaderUsageDescription"},{"type":"text","text":" and lists the FIDO applet AID ("},{"type":"codeVoice","code":"A0000006472F0001"},{"type":"text","text":") under "},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers"},{"type":"text","text":"; the entitlements turn on "},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.formats"},{"type":"text","text":" ("},{"type":"codeVoice","code":"TAG"},{"type":"text","text":") and "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS."}]},{"text":" ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" uses ","type":"text"},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables "},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"type":"text","text":" and "},{"code":"com.apple.security.device.usb","type":"codeVoice"},{"type":"text","text":" so the same target builds cleanly for both platforms."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Where to Customize","anchor":"Where-to-Customize","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Which requests get intercepted.","type":"text"}],"type":"strong"},{"text":" Edit ","type":"text"},{"code":"shouldIntercept","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"Interceptor.js","type":"codeVoice"},{"text":" to scope by hint, RP ID, or any other heuristic.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Origin verification.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" builds a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference","isActive":true},{"text":" from ","type":"text"},{"code":"window.location.origin","type":"codeVoice"},{"text":". Replace the ","type":"text"},{"code":"isPublicSuffix","type":"codeVoice"},{"text":" closure passed to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" with a real public-suffix-list check before shipping.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"UI.","type":"text"}]},{"type":"text","text":" Swap or restyle the panels in "},{"type":"codeVoice","code":"FidoUI\/Sources\/FidoUI\/Views\/"},{"text":" — the rest of the module is UI-agnostic.","type":"text"}]}]}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/docum
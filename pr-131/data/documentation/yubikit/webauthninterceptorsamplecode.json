{"kind":"article","hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","interfaceLanguage":"swift"},"sections":[],"metadata":{"title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","color":{"standardColorIdentifier":"yellow"},"modules":[{"name":"YubiKit"}],"role":"sampleCode","roleHeading":"Sample Code"},"variants":[{"paths":["\/documentation\/yubikit\/webauthninterceptorsamplecode"],"traits":[{"interfaceLanguage":"swift"}]}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"type":"reference","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample","isActive":true,"overridingTitle":"View Source"}},"abstract":[{"text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts ","type":"text"},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"text":" calls inside a ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" and routes them to a YubiKey. It uses the high-level ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" companion module.","type":"text"}],"seeAlsoSections":[{"title":"Sample code","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"],"generated":true,"anchor":"Sample-code"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The interceptor demonstrates how to:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Intercept ","type":"text"},{"code":"navigator.credentials.create()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"navigator.credentials.get()","type":"codeVoice"},{"text":" in a ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options","type":"reference"},{"text":" \/ ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","type":"reference"},{"text":" types.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Drive the SDK’s high-level ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use the bundled ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface.","type":"text"}]},{"text":"Architecture Overview","type":"heading","level":2,"anchor":"Architecture-Overview"},{"type":"paragraph","inlineContent":[{"text":"The sample itself is intentionally thin:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Interceptor.js"}],"type":"strong"},{"text":" — injected into the ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" to monkey-patch ","type":"text"},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"text":" and shuttle requests\/responses through ","type":"text"},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"WebView.swift"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"UIViewRepresentable","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"NSViewRepresentable","type":"codeVoice"},{"text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"WebAuthnHandler.swift"}],"type":"strong"},{"text":" — decodes the JSON envelope, builds a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference"},{"text":", and calls ","type":"text"},{"code":"FidoUI.makeCredential","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"FidoUI.getAssertion","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"ContentView.swift"}],"type":"strong"},{"text":" — minimal SwiftUI shell with a URL bar and back button.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"FidoUI"}],"type":"strong"},{"text":" (separate Swift package under ","type":"text"},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI","type":"codeVoice"},{"text":") — the reusable UI + transport layer described below.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The end-to-end flow:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Page JS calls ","type":"text"},{"code":"navigator.credentials.create()","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".get()","type":"codeVoice"},{"text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" decodes the JSON straight into the SDK’s strongly-typed ","type":"text"},{"code":"Options","type":"codeVoice"},{"text":" and hands them to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"FidoUI","type":"codeVoice"},{"text":" opens a transport, runs the ceremony via ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":", and shows PIN \/ UV \/ error \/ success panels as needed.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The resulting ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","type":"reference"},{"text":" is serialized via its built-in ","type":"text"},{"code":"toJSON()","type":"codeVoice"},{"text":" and posted back to JS.","type":"text"}],"type":"paragraph"}]}]},{"text":"Intercepting WebAuthn Calls","type":"heading","level":2,"anchor":"Intercepting-WebAuthn-Calls"},{"text":"JavaScript Injection","type":"heading","level":3,"anchor":"JavaScript-Injection"},{"type":"paragraph","inlineContent":[{"code":"Interceptor.js","type":"codeVoice"},{"text":" replaces ","type":"text"},{"code":"navigator.credentials.create","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"navigator.credentials.get","type":"codeVoice"},{"text":" with versions that forward to Swift. Binary fields (","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"user.id","type":"codeVoice"},{"text":", ","type":"text"},{"code":"rawId","type":"codeVoice"},{"text":", …) are serialized to ","type":"text"},{"inlineContent":[{"type":"text","text":"base64url"}],"type":"strong"},{"text":" strings via ","type":"text"},{"code":"JSON.stringify","type":"codeVoice"},{"text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed.","type":"text"}]},{"code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"],"type":"codeListing","syntax":"javascript"},{"type":"paragraph","inlineContent":[{"text":"The script is injected at document start so it runs before any page code:","type":"text"}]},{"code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"shouldIntercept","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for any ","type":"text"},{"code":"publicKey","type":"codeVoice"},{"text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when ","type":"text"},{"code":"publicKey.hints","type":"codeVoice"},{"text":" includes ","type":"text"},{"code":"\"security-key\"","type":"codeVoice"},{"text":").","type":"text"}]},{"text":"Receiving Messages in Swift","type":"heading","level":3,"anchor":"Receiving-Messages-in-Swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"Coordinator","type":"codeVoice"},{"text":" is both ","type":"text"},{"code":"WKNavigationDelegate","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:","type":"text"}]},{"code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"shutdown()","type":"codeVoice"},{"type":"text","text":" is called from "},{"code":"dismantle{UI,NS}View","type":"codeVoice"},{"type":"text","text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle."}]},{"text":"Driving the Ceremony","type":"heading","level":2,"anchor":"Driving-the-Ceremony"},{"type":"paragraph","inlineContent":[{"code":"WebAuthnHandler","type":"codeVoice"},{"type":"text","text":" is intentionally tiny — it decodes the envelope, builds a typed "},{"code":"Origin","type":"codeVoice"},{"type":"text","text":", and delegates to "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself."}]},{"code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"handleGet","type":"codeVoice"},{"type":"text","text":" is the symmetric counterpart that decodes "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","isActive":true,"type":"reference"},{"type":"text","text":" and calls "},{"code":"fidoUI.getAssertion","type":"codeVoice"},{"type":"text","text":". The response JSON produced by "},{"code":"toJSON()","type":"codeVoice"},{"type":"text","text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to "},{"code":"ArrayBuffer","type":"codeVoice"},{"type":"text","text":" when it materializes the credential."}]},{"text":"Returning the Response to JavaScript","type":"heading","level":2,"anchor":"Returning-the-Response-to-JavaScript"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:"}]},{"code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"JavaScript decodes the JSON and rebuilds a "},{"code":"PublicKeyCredential","type":"codeVoice"},{"type":"text","text":"-shaped object — converting the base64url binary fields back to "},{"code":"ArrayBuffer","type":"codeVoice"},{"type":"text","text":"s and wiring up "},{"code":"getClientExtensionResults","type":"codeVoice"},{"type":"text","text":", "},{"code":"getAuthenticatorData","type":"codeVoice"},{"type":"text","text":", "},{"code":"getPublicKey","type":"codeVoice"},{"type":"text","text":", "},{"code":"toJSON","type":"codeVoice"},{"type":"text","text":", and the rest. Errors travel through a parallel "},{"code":"__webauthn_error__","type":"codeVoice"},{"type":"text","text":" channel and surface to the page as a "},{"code":"DOMException","type":"codeVoice"},{"type":"text","text":" with name "},{"code":"NotAllowedError","type":"codeVoice"},{"type":"text","text":"."}]},{"text":"The FidoUI Module","type":"heading","level":2,"anchor":"The-FidoUI-Module"},{"type":"paragraph","inlineContent":[{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" is a "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting "},{"code":"navigator.credentials.*","type":"codeVoice"},{"type":"text","text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Transport selection.","type":"text"}],"type":"strong"},{"type":"text","text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Ceremony serialization.","type":"text"}],"type":"strong"},{"type":"text","text":" Concurrent calls on the same "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Cancellation.","type":"text"}],"type":"strong"},{"type":"text","text":" A single "},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The host code only needs to construct one "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" instance and call "},{"code":"makeCredential","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"getAssertion","type":"codeVoice"},{"type":"text","text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See "},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/","type":"codeVoice"},{"type":"text","text":" for the full source."}]},{"text":"Platform Notes","type":"heading","level":2,"anchor":"Platform-Notes"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"iOS.","type":"text"}],"type":"strong"},{"type":"text","text":" The wired path goes through CryptoTokenKit ("},{"type":"codeVoice","code":"WiredSmartCardConnection"},{"type":"text","text":" — USB-C or Lightning), and the NFC path through "},{"type":"codeVoice","code":"NFCSmartCardConnection"},{"type":"text","text":". The sample’s "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"NFCReaderUsageDescription"},{"type":"text","text":" and lists the FIDO applet AID ("},{"type":"codeVoice","code":"A0000006472F0001"},{"type":"text","text":") under "},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers"},{"type":"text","text":"; the entitlements turn on "},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.formats"},{"type":"text","text":" ("},{"type":"codeVoice","code":"TAG"},{"type":"text","text":") and "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"macOS.","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" uses "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" and "},{"type":"codeVoice","code":"com.apple.security.device.usb"},{"type":"text","text":" so the same target builds cleanly for both platforms."}],"type":"paragraph"}]}]},{"text":"Where to Customize","type":"heading","level":2,"anchor":"Where-to-Customize"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Which requests get intercepted.","type":"text"}],"type":"strong"},{"type":"text","text":" Edit "},{"type":"codeVoice","code":"shouldIntercept"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" to scope by hint, RP ID, or any other heuristic."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Origin verification.","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" builds a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin"},{"type":"text","text":" from "},{"type":"codeVoice","code":"window.location.origin"},{"type":"text","text":". Replace the "},{"type":"codeVoice","code":"isPublicSuffix"},{"type":"text","text":" closure passed to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" with a real public-suffix-list check before shipping."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"UI.","type":"text"}],"type":"strong"},{"type":"text","text":" Swap or restyle the panels in "},{"type":"codeVoice","code":"FidoUI\/Sources\/FidoUI\/Views\/"},{"type":"text","text":" — the rest of the module is UI-agnostic."}],"type":"paragraph"}]}]}]}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authentication/Response":{"url":"\/documentation\/yubikit\/webauthn\/authentication\/response","title":"WebAuthn.Authentication.Response","abstract":[{"text":"Authenticator response from a successful credential authentication.","type":"text"}],"type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Response"}],"navigatorTitle":[{"text":"Response","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSampleCode":{"kind":"article","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","role":"sampleCo
{"seeAlsoSections":[{"title":"Sample code","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"],"generated":true,"anchor":"Sample-code"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The interceptor demonstrates how to:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Intercept "},{"type":"codeVoice","code":"navigator.credentials.create()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"navigator.credentials.get()"},{"type":"text","text":" in a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options","isActive":true,"type":"reference"},{"type":"text","text":" \/ "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","isActive":true,"type":"reference"},{"type":"text","text":" types."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Drive the SDK’s high-level "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Use the bundled "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface."}],"type":"paragraph"},{"anchor":"Architecture-Overview","text":"Architecture Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The sample itself is intentionally thin:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Interceptor.js"}]},{"type":"text","text":" — injected into the "},{"code":"WKWebView","type":"codeVoice"},{"type":"text","text":" to monkey-patch "},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"type":"text","text":" and shuttle requests\/responses through "},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"WebView.swift","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"UIViewRepresentable","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"NSViewRepresentable","type":"codeVoice"},{"text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"WebAuthnHandler.swift","type":"text"}]},{"type":"text","text":" — decodes the JSON envelope, builds a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","isActive":true},{"type":"text","text":", and calls "},{"type":"codeVoice","code":"FidoUI.makeCredential"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"FidoUI.getAssertion"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"ContentView.swift","type":"text"}],"type":"strong"},{"text":" — minimal SwiftUI shell with a URL bar and back button.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"FidoUI","type":"text"}]},{"type":"text","text":" (separate Swift package under "},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI"},{"type":"text","text":") — the reusable UI + transport layer described below."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The end-to-end flow:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page JS calls "},{"type":"codeVoice","code":"navigator.credentials.create()"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".get()"},{"type":"text","text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"text":" decodes the JSON straight into the SDK’s strongly-typed ","type":"text"},{"type":"codeVoice","code":"Options"},{"type":"text","text":" and hands them to "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" opens a transport, runs the ceremony via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"type":"text","text":", and shows PIN \/ UV \/ error \/ success panels as needed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The resulting "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","type":"reference","isActive":true},{"type":"text","text":" is serialized via its built-in "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" and posted back to JS."}]}]}],"type":"orderedList"},{"text":"Intercepting WebAuthn Calls","level":2,"anchor":"Intercepting-WebAuthn-Calls","type":"heading"},{"text":"JavaScript Injection","level":3,"anchor":"JavaScript-Injection","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Interceptor.js"},{"text":" replaces ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.create"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.get"},{"text":" with versions that forward to Swift. Binary fields (","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":", ","type":"text"},{"type":"codeVoice","code":"user.id"},{"text":", ","type":"text"},{"type":"codeVoice","code":"rawId"},{"text":", …) are serialized to ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"base64url"}]},{"text":" strings via ","type":"text"},{"type":"codeVoice","code":"JSON.stringify"},{"text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed.","type":"text"}],"type":"paragraph"},{"syntax":"javascript","type":"codeListing","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The script is injected at document start so it runs before any page code:"}]},{"syntax":"swift","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"],"type":"codeListing"},{"inlineContent":[{"code":"shouldIntercept","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for any ","type":"text"},{"code":"publicKey","type":"codeVoice"},{"text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when ","type":"text"},{"code":"publicKey.hints","type":"codeVoice"},{"text":" includes ","type":"text"},{"code":"\"security-key\"","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"level":3,"text":"Receiving Messages in Swift","anchor":"Receiving-Messages-in-Swift","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"Coordinator","type":"codeVoice"},{"text":" is both ","type":"text"},{"code":"WKNavigationDelegate","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"shutdown()"},{"type":"text","text":" is called from "},{"type":"codeVoice","code":"dismantle{UI,NS}View"},{"type":"text","text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle."}],"type":"paragraph"},{"level":2,"text":"Driving the Ceremony","anchor":"Driving-the-Ceremony","type":"heading"},{"inlineContent":[{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" is intentionally tiny — it decodes the envelope, builds a typed ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":", and delegates to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself.","type":"text"}],"type":"paragraph"},{"code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"handleGet"},{"type":"text","text":" is the symmetric counterpart that decodes "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","isActive":true},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"fidoUI.getAssertion"},{"type":"text","text":". The response JSON produced by "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to "},{"type":"codeVoice","code":"ArrayBuffer"},{"type":"text","text":" when it materializes the credential."}]},{"anchor":"Returning-the-Response-to-JavaScript","type":"heading","level":2,"text":"Returning the Response to JavaScript"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:"}]},{"code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"JavaScript decodes the JSON and rebuilds a "},{"code":"PublicKeyCredential","type":"codeVoice"},{"type":"text","text":"-shaped object — converting the base64url binary fields back to "},{"code":"ArrayBuffer","type":"codeVoice"},{"type":"text","text":"s and wiring up "},{"code":"getClientExtensionResults","type":"codeVoice"},{"type":"text","text":", "},{"code":"getAuthenticatorData","type":"codeVoice"},{"type":"text","text":", "},{"code":"getPublicKey","type":"codeVoice"},{"type":"text","text":", "},{"code":"toJSON","type":"codeVoice"},{"type":"text","text":", and the rest. Errors travel through a parallel "},{"code":"__webauthn_error__","type":"codeVoice"},{"type":"text","text":" channel and surface to the page as a "},{"code":"DOMException","type":"codeVoice"},{"text":" with name ","type":"text"},{"code":"NotAllowedError","type":"codeVoice"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"The FidoUI Module","anchor":"The-FidoUI-Module"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.*"},{"text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Transport selection.","type":"text"}]},{"type":"text","text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ceremony serialization."}]},{"text":" Concurrent calls on the same ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Cancellation."}],"type":"strong"},{"text":" A single ","type":"text"},{"type":"codeVoice","code":"cancel()"},{"text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The host code only needs to construct one "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" instance and call "},{"code":"makeCredential","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"getAssertion","type":"codeVoice"},{"type":"text","text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See "},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/","type":"codeVoice"},{"type":"text","text":" for the full source."}]},{"type":"heading","level":2,"text":"Platform Notes","anchor":"Platform-Notes"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"iOS.","type":"text"}],"type":"strong"},{"text":" The wired path goes through CryptoTokenKit (","type":"text"},{"code":"WiredSmartCardConnection","type":"codeVoice"},{"text":" — USB-C or Lightning), and the NFC path through ","type":"text"},{"code":"NFCSmartCardConnection","type":"codeVoice"},{"text":". The sample’s ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" declares ","type":"text"},{"code":"NFCReaderUsageDescription","type":"codeVoice"},{"text":" and lists the FIDO applet AID (","type":"text"},{"code":"A0000006472F0001","type":"codeVoice"},{"text":") under ","type":"text"},{"code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers","type":"codeVoice"},{"text":"; the entitlements turn on ","type":"text"},{"code":"com.apple.developer.nfc.readersession.formats","type":"codeVoice"},{"text":" (","type":"text"},{"code":"TAG","type":"codeVoice"},{"text":") and ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS."}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" uses ","type":"text"},{"type":"codeVoice","code":"HIDFIDOConnection"},{"text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables ","type":"text"},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"com.apple.security.device.usb"},{"text":" so the same target builds cleanly for both platforms.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Where-to-Customize","level":2,"type":"heading","text":"Where to Customize"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Which requests get intercepted.","type":"text"}]},{"type":"text","text":" Edit "},{"type":"codeVoice","code":"shouldIntercept"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" to scope by hint, RP ID, or any other heuristic."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Origin verification.","type":"text"}]},{"text":" ","type":"text"},{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" builds a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin"},{"text":" from ","type":"text"},{"code":"window.location.origin","type":"codeVoice"},{"text":". Replace the ","type":"text"},{"type":"codeVoice","code":"isPublicSuffix"},{"type":"text","text":" closure passed to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" with a real public-suffix-list check before shipping."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"UI.","type":"text"}],"type":"strong"},{"type":"text","text":" Swap or restyle the panels in "},{"type":"codeVoice","code":"FidoUI\/Sources\/FidoUI\/Views\/"},{"type":"text","text":" — the rest of the module is UI-agnostic."}]}]}],"type":"unorderedList"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","interfaceLanguage":"swift"},"sampleCodeDownload":{"kind":"sampleDownload","action":{"type":"reference","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample","i
{"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"title":"Supported Extensions","generated":true,"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/CredProtect","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/CredBlob","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/CredProps","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/LargeBlob","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/MinPinLength","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/ThirdPartyPayment","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PreviewSign"],"anchor":"Supported-Extensions"}],"metadata":{"title":"WebAuthn.Extension.PRF","symbolKind":"struct","role":"symbol","roleHeading":"Structure","modules":[{"name":"YubiKit"}],"navigatorTitle":[{"kind":"identifier","text":"PRF"}],"externalID":"s:7YubiKit8WebAuthnO9ExtensionO3PRFV","extendedModule":"YubiKit","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PRF"}]},"abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/#prf-extension"},{"type":"text","text":" "},{"type":"text","text":"for deriving symmetric keys."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PRF"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"This WebAuthn extension wraps the CTAP2 hmac-secret extension, transforming"},{"type":"text","text":" "},{"type":"text","text":"PRF secrets into hmac-secret salts using "},{"code":"SHA-256(\"WebAuthn PRF\\0\" + secret)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Simple Usage (single credential)","level":2,"anchor":"Simple-Usage-single-credential","type":"heading"},{"syntax":"swift","code":["let prf = try await WebAuthn.Extension.PRF(session: session)","let ext = try prf.getAssertion.input(first: userSecret)","let params = CTAP2.GetAssertion.Parameters(..., extensions: [ext])","let response = try await session.getAssertion(parameters: params)","if let secrets = try prf.getAssertion.output(from: response) {","    \/\/ Use derived keys","}"],"type":"codeListing"},{"text":"Multi-credential Usage (evalByCredential)","level":2,"anchor":"Multi-credential-Usage-evalByCredential","type":"heading"},{"type":"codeListing","syntax":"swift","code":["let prf = try await WebAuthn.Extension.PRF(","    first: defaultSecret,","    evalByCredential: [credIdA: (secretA, nil), credIdB: (secretB, nil)],","    session: session",")","","\/\/ After credential selection:","let ext = try prf.getAssertion.input(for: selectedCredentialId)","let params = CTAP2.GetAssertion.Parameters(..., extensions: [ext])","let response = try await session.getAssertion(parameters: params)","if let secrets = try prf.getAssertion.output(from: response) {","    \/\/ Use derived keys","}"]},{"type":"paragraph","inlineContent":[{"text":"Pseudo-random function extension for deriving symmetric secrets bound to a credential.","type":"text"}]},{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"PRF","type":"codeVoice"},{"type":"text","text":" lets a relying party derive deterministic symmetric secrets from a credential"},{"type":"text","text":" "},{"type":"text","text":"— the same input produces the same output every time the user authenticates with"},{"type":"text","text":" "},{"type":"text","text":"that credential. It’s the "},{"isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/#prf-extension","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"for credential-bound key derivation, built on the CTAP2 "},{"code":"hmac-secret","type":"codeVoice"},{"type":"text","text":" extension."},{"type":"text","text":" "},{"type":"text","text":"The SDK transforms each PRF input with "},{"code":"SHA-256(\"WebAuthn PRF\\0\" || input)","type":"codeVoice"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"text","text":"sending it to the authenticator — that domain separation is mandated by the spec."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In a high-level WebAuthn flow, configure "},{"type":"codeVoice","code":"PRF"},{"type":"text","text":" per ceremony via"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/RegistrationInputs\/prf","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/AuthenticationInputs\/prf","isActive":true},{"type":"text","text":"; outputs come back on"},{"type":"text","text":" "},{"type":"codeVoice","code":"clientExtensionResults"},{"type":"text","text":" of the corresponding "},{"type":"codeVoice","code":"Response"},{"type":"text","text":". Registration enables"},{"type":"text","text":" "},{"type":"text","text":"PRF on a credential, optionally deriving secrets at the same time on"},{"type":"text","text":" "},{"type":"text","text":"authenticators that support hmac-secret-mc. Authentication evaluates the PRF at"},{"type":"text","text":" "},{"type":"text","text":"one or more inputs and returns the derived bytes."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Registration: enable PRF on the new credential","let regOpts = WebAuthn.Registration.Options(","    challenge: challenge,","    rp: .init(id: \"example.com\", name: \"Example\"),","    user: .init(id: userId, name: \"alice@example.com\"),","    extensions:
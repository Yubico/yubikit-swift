dential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    switch result {","    case .enabled:","        \/\/ hmac-secret-mc not supported, but hmac-secret is enabled","    case .secrets(let secrets):","        \/\/ Use derived keys (secrets.first, secrets.second)","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"GetAssertion-Usage","type":"heading","text":"GetAssertion Usage","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Derive keys during authentication:"}]},{"code":["let hmacSecret = try await CTAP2.Extension.HmacSecret(session: session)","let ext = try hmacSecret.getAssertion.input(salt1: salt)","let params = CTAP2.GetAssertion.Parameters(..., extensions: [ext])","let response = try await session.getAssertion(params)","if let secrets = try hmacSecret.getAssertion.output(from: response) {","    \/\/ Use derived keys (secrets.first, secrets.second)","}"],"type":"codeListing","syntax":"swift"},{"style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"https:\/\/fidoalliance.org\/specs\/fido-v2.2-ps-20250714\/fido-client-to-authenticator-protocol-v2.2-ps-20250714.html#sctn-hmac-secret-extension","type":"reference"}],"type":"paragraph"}],"type":"aside","name":"See Also"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"https:\/\/fidoalliance.org\/specs\/fido-v2.2-ps-20250714\/fido-client-to-authenticator-protocol-v2.2-ps-20250714.html#sctn-hmac-secret-make-cred-extension","isActive":true,"type":"reference"}]}],"type":"aside","name":"See Also"}]}],"variants":[{"paths":["\/documentation\/yubikit\/ctap2\/extension\/hmacsecret"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"CTAP2.Extension.HmacSecret","symbolKind":"struct","navigatorTitle":[{"text":"HmacSecret","kind":"identifier"}],"extendedModule":"YubiKit","modules":[{"name":"YubiKit"}],"role":"symbol","externalID":"s:7YubiKit5C
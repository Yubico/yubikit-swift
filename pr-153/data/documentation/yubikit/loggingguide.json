lineContent":[{"text":"Add ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-log"},{"text":"’s ","type":"text"},{"code":"Logging","type":"codeVoice"},{"text":" product to your app target","type":"text"},{"text":" ","type":"text"},{"text":"to use its backend types. Any SwiftLog ","type":"text"},{"code":"LogHandler","type":"codeVoice"},{"text":" can be supplied by the factory.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;","type":"text"},{"text":" ","type":"text"},{"text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,","type":"text"},{"text":" ","type":"text"},{"text":"though logs already in progress may use the previous settings.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,","type":"text"},{"text":" ","type":"text"},{"text":"pass its factory explicitly; global ","type":"text"},{"code":"LoggingSystem.bootstrap","type":"codeVoice"},{"text":" does not select YubiKit’s backend.","type":"text"},{"text":" ","type":"text"},{"text":"Factories may run concurrently and must not log through YubiKit themselves.","type":"text"}]},{"text":"Traffic logging","type":"heading","level":3,"anchor":"Traffic-logging"},{"code":["Logging.configure(logLevel: .trace)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Raw traffic and SCP plaintext logs require ","type":"text"},{"inlineContent":[{"type":"text","text":"YubiKit to be compiled with "},{"type":"codeVoice","code":"DEBUG"}],"type":"strong"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Neither configuration nor a custom backend can enable them in other builds.","type":"text"},{"text":" ","type":"text"},{"text":"Custom connections are responsible for their own traffic logging.","type":"text"}]},{"style":"warning","name":"Warning","content":[{"inlineContent":[{"type":"text","text":"Debug logs can include account names and credential identifiers."},{"type":"text","text":" "},{"type":"text","text":"Trace logs can include PINs, credentials, and cryptographic keys. Protect or redact logs before sharing them."}],"type":"paragraph"}],"type":"aside"},{"text":"Custom backends","type":"heading","level":3,"anchor":"Custom-backends"},{"type":"paragraph","inlineContent":[{"text":"Labels identify categories, such as ","type":"text"},{"code":"com.yubico.YubiKit.OATH","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"com.yubico.YubiKit.FIDO","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Metadata carries details such as byte counts and error codes; the default backend displays","type":"text"},{"text":" ","type":"text"},{"text":"these as ","type":"text"},{"code":"key=value","type":"codeVoice"},{"text":" pairs. Message wording and metadata keys are not a stable API.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages.","type":"text"}]}],"kind":"content"}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/GettingStarted":{"type":"topic","role":"article","abstract":[{"type":"text","text":"Prepare your project to connect to the YubiKey via NFC, SmartCard, Lightning and USB HID."}],"title":"Getting Started","url":"\/documentation\/yubikit\/gettingstarted","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","kind":"article"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logging":{"navigatorTitle":[{"text":"Logging","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Configures logging for YubiKit connections and sessions."}],"title":"Logging","url":"\/documentation\/yubikit\/logging","identifier":"doc:\/\/yubikit-swift.YubiKit\/document
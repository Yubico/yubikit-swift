{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"No setup is required. YubiKit defaults to ","type":"text"},{"type":"codeVoice","code":"debug"},{"text":" on stdout when compiled with ","type":"text"},{"type":"codeVoice","code":"DEBUG"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"type":"codeVoice","code":"info"},{"text":" on stderr otherwise. You can override either default:","type":"text"}],"type":"paragraph"},{"code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","Logging.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","Logging.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","Logging.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","Logging.configure()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Add ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-log","isActive":true},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"Logging"},{"text":" product to your app target","type":"text"},{"text":" ","type":"text"},{"text":"to use its backend types. Any SwiftLog ","type":"text"},{"type":"codeVoice","code":"LogHandler"},{"text":" can be supplied by the factory.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;","type":"text"},{"text":" ","type":"text"},{"text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,","type":"text"},{"text":" ","type":"text"},{"text":"though logs already in progress may use the previous settings.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,","type":"text"},{"text":" ","type":"text"},{"text":"pass its factory explicitly; global ","type":"text"},{"type":"codeVoice","code":"LoggingSystem.bootstrap"},{"text":" does not select YubiKit’s backend.","type":"text"},{"text":" ","type":"text"},{"text":"Factories may run concurrently and must not log through YubiKit themselves.","type":"text"}],"type":"paragraph"},{"anchor":"Traffic-logging","level":3,"type":"heading","text":"Traffic logging"},{"code":["Logging.configure(logLevel: .trace)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Raw traffic and SCP plaintext logs require ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"YubiKit to be compiled with "},{"code":"DEBUG","type":"codeVoice"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Neither configuration nor a custom backend can enable them in other builds.","type":"text"},{"text":" ","type":"text"},{"text":"Custom connections are responsible for their own traffic logging.","type":"text"}],"type":"paragraph"},{"name":"Warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Debug logs can include account names and credential identifiers."},{"type":"text","text":" "},{"type":"text","text":"Trace logs can include PINs, credentials, and cryptographic keys. Protect or redact logs before sharing them."}]}],"style":"warning","type":"aside"},{"anchor":"Custom-backends","level":3,"type":"heading","text":"Custom backends"},{"inlineContent":[{"text":"Labels identify categories, such as ","type":"text"},{"type":"codeVoice","code":"com.yubico.YubiKit.OATH"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"com.yubico.YubiKit.FIDO"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Metadata carries details such as byte counts and error codes; the default backend displays","type":"text"},{"text":" ","type":"text"},{"text":"these as ","type":"text"},{"type":"codeVoice","code":"key=value"},{"text":" pairs. Message wording and metadata keys are not a stable API.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"role":"article","modules":[{"name":"YubiKit"}],"roleHeading":"Article","title":"Logging"},"seeAlsoSections":[{"anchor":"Preparing-your-project","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging"],"title":"Preparing your project","generated":true}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"abstract":[{"type":"text","text":"Choose YubiKit’s log level and backend with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging\/configure(logLevel:factory:)"},{"type":"text","text":"."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/loggingguide"]}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/GettingStarted":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","kind":"article","title":"Getting Started","role":"article","url":"\/documentation\/yubikit\/gettingstarted","type":"topic","abstract":[{"text":"Prepare your project to connect to the YubiKey via NFC, SmartCard, Lightning and USB HID.","type":"text"}]},"documentation-header.png":{"variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}],"type":"image","identifier":"documentation-header.png","alt":"YubiKeys in a row"},"doc://yubikit-swift.YubiKit/documentatio
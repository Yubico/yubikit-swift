{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/webauthninterceptorsamplecode"]}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The interceptor demonstrates how to:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Intercept "},{"type":"codeVoice","code":"navigator.credentials.create()"},{"text":" and ","type":"text"},{"code":"navigator.credentials.get()","type":"codeVoice"},{"type":"text","text":" in a "},{"code":"WKWebView","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options","type":"reference","isActive":true},{"type":"text","text":" \/ "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","type":"reference","isActive":true},{"type":"text","text":" types."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Drive the SDK’s high-level "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"type":"text","text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the bundled "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface.","type":"text"}]},{"level":2,"text":"Architecture Overview","type":"heading","anchor":"Architecture-Overview"},{"type":"paragraph","inlineContent":[{"text":"The sample itself is intentionally thin:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Interceptor.js"}]},{"type":"text","text":" — injected into the "},{"code":"WKWebView","type":"codeVoice"},{"type":"text","text":" to monkey-patch "},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"type":"text","text":" and shuttle requests\/responses through "},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"WebView.swift"}]},{"type":"text","text":" — "},{"code":"UIViewRepresentable","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"NSViewRepresentable","type":"codeVoice"},{"type":"text","text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"WebAuthnHandler.swift","type":"text"}]},{"type":"text","text":" — decodes the JSON envelope, builds a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin"},{"type":"text","text":", and calls "},{"code":"FidoUI.makeCredential","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"FidoUI.getAssertion","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"ContentView.swift","type":"text"}]},{"type":"text","text":" — minimal SwiftUI shell with a URL bar and back button."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"FidoUI","type":"text"}]},{"type":"text","text":" (separate Swift package under "},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI","type":"codeVoice"},{"type":"text","text":") — the reusable UI + transport layer described below."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The end-to-end flow:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page JS calls "},{"code":"navigator.credentials.create()","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":".get()","type":"codeVoice"},{"type":"text","text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"WebAuthnHandler","type":"codeVoice"},{"type":"text","text":" decodes the JSON straight into the SDK’s strongly-typed "},{"code":"Options","type":"codeVoice"},{"type":"text","text":" and hands them to "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" opens a transport, runs the ceremony via "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"type":"text","text":", and shows PIN \/ UV \/ error \/ success panels as needed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The resulting "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","type":"reference"},{"type":"text","text":" or "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","type":"reference"},{"type":"text","text":" is serialized via its built-in "},{"code":"toJSON()","type":"codeVoice"},{"type":"text","text":" and posted back to JS."}]}]}],"type":"orderedList"},{"level":2,"text":"Intercepting WebAuthn Calls","type":"heading","anchor":"Intercepting-WebAuthn-Calls"},{"level":3,"text":"JavaScript Injection","type":"heading","anchor":"JavaScript-Injection"},{"type":"paragraph","inlineContent":[{"code":"Interceptor.js","type":"codeVoice"},{"type":"text","text":" replaces "},{"code":"navigator.credentials.create","type":"codeVoice"},{"type":"text","text":" and "},{"code":"navigator.credentials.get","type":"codeVoice"},{"type":"text","text":" with versions that forward to Swift. Binary fields ("},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", "},{"code":"user.id","type":"codeVoice"},{"type":"text","text":", "},{"code":"rawId","type":"codeVoice"},{"type":"text","text":", …) are serialized to "},{"type":"strong","inlineContent":[{"text":"base64url","type":"text"}]},{"type":"text","text":" strings via "},{"code":"JSON.stringify","type":"codeVoice"},{"type":"text","text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed."}]},{"syntax":"javascript","type":"codeListing","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"]},{"type":"paragraph","inlineContent":[{"text":"The script is injected at document start so it runs before any page code:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shouldIntercept"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" for any ","type":"text"},{"type":"codeVoice","code":"publicKey"},{"text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when ","type":"text"},{"type":"codeVoice","code":"publicKey.hints"},{"text":" includes ","type":"text"},{"type":"codeVoice","code":"\"security-key\""},{"text":").","type":"text"}]},{"level":3,"text":"Receiving Messages in Swift","type":"heading","anchor":"Receiving-Messages-in-Swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Coordinator"},{"text":" is both ","type":"text"},{"type":"codeVoice","code":"WKNavigationDelegate"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shutdown()"},{"text":" is called from ","type":"text"},{"type":"codeVoice","code":"dismantle{UI,NS}View"},{"text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle.","type":"text"}]},{"level":2,"text":"Driving the Ceremony","type":"heading","anchor":"Driving-the-Ceremony"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"text":" is intentionally tiny — it decodes the envelope, builds a typed ","type":"text"},{"type":"codeVoice","code":"Origin"},{"text":", and delegates to ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"handleGet"},{"text":" is the symmetric counterpart that decodes ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","isActive":true,"type":"reference"},{"text":" and calls ","type":"text"},{"type":"codeVoice","code":"fidoUI.getAssertion"},{"text":". The response JSON produced by ","type":"text"},{"type":"codeVoice","code":"toJSON()"},{"text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to ","type":"text"},{"type":"codeVoice","code":"ArrayBuffer"},{"text":" when it materializes the credential.","type":"text"}]},{"level":2,"text":"Returning the Response to JavaScript","type":"heading","anchor":"Returning-the-Response-to-JavaScript"},{"type":"paragraph","inlineContent":[{"text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"]},{"type":"paragraph","inlineContent":[{"text":"JavaScript decodes the JSON and rebuilds a ","type":"text"},{"type":"codeVoice","code":"PublicKeyCredential"},{"text":"-shaped object — converting the base64url binary fields back to ","type":"text"},{"code":"ArrayBuffer","type":"codeVoice"},{"text":"s and wiring up ","type":"text"},{"type":"codeVoice","code":"getClientExtensionResults"},{"text":", ","type":"text"},{"type":"codeVoice","code":"getAuthenticatorData"},{"text":", ","type":"text"},{"type":"codeVoice","code":"getPublicKey"},{"text":", ","type":"text"},{"type":"codeVoice","code":"toJSON"},{"text":", and the rest. Errors travel through a parallel ","type":"text"},{"type":"codeVoice","code":"__webauthn_error__"},{"text":" channel and surface to the page as a ","type":"text"},{"type":"codeVoice","code":"DOMException"},{"text":" with name ","type":"text"},{"code":"NotAllowedError","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"The-FidoUI-Module","type":"heading","level":2,"text":"The FidoUI Module"},{"inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" is a "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting "},{"code":"navigator.credentials.*","type":"codeVoice"},{"type":"text","text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — "},{"code":"FidoUI","type":"codeVoice"},{"text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Transport selection."}]},{"type":"text","text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Ceremony serialization.","type":"text"}],"type":"strong"},{"type":"text","text":" Concurrent calls on the same "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Cancellation.","type":"text"}]},{"type":"text","text":" A single "},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The host code only needs to construct one ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" instance and call "},{"code":"makeCredential","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"getAssertion","type":"codeVoice"},{"type":"text","text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See "},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/","type":"codeVoice"},{"text":" for the full source.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Platform Notes","anchor":"Platform-Notes","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS."}]},{"type":"text","text":" The wired path goes through CryptoTokenKit ("},{"code":"WiredSmartCardConnection","type":"codeVoice"},{"type":"text","text":" — USB-C or Lightning), and the NFC path through "},{"code":"NFCSmartCardConnection","type":"codeVoice"},{"type":"text","text":". The sample’s "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" declares "},{"code":"NFCReaderUsageDescription","type":"codeVoice"},{"type":"text","text":" and lists the FIDO applet AID ("},{"code":"A0000006472F0001","type":"codeVoice"},{"type":"text","text":") under "},{"code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers","type":"codeVoice"},{"type":"text","text":"; the entitlements turn on "},{"code":"com.apple.developer.nfc.readersession.formats","type":"codeVoice"},{"type":"text","text":" ("},{"type":"codeVoice","code":"TAG"},{"text":") and ","type":"text"},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS."}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" uses ","type":"text"},{"type":"codeVoice","code":"HIDFIDOConnection"},{"text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables ","type":"text"},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"com.apple.security.device.usb"},{"text":" so the same target builds cleanly for both platforms.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Where to Customize","anchor":"Where-to-Customize","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Which requests get intercepted.","type":"text"}]},{"text":" Edit ","type":"text"},{"type":"codeVoice","code":"shouldIntercept"},{"text":" in ","type":"text"},{"code":"Interceptor.js","type":"codeVoice"},{"text":" to scope by hint, RP ID, or any other heuristic.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Origin verification."}]},{"text":" ","type":"text"},{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" builds a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","isActive":true,"type":"reference"},{"text":" from ","type":"text"},{"code":"window.location.origin","type":"codeVoice"},{"text":". Replace the ","type":"text"},{"type":"codeVoice","code":"isPublicSuffix"},{"text":" closure passed to ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" with a real public-suffix-list check before shipping.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"UI."}]},{"text":" Swap or restyle the panels in ","type":"text"},{"code":"FidoUI\/Sources\/FidoUI\/Views\/","type":"codeVoice"},{"text":" — the rest of the module is UI-agnostic.","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample","overridingTitle":"View Source"}},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn
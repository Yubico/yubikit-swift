ifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use a built-in factory for trivial cases:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let r = try await client.makeCredential(opts, authorization: .pin(\"1234\")).value"]},{"type":"paragraph","inlineContent":[{"text":"Or build a custom instance to bridge into a UI:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let auth = WebAuthn.Authorization(providePIN: {","    guard let pin = await viewModel.askForPIN() else { return .cancel }","    return .pin(pin)","})","let r = try await client.makeCredential(opts, authorization: auth).value"]},{"type":"paragraph","inlineContent":[{"text":"PIN attempts are one-shot: a wrong PIN throws","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/pinRejected(retriesRemaining:source:)","isActive":true},{"text":" and the caller","type":"text"},{"text":" ","type":"text"},{"text":"decides whether to re-prompt and retry the ceremony with a fresh","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Authorization"},{"text":".","type":"text"}]},{"inlineContent":[{"type":"text","text":"PIN and user-verification policy for a single WebAuthn ceremony."}],"type":"paragraph"},{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Authorization"},{"type":"text","text":" is supplied per ceremony to"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCreden
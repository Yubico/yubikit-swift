{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"YubiKit"}],"title":"Getting Started"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/gettingstarted"]}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"anchor":"Preparing-your-project","title":"Preparing your project","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"The YubiKit framework is distributed using the Swift Package Manager. To add the framework to your project follow these steps:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Package Dependencies” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Press the plus-button to bring up the add package dialog.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"add-framework-1.png","type":"image"}],"type":"paragraph"},{"start":4,"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Enter ","type":"text"},{"code":"https:\/\/github.com\/Yubico\/yubikit-swift\/","type":"codeVoice"},{"text":" in the search field and select the Yubico Swift Package.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Press the “Add Package” button to add the SDK to your project.","type":"text"}]}]}]},{"inlineContent":[{"identifier":"add-framework-2.png","type":"image"}],"type":"paragraph"},{"text":"NFC","type":"heading","level":3,"anchor":"NFC"},{"inlineContent":[{"text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC","type":"text"},{"text":" ","type":"text"},{"text":"application identifiers and a NFC Privacy statement to the application.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Add Wireless entitlement","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Signing & Capabilities” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Click the “+”-button to add a new capability.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the “Near Field Communication Tag” capability.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"nfc-entitlement.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Add list of NFC application identifiers","type":"text"}],"type":"strong"}],"type":"paragraph"},{"start":6,"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”.","type":"text"}]}]}]},{"inlineContent":[{"identifier":"nfc-identifiers.png","type":"image"}],"type":"paragraph"},{"start":8,"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the Yubico NFC application identifiers to enable communication with the different","type":"text"},{"text":" ","type":"text"},{"text":"applications on the YubiKey.","type":"text"}]}]}]},{"syntax":null,"type":"codeListing","code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"]},{"inlineContent":[{"identifier":"nfc-identifiers-list.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Add a NFC Privacy description","type":"text"}],"type":"strong"}],"type":"paragraph"},{"start":9,"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in","type":"text"},{"text":" ","type":"text"},{"text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”","type":"text"}]}]}]},{"inlineContent":[{"identifier":"nfc-privacy.png","type":"image"}],"type":"paragraph"},{"text":"SmartCard\/USB","type":"heading","level":3,"anchor":"SmartCardUSB"},{"inlineContent":[{"text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the","type":"text"},{"text":" ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" entitlement to your application.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the application entitlements file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" entitlement to the entitlement list.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"smart-card.png","type":"image"}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"text":"USB SmartCard supports Yubico OTP slot programming. HMAC-SHA1 challenge-response requires","type":"text"},{"text":" ","type":"text"},{"code":"HIDOTPConnection","type":"codeVoice"},{"text":" on macOS, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LightningSmartCardConnection"},{"text":", or NFC without a touch requirement.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey","type":"heading","level":3,"anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey"},{"inlineContent":[{"text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" string to the list of External Accessories.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not present add the ","type":"text"},{"code":"Supported external accessory protocols","type":"codeVoice"},{"text":" key and insert the string ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" in its list.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"external-accessory.png","type":"image"}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for ","type":"text"},{"code":"Supported external accessory protocols","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"text":"Making Your First Connection","type":"heading","level":2,"anchor":"Making-Your-First-Connection"},{"inlineContent":[{"text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device.","type":"text"}],"type":"paragraph"},{"text":"Understanding Connection Types","type":"heading","level":3,"anchor":"Understanding-Connection-Types"},{"inlineContent":[{"text":"YubiKit provides the following connection methods:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"NFC"}],"type":"strong"},{"text":": Short-range wireless communication (iOS only)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"USB"}],"type":"strong"},{"text":": Direct USB connection via SmartCard interface","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Lightning"}],"type":"strong"},{"text":": YubiKey 5Ci connected to Lightning port (iOS only)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"USB HID"}],"type":"strong"},{"text":": Direct access to the FIDO or OTP interface (macOS only)","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Each connection type works differently, so let’s explore how to use them.","type":"text"}],"type":"paragraph"},{"text":"NFC Connections","type":"heading","level":3,"anchor":"NFC-Connections"},{"inlineContent":[{"text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"]},{"inlineContent":[{"text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete.","type":"text"}],"type":"paragraph"},{"text":"USB and Lightning Connections","type":"heading","level":3,"anchor":"USB-and-Lightning-Connections"},{"inlineContent":[{"text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"]},{"inlineContent":[{"text":"The ","type":"text"},{"code":"WiredSmartCardConnection.makeConnection()","type":"codeVoice"},{"text":" method automatically detects whether you’re using USB or Lightning.","type":"text"}],"type":"paragraph"},{"text":"Specific Connection Types","type":"heading","level":3,"anchor":"Specific-Connection-Types"},{"inlineContent":[{"text":"For more control, you can connect to specific interfaces:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"]},{"inlineContent":[{"text":"On macOS, use ","type":"text"},{"code":"HIDOTPConnection","type":"codeVoice"},{"text":" for the OTP keyboard interface or ","type":"text"},{"code":"HIDFIDOConnection","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"the FIDO interface:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let otpConnection = try await HIDOTPConnection()"]},{"text":"Understanding Connection Lifecycle","type":"heading","level":2,"anchor":"Understanding-Connection-Lifecycle"},{"inlineContent":[{"inlineContent":[{"text":"Critical:","type":"text"}],"type":"strong"},{"text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time.","type":"text"}],"type":"paragraph"},{"text":"Connection Behavior","type":"heading","level":3,"anchor":"Connection-Behavior"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Exclusive access"}],"type":"strong"},{"text":": Only one connection can exist per YubiKey at any time","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Manual closure required"}],"type":"strong"},{"text":": Dropping a connection reference does NOT automatically close it - you must call ","type":"text"},{"code":"close()","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Resource blocking"}],"type":"strong"},{"text":": An unclosed connection prevents new connections (throws ","type":"text"},{"code":"SmartCardConnectionError.busy","type":"codeVoice"},{"text":")","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call ","type":"text"},{"code":"close()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Working with Sessions","type":"heading","level":2,"anchor":"Working-with-Sessions"},{"inlineContent":[{"text":"Once you have a connection, create sessions to access different YubiKey applications:","type":"text"}],"type":"paragraph"},{"text":"OATH Session (TOTP\/HOTP codes)","type":"heading","level":3,"anchor":"OATH-Session-TOTPHOTP-codes"},{"syntax":"swift","type":"codeListing","code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"]},{"text":"Yubico OTP Session (OTP slots)","type":"heading","level":3,"anchor":"Yubico-OTP-Session-OTP-slots"},{"inlineContent":[{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","isActive":true,"type":"reference"},{"text":" manages the two OTP slots. Create it with a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","isActive":true,"type":"reference"},{"text":" or,","type":"text"},{"text":" ","type":"text"},{"text":"on macOS, an ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OTPConnection","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let session = try await YubiOTP.Session.makeSession(connection: connection)","let state = await session.configState","print(\"Slot 2 configured: \\(try state.isConfigured(.two))\")","","\/\/ Program slot 2 for HOTP, replacing its existing configuration","try await session.putConfiguration(.hotp(key: secret), in: .two)"]},{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","isActive":true,"type":"reference"},{"text":" for HMAC-SHA1 challenge-response, transport support, and NFC output.","type":"text"}],"type":"paragraph"},{"text":"PIV Session (Certificates and keys)","type":"heading","level":3,"anchor":"PIV-Session-Certificates-and-keys"},{"syntax":"swift","type":"codeListing","code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"]},{"text":"Management Session (Device information)","type":"heading","level":3,"anchor":"Management-Session-Device-information"},{"syntax":"swift","type":"codeListing","code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"]},{"text":"WebAuthn Client (FIDO2 \/ passkeys)","type":"heading","level":3,"anchor":"WebAuthn-Client-FIDO2--passkeys"},{"inlineContent":[{"text":"For passkey registration and authentication, ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":" wraps a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true,"type":"reference"},{"text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"code":"HIDFIDOConnection","type":"codeVoice"},{"text":" (USB HID on macOS) or any ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"(NFC \/ USB CCID).","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"]},{"inlineContent":[{"text":"PIN and UV are supplied per ceremony via ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","isActive":true,"type":"reference"},{"text":". For raw","type":"text"},{"text":" ","type":"text"},{"text":"CTAP2 access (credential management, bio enrollment, large blobs), use","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true,"type":"reference"},{"text":" directly.","type":"text"}],"type":"paragraph"},{"text":"Connection Management Patterns","type":"heading","level":2,"anchor":"Connection-Management-Patterns"},{"text":"For UI Applications","type":"heading","level":3,"anchor":"For-UI-Applications"},{"inlineContent":[{"text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","isActive":true,"type":"reference"},{"text":" for complete examples of reactive connection management patterns that automatically update your UI when YubiKeys are plugged in or removed.","type":"text"}],"type":"paragraph"},{"text":"For Command-Line Tools","type":"heading","level":3,"anchor":"For-Command-Line-Tools"},{"inlineContent":[{"text":"CLI applications often use a simpler approach with a single connection per operation. See ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","isActive":true,"type":"reference"},{"text":" for examples of how command-line tools handle connections for one-time operations.","type":"text"}],"type":"paragraph"},{"text":"Next Steps","type":"heading","level":2,"anchor":"Next-Steps"},{"inlineContent":[{"text":"Now you’re ready to build YubiKey applications! Check out the sample projects to see complete implementations:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"OATHSample"}],"type":"strong"},{"text":": Shows how to build a TOTP authenticator app with SwiftUI","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"PIVTool"}],"type":"strong"},{"text":": Demonstrates PIV operations for certificates and digital signatures","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"WebAuthnInterceptorSample"}],"type":"strong"},{"text":": Routes WebAuthn calls from a ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":" to a YubiKey","type":"text"}]}]}],"type":"unorderedList"},{"text":"Build SDK documentation","type":"heading","level":3,"anchor":"Build-SDK-documentation"},{"inlineContent":[{"text":"You can also build the complete SDK documentation by selecting “Product” -> “Build Documentation” in Xcode. This gives you access to the full YubiKit API reference.","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"text":"Select an iOS target to include NFC and Lightning connections, or a macOS target to include","type":"text"},{"text":" ","type":"text"},{"text":"USB HID connections.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"abstract":[{"text":"Prepare your project to connect to the YubiKey via NFC, SmartCard, Lightning and USB HID.","type":"text"}],"references":{"smart-card.png":{"identifier":"smart-card.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/smart-card@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/smart-card~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to add NFC privacy string to project.","type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logs":{"kind":"symbol","role":"symbol","title":"Logs","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Logs"}],"abstract":[{"type":"text","text":"Configures logging for YubiKit connections and sessions."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs","navigatorTitle":[{"kind":"identifier","text":"Logs"}],"url":"\/documentation\/yubikit\/logs","type":"topic"},"external-accessory.png":{"identifier":"external-accessory.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to support for lightn
ifier","text":"Authorization"}],"roleHeading":"Structure","title":"WebAuthn.Authorization","modules":[{"name":"YubiKit"}],"externalID":"s:7YubiKit8WebAuthnO13AuthorizationV","extendedModule":"YubiKit"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Authorization"}]}]},{"kind":"mentions","mentions":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted"]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"Authorization"},{"type":"text","text":" carries the PIN-providing closure and the UV"},{"type":"text","text":" "},{"type":"text","text":"policy for one ceremony. It is supplied per call to"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use a built-in factory for trivial cases:"}],"type":"paragraph"},{"syntax":"swift","code":["let r = try await client.makeCredential(opts, authorization: .pin(\"1234\")).value"],"type":"codeListing"},{"inlineContent":[{"text":"Or build a custom instance to bridge into a UI:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let auth = WebAuthn.Authorization(providePIN: {","    guard let pin = await viewModel.askForPIN() else { return .cancel }","    return .pin(pin)","})","let r = try await client.makeCredential(opts, authorization: auth).value"],"type":"codeListing"},{"inlineContent":[{"text":"PIN at
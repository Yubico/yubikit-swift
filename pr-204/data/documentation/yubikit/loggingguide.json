{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"No setup is required. YubiKit defaults to ","type":"text"},{"code":"debug","type":"codeVoice"},{"text":" on stdout when compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"info","type":"codeVoice"},{"text":" on stderr otherwise. You can override either default:","type":"text"}],"type":"paragraph"},{"code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","YubiKit.Logs.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","YubiKit.Logs.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","YubiKit.Logs.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","YubiKit.Logs.configure()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Add "},{"identifier":"https:\/\/github.com\/apple\/swift-log","isActive":true,"type":"reference"},{"type":"text","text":"’s "},{"code":"Logging","type":"codeVoice"},{"type":"text","text":" product to your app target"},{"type":"text","text":" "},{"type":"text","text":"to use its backend types. Any SwiftLog "},{"code":"LogHandler","type":"codeVoice"},{"type":"text","text":" can be supplied by the factory."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;"},{"text":" ","type":"text"},{"type":"text","text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,"},{"type":"text","text":" "},{"type":"text","text":"though logs already in progress may use the previous settings."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,"},{"type":"text","text":" "},{"type":"text","text":"pass its factory explicitly; global "},{"code":"LoggingSystem.bootstrap","type":"codeVoice"},{"type":"text","text":" does not select YubiKit’s backend."},{"type":"text","text":" "},{"type":"text","text":"Factories may run concurrently and must not log through YubiKit themselves."}],"type":"paragraph"},{"level":3,"text":"Traffic logging","anchor":"Traffic-logging","type":"heading"},{"code":["YubiKit.Logs.configure(logLevel: .trace)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Raw traffic and SCP plaintext logs require ","type":"text"},{"inlineContent":[{"type":"text","text":"YubiKit to be compiled with "},{"code":"DEBUG","type":"codeVoice"}],"type":"strong"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Neither configuration nor a custom backend can enable them in other builds."},{"type":"text","text":" "},{"type":"text","text":"Custom connections are responsible for their own traffic logging."}],"type":"paragraph"},{"name":"Warning","style":"warning","content":[{"type":"paragraph","inlineContent":[{"text":"Debug logs can include account names and credential identifiers.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Trace logs can include PINs, credentials, and cryptographic keys. Protect or redact logs before sharing them."}]}],"type":"aside"},{"level":3,"text":"Custom backends","anchor":"Custom-backends","type":"heading"},{"inlineContent":[{"type":"text","text":"Labels identify categories, such as "},{"code":"com.yubico.YubiKit.OATH","type":"codeVoice"},{"type":"text","text":" or "},{"code":"com.yubico.YubiKit.FIDO","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Metadata carries details such as byte counts and error codes; the default backend displays"},{"type":"text","text":" "},{"type":"text","text":"these as "},{"code":"key=value","type":"codeVoice"},{"type":"text","text":" pairs. Message wording and metadata keys are not a stable API."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages."}],"type":"paragraph"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"anchor":"Preparing-your-project","title":"Preparing your project","generated":true}],"abstract":[{"text":"Choose YubiKit’s log level and backend with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)","type":"reference"},{"text":".","type":"text"}],"metadata":{"title":"Logging","modules":[{"name":"YubiKit"}],"role":"article","roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/loggingguide"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide"},"sections":[],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logs":{"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Logs"}],"title":"Logs","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs","navigatorTitle":[{"kind":"identifier","text":"Logs"}],"kind":"symbol","url":"\/documentation\/yubikit\/logs","abstract":[{"text":"Configures logging for YubiKit connections and sessions.","type":"text"}],"type":"topic"},"https://github.com/apple/swift-log":{"type":"link","identifier":"https:\/\/github.com\/apple\/swift-log","title":"SwiftLog","titleInlineContent":[{"type":"text","text":"SwiftLog"}],"url":"https:\/\/github.com\/apple\/swift-log"},"documentation-heade
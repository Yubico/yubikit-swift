{"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"abstract":[{"text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts ","type":"text"},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"text":" calls inside a ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" and routes them to a YubiKey. It uses the high-level ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" companion module.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"The interceptor demonstrates how to:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Intercept "},{"code":"navigator.credentials.create()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"navigator.credentials.get()","type":"codeVoice"},{"type":"text","text":" in a "},{"code":"WKWebView","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options","isActive":true},{"type":"text","text":" \/ "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","isActive":true},{"type":"text","text":" types."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Drive the SDK’s high-level "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Use the bundled "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface.","type":"text"}],"type":"paragraph"},{"text":"Architecture Overview","level":2,"anchor":"Architecture-Overview","type":"heading"},{"inlineContent":[{"text":"The sample itself is intentionally thin:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Interceptor.js"}],"type":"strong"},{"type":"text","text":" — injected into the "},{"code":"WKWebView","type":"codeVoice"},{"type":"text","text":" to monkey-patch "},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"type":"text","text":" and shuttle requests\/responses through "},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"WebView.swift"}],"type":"strong"},{"type":"text","text":" — "},{"code":"UIViewRepresentable","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"NSViewRepresentable","type":"codeVoice"},{"type":"text","text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"WebAuthnHandler.swift"}],"type":"strong"},{"type":"text","text":" — decodes the JSON envelope, builds a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","isActive":true},{"type":"text","text":", and calls "},{"code":"FidoUI.makeCredential","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"FidoUI.getAssertion","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"ContentView.swift"}],"type":"strong"},{"type":"text","text":" — minimal SwiftUI shell with a URL bar and back button."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"FidoUI"}],"type":"strong"},{"type":"text","text":" (separate Swift package under "},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI","type":"codeVoice"},{"type":"text","text":") — the reusable UI + transport layer described below."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The end-to-end flow:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Page JS calls "},{"code":"navigator.credentials.create()","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":".get()","type":"codeVoice"},{"type":"text","text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"WebAuthnHandler","type":"codeVoice"},{"type":"text","text":" decodes the JSON straight into the SDK’s strongly-typed "},{"code":"Options","type":"codeVoice"},{"type":"text","text":" and hands them to "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" opens a transport, runs the ceremony via "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":", and shows PIN \/ UV \/ error \/ success panels as needed."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The resulting "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","isActive":true},{"type":"text","text":" is serialized via its built-in "},{"code":"toJSON()","type":"codeVoice"},{"type":"text","text":" and posted back to JS."}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Intercepting WebAuthn Calls","level":2,"anchor":"Intercepting-WebAuthn-Calls","type":"heading"},{"text":"JavaScript Injection","level":3,"anchor":"JavaScript-Injection","type":"heading"},{"inlineContent":[{"code":"Interceptor.js","type":"codeVoice"},{"text":" replaces ","type":"text"},{"code":"navigator.credentials.create","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"navigator.credentials.get","type":"codeVoice"},{"text":" with versions that forward to Swift. Binary fields (","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"user.id","type":"codeVoice"},{"text":", ","type":"text"},{"code":"rawId","type":"codeVoice"},{"text":", …) are serialized to ","type":"text"},{"inlineContent":[{"type":"text","text":"base64url"}],"type":"strong"},{"text":" strings via ","type":"text"},{"code":"JSON.stringify","type":"codeVoice"},{"text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed.","type":"text"}],"type":"paragraph"},{"syntax":"javascript","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"],"type":"codeListing"},{"inlineContent":[{"text":"The script is injected at document start so it runs before any page code:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"],"type":"codeListing"},{"inlineContent":[{"code":"shouldIntercept","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for any ","type":"text"},{"code":"publicKey","type":"codeVoice"},{"text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when ","type":"text"},{"code":"publicKey.hints","type":"codeVoice"},{"text":" includes ","type":"text"},{"code":"\"security-key\"","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"text":"Receiving Messages in Swift","level":3,"anchor":"Receiving-Messages-in-Swift","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"Coordinator","type":"codeVoice"},{"text":" is both ","type":"text"},{"code":"WKNavigationDelegate","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"shutdown()","type":"codeVoice"},{"text":" is called from ","type":"text"},{"code":"dismantle{UI,NS}View","type":"codeVoice"},{"text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle.","type":"text"}],"type":"paragraph"},{"text":"Driving the Ceremony","level":2,"anchor":"Driving-the-Ceremony","type":"heading"},{"inlineContent":[{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" is intentionally tiny — it decodes the envelope, builds a typed ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":", and delegates to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"],"type":"codeListing"},{"inlineContent":[{"code":"handleGet","type":"codeVoice"},{"text":" is the symmetric counterpart that decodes ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","isActive":true,"type":"reference"},{"text":" and calls ","type":"text"},{"code":"fidoUI.getAssertion","type":"codeVoice"},{"text":". The response JSON produced by ","type":"text"},{"code":"toJSON()","type":"codeVoice"},{"text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to ","type":"text"},{"code":"ArrayBuffer","type":"codeVoice"},{"text":" when it materializes the credential.","type":"text"}],"type":"paragraph"},{"text":"Returning the Response to JavaScript","level":2,"anchor":"Returning-the-Response-to-JavaScript","type":"heading"},{"inlineContent":[{"text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"],"type":"codeListing"},{"inlineContent":[{"text":"JavaScript decodes the JSON and rebuilds a ","type":"text"},{"code":"PublicKeyCredential","type":"codeVoice"},{"text":"-shaped object — converting the base64url binary fields back to ","type":"text"},{"code":"ArrayBuffer","type":"codeVoice"},{"text":"s and wiring up ","type":"text"},{"code":"getClientExtensionResults","type":"codeVoice"},{"text":", ","type":"text"},{"code":"getAuthenticatorData","type":"codeVoice"},{"text":", ","type":"text"},{"code":"getPublicKey","type":"codeVoice"},{"text":", ","type":"text"},{"code":"toJSON","type":"codeVoice"},{"text":", and the rest. Errors travel through a parallel ","type":"text"},{"code":"__webauthn_error__","type":"codeVoice"},{"text":" channel and surface to the page as a ","type":"text"},{"code":"DOMException","type":"codeVoice"},{"text":" with name ","type":"text"},{"code":"NotAllowedError","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"The FidoUI Module","level":2,"anchor":"The-FidoUI-Module","type":"heading"},{"inlineContent":[{"code":"FidoUI","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting ","type":"text"},{"code":"navigator.credentials.*","type":"codeVoice"},{"text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Transport selection."}],"type":"strong"},{"type":"text","text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Ceremony serialization."}],"type":"strong"},{"type":"text","text":" Concurrent calls on the same "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Cancellation."}],"type":"strong"},{"type":"text","text":" A single "},{"code":"cancel()","type":"codeVoice"},{"type":"text","text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The host code only needs to construct one ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" instance and call ","type":"text"},{"code":"makeCredential","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"getAssertion","type":"codeVoice"},{"text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See ","type":"text"},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/","type":"codeVoice"},{"text":" for the full source.","type":"text"}],"type":"paragraph"},{"text":"Platform Notes","level":2,"anchor":"Platform-Notes","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"iOS."}],"type":"strong"},{"type":"text","text":" The wired path goes through CryptoTokenKit ("},{"code":"WiredSmartCardConnection","type":"codeVoice"},{"type":"text","text":" — USB-C or Lightning), and the NFC path through "},{"code":"NFCSmartCardConnection","type":"codeVoice"},{"type":"text","text":". The sample’s "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" declares "},{"code":"NFCReaderUsageDescription","type":"codeVoice"},{"type":"text","text":" and lists the FIDO applet AID ("},{"code":"A0000006472F0001","type":"codeVoice"},{"type":"text","text":") under "},{"code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers","type":"codeVoice"},{"type":"text","text":"; the entitlements turn on "},{"code":"com.apple.developer.nfc.readersession.formats","type":"codeVoice"},{"type":"text","text":" ("},{"code":"TAG","type":"codeVoice"},{"type":"text","text":") and "},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"macOS."}],"type":"strong"},{"type":"text","text":" "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" uses "},{"code":"HIDFIDOConnection","type":"codeVoice"},{"type":"text","text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables "},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"type":"text","text":" and "},{"code":"com.apple.security.device.usb","type":"codeVoice"},{"type":"text","text":" so the same target builds cleanly for both platforms."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Where to Customize","level":2,"anchor":"Where-to-Customize","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Which requests get intercepted."}],"type":"strong"},{"type":"text","text":" Edit "},{"code":"shouldIntercept","type":"codeVoice"},{"type":"text","text":" in "},{"code":"Interceptor.js","type":"codeVoice"},{"type":"text","text":" to scope by hint, RP ID, or any other heuristic."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Origin verification."}],"type":"strong"},{"type":"text","text":" "},{"code":"WebAuthnHandler","type":"codeVoice"},{"type":"text","text":" builds a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","isActive":true},{"type":"text","text":" from "},{"code":"window.location.origin","type":"codeVoice"},{"type":"text","text":". Replace the "},{"code":"isPublicSuffix","type":"codeVoice"},{"type":"text","text":" closure passed to "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" with a real public-suffix-list check before shipping."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"UI."}],"type":"strong"},{"type":"text","text":" Swap or restyle the panels in "},{"code":"FidoUI\/Sources\/FidoUI\/Views\/","type":"codeVoice"},{"type":"text","text":" — the rest of the module is UI-agnostic."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/webauthninterceptorsamplecode"]}],"sampleCodeDownload":{"action":{"isActive":true,"overridingTitle":"View Source","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample","type":"reference"},"kind":"sampleDownload"},"sections":[],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"sampleCode","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","roleHeading":"Sample Code","color":{"standardColorIdentifier":"yellow"},"modules":[{"name":"YubiKit"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"},"seeAlsoSections":[{"title":"Sample code","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"],"anchor":"Sample-code","generated":true}],"references":{"documentation-header.png":{"alt":"YubiKeys in a row","identifier":"documentation-header.png","type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}],"navigatorTitle":[{"text":"Client","kind":"identifier"}],"abstract":[{"text":"Client for performing WebAuthn passkey operations.","type":"text"}],"type":"topic","title":"WebAuthn.Client","role":"symbol","url":"\/documentation\/yubikit\/webauthn\/client","kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/docu
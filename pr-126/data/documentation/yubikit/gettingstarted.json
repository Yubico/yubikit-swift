-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"reference","isActive":true},{"type":"text","text":" to retrieve authentication codes, and "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"reference","isActive":true},{"type":"text","text":" to get device information."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","role":"sampleCode","url":"\/documentation\/yubikit\/oathsamplecode","kind":"article","type":"topic"},"documentation-header.png":{"identifier":"documentation-header.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}],"alt":"YubiKeys in a row","type":"image"},"external-accessory.png":{"identifier":"external-accessory.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to support for lightning YubiKeys.","type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"title":"PIVTool: Building PIV applications with YubiKey","abstract":[{"text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","type":"reference","isActive":true},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","role":"sampleCode","url":"\/documentation\/yubikit\/pivtoolsamplecode","kind":"article","type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"role":"symbol","navigatorTitle":[{"text":"Client","kind":"identifier"}],"url":"\/documentation\/yubikit\/webauthn\/client","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"topic","kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}],"title":"WebAuthn.Client","abstract":[{"text":"Client for performing WebAuthn passkey operations.","type":"text"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","navigatorTitle":[{"text":"PIVSession","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/yubikit\/pivsession","title":"PIVSession","kind":"symbol","abstract":[{"text":"An interface to the PIV application on the YubiKey.","type":"text"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}]},"nfc-privacy.png":{"identifier":"nfc-privacy.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to add the NFC privacy string to a project.","type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/CTAP2/Session":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Session"}],"url":"\/documentation\/yubikit\/ctap2\/session","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}],"title":"CTAP2.Session","abstract":[{"type":"text","text":"Interface to the FIDO2\/CTAP authenticator on the YubiKey."}]},"smart-card.png":{"identifier":"smart-card.png","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/smart-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/smart-card~dark@2x.png"}],"alt":"An image showing how to add NFC privacy string to project.","type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authorization":{"role":"symbol","navigatorTitle":[{"text":"Authorization","kind":"identifier"}],"url":"\/documentation\/yubikit\/webauthn\/authorization","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Authorization","kind":"identifier"}],"title":"WebAuthn.Authorization","abstract":[{"type":"text","text":"PIN\/UV policy for a single WebAuthn ceremony."}]},"add-framework-2.png":{"variants":[{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-2@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-2~dark@2x.png","traits":["2x","dark"]}],"identifier":"add-framework-2.png","type":"image","alt":"An image showing how to add the YubiKit SDK to your Xcode project."},"nfc-identifiers-list.png":{"variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list~dark@2x.png","traits":["2x","dark"]}],"identifier":"nfc-identifiers-list.png","type":"image","alt":"An image showing the list of nfc identifiers added."},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","kind":"symbol","title":"YubiKit","type":"topic","role":"collection","url":"\/documentation\/yubikit","abstract":[{"text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB.","type":"text"}],"images":[{"identifier":"documentation-header.png","type":"icon"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"identifier":"doc:\/\
{"kind":"article","abstract":[{"text":"Prepare your project to connect to the YubiKey via NFC, SmartCard and Lightning.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The YubiKit framework is distributed using the Swift Package Manager. To add the framework to your project follow these steps:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Select your project.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Choose the “Package Dependencies” tab."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Press the plus-button to bring up the add package dialog."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"add-framework-1.png"}]},{"type":"orderedList","start":4,"items":[{"content":[{"inlineContent":[{"type":"text","text":"Enter "},{"code":"https:\/\/github.com\/Yubico\/yubikit-swift\/","type":"codeVoice"},{"type":"text","text":" in the search field and select the Yubico Swift Package."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Press the “Add Package” button to add the SDK to your project."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"add-framework-2.png"}]},{"level":3,"text":"NFC","anchor":"NFC","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC","type":"text"},{"text":" ","type":"text"},{"text":"application identifiers and a NFC Privacy statement to the application.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Add Wireless entitlement"}],"type":"strong"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Select your project."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select your application target."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Choose the “Signing & Capabilities” tab."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Click the “+”-button to add a new capability."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select the “Near Field Communication Tag” capability."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-entitlement.png"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Add list of NFC application identifiers"}],"type":"strong"}]},{"type":"orderedList","start":6,"items":[{"content":[{"inlineContent":[{"type":"text","text":"Choose the “Info” tab."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-identifiers.png"}]},{"type":"orderedList","start":8,"items":[{"content":[{"inlineContent":[{"type":"text","text":"Add the Yubico NFC application identifiers to enable communication with the different"},{"type":"text","text":" "},{"type":"text","text":"applications on the YubiKey."}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":null,"code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-identifiers-list.png"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Add a NFC Privacy description"}],"type":"strong"}]},{"type":"orderedList","start":9,"items":[{"content":[{"inlineContent":[{"type":"text","text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in"},{"type":"text","text":" "},{"type":"text","text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-privacy.png"}]},{"level":3,"text":"SmartCard\/USB","anchor":"SmartCardUSB","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"text":" entitlement to your application.","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Select the application entitlements file."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"type":"text","text":" entitlement to the entitlement list."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"smart-card.png"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"The SmartCard\/USB connection only support the CCID based applications on the YubiKey and does not support U2F, FIDO2 or OTP."}],"type":"paragraph"}]},{"level":3,"text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey","anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the ","type":"text"},{"type":"codeVoice","code":"com.yubico.ylp"},{"text":" string to the list of External Accessories.","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Select your project."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select your application target."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Choose the “Info” tab."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If not present add the "},{"code":"Supported external accessory protocols","type":"codeVoice"},{"type":"text","text":" key and insert the string "},{"code":"com.yubico.ylp","type":"codeVoice"},{"type":"text","text":" in its list."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"external-accessory.png"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for "},{"type":"codeVoice","code":"Supported external accessory protocols"},{"type":"text","text":" to "},{"type":"codeVoice","code":"com.yubico.ylp"},{"type":"text","text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework."}],"type":"paragraph"}]},{"level":2,"text":"Making Your First Connection","anchor":"Making-Your-First-Connection","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device.","type":"text"}]},{"level":3,"text":"Understanding Connection Types","anchor":"Understanding-Connection-Types","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"YubiKit handles three different connection methods:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"NFC"}],"type":"strong"},{"type":"text","text":": Short-range wireless communication (iOS only)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"USB"}],"type":"strong"},{"type":"text","text":": Direct USB connection via SmartCard interface"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Lightning"}],"type":"strong"},{"type":"text","text":": YubiKey 5Ci connected to Lightning port (iOS only)"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Each connection type works differently, so let’s explore how to use them.","type":"text"}]},{"level":3,"text":"NFC Connections","anchor":"NFC-Connections","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"]},{"type":"paragraph","inlineContent":[{"text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete.","type":"text"}]},{"level":3,"text":"USB and Lightning Connections","anchor":"USB-and-Lightning-Connections","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"WiredSmartCardConnection.makeConnection()"},{"text":" method automatically detects whether you’re using USB or Lightning.","type":"text"}]},{"level":3,"text":"Specific Connection Types","anchor":"Specific-Connection-Types","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For more control, you can connect to specific interfaces:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"]},{"level":2,"text":"Understanding Connection Lifecycle","anchor":"Understanding-Connection-Lifecycle","type":"heading"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Critical:"}],"type":"strong"},{"text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time.","type":"text"}]},{"level":3,"text":"Connection Behavior","anchor":"Connection-Behavior","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Exclusive access"}],"type":"strong"},{"type":"text","text":": Only one connection can exist per YubiKey at any time"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Manual closure required"}],"type":"strong"},{"type":"text","text":": Dropping a connection reference does NOT automatically close it - you must call "},{"code":"close()","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Resource blocking"}],"type":"strong"},{"type":"text","text":": An unclosed connection prevents new connections (throws "},{"code":"SmartCardConnectionError.busy","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call ","type":"text"},{"type":"codeVoice","code":"close()"},{"text":".","type":"text"}]},{"level":2,"text":"Working with Sessions","anchor":"Working-with-Sessions","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Once you have a connection, create sessions to access different YubiKey applications:","type":"text"}]},{"level":3,"text":"OATH Session (TOTP\/HOTP codes)","anchor":"OATH-Session-TOTPHOTP-codes","type":"heading"},{"type":"codeListing","syntax":"swift","code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"]},{"level":3,"text":"PIV Session (Certificates and keys)","anchor":"PIV-Session-Certificates-and-keys","type":"heading"},{"type":"codeListing","syntax":"swift","code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"]},{"level":3,"text":"Management Session (Device information)","anchor":"Management-Session-Device-information","type":"heading"},{"type":"codeListing","syntax":"swift","code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"]},{"level":3,"text":"WebAuthn Client (FIDO2 \/ passkeys)","anchor":"WebAuthn-Client-FIDO2--passkeys","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For passkey registration and authentication, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":" wraps a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"type":"codeVoice","code":"HIDFIDOConnection"},{"text":" (USB HID on macOS) or any ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection"},{"text":" ","type":"text"},{"text":"(NFC \/ USB CCID).","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"]},{"type":"paragraph","inlineContent":[{"text":"PIN and UV are supplied per ceremony via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization"},{"text":". For raw","type":"text"},{"text":" ","type":"text"},{"text":"CTAP2 access (credential management, bio enrollment, large blobs), use","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"text":" directly.","type":"text"}]},{"level":2,"text":"Connection Management Patterns","anchor":"Connection-Management-Patterns","type":"heading"},{"level":3,"text":"For UI Applications","anchor":"For-UI-Applications","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode"},{"text":" for complete examples of reactive connection management patterns that automatically update your UI when YubiKeys are plugged in or removed.","type":"text"}]},{"level":3,"text":"For Command-Line Tools","anchor":"For-Command-Line-Tools","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"CLI applications often use a simpler approach with a single connection per operation. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"},{"text":" for examples of how command-line tools handle connections for one-time operations.","type":"text"}]},{"level":2,"text":"Next Steps","anchor":"Next-Steps","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Now you’re ready to build YubiKey applications! Check out the sample projects to see complete implementations:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"OATHSample"}],"type":"strong"},{"type":"text","text":": Shows how to build a TOTP authenticator app with SwiftUI"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"PIVTool"}],"type":"strong"},{"type":"text","text":": Demonstrates PIV operations for certificates and digital signatures"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"WebAuthnInterceptorSample"}],"type":"strong"},{"type":"text","text":": Routes WebAuthn calls from a "},{"code":"WKWebView","type":"codeVoice"},{"type":"text","text":" through "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" to a YubiKey"}],"type":"paragraph"}]}]},{"level":3,"text":"Build SDK documentation","anchor":"Build-SDK-documentation","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"You can also build the complete SDK documentation by selecting “Product” -> “Build Documentation” in Xcode. This gives you access to the full YubiKit API reference.","type":"text"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"Select an iOS target when building documentation to include all connection types."}],"type":"paragraph"}]}]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted"},"variants":[{"paths":["\/documentation\/yubikit\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","role":"article","title":"Getting Started","modules":[{"name":"YubiKit"}]},"references":{"external-accessory.png":{"identifier":"external-accessory.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to support for lightning YubiKeys.","type":"image"},"nfc-entitlement.png":{"alt":"An image showing how to add wireless entitlements to project.","identifier":"nfc-entitlement.png","type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement~dark@2x.png","traits":["2x","dark"]}]},"documentation-header.png":{"alt":"YubiKeys in a row","type":"image","identifier":"documentation-header.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Session","kind":"identifier"}],"navigatorTitle":[{"text":"Session","kind":"identifier"}],"abstract":[{"text":"An interface to the Management application on the YubiKey.","type":"text"}],"title":"Management.Session","type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/yubikit\/management\/session","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authorization":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Authorization"}],"navigatorTitle":[{"kind":"identifier","text":"Authorization"}],"type":"topic","title":"WebAuthn.Authorization","abstract":[{"text":"PIN\/UV policy for a single WebAuthn ceremony.","type":"text"}],"role":"symbol","url":"\/documentation\/yubikit\/webauthn\/authorization","kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"kind":"article","abstract":[{"type":"text","text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","type":"reference","isActive":true},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}],"url":"\/documentation\/yubikit\/pivtoolsamplecode","type":"topic","title":"PIVTool: Building PIV applications with YubiKey","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","role":"sampleCode"},"add-framework-1.png":{"variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1~dark@2x.png"}],"type":"image","alt":"An image showing how to add the YubiKit SDK to your Xcode project.","identifier":"add-framework-1.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}],"navigatorTitle":[{"text":"Client","kind":"identifier"}],"abstract":[{"text":"Client for performing WebAuthn passkey operations.","type":"text"}],"type":"topic","title":"WebAuthn.Client","role":"symbol","url":"\/documentation\/yubikit\/webauthn\/client","kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},"smart-card.png":{"variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/smart-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/smart-card~dark@2x.png"}]
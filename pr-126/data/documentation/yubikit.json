{"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The YubiKit Swift SDK provides a modern async\/await version of the YubiKit framework, making it easy to integrate"},{"type":"text","text":" "},{"type":"text","text":"in Swift and SwiftUI based applications. The async\/await syntax provides an easy to read and powerful way of"},{"type":"text","text":" "},{"type":"text","text":"creating connections and sending commands to the different applications on the YubiKey."}]},{"type":"codeListing","syntax":"swift","code":["let connection = try await NFCSmartCardConnection()","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()"]},{"type":"aside","style":"warning","content":[{"type":"paragraph","inlineContent":[{"text":"This SDK does not perform zeroization of sensitive data in memory. Cryptographic keys, PIN tokens,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and other secrets are not securely erased when no longer in use. This is currently out of scope but may be"},{"text":" ","type":"text"},{"text":"addressed in a future release.","type":"text"}]}],"name":"Warning"}]}],"variants":[{"paths":["\/documentation\/yubikit"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"externalID":"YubiKit","symbolKind":"module","images":[{"type":"icon","identifier":"documentation-header.png"}],"title":"YubiKit","color":{"standardColorIdentifier":"green"},"modules":[{"name":"YubiKit"}],"platforms":[{"name":"iOS","introducedAt":"16.0","beta":false},{"name":"macOS","introducedAt":"13.0","beta":false}],"roleHeading":"Framework","role":"collection"},"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Connect and run commands on the different applications on a YubiKey. The framework suppor
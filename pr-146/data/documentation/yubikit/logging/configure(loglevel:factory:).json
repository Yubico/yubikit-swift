t"},{"code":"info","type":"codeVoice"},{"text":" otherwise.","type":"text"},{"text":" ","type":"text"},{"text":"Each call replaces both options. An omitted factory uses YubiKit’s default backend;","type":"text"},{"text":" ","type":"text"},{"text":"an omitted level preserves the selected handler’s level.","type":"text"},{"text":" ","type":"text"},{"text":"Existing sessions use the new configuration on their next logging operation.","type":"text"},{"text":" ","type":"text"},{"text":"Operations already in progress may finish using the previous configuration.","type":"text"}]},{"code":["\/\/ Include raw traffic when YubiKit is compiled with DEBUG.","Logging.configure(logLevel: .trace)","","\/\/ Restore the build's default backend and level.","Logging.configure()"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/logging\/configure(loglevel:factory:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging\/configure(logLevel:factory:)"},"abstract":[{"text":"Replaces the SDK’s logging configuration without affecting other libraries.","type":"text"}],"kind":"symbol","references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logging":{"kind":"symbol","navigatorTitle":[{"text":"Logging","kind":"identifier"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging","title":"Logging","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Logging","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Configures logging for YubiKit connections and sessions."}],"role":"symbol","url":"\/documentation\/yubikit\/logging"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/LoggingGuide":{"kind":"article","identi
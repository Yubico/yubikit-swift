agraph","inlineContent":[{"text":"Call with no arguments to restore YubiKit’s defaults: standard output at ","type":"text"},{"code":"debug","type":"codeVoice"},{"text":" ","type":"text"},{"text":"when the SDK is compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"},{"text":", or standard error at ","type":"text"},{"code":"info","type":"codeVoice"},{"text":" otherwise.","type":"text"},{"text":" ","type":"text"},{"text":"Each call replaces both options. An omitted factory uses YubiKit’s default backend;","type":"text"},{"text":" ","type":"text"},{"text":"an omitted level preserves the selected handler’s level.","type":"text"},{"text":" ","type":"text"},{"text":"Existing sessions use the new configuration on their next logging operation.","type":"text"},{"text":" ","type":"text"},{"text":"Operations already in progress may finish using the previous configuration.","type":"text"}]},{"code":["\/\/ Include raw traffic when YubiKit is compiled with DEBUG.","Logging.configure(logLevel: .trace)","","\/\/ Restore the build's default backend and level.","Logging.configure()"],"type":"codeListing","syntax":"swift"}]}],"abstract":[{"type":"text","text":"Replaces the SDK’s logging configuration without affecting other libraries."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/logging\/configure(loglevel:factory:)"]}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logging/configure(logLevel:factory:)":{"kind":"symbol","title":"configure(logLevel:factory:)","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging\/configure(logLevel:factory:)","role":"symbol","abstract":[{"type":"text","text":"Replaces the SDK’s logging configuration without affecting other libraries."}],"type":"topic","url":"\/documentation\/yubikit\/logging\/configure(loglevel:factory:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "
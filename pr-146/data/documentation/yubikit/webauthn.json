{"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"WebAuthn"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"Contains the high-level passkey ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":" and the request, response, and","type":"text"},{"text":" ","type":"text"},{"text":"data-model types defined by the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/","type":"reference"},{"text":" ","type":"text"},{"text":"specification.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A passkey client and the W3C Web Authentication data model, mediated by a YubiKey."}],"type":"paragraph"},{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"WebAuthn"},{"text":" namespace provides a high-level passkey client (","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"text":") that runs","type":"text"},{"text":" ","type":"text"},{"overridingTitleInlineContent":[{"type":"text","text":"Web Authentication Level 3"}],"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/","type":"reference","isActive":true,"overridingTitle":"Web Authentication Level 3"},{"text":" ceremonies against a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"YubiKey, plus the request and response types defined by the WebAuthn specification."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A WebAuthn ceremony involves three parties: the "},{"type":"strong","inlineContent":[{"type":"text","text":"authenticator"}]},{"type":"text","text":" (a YubiKey), the"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"client","type":"text"}]},{"type":"text","text":" (your app, via "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":"), and the "},{"type":"strong","inlineContent":[{"text":"relying party","type":"text"}]},{"text":" (your server, which","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"verifies what the authenticator returns). The client is the communication path between"},{"type":"text","text":" "},{"text":"authenticator and relying party — and it verifies the relying party’s identity against","type":"text"},{"text":" ","type":"text"},{"text":"the origin it’s bound to, so it can refuse to sign for a fraudulent site.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There are two ceremonies. "},{"type":"strong","inlineContent":[{"type":"text","text":"Registration"}]},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","isActive":true},{"type":"text","text":") creates a new credential and supplies its"},{"type":"text","text":" "},{"type":"text","text":"public key to the relying party for account association. "},{"type":"strong","inlineContent":[{"text":"Authentication","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","isActive":true},{"type":"text","text":") proves to the relying party that the"},{"type":"text","text":" "},{"type":"text","text":"YubiKey is the one registered for the user. Both ceremonies follow the same mechanical"},{"type":"text","text":" "},{"text":"shape: the relying party supplies a challenge, the authenticator signs it together","type":"text"},{"text":" ","type":"text"},{"text":"with the relying-party identifier, and the signature goes back to the relying party","type":"text"},{"text":" ","type":"text"},{"text":"for verification.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The pieces fit together as: a connection carries CTAP2 traffic, a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"sits on top, and "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" runs ceremonies on that session. Connections come in"},{"type":"text","text":" "},{"type":"text","text":"three flavours that all work for WebAuthn: "},{"type":"codeVoice","code":"YubiKit\/HIDFIDOConnection"},{"text":" on macOS,","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection","isActive":true},{"type":"text","text":" for tap-to-auth on iOS, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/USBSmartCardConnection","isActive":true},{"type":"text","text":" on either platform. Pick the one that matches"},{"type":"text","text":" "},{"type":"text","text":"your platform and form factor."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ macOS — USB HID FIDO","let connection = try await HIDFIDOConnection()","\/\/ iOS — tap-to-auth over NFC:","\/\/ let connection = try await NFCSmartCardConnection()","","let session = try await CTAP2.Session.makeSession(connection: connection)","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","\/\/ Register a new passkey","let registration = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value","","\/\/ Authenticate","let assertions = try await client.getAssertion(","    .init(challenge: challenge, rpId: \"example.com\"),","    authorization: .pin(\"1234\")",").value"]},{"inlineContent":[{"text":"Most apps start with ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"type":"text","text":". For lower-level CTAP2 access — raw "},{"type":"codeVoice","code":"makeCredential"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"getAssertion"},{"text":", credential management, bio enrollment — use ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"text":" directly.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/webauthn"]}],"topicSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientData","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/PublicSuffixChecker"],"anchor":"Client","title":"Client"},{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAut
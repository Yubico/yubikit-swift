pleCode","url":"\/documentation\/yubikit\/pivtoolsamplecode"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"type":"topic","abstract":[{"text":"Client for performing WebAuthn passkey operations.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","role":"symbol","title":"WebAuthn.Client","url":"\/documentation\/yubikit\/webauthn\/client","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"navigatorTitle":[{"kind":"identifier","text":"Client"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"type":"topic","kind":"article","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","role":"sampleCode","abstract":[{"text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts ","type":"text"},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"text":" calls inside a ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" and routes them to a YubiKey. It uses the high-level ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" companion module.","type":"text"}],"url":"\/documentation\/yubikit\/webauthninterceptorsamplecode","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView"}}}
er verification and the PIN path is chosen — when built-in UV isn’t"},{"type":"text","text":" "},{"type":"text","text":"available, has been blocked, or is ruled out by the "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/UVPolicy","isActive":true},{"type":"text","text":" on this"},{"type":"text","text":" "},{"type":"codeVoice","code":"Authorization"},{"type":"text","text":". If built-in UV succeeds, the closure is never called. PIN"},{"type":"text","text":" "},{"type":"text","text":"attempts are one-shot: a wrong PIN throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/pinRejected(retriesRemaining:source:)","isActive":true},{"type":"text","text":" and the caller"},{"type":"text","text":" "},{"type":"text","text":"re-invokes the ceremony with a fresh "},{"type":"codeVoice","code":"Authorization"},{"type":"text","text":". Returning "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/PINReply\/cancel","isActive":true},{"type":"text","text":" "},{"type":"text","text":"aborts with "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/cancelled(source:)","isActive":true},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Pre-supplied PIN — skips built-in UV.","let r = try await client.makeCredential(opts, authorization: .pin(\"1234\")).value","","\/\/ Built-in UV only — the PIN closure is never invoked.","let r = try await client.makeCredential(opts, authorization: .uvOnly).value","","\/\/ Custom — bridge into a UI.","let auth = WebAuthn.Authorization(providePIN: {","    guard let pin = await viewModel.askForPIN() else { return .cancel }","    return .pin(pin)","}, uv: .preferred)"]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/
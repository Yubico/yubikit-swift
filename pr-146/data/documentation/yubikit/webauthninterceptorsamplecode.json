ion."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"title":"OATHSession","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","navigatorTitle":[{"text":"OATHSession","kind":"identifier"}],"url":"\/documentation\/yubikit\/oathsession","kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"OATHSession"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"An interface to the OATH application on the YubiKey."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}],"title":"WebAuthn.Client","navigatorTitle":[{"text":"Client","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","url":"\/documentation\/yubikit\/webauthn\/client","abstract":[{"text":"Client for performing WebAuthn passkey operations.","type":"text"}],"role":"symbol"}}}
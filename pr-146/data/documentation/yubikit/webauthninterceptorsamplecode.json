c","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","url":"\/documentation\/yubikit\/pivsession","kind":"symbol","role":"symbol","abstract":[{"text":"An interface to the PIV application on the YubiKey.","type":"text"}],"title":"PIVSession","navigatorTitle":[{"text":"PIVSession","kind":"identifier"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authentication/Response":{"navigatorTitle":[{"text":"Response","kind":"identifier"}],"type":"topic","title":"WebAuthn.Authentication.Response","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","url":"\/documentation\/yubikit\/webauthn\/authentication\/response","kind":"symbol","role":"symbol","abstract":[{"text":"Authenticator response from a successful credential authentication.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Response","kind":"identifier"}]}}}
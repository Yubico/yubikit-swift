{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Configure YubiKit diagnostics with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging"},{"text":" and SwiftLog.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"metadata":{"roleHeading":"Article","title":"Logging","role":"article","modules":[{"name":"YubiKit"}]},"kind":"article","identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Preparing-your-project","title":"Preparing your project","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging"],"generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"YubiKit provides its own defaults using ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-log"},{"text":":","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"When the SDK is compiled with ","type":"text"},{"type":"codeVoice","code":"DEBUG"},{"text":", messages at ","type":"text"},{"type":"codeVoice","code":"debug"},{"text":" and above go to standard output,","type":"text"},{"text":" ","type":"text"},{"text":"appearing in Xcode’s console like ","type":"text"},{"type":"codeVoice","code":"print"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Otherwise, messages at "},{"type":"codeVoice","code":"info"},{"type":"text","text":" and above go to standard error."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Raw "},{"type":"codeVoice","code":"trace"},{"type":"text","text":" traffic is available only when YubiKit is compiled with "},{"type":"codeVoice","code":"DEBUG"},{"type":"text","text":", and is disabled by default."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"No caller configuration or ","type":"text"},{"type":"codeVoice","code":"#if DEBUG"},{"text":" block is needed for this behavior.","type":"text"}]},{"type":"heading","level":3,"text":"Levels and custom backends","anchor":"Levels-and-custom-backends"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging\/configure(logLevel:factory:)"},{"text":" to configure just YubiKit:","type":"text"}],"type":"paragraph"},{"code":["import YubiKit","import Logging","","Logging.configure(logLevel: .warning)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Add SwiftLog’s ","type":"text"},{"type":"codeVoice","code":"Logging"},{"text":" product to your application target when using its backend types.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The factory accepts any SwiftLog ","type":"text"},{"type":"codeVoice","code":"LogHandler"},{"text":". Its category labels start with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"com.yubico.YubiKit."},{"type":"text","text":", followed by a category such as "},{"type":"codeVoice","code":"OATH"},{"type":"text","text":", "},{"type":"codeVoice","code":"PIV"},{"text":", ","type":"text"},{"type":"codeVoice","code":"FIDO"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"SmartCard"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Use the label to route or filter categories.","type":"text"},{"text":" ","type":"text"},{"text":"Leave ","type":"text"},{"type":"codeVoice","code":"logLevel"},{"text":" nil to preserve each handler’s own level.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Supply a backend and an explicit minimum level.","Logging.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Suppress SDK output.","Logging.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore YubiKit's defaults for this build.","Logging.configure()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Each call replaces both settings: an omitted factory uses YubiKit’s default backend, and an omitted","type":"text"},{"text":" ","type":"text"},{"text":"level preserves the selected handler’s level.","type":"text"},{"text":" ","type":"text"},{"text":"Configuration can change after sessions have been created. Subsequent SDK logging operations use","type":"text"},{"text":" ","type":"text"},{"text":"the new settings; operations already in progress may finish with the previous settings. Factories","type":"text"},{"text":" ","type":"text"},{"text":"may run concurrently and should not log through YubiKit themselves.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"YubiKit configuration leaves other libraries’ loggers unchanged. Its default backend and level","type":"text"},{"text":" ","type":"text"},{"text":"do not inherit the application’s global ","type":"text"},{"type":"codeVoice","code":"LoggingSystem.bootstrap"},{"text":" configuration. To share a backend, pass its handler","type":"text"},{"text":" ","type":"text"},{"text":"factory to YubiKit’s ","type":"text"},{"type":"codeVoice","code":"configure"},{"text":" method too. The SDK never calls ","type":"text"},{"type":"codeVoice","code":"LoggingSystem.bootstrap"},{"text":" itself.","type":"text"}],"type":"paragraph"},{"text":"Levels","anchor":"Levels","level":3,"type":"heading"},{"inlineContent":[{"text":"YubiKit follows the Python SDK’s distinction between operation diagnostics and traffic tracing:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Level","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Content","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"error"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"warning"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Failures and unexpected conditions.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"info"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Significant session and configuration events.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"debug"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Operation details, identifiers, and protocol decisions.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"trace"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Python’s ","type":"text"},{"type":"codeVoice","code":"TRAFFIC"},{"text":": raw transport bytes and SCP plaintext, compiled only with ","type":"text"},{"type":"codeVoice","code":"DEBUG"},{"text":".","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"Logging.configure(logLevel: .trace)"},{"text":" to include traffic when YubiKit is compiled with ","type":"text"},{"type":"codeVoice","code":"DEBUG"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"SwiftLog’s ","type":"text"},{"type":"codeVoice","code":".trace"},{"text":" level remains available in other builds, but neither it nor a custom backend","type":"text"},{"text":" ","type":"text"},{"text":"can enable YubiKit’s raw traffic or SCP plaintext logs in those builds. This depends on how","type":"text"},{"text":" ","type":"text"},{"text":"the SDK is compiled, not on the caller’s build configuration.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"USB, NFC, and Lightning smart-card traces contain each APDU request and response, including","type":"text"},{"text":" ","type":"text"},{"text":"response status words. FIDO traces contain HID packets, including continuation, cancellation,","type":"text"},{"text":" ","type":"text"},{"text":"keepalive, and error packets. SCP traces include the command data before encryption and the","type":"text"},{"text":" ","type":"text"},{"text":"unpadded response data after decryption. Messages use ","type":"text"},{"type":"codeVoice","code":"SEND:"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RECV:"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Plaintext data:"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Plaintext resp:"},{"text":" followed by hexadecimal bytes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Built-in connections emit their transport traces only in ","type":"text"},{"type":"codeVoice","code":"DEBUG"},{"text":" builds. Custom ","type":"text"},{"type":"codeVoice","code":"SmartCardConnection"},{"text":" implementations","type":"text"},{"text":" ","type":"text"},{"text":"should log their own APDU exchanges; the session layer emits SCP plaintext diagnostics separately.","type":"text"},{"text":" ","type":"text"},{"text":"Custom connection logging is controlled by its implementation, not by YubiKit’s compilation condition.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Debug output can contain identifying information such as relying-party IDs, credential","type":"text"},{"text":" ","type":"text"},{"text":"identifiers, and account names. Trace output can contain PINs, credentials, cryptographic material, and other sensitive","type":"text"},{"text":" ","type":"text"},{"text":"data carried by APDU or CTAP messages. Enable it only for controlled diagnostics and protect or","type":"text"},{"text":" ","type":"text"},{"text":"redact captured logs before sharing them.","type":"text"}],"type":"paragraph"}],"style":"warning","name":"Warning","type":"aside"},{"text":"Storage and export","anchor":"Storage-and-export","level":3,"type":"heading"},{"inlineContent":[{"text":"Your backend owns log storage, formatting and export. Use a SwiftLog file or unified-logging","type":"text"},{"text":" ","type":"text"},{"text":"backend when you need persistence. YubiKit does not retain log messages.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/loggingguide"]}],"sections":[],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logging":{"url":"\/documentation\/yubikit\/logging","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Configures logging for YubiKit connections and sessions."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging","title":"Logging","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Logging"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Logging"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logging/configure(logLevel:factory:)":{"kind":"symbol","title":"configure(logLevel:factory:)","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging\/configure(logLevel:factory:)","role":"symbol","abstract":[{"type":"text","text":"Replaces the SDK’s logging configuration without affecting other libraries."}],"type":"topic","url":"\/documentation\/yubikit\/logging\/configure(loglevel:factory:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"configure"},{"kind":"text","text":"("},{"kind":"externalParam","text":"logLevel"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Logger","preciseIdentifier":"s:7Logging6LoggerV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Level","preciseIdentifier":"s:7Logging6LoggerV5LevelO"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"factory"},{"kind":"text","text":": ("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"LogHandler","preciseIdentifier":"s:7Logging10LogHandlerP"},{"kind":"text","text":")?)"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"kind":"symbol","url":"\/documentation\/yubikit","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","title":"YubiKit","role":"collection","images":[{"type":"icon","identifier":"documentation-header.png"}],"type":"topic"},"https://github.com/apple/swift-log":{"type":"link","identifier":"https:\/\/github.com\/apple\/swift-log","title":"SwiftLog","url":"https:\/\/github.com\/apple\/swift-log","titleInlineContent":[{"text":"SwiftLog","type":"text"}]},"documentation-header.png":{"alt":"YubiKeys in a row","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}],"type":"image","identifier":"documentation-header.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/GettingStarted":{"url":"\/documentation\/yubikit\/gettingstarted","role":"article","type":"topic","abstract":[{"text":"Prepare your project to connect to the YubiKey via NFC, SmartCard and Lightning.","type":"text"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","title":"Getting Started","kind":"article"}}}
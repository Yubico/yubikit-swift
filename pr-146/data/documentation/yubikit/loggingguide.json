{"sections":[],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging"],"generated":true,"anchor":"Preparing-your-project","title":"Preparing your project"}],"abstract":[{"type":"text","text":"Configure YubiKit diagnostics with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging"},{"type":"text","text":" and SwiftLog."}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"YubiKit provides its own defaults using ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-log"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"When the SDK is compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"},{"text":", messages at ","type":"text"},{"code":"debug","type":"codeVoice"},{"text":" and above go to standard output,","type":"text"},{"text":" ","type":"text"},{"text":"appearing in Xcode’s console like ","type":"text"},{"code":"print","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Otherwise, messages at ","type":"text"},{"code":"info","type":"codeVoice"},{"text":" and above go to standard error.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Raw ","type":"text"},{"code":"trace","type":"codeVoice"},{"text":" traffic is available only when YubiKit is compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"},{"text":", and is disabled by default.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"No caller configuration or ","type":"text"},{"code":"#if DEBUG","type":"codeVoice"},{"text":" block is needed for this behavior.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Levels and custom backends","level":3,"anchor":"Levels-and-custom-backends"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging\/configure(logLevel:factory:)"},{"text":" to configure just YubiKit:","type":"text"}],"type":"paragraph"},{"code":["import YubiKit","import Logging","","Logging.configure(logLevel: .warning)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Add SwiftLog’s ","type":"text"},{"code":"Logging","type":"codeVoice"},{"text":" product to your application target when using its backend types.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The factory accepts any SwiftLog ","type":"text"},{"code":"LogHandler","type":"codeVoice"},{"text":". Its category labels start with","type":"text"},{"text":" ","type":"text"},{"code":"com.yubico.YubiKit.","type":"codeVoice"},{"text":", followed by a category such as ","type":"text"},{"code":"OATH","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PIV","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FIDO","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"SmartCard","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Use the label to route or filter categories.","type":"text"},{"text":" ","type":"text"},{"text":"Leave ","type":"text"},{"code":"logLevel","type":"codeVoice"},{"text":" nil to preserve each handler’s own level.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Messages describe the event; metadata carries details such as byte counts, slots, and error codes.","type":"text"},{"text":" ","type":"text"},{"text":"The default stream handler renders metadata as ","type":"text"},{"code":"key=value","type":"codeVoice"},{"text":" pairs. Custom handlers can use these","type":"text"},{"text":" ","type":"text"},{"text":"fields for filtering or structured output. Message wording and metadata keys are diagnostic details,","type":"text"},{"text":" ","type":"text"},{"text":"not a stable API.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Supply a backend and an explicit minimum level.","Logging.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Suppress SDK output.","Logging.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore YubiKit's defaults for this build.","Logging.configure()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Each call replaces both settings: an omitted factory uses YubiKit’s default backend, and an omitted","type":"text"},{"text":" ","type":"text"},{"text":"level preserves the selected handler’s level.","type":"text"},{"text":" ","type":"text"},{"text":"Configuration can change after sessions have been created. Subsequent SDK logging operations use","type":"text"},{"text":" ","type":"text"},{"text":"the new settings; operations already in progress may finish with the previous settings. Factories","type":"text"},{"text":" ","type":"text"},{"text":"may run concurrently and should not log through YubiKit themselves.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"YubiKit configuration leaves other libraries’ loggers unchanged. Its default backend and level","type":"text"},{"text":" ","type":"text"},{"text":"do not inherit the application’s global ","type":"text"},{"code":"LoggingSystem.bootstrap","type":"codeVoice"},{"text":" configuration. To share a backend, pass its handler","type":"text"},{"text":" ","type":"text"},{"text":"factory to YubiKit’s ","type":"text"},{"code":"configure","type":"codeVoice"},{"text":" method too. The SDK never calls ","type":"text"},{"code":"LoggingSystem.bootstrap","type":"codeVoice"},{"text":" itself.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Levels","text":"Levels","type":"heading"},{"inlineContent":[{"text":"YubiKit follows the Python SDK’s distinction between operation diagnostics and traffic tracing:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Level","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Content","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"error","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"warning","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Failures and unexpected conditions.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"info","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Significant session and configuration events.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"debug","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Operation details, identifiers, and protocol decisions.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"trace","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Python’s ","type":"text"},{"code":"TRAFFIC","type":"codeVoice"},{"text":": raw transport bytes and SCP plaintext, compiled only with ","type":"text"},{"code":"DEBUG","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"Logging.configure(logLevel: .trace)","type":"codeVoice"},{"text":" to include traffic when YubiKit is compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"SwiftLog’s ","type":"text"},{"code":".trace","type":"codeVoice"},{"text":" level remains available in other builds, but neither it nor a custom backend","type":"text"},{"text":" ","type":"text"},{"text":"can enable YubiKit’s raw traffic or SCP plaintext logs in those builds. This depends on how","type":"text"},{"text":" ","type":"text"},{"text":"the SDK is compiled, not on the caller’s build configuration.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"USB, NFC, and Lightning smart-card traces contain each APDU request and response, including","type":"text"},{"text":" ","type":"text"},{"text":"response status words. FIDO traces contain HID packets, including continuation, cancellation,","type":"text"},{"text":" ","type":"text"},{"text":"keepalive, and error packets. SCP traces include the command data before encryption and the","type":"text"},{"text":" ","type":"text"},{"text":"unpadded response data after decryption. Messages use ","type":"text"},{"code":"SEND:","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RECV:","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Plaintext data:","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"Plaintext resp:","type":"codeVoice"},{"text":" followed by hexadecimal bytes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Built-in connections emit their transport traces only in ","type":"text"},{"code":"DEBUG","type":"codeVoice"},{"text":" builds. Custom ","type":"text"},{"code":"SmartCardConnection","type":"codeVoice"},{"text":" implementations","type":"text"},{"text":" ","type":"text"},{"text":"should log their own APDU exchanges; the session layer emits SCP plaintext diagnostics separately.","type":"text"},{"text":" ","type":"text"},{"text":"Custom connection logging is controlled by its implementation, not by YubiKit’s compilation condition.","type":"text"}],"type":"paragraph"},{"style":"warning","name":"Warning","content":[{"inlineContent":[{"text":"Debug output can contain identifying information such as relying-party IDs, credential","type":"text"},{"text":" ","type":"text"},{"text":"identifiers, and account names. Trace output can contain PINs, credentials, cryptographic material, and other sensitive","type":"text"},{"text":" ","type":"text"},{"text":"data carried by APDU or CTAP messages. Enable it only for controlled diagnostics and protect or","type":"text"},{"text":" ","type":"text"},{"text":"redact captured logs before sharing them.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"level":3,"anchor":"Storage-and-export","text":"Storage and export","type":"heading"},{"inlineContent":[{"text":"Your backend owns log storage, formatting and export. Use a SwiftLog file or unified-logging","type":"text"},{"text":" ","type":"text"},{"text":"backend when you need persistence. YubiKit does not retain log messages.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide"},"metadata":{"title":"Logging","modules":[{"name":"YubiKit"}],"roleHeading":"Article","role":"article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/loggingguide"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","references":{"https://github.com/apple/swift-log":{"url":"https:\/\/github.com\/apple\/swift-log","identifier":"https:\/\/github.com\/apple\/swift-log","title":"SwiftLog","titleInlineContent":[{"text":"SwiftLog","type":"text"}],"type":"link"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/GettingStarted":{"abstract":[{"text":"Prepare your project to connect to the YubiKey via NFC, SmartCard and Lightning.","type":"text"}],"kind":"article","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","url":"\/documentation\/yubikit\/gettingstarted","title":"Getting Started","role":"article"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logging":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Logging"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging","abstract":[{"text":"Configures logging for YubiKit connections and sessions.","type":"text"}],"kind":"symbol","title":"Logging","type":"topic","url":"\/documentation\/yubikit\/
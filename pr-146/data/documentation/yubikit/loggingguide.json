{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"No setup is required. YubiKit defaults to ","type":"text"},{"code":"debug","type":"codeVoice"},{"text":" on stdout when compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"},{"type":"text","text":","},{"text":" ","type":"text"},{"type":"text","text":"or "},{"code":"info","type":"codeVoice"},{"type":"text","text":" on stderr otherwise. You can override either default:"}],"type":"paragraph"},{"type":"codeListing","code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","Logging.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","Logging.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","Logging.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","Logging.configure()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"identifier":"https:\/\/github.com\/apple\/swift-log","type":"reference","isActive":true},{"text":"’s ","type":"text"},{"code":"Logging","type":"codeVoice"},{"text":" product to your app target","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to use its backend types. Any SwiftLog "},{"code":"LogHandler","type":"codeVoice"},{"type":"text","text":" can be supplied by the factory."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;"},{"type":"text","text":" "},{"type":"text","text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,"},{"type":"text","text":" "},{"type":"text","text":"though logs already in progress may use the previous settings."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit’s configuration does not affect other libraries. To share your app’
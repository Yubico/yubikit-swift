{"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"metadata":{"title":"Logging","modules":[{"name":"YubiKit"}],"roleHeading":"Article","role":"article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide"},"seeAlsoSections":[{"anchor":"Preparing-your-project","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging"],"title":"Preparing your project","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/loggingguide"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit uses "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-log"},{"type":"text","text":". By default, logs appear in"},{"type":"text","text":" "},{"type":"text","text":"Xcode’s console in both debug and release builds:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"When the SDK is compiled with "},{"type":"codeVoice","code":"DEBUG"},{"type":"text","text":", messages at "},{"type":"codeVoice","code":"debug"},{"type":"text","text":" and above go to standard output."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Otherwise, messages at "},{"type":"codeVoice","code":"info"},{"type":"text","text":" and above go to standard error."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Raw ","type":"text"},{"code":"trace","type":"codeVoice"},{"text":" traffic is available only when YubiKit is compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"},{"text":", and is disabled by default.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"No caller configuration or ","type":"text"},{"code":"#if DEBUG","type":"codeVoice"},{"text":" block is needed for these defaults. Override the minimum","type":"text"},{"text":" ","type":"text"},{"text":"level or backend with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging\/configure(logLevel:factory:)"},{"text":". The DEBUG-only restriction on","type":"text"},{"text":" ","type":"text"},{"text":"raw traffic applies regardless of configuration.","type":"text"}],"type":"paragraph"},{"text":"Levels and custom backends","level":3,"anchor":"Levels-and-custom-backends","type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging\/configure(logLevel:factory:)"},{"text":" to configure just YubiKit:","type":"text"}],"type":"paragraph"},{"code":["import YubiKit","import Logging","","Logging.configure(logLevel: .warning)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Add SwiftLog’s ","type":"text"},{"code":"Logging","type":"codeVoice"},{"text":" product to your application target when using its backend types.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The factory accepts any SwiftLog ","type":"text"},{"code":"LogHandler","type":"codeVoice"},{"text":". Its category labels start with","type":"text"},{"text":" ","type":"text"},{"code":"com.yubico.YubiKit.","type":"codeVoice"},{"text":", followed by a category such as ","type":"text"},{"code":"OATH","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PIV","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FIDO","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"SmartCard","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Use the label to route or filter categories.","type":"text"},{"text":" ","type":"text"},{"text":"Leave ","type":"text"},{"code":"logLevel","type":"codeVoice"},{"text":" nil to preserve each handler’s own level.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Messages describe the event; metadata carries details such as byte counts, slots, and error codes.","type":"text"},{"text":" ","type":"text"},{"text":"The default stream handler renders metadata as ","type":"text"},{"code":"key=value","type":"codeVoice"},{"text":" pairs. Custom handlers can use these","type":"text"},{"text":" ","type":"text"},{"text":"fields for filtering or structured output. Message wording and metadata keys are diagnostic details,","type":"text"},{"text":" ","type":"text"},{"text":"not a stable API.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Supply a backend and an explicit minimum level.","Logging.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Suppress SDK output.","Logging.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore YubiKit's defaults for this build.","Logging.configure()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Each call replaces both settings: an omitted factory uses YubiKit’s default backend, and an omitted","type":"text"},{"text":" ","type":"text"},{"text":"level preserves the selected handler’s level.","type":"text"},{"text":" ","type":"text"},{"text":"Configuration can change after sessions have been created. Subsequent SDK logging operations use","type":"text"},{"text":" ","type":"text"},{"text":"the new settings; operations already in progress may finish with the previous settings. Factories","type":"text"},{"text":" ","type":"text"},{"text":"may run concurrently and should not log through YubiKit themselves.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"YubiKit configuration leaves other libraries’ loggers unchanged. Its default backend and level","type":"text"},{"text":" ","type":"text"},{"text":"do not inherit the application’s global ","type":"text"},{"code":"LoggingSystem.bootstrap","type":"codeVoice"},{"text":" configuration. To share a backend, pass its handler","type":"text"},{"text":" ","type":"text"},{"text":"factory to YubiKit’s ","type":"text"},{"code":"configure","type":"codeVoice"},{"text":" method too. The SDK never calls ","type":"text"},{"code":"LoggingSystem.bootstrap","type":"codeVoice"},{"text":" itself.","type":"text"}],"type":"paragraph"},{"anchor":"Levels","text":"Levels","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"YubiKit follows the Python SDK’s distinction between operation diagnostics and traffic tracing:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Level"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Content"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"error"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"warning"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Failures and unexpected conditions."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"info"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Significant session and configuration events."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"debug"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Operation details, identifiers, and protocol decisions."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"trace"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Python’s "},{"type":"codeVoice","code":"TRAFFIC"},{"type":"text","text":": raw transport bytes and SCP plaintext, compiled only with "},{"code":"DEBUG","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"Logging.configure(logLevel: .trace)","type":"codeVoice"},{"text":" to include traffic when YubiKit is compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"SwiftLog’s ","type":"text"},{"code":".trace","type":"codeVoice"},{"text":" level remains available in other builds, but neither it nor a custom backend","type":"text"},{"text":" ","type":"text"},{"text":"can enable YubiKit’s raw traffic or SCP plaintext logs in those builds. This depends on how","type":"text"},{"text":" ","type":"text"},{"text":"the SDK is compiled, not on the caller’s build configuration.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"USB, NFC, and Lightning smart-card traces contain each APDU request and response, including","type":"text"},{"text":" ","type":"text"},{"text":"response status words. FIDO traces contain HID packets, including continuation, cancellation,","type":"text"},{"text":" ","type":"text"},{"text":"keepalive, and error packets. SCP traces include the command data before encryption and the","type":"text"},{"text":" ","type":"text"},{"text":"unpadded response data after decryption. Messages use ","type":"text"},{"code":"SEND:","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RECV:","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Plaintext data:","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"Plaintext resp:","type":"codeVoice"},{"text":" followed by hexadecimal bytes.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in connections emit their transport traces only in "},{"type":"codeVoice","code":"DEBUG"},{"type":"text","text":" builds. Custom "},{"type":"codeVoice","code":"SmartCardConnection"},{"type":"text","text":" implementations"},{"type":"text","text":" "},{"type":"text","text":"should log their own APDU exchanges; the session layer emits SCP plaintext diagnostics separately."},{"type":"text","text":" "},{"type":"text","text":"Custom connection logging is controlled by its implementation, not by YubiKit’s compilation condition."}]},{"name":"Warning","type":"aside","style":"warning","content":[{"type":"paragraph","inlineContent":[{"text":"Debug output can contain identifying information such as relying-party IDs, credential","type":"text"},{"text":" ","type":"text"},{"text":"identifiers, and account names. Trace output can contain PINs, credentials, cryptographic material, and other sensitive","type":"text"},{"text":" ","type":"text"},{"text":"data carried by APDU or CTAP messages. Enable it only for controlled diagnostics and protect or","type":"text"},{"text":" ","type":"text"},{"text":"redact captured logs before sharing them.","type":"text"}]}]},{"level":3,"text":"Storage and export","anchor":"Storage-and-export","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend owns log storage, formatting and export. Use a SwiftLog file or unified-logging"},{"type":"text","text":" "},{"type":"text","text":"backend when you need persistence. YubiKit does not retain log messages."}]}]}],"sections":[],"abstract":[{"type":"text","text":"Configure YubiKit diagnostics with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging"},{"type":"text","text":" and SwiftLog."}],"references":{"documentation-header.png":{"identifier":"documentation-header.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}],"type":"image","alt":"YubiKeys in a row"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logging/configure(logLevel:factory:)":{"type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging\/configure(logLevel:factory:)","url":"\/documentation\/yubikit\/logging\/configure(loglevel:factory:)","abstract":[{"type":"text","text":"Replaces the SDK’s logging configuration without affecting other libraries."}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"configure"},{"kind":"text","text":"("},{"kind":"externalParam","text":"logLevel"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Logging6LoggerV","text":"Logger"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7Logging6LoggerV5LevelO","text":"Level"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"factory"},{"kind":"text","text":": ("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Logging10LogHandlerP","text":"LogHandler"},{"kind":"text","text":")?)"}],"kind":"symbol","title":"configure(logLevel:factory:)","role":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logging":{"kind":"symbol","navigatorTitle":[{"text":"Logging","kind":"identifier"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging","title":"Logging","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Logging","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Configures logging for YubiKit connections and sessions."}],"role":"symbol","url":"\/documentation\/yubikit\/logging"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/GettingStarted":{"kind":"article","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","title":"Getting Started","type":"topic","abstract":[{"text":"Prepare your project to connect to the YubiKey via NFC, SmartCard and Lightning.","type":"text"}],"role":"article","url":"\/documentation\/yubikit\/gettingstarted"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"kind":"symbol","identifier":"d
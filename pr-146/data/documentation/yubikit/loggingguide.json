{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/loggingguide"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide"},"metadata":{"modules":[{"name":"YubiKit"}],"roleHeading":"Article","role":"article","title":"Logging"},"abstract":[{"type":"text","text":"Configure YubiKit diagnostics with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging"},{"type":"text","text":" and SwiftLog."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"YubiKit provides its own defaults using "},{"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-log","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the SDK is compiled with "},{"type":"codeVoice","code":"DEBUG"},{"type":"text","text":", messages at "},{"type":"codeVoice","code":"debug"},{"type":"text","text":" and above go to standard output,"},{"type":"text","text":" "},{"type":"text","text":"appearing in Xcode’s console like "},{"type":"codeVoice","code":"print"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Otherwise, messages at ","type":"text"},{"code":"info","type":"codeVoice"},{"text":" and above go to standard error.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Raw "},{"code":"trace","type":"codeVoice"},{"type":"text","text":" traffic is available only when YubiKit is compiled with "},{"code":"DEBUG","type":"codeVoice"},{"type":"text","text":", and is disabled by default."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"No caller configuration or "},{"type":"codeVoice","code":"#if DEBUG"},{"type":"text","text":" block is needed for this behavior."}],"type":"paragraph"},{"text":"Levels and custom backends","anchor":"Levels-and-custom-backends","level":3,"type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging\/configure(logLevel:factory:)","type":"reference"},{"text":" to configure just YubiKit:","type":"text"}],"type":"paragraph"},{"code":["import YubiKit","import Logging","","Logging.configure(logLevel: .warning)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Add SwiftLog’s "},{"type":"codeVoice","code":"Logging"},{"type":"text","text":" product to your application target when using its backend types."}],"type":"paragraph"},{"inlineContent":[{"text":"The factory accepts any SwiftLog ","type":"text"},{"type":"codeVoice","code":"LogHandler"},{"text":". Its category labels start with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"com.yubico.YubiKit."},{"text":", followed by a category such as ","type":"text"},{"type":"codeVoice","code":"OATH"},{"text":", ","type":"text"},{"type":"codeVoice","code":"PIV"},{"text":", ","type":"text"},{"type":"codeVoice","code":"FIDO"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"SmartCard"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Use the label to route or filter categories.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Leave "},{"type":"codeVoice","code":"logLevel"},{"type":"text","text":" nil to preserve each handler’s own level."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Supply a backend and an explicit minimum level.","Logging.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Suppress SDK output.","Logging.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore YubiKit's defaults for this build.","Logging.configure()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each call replaces both settings: an omitted factory uses YubiKit’s default backend, and an omitted"},{"type":"text","text":" "},{"type":"text","text":"level preserves the selected handler’s level."},{"type":"text","text":" "},{"type":"text","text":"Configuration can change after sessions have been created. Subsequent SDK logging operations use"},{"type":"text","text":" "},{"type":"text","text":"the new settings; operations already in progress may finish with the previous settings. Factories"},{"type":"text","text":" "},{"type":"text","text":"may run concurrently and should not log through YubiKit themselves."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit configuration leaves other libraries’ loggers unchanged. Its default backend and level"},{"type":"text","text":" "},{"type":"text","text":"do not inherit the application’s global "},{"code":"LoggingSystem.bootstrap","type":"codeVoice"},{"type":"text","text":" configuration. To share a backend, pass its handler"},{"type":"text","text":" "},{"type":"text","text":"factory to YubiKit’s "},{"code":"configure","type":"codeVoice"},{"type":"text","text":" method too. The SDK never calls "},{"code":"LoggingSystem.bootstrap","type":"codeVoice"},{"type":"text","text":" itself."}]},{"type":"heading","text":"Levels","anchor":"Levels","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit follows the Python SDK’s distinction between operation diagnostics and traffic tracing:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Level","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Content","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"error"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"warning"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Failures and unexpected conditions."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"info"}]}],[{"type":"paragraph","inlineContent":[{"text":"Significant session and configuration events.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"debug","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Operation details, identifiers, and protocol decisions."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"trace","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Python’s ","type":"text"},{"code":"TRAFFIC","type":"codeVoice"},{"text":": raw transport bytes and SCP plaintext, compiled only with ","type":"text"},{"code":"DEBUG","type":"codeVoice"},{"text":".","type":"text"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"Logging.configure(logLevel: .trace)","type":"codeVoice"},{"text":" to include traffic when YubiKit is compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"SwiftLog’s ","type":"text"},{"code":".trace","type":"codeVoice"},{"text":" level remains available in other builds, but neither it nor a custom backend","type":"text"},{"text":" ","type":"text"},{"text":"can enable YubiKit’s raw traffic or SCP plaintext logs in those builds. This depends on how","type":"text"},{"text":" ","type":"text"},{"text":"the SDK is compiled, not on the caller’s build configuration.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"USB, NFC, and Lightning smart-card traces contain each APDU request and response, including","type":"text"},{"text":" ","type":"text"},{"text":"response status words. FIDO traces contain HID packets, including continuation, cancellation,","type":"text"},{"text":" ","type":"text"},{"text":"keepalive, and error packets. SCP traces include the command data before encryption and the","type":"text"},{"text":" ","type":"text"},{"text":"unpadded response data after decryption. Messages use ","type":"text"},{"type":"codeVoice","code":"SEND:"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RECV:"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Plaintext data:"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Plaintext resp:"},{"text":" followed by hexadecimal bytes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in connections emit their transport traces only in "},{"code":"DEBUG","type":"codeVoice"},{"type":"text","text":" builds. Custom "},{"code":"SmartCardConnection","type":"codeVoice"},{"type":"text","text":" implementations"},{"type":"text","text":" "},{"type":"text","text":"should log their own APDU exchanges; the session layer emits SCP plaintext diagnostics separately."},{"type":"text","text":" "},{"type":"text","text":"Custom connection logging is controlled by its implementation, not by YubiKit’s compilation condition."}]},{"content":[{"inlineContent":[{"type":"text","text":"Debug output can contain identifying information such as relying-party IDs, credential"},{"type":"text","text":" "},{"type":"text","text":"identifiers, and account names. Trace output can contain PINs, credentials, cryptographic material, and other sensitive"},{"type":"text","text":" "},{"type":"text","text":"data carried by APDU or CTAP messages. Enable it only for controlled diagnostics and protect or"},{"type":"text","text":" "},{"type":"text","text":"redact captured logs before sharing them."}],"type":"paragraph"}],"type":"aside","style":"warning","name":"Warning"},{"type":"heading","level":3,"text":"Storage and export","anchor":"Storage-and-export"},{"inlineContent":[{"text":"Your backend owns log storage, formatting and export. Use a SwiftLog file or unified-logging","type":"text"},{"text":" ","type":"text"},{"text":"backend when you need persistence. YubiKit does not retain log messages.","type":"text"}],"type":"paragraph"}]}],"seeAlsoSections":[{"generated":true,"anchor":"Preparing-your-project","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging"],"title":"Preparing your project"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"kind":"article","references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logging":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Configures logging for YubiKit connections and sessions."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Logging"}],"title":"Logging","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging","role":"symbol","url":"\/documentation\/yubikit\/logging","navigatorTitle":[{"kind":"identifier","text":"Logging"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logging/configure(logLevel:factory:)":{"type":"topic","role":"symbol","url":"\/documentation\/yubikit\/logging\/configure(loglevel:factory:)","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"configure"},{"kind":"text","text":"("},{"kind":"externalParam","text":"logLevel"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Logging6LoggerV","text":"Logger"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7Logging6LoggerV5LevelO","text":"Level"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"factory"},{"kind":"text","text":": ("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7Logging10LogHandlerP","kind":"typeIdentifier","text":"LogHandler"},{"kind":"text","text":")?)"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging\/configure(logLevel:factory:)","abstract":[{"type":"text","text":"Replaces the SDK’s logging configuration without affecting other libraries."}],"title":"configure(logLevel:factory:)"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"images":[{"type":"icon","identifier":"documentation-header.png"}],"title":"YubiKit","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","role":"collection","url":"\/documentation\/yubikit"},"documentation-header.png":{"variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png"}],"type":"image","identifier":"documentation-header.png","alt":"YubiKeys in a row"},"https://github.com/apple/swift-log":{"title":"SwiftLog","type":"link","titleInlineContent":[{"text":"SwiftLog","type":"text"}],"identifier":"https:\/\/github.com\/apple\/swift-log","url":"https:\/\/github.com\/apple\/swift-log"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/GettingStarted":{"type":"topic","role":"article","url":"\/documentation\/yubikit\/gettingstarted","kind":"article","abstract":[{"text":"Prepare your project to connect to the YubiKey via NFC, SmartCard and Lightning.","type":"text"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","title":"Getting Started"}}}
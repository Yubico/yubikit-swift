{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HmacSecret"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"This extension allows a relying party to derive symmetric keys from a credential","type":"text"},{"text":" ","type":"text"},{"text":"using HMAC-SHA-256 with user-provided salts. The derived keys can be used for","type":"text"},{"text":" ","type":"text"},{"text":"encryption or other cryptographic operations.","type":"text"}]},{"text":"MakeCredential Usage","type":"heading","level":2,"anchor":"MakeCredential-Usage"},{"type":"paragraph","inlineContent":[{"text":"Request hmac-secret support when creating a credential:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let hmacSecret = CTAP2.Extension.HmacSecret()","let ext = hmacSecret.makeCredential.input()","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    \/\/ hmac-secret is enabled","}"]},{"type":"paragraph","inlineContent":[{"text":"Or derive secrets at registration time (CTAP 2.2 hmac-secret-mc):","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let hmacSecret = try await CTAP2.Extension.HmacSecret(session: session)","let ext = try hmacSecret.makeCredential.input(salt1: salt, salt2: salt2)","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    switch result {","    case .enabled:","        \/\/ hmac-secret-mc not supported, but hmac-secret is enabled","    case .secrets(let secrets):","        \/\/ Use derived keys (secrets.first, secrets.second)","    }","}"]},{"text":"GetAssertion Usage","type":"heading","level":2,"anchor":"GetAssertion-Usage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Derive keys during authentication:"}]},{"syntax":"swift","type":"codeListing","code":["let hmacSecret = try await CTAP2.Extension.HmacSecret(session: session)","let ext = try hmacSecret.getAssertion.input(salt1: salt)","let params = CTAP2.GetAssertion.Parameters(..., extensions: [ext])","let response = try await session.getAssertion(params)","if let secrets = try hmacSecret.getAssertion.output(from: response) {","    \/\/ Use derived keys (secrets.first, secrets.second)","}"]},{"style":"note","type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"reference","identifier":"https:\/\/fidoalliance.org\/specs\/fido-v2.2-ps-20250714\/fido-client-to-authenticator-protocol-v2.2-ps-20250714.html#sctn-hmac-secret-extension","isActive":true}]}]},{"name":"See Also","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"https:\/\/fidoalliance.org\/specs\/fido-v2.2-ps-20250714\/fido-client-to-authenticator-protocol-v2.2-ps-20250714.html#sctn-hmac-secret-make-cred-extension","isActive":true,"type":"reference"}],"type":"paragraph"}],"style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Extension"]]},"sections":[],"metadata":{"extendedModule":"YubiKit","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"HmacSecret"}],"roleHeading":"Structure","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HmacSecret"}],"title":"CTAP2.Extension.HmacSecret","externalID":"s:7YubiKit5CTAP2O9ExtensionO10HmacSecretV","modules":[{"name":"YubiKit"}]},
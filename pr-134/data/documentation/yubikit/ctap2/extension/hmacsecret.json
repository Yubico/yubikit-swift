{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HmacSecret","kind":"identifier"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This extension allows a relying party to derive symmetric keys from a credential"},{"type":"text","text":" "},{"type":"text","text":"using HMAC-SHA-256 with user-provided salts. The derived keys can be used for"},{"type":"text","text":" "},{"type":"text","text":"encryption or other cryptographic operations."}]},{"level":2,"type":"heading","text":"MakeCredential Usage","anchor":"MakeCredential-Usage"},{"type":"paragraph","inlineContent":[{"text":"Request hmac-secret support when creating a credential:","type":"text"}]},{"code":["let hmacSecret = CTAP2.Extension.HmacSecret()","let ext = hmacSecret.makeCredential.input()","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    \/\/ hmac-secret is enabled","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or derive secrets at registration time (CTAP 2.2 hmac-secret-mc):"}]},{"code":["let hmacSecret = try await CTAP2.Extension.HmacSecret(session: session)","let ext = try hmacSecret.makeCredential.input(salt1: salt, salt2: salt2)","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    switch result {","    case .enabled:","        \/\/ hmac-secret-mc not supported, but hmac-secret is enabled","    case .secrets(let secrets):"
}],"type":"paragraph"},{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"BioEnrollment manages fingerprint enrollments on biometric authenticators. It requires a"},{"type":"text","text":" "},{"type":"text","text":"PIN\/UV auth token with the "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/ClientPin\/Permission\/bioEnrollment","isActive":true},{"type":"text","text":" permission."}],"type":"paragraph"},{"code":["let token = try await session.getPinUVToken(","    using: .pin(\"123456\"),","    permissions: [.bioEnrollment]",")","let bio = try await session.bioEnrollment(token: token)","","\/\/ Check sensor capabilities","let sensorInfo = try await bio.getFingerprintSensorInfo()","","\/\/ Enroll a new fingerprint","for try await sample in bio.enroll(timeout: 10000) {","    switch sample {","    case .waitingForUser:","        print(\"Touch the sensor...\")","    case .sample(let status, let remaining):","        print(\"Captured: \\(status), \\(remaining) remaining\")","    case .completed(let templateId, _):","        print(\"Enrollment complete!\")","    }","}","","\/\/ List existing enrollments","for try await enrollment in bio.enrollments {","    print(\"\\(enrollment.templateId): \\(enrollment.friendlyName ?? \"unnamed\")\")","}"],"type":"codeListing","syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/yubikit\/ctap2\/bioenrollment"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Bio enrollment operations bound to a PIN\/UV auth token."}],"topicSections":[{"anchor":"Feature-Detection","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/BioEnrollment\/isSupported(by:)"],"title":"Feature Detection"},{"anchor":"Sensor-Information","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/BioEnrollment\/getFingerprintSensorInfo()"],"title":"Sensor Information"},{"anchor":"Enrol
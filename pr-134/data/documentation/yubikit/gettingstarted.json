tive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession"},{"text":" to retrieve authentication codes, and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},{"text":" to get device information.","type":"text"}],"role":"sampleCode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","kind":"article","title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","url":"\/documentation\/yubikit\/oathsamplecode"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","title":"OATHSession","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OATHSession","kind":"identifier"}],"abstract":[{"text":"An interface to the OATH application on the YubiKey.","type":"text"}],"url":"\/documentation\/yubikit\/oathsession","role":"symbol","kind":"symbol","type":"topic","navigatorTitle":[{"text":"OATHSession","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}],"abstract":[{"type":"text","text":"An interface to the PIV application on the YubiKey."}],"navigatorTitle":[{"text":"PIVSession","kind":"identifier"}],"title":"PIVSession","url":"\/documentation\/yubikit\/pivsession"},"add-framework-1.png":{"variants":[{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1~dark@2x.png","traits":["2x","dark"]}],"type":"image","identifier":"add-framework-1.png","alt":"An image showing how to add the YubiKit SDK to your Xcode project."},"smart-card.png":{"variants":[{"url":"\/images\/yubikit-swift.YubiKit\/smart-card@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/smart-card~dark@2x.png","traits":["2x","dark"]}],"type":"image","identifier":"smart-card.png","alt":"An image showing how to add NFC privacy string to project."},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"type":"topic","abstract":[{"text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession"},{"text":" for cryptographic operations, certificate management, and access control.","type":"text"}],"role":"sampleCode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","kind":"article","title":"PIVTool: Building PIV applications with YubiKey","url":"\/documentation\/yubikit\/pivtoolsamplecode"}}}
pleCode":{"kind":"article","type":"topic","url":"\/documentation\/yubikit\/pivtoolsamplecode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","role":"sampleCode","title":"PIVTool: Building PIV applications with YubiKey","abstract":[{"type":"text","text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession"},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}]},"add-framework-1.png":{"type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1~dark@2x.png"}],"identifier":"add-framework-1.png","alt":"An image showing how to add the YubiKit SDK to your Xcode project."},"doc://yubikit-swift.YubiKit/documentation/YubiKit/SmartCardConnection":{"abstract":[{"text":"An interface defining a SmartCard based connection to a YubiKey.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"SmartCardConnection","kind":"identifier"}],"role":"symbol","type":"topic","title":"SmartCardConnection","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SmartCardConnection","kind":"identifier"}],"url":"\/documentation\/yubikit\/smartcardconnection","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"navigatorTitle":[{"text":"Client","kind":"identifier"}],"title":"WebAuthn.Client","type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/yubikit\/webauthn\/client","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}]},"add-framework-2.png":{"identifier":"add-framework-2.png","type":"image","alt":"An image showing how to add the YubiKit SDK to your Xcode project.","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-2@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-2~dark@2x.png","traits":["2x","dark"]}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/CTAP2/Session":{"type":"topic","url":"\/documentation\/yubikit\/ctap2\/session","kind":"symbol","role":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Session","kind":"identifier"}],"navigatorTitle":[{"text":"Session","kind":"identifier"}],"title":"CTAP2.Session","abstract":[{"text":"Interface to the FIDO2\/CTAP authenticator on the YubiKey.","type":"text"}]}}}
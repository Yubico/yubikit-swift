{"variants":[{"paths":["\/documentation\/yubikit\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted"},"metadata":{"modules":[{"name":"YubiKit"}],"title":"Getting Started","roleHeading":"Article","role":"article"},"kind":"article","sections":[],"abstract":[{"type":"text","text":"Prepare your project to connect to the YubiKey via NFC, SmartCard and Lightning."}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The YubiKit framework is distributed using the Swift Package Manager. To add the framework to your project follow these steps:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Package Dependencies” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Press the plus-button to bring up the add package dialog.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"add-framework-1.png"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Enter ","type":"text"},{"code":"https:\/\/github.com\/Yubico\/yubikit-swift\/","type":"codeVoice"},{"text":" in the search field and select the Yubico Swift Package.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Press the “Add Package” button to add the SDK to your project.","type":"text"}],"type":"paragraph"}]}],"start":4},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"add-framework-2.png"}]},{"type":"heading","level":3,"text":"NFC","anchor":"NFC"},{"type":"paragraph","inlineContent":[{"text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC","type":"text"},{"text":" ","type":"text"},{"text":"application identifiers and a NFC Privacy statement to the application.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Add Wireless entitlement","type":"text"}]}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Signing & Capabilities” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Click the “+”-button to add a new capability.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the “Near Field Communication Tag” capability.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-entitlement.png"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Add list of NFC application identifiers","type":"text"}]}]},{"type":"orderedList","start":6,"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-identifiers.png"}]},{"start":8,"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the Yubico NFC application identifiers to enable communication with the different","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"applications on the YubiKey."}]}]}]},{"type":"codeListing","code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-identifiers-list.png"}]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Add a NFC Privacy description","type":"text"}]}],"type":"paragraph"},{"start":9,"items":[{"content":[{"inlineContent":[{"text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in","type":"text"},{"text":" ","type":"text"},{"text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"image","identifier":"nfc-privacy.png"}],"type":"paragraph"},{"text":"SmartCard\/USB","level":3,"type":"heading","anchor":"SmartCardUSB"},{"inlineContent":[{"type":"text","text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" entitlement to your application."}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the application entitlements file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" entitlement to the entitlement list.","type":"text"}]}]}]},{"inlineContent":[{"type":"image","identifier":"smart-card.png"}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SmartCard\/USB connection only support the CCID based applications on the YubiKey and does not support U2F, FIDO2 or OTP."}]}]},{"text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey","level":3,"type":"heading","anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey"},{"inlineContent":[{"text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the ","type":"text"},{"type":"codeVoice","code":"com.yubico.ylp"},{"text":" string to the list of External Accessories.","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not present add the ","type":"text"},{"code":"Supported external accessory protocols","type":"codeVoice"},{"text":" key and insert the string ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" in its list.","type":"text"}]}]}]},{"inlineContent":[{"type":"image","identifier":"external-accessory.png"}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for ","type":"text"},{"code":"Supported external accessory protocols","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework.","type":"text"}]}]},{"text":"Making Your First Connection","level":2,"type":"heading","anchor":"Making-Your-First-Connection"},{"inlineContent":[{"text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device.","type":"text"}],"type":"paragraph"},{"text":"Understanding Connection Types","level":3,"type":"heading","anchor":"Understanding-Connection-Types"},{"inlineContent":[{"text":"YubiKit handles three different connection methods:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"NFC","type":"text"}]},{"text":": Short-range wireless communication (iOS only)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"USB","type":"text"}]},{"text":": Direct USB connection via SmartCard interface","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Lightning","type":"text"}]},{"text":": YubiKey 5Ci connected to Lightning port (iOS only)","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Each connection type works differently, so let’s explore how to use them."}],"type":"paragraph"},{"text":"NFC Connections","level":3,"type":"heading","anchor":"NFC-Connections"},{"inlineContent":[{"type":"text","text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:"}],"type":"paragraph"},{"type":"codeListing","code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete."}],"type":"paragraph"},{"text":"USB and Lightning Connections","level":3,"type":"heading","anchor":"USB-and-Lightning-Connections"},{"inlineContent":[{"type":"text","text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:"}],"type":"paragraph"},{"type":"codeListing","code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"WiredSmartCardConnection.makeConnection()"},{"type":"text","text":" method automatically detects whether you’re using USB or Lightning."}],"type":"paragraph"},{"text":"Specific Connection Types","level":3,"type":"heading","anchor":"Specific-Connection-Types"},{"inlineContent":[{"type":"text","text":"For more control, you can connect to specific interfaces:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"],"syntax":"swift"},{"text":"Understanding Connection Lifecycle","level":2,"type":"heading","anchor":"Understanding-Connection-Lifecycle"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Critical:","type":"text"}]},{"type":"text","text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time."}],"type":"paragraph"},{"text":"Connection Behavior","level":3,"type":"heading","anchor":"Connection-Behavior"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Exclusive access","type":"text"}]},{"text":": Only one connection can exist per YubiKey at any time","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Manual closure required","type":"text"}]},{"text":": Dropping a connection reference does NOT automatically close it - you must call ","type":"text"},{"type":"codeVoice","code":"close()"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Resource blocking","type":"text"}]},{"text":": An unclosed connection prevents new connections (throws ","type":"text"},{"type":"codeVoice","code":"SmartCardConnectionError.busy"},{"text":")","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call "},{"type":"codeVoice","code":"close()"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Working with Sessions","level":2,"type":"heading","anchor":"Working-with-Sessions"},{"inlineContent":[{"type":"text","text":"Once you have a connection, create sessions to access different YubiKey applications:"}],"type":"paragraph"},{"text":"OATH Session (TOTP\/HOTP codes)","level":3,"type":"heading","anchor":"OATH-Session-TOTPHOTP-codes"},{"type":"codeListing","code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"],"syntax":"swift"},{"text":"PIV Session (Certificates and keys)","level":3,"type":"heading","anchor":"PIV-Session-Certificates-and-keys"},{"type":"codeListing","code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"],"syntax":"swift"},{"text":"Management Session (Device information)","level":3,"type":"heading","anchor":"Management-Session-Device-information"},{"type":"codeListing","code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"],"syntax":"swift"},{"text":"WebAuthn Client (FIDO2 \/ passkeys)","level":3,"type":"heading","anchor":"WebAuthn-Client-FIDO2--passkeys"},{"inlineContent":[{"type":"text","text":"For passkey registration and authentication, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"type":"text","text":" wraps a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" (USB HID on macOS) or any "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection"},{"type":"text","text":" "},{"type":"text","text":"(NFC \/ USB CCID)."}],"type":"paragraph"},{"type":"codeListing","code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"PIN and UV are supplied per ceremony via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization"},{"type":"text","text":". For raw"},{"type":"text","text":" "},{"type":"text","text":"CTAP2 access (credential management, bio enrollment, large blobs), use"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":" directly."}],"type":"paragraph"},{"text":"Connection Management Patterns","level":2,"type":"heading","anchor":"Connection-Management-Patterns"},{"text":"For UI Applications","level":3,"type":"heading","anchor":"For-UI-Applications"},{"inlineContent":[{"type":"text","text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode"},{"type":"text","text":" for complete examples of reactive connection management patterns that automatically update your UI when YubiKeys are plugged in or removed."}],"type":"paragraph"},{"text":"For Command-Line Tools","level":3,"type":"heading","anchor":"For-Command-Line-Tools"},{"inlineContent":[{"type":"text","text":"CLI applications often use a simpler approach with a single connection per operation. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"},{"type":"text","text":" for examples of how command-line tools handle connections for one-time operations."}],"type":"paragraph"},{"text":"Next Steps","level":2,"type":"heading","anchor":"Next-Steps"},{"inlineContent":[{"type":"text","text":"Now you’re ready to build YubiKey applications! Check out the sample projects to see complete implementations:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"OATHSample","type":"text"}]},{"text":": Shows how to build a TOTP authenticator app with SwiftUI","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"PIVTool","type":"text"}]},{"text":": Demonstrates PIV operations for certificates and digital signatures","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"WebAuthnInterceptorSample","type":"text"}]},{"text":": Routes WebAuthn calls from a ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":" through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":" to a YubiKey","type":"text"}]}]}]},{"text":"Build SDK documentation","level":3,"type":"heading","anchor":"Build-SDK-documentation"},{"inlineContent":[{"type":"text","text":"You can also build the complete SDK documentation by selecting “Product” -> “Build Documentation” in Xcode. This gives you access to the full YubiKit API reference."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Select an iOS target when building documentation to include all connection types.","type":"text"}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"schemaVersion":{"major":0,"patch
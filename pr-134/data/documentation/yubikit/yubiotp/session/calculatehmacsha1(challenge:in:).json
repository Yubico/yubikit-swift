{"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session\/calculateHMACSHA1(challenge:in:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session"]]},"sections":[],"abstract":[{"text":"Performs an HMAC-SHA1 challenge-response against a slot.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"calculateHMACSHA1","kind":"identifier"},{"text":"(","kind":"text"},{"text":"challenge","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"in"},{"text":" ","kind":"text"},{"text":"slot","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"YubiOTP","kind":"typeIdentifier","preciseIdentifier":"s:7YubiKit0A3OTPO","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP"},{"text":".","kind":"text"},{"text":"Slot","kind":"typeIdentifier","preciseIdentifier":"s:7YubiKit0A3OTPO4SlotO","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Slot"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"YubiOTP","kind":"typeIdentifier","preciseIdentifier":"s:7YubiKit0A3OTPO","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP"},{"text":".","kind":"text"},{"text":"StatusStream","kind":"typeIdentifier","preciseIdentifier":"s:7YubiKit0A3OTPO12StatusStreamV","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/StatusStream"},{"text":"<","kind":"text"},{"text":"Data","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV"},{"text":">","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The challenge. Padded to 64 bytes before transmission.","type":"text"}]}],"name":"challenge"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The slot to challenge."}]}],"name":"slot"}],"kind":"parameters"},{"content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"inlineContent":[{"text":"A stream yielding progress and finally the 20-byte HMAC-SHA1 response.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"If the slot was programmed with ","type":"text"},{"code":"requireTouch","type":"codeVoice"},{"text":", the YubiKey waits for a button press before","type":"text"},{"text":" ","type":"text"},{"text":"answering. The returned stream reports that wait as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Status\/waitingForUser(cancel:)"},{"type":"text","text":" so a caller can prompt and offer to give up; when"},{"type":"text","text":" "},{"type":"text","text":"no such feedback is needed, read "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/StatusStream\/value"},{"type":"text","text":"."}]},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A touch-triggered slot only works over the OTP keyboard transport, which polls"},{"type":"text","text":" "},{"type":"text","text":"the key — the pending touch shows up on every report, and the host can abort between polls."},{"type":"text","text":" "},{"type":"text","text":"Over SmartCard the YubiOTP application refuses the command outright with "},{"type":"codeVoice","code":"0x6985"},{"type":"text","text":" rather than"},{"type":"text","text":" "},{"type":"text","text":"waiting, so the stream yields "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Status\/finished(_:)","isActive":true},{"type":"text","text":" alone and cancellation does"},{"type":"text","text":" "},{"type":"text","text":"nothing. Python and Java accept the same parameters on their SmartCard backends and likewise"},{"type":"text","text":" "},{"type":"text","text":"ignore them."}]},{"inlineContent":[{"type":"text","text":"This is a limitation of the application, not of SmartCard: an application that defines a"},{"type":"text","text":" "},{"type":"text","text":"continuation on top of APDUs can report progress and be cancelled over the same transport."},{"type":"text","text":" "},{"type":"text","text":"CTAP2 does exactly that — it answers "},{"type":"codeVoice","code":"0x9100"},{"type":"text","text":" and the host polls with "},{"type":"codeVoice","code":"NFCCTAP_GETRESPONSE"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which is how "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Status\/waitingForUser(cancel:)","isActive":true},{"type":"text","text":" works over NFC. YubiOTP defines no such"},{"type":"text","text":" "},{"type":"text","text":"exchange."}],"type":"paragraph"}],"type":"aside","name":"Important"},{"content":[{"inlineContent":[{"text":"Requires ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Feature\/challengeResponse","isActive":true,"type":"reference"},{"text":", available on YubiKey 2.2 or later.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/yubiotp\/session\/calculatehmacsha1(challenge:in:)"]}],"metadata":{"roleHeading":"Instance Method","externalID":"s:7YubiKit0A
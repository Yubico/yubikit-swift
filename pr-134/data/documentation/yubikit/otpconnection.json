text"}]}],"style":"note"},{"type":"paragraph","inlineContent":[{"text":"Protocol for connections to the Yubico OTP keyboard interface on a YubiKey.","type":"text"}]},{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"OTPConnection defines the interface for low-level Yubico OTP communication with a YubiKey. All","type":"text"},{"text":" ","type":"text"},{"text":"traffic moves in fixed 8-byte HID feature reports; the 70-byte command frame, its CRC, and","type":"text"},{"text":" ","type":"text"},{"text":"programming-sequence tracking are handled above this layer.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the keyboard HID interface (usage page "},{"code":"0x01","type":"codeVoice"},{"type":"text","text":", usage "},{"code":"0x06","type":"codeVoice"},{"type":"text","text":"), not the FIDO HID interface"},{"type":"text","text":" "},{"type":"text","text":"used by "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/FIDOConnection","type":"reference","isActive":true},{"type":"text","text":". A YubiKey only exposes it when the Yubico OTP application is enabled"},{"type":"text","text":" "},{"type":"text","text":"over USB."}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"HIDOTPConnection","type":"codeVoice"},{"text":" on macOS. Everywhere else — and over NFC — reach the same application","type":"text"},{"text":" ","type":"text"},{"text":"with a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ macOS: the OTP keyboard interface","let connection = try await HIDOTPConnection()","let session = try await YubiOTP.Session.makeSession(connection: connection)","","\/\/ iOS: the same application over NFC","let nfcConnection = try await NFCSmartCardConnection()"
d above this layer."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the keyboard HID interface (usage page "},{"type":"codeVoice","code":"0x01"},{"type":"text","text":", usage "},{"type":"codeVoice","code":"0x06"},{"type":"text","text":"), not the FIDO HID interface"},{"type":"text","text":" "},{"type":"text","text":"used by "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/FIDOConnection"},{"type":"text","text":". A YubiKey only exposes it when the Yubico OTP application is enabled"},{"type":"text","text":" "},{"type":"text","text":"over USB."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"HIDOTPConnection"},{"type":"text","text":" on macOS. Everywhere else — and over NFC — reach the same application"},{"type":"text","text":" "},{"type":"text","text":"with a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection"},{"type":"text","text":"."}]},{"type":"codeListing","code":["\/\/ macOS: the OTP keyboard interface","let connection = try await HIDOTPConnection()","let session = try await YubiOTP.Session.makeSession(connection: connection)","","\/\/ iOS: the same application over NFC","let nfcConnection = try await NFCSmartCardConnection()","let nfcSession = try await YubiOTP.Session.makeSession(connection: nfcConnection)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both transports support slot programming. USB SmartCard does not support HMAC-SHA1"},{"type":"text","text":" "},{"type":"text","text":"challenge-response; use OTP keyboard HID for that operation over USB. NFC supports"},{"type":"text","text":" "},{"type":"text","text":"challenge-response without touch, but does not provide touch progress or cancellation."}]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"relationshipsSections":[{"identi
{"abstract":[{"text":"A low-level transport connection to the Yubico OTP application on a YubiKey.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"OTPConnection"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:7YubiKit10ConnectionP","text":"Connection","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Connection"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use an OTP connection to exchange 8-byte HID feature reports with the YubiKey’s keyboard"},{"type":"text","text":" "},{"type":"text","text":"interface. Higher-level framing — the 70-byte command frame, CRC, and programming-sequence"},{"type":"text","text":" "},{"type":"text","text":"tracking — is handled above this layer; a connection only moves whole reports."}]},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"This is the keyboard HID interface (usage page ","type":"text"},{"code":"0x01","type":"codeVoice"},{"text":", usage ","type":"text"},{"code":"0x06","type":"codeVoice"},{"text":"), not the FIDO HID","type":"text"},{"text":" ","type":"text"},{"text":"interface used by ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/FIDOConnection","isActive":true},{"text":". A YubiKey only exposes it when the Yubico OTP application","type":"text"},{"text":" ","type":"text"},{"text":"is enabled over USB.","type":"text"}]}],"type":"aside"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Protocol for connections to the Yubico OTP keyboard interface on a YubiKey."}]},{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type"
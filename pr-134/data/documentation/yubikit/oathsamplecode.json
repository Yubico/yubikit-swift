{"sampleCodeDownload":{"kind":"sampleDownload","action":{"overridingTitle":"View Source","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","type":"reference","isActive":true}},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"abstract":[{"type":"text","text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"reference"},{"text":" to retrieve authentication codes, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"reference"},{"type":"text","text":" to get device information."}],"kind":"article","seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"],"anchor":"Sample-code","title":"Sample code"}],"metadata":{"color":{"standardColorIdentifier":"green"},"title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","role":"sampleCode","roleHeading":"Sample Code","modules":[{"name":"YubiKit"}]},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample creates an authenticator app that:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Establishes connections to YubiKeys via USB, Lightning, or NFC"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Manages connection lifecycle (detecting plugged\/unplugged devices)"}]}]},{"content":[{"inlineContent":[{"text":"Lists TOTP codes stored on the YubiKey","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Shows device information like firmware version","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Handles connection errors and user cancellations gracefully"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This sample focuses on read-only operations and doesn’t handle password-protected YubiKeys or credential management.","type":"text"}],"type":"paragraph"},{"text":"Connection Management","anchor":"Connection-Management","type":"heading","level":2},{"text":"Handling Wired Connections","anchor":"Handling-Wired-Connections","type":"heading","level":3},{"inlineContent":[{"text":"The app uses a ","type":"text"},{"type":"codeVoice","code":"ConnectionManager"},{"text":" to handle persistent connections to plugged-in YubiKeys. This approach ensures your app stays responsive when users plug and unplug their YubiKeys:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["private func startWiredConnection() {","    wiredConnectionTask = Task { @MainActor in","        while !Task.isCancelled {","            do {","                let newConnection = try await WiredSmartCardConnection.makeConnection()","                wiredConnection = newConnection","","                \/\/ Wait for disconnect","                let closeError = await newConnection.waitUntilClosed()","                wiredConnection = nil","            } catch {","                self.error = error","            }","        }","    }","}"]},{"inlineContent":[{"text":"The key insight here is using ","type":"text"},{"type":"codeVoice","code":"waitUntilClosed()"},{"type":"text","text":" to detect when the YubiKey is unplugged, then automatically waiting for the next connection."}],"type":"paragraph"},{"text":"NFC Connections","anchor":"NFC-Connections","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"NFC connections work differently - they’re initiated by user action and are short-lived:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func requestNFCConnection() async {","    do {","        nfcConnection = try await NFCSmartCardConnection()","    } catch {","        self.error = error","    }","}"]},{"inlineContent":[{"type":"text","text":"When an NFC connection is established, the app fetches data and immediately closes it with a user message:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Task {","    await model.update(using: connection)","    await connection.close(message: \"Codes calculated\")","}"]},{"text":"Working with YubiKey Data","anchor":"Working-with-YubiKey-Data","type":"heading","level":2},{"text":"Reading OATH Codes","anchor":"Reading-OATH-Codes","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Once you have a connection, getting TOTP codes is straightforward:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["private func calculateCodes(using connection: SmartCardConnection) async {","    do {","        let session = try await OATHSession.makeSession(connection: connection)","        let result = try await session.calculateCredentialCodes()","        accounts = result.map { credential, code in","            Account(","                label: credential.label,","                code: code?.code,","                issuer: credential.issuer,","                type: credential.type","            )","        }","    } catch {","        self.error = error","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"calculateCredentialCodes()"},{"type":"text","text":" method returns a dictionary mapping credentials to their current codes. Some codes might be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if they require touch or are password-protected."}]},{"text":"Getting Device Information","level":3,"type":"heading","anchor":"Getting-Device-Information"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"Management.Session"},{"text":" to get YubiKey information:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["private func getKeyVersion(using connection: SmartCardConnection) async {","    do {","        let session: Management.Session = try await .makeSession(connection: connection)","        self.keyVersion = await session.version.description","    } catch {","        self.error = error","    }","}"]},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Model"},{"type":"text","text":" class combines both operations in a single "},{"type":"codeVoice","code":"update"},{"type":"text","text":" method:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func update(using connection: SmartCardConnection) async {","    await calculateCodes(using: connection)","    await getKeyVersion(using: connection)","    connectionType = connection.connectionType","}"]},{"level":2,"anchor":"SwiftUI-Integration","type":"heading","text":"SwiftUI Integration"},{"text":"Reacting to Connection Changes","level":3,"type":"heading","anchor":"Reacting-to-Connection-Changes"},{"inlineContent":[{"text":"The app uses SwiftUI’s ","type":"text"},{"type":"codeVoice","code":"@Published"},{"text":" properties and ","type":"text"},{"type":"codeVoice","code":"onReceive"},{"type":"text","text":" to update the UI when connections change:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".onReceive(connectionManager.$wiredConnection) { newConnection in","    guard let connection = newConnection else {","        model.clear()  \/\/ Clear UI when YubiKey unplugged","        return","    }","    Task { await model.update(using: connection) }","}"]},{"inlineContent":[{"text":"This pattern ensures the UI immediately updates when YubiKeys are plugged in or removed.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Platform-Specific Features","level":3,"anchor":"Platform-Specific-Features"},{"inlineContent":[{"type":"text","text":"The app handles iOS vs macOS differences with conditional compilation:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["#if os(iOS)",".refreshable {","    await connectionManager.requestNFCConnection()","}","#endif"]},{"inlineContent":[{"type":"text","text":"iOS users can pull-to-refresh to scan with NFC, while macOS users only see USB options."}],"type":"paragraph"},{"text":"Connection Type Detection","level":3,"type":"heading","anchor":"Connection-Type-Detection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample includes a useful extension to identify connection types:"}]},{"syntax":"swift","type":"codeListing","code":["extension SmartCardConnection {","    var connectionType: String {","        switch self {","        case _ as NFCSmartCardConnection: return \"NFC\"","        case _ as LightningSmartCardConnection: return \"Lightning\"","        case _ as USBSmartCardConnection: return \"USB\"","        default: return \"Unknown\"","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"This is helpful because NFC connections are slower than USB, and users like to know how their YubiKey is connected."}],"type":"paragraph"},{"text":"Architecture Decisions","level":2,"type":"heading","anchor":"Architecture-Decisions"},{"text":"Why the connection management works this way","level":3,"type":"heading","anchor":"Why-the-connection-management-works-this-way"},{"inlineContent":[{"text":"The sample uses a background loop that continuously waits for wired connections. This might seem unusual, but it solves a key problem: YubiKeys get plugged and unplugged frequently, but apps need to stay responsive.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"When you unplug your YubiKey, the app doesn’t crash or freeze - it detects the disconnection via ","type":"text"},{"code":"waitUntilClosed()","type":"codeVoice"},{"text":" and immediately starts waiting for the next YubiKey. This creates a smoother user experience where the app responds when you plug \/ unplug a YubiKey.","type":"text"}]},{"inlineContent":[{"text":"NFC works differently since you can’t continuously scan - the user has to explicitly initiate each scan. That’s why NFC connections are handled separately through user actions like the scan button or pull-to-refresh.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Error-handling-for-hardware-connections","type":"heading","text":"Error handling for hardware connections"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hardware connections are unreliable by nature. Users will unplug devices mid-operation, walk away during NFC scans, or have connectivity issues. The sample handles this gracefully:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Connection failures are caught and stored as errors"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"User cancellations (like dismissing NFC scan) are filtered out to avoid unnecessary error alerts"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Session errors are handled similarly - show the error but maintain app functionality"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Working with Swift actors","level":3,"type":"heading","anchor":"Working-with-Swift-actors"},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit sessions are Swift actors that handle their own threading. The sample shows how to integrate this with SwiftUI’s main actor requirements:"}]},{"items":[{"content":[{"inlineContent":[{"code":"ConnectionManager","type":"codeVoice"},{"type":"text","text":" runs on "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" so it can directly update "},{"type":"codeVoice","code":"@Published"},{"type":"text","text":" properties"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Session calls happen on the session’s actor, then results are passed back to update the UI"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Everything uses "},{"type":"codeVoice","code":"async\/await"}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/yubikit\/oathsamplecode"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"abstract":[{"type":"text","text":"An interface to the OATH application on the YubiKey."}],"url":"\/documentation\/yubikit\/oathsession","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","navigatorTitle":[{"kind":"identifier","text":"OATHSession"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"OATHSession"}],"title":"OATHSession","role":"symbol","kind":"symbol"},"https://github.com/Yubico/yubikit-swift/tree/main/Samples/OATHSample":{"url":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","type":"download","checksum":null},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"url":"\/documentation\/yubikit","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","images":[{"identifier":"documentation-header.png","type":"icon"}],"title":"YubiKit","role":"collection","kind":"symbol"},"documentation-header.png":{"variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}],"type":"image","identifier":"documentation-header.png","alt":"YubiKeys in a row"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","url":"\/documentation\/yubikit\/pivtoolsamplecode","type":"topic","abstract":[{"text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","type":"reference","isActive":true},{"text":" for cryptographic operations, certificate management, and access control.","type":"text"}],"kind":"article","role":"sampleCode","title":"PIVTool: Building PIV applications with YubiKey"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"abstract":[{"text":"An interface to the PIV application on the YubiKey.","type":"text"}],"url":"\/documentation\/yubikit\/pivsession","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","navigatorTitle":[{"text":"PIVSession","kind":"identifier"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}],"title":"PIVSession","role":"symbol","kind":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"title":"Management.Session","kind":"symbol","abstract":[{"type":"text","text":"An interface to the Management application on the YubiKey."}],"url":"\/documentation\/yubikit\/management\/session","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"topic","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Session","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Session","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"title":"WebAuthn.Client","kind":"symbol","abstract":[{"text":"Client for performing WebAuthn passkey operations.","type":"text"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","url":"\/documentation\/yubikit\/webauthn\/client","type":"topic","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Client","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","role":"sampleCode","type":"topic","kind":"article","url":"\/documentation\/yubikit\/webauthninterceptorsamplecode","abstract":[{"type":"text","text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts "},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"type":"text","text":" calls inside a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" and routes them to a YubiKey. It uses the high-level "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"type":"text","text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" companion module."}]}}}
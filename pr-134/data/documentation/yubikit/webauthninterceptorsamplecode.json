the sample enables ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"com.apple.security.device.usb","type":"codeVoice"},{"text":" so the same target builds cleanly for both platforms.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Where to Customize","anchor":"Where-to-Customize","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Which requests get intercepted.","type":"text"}]},{"type":"text","text":" Edit "},{"type":"codeVoice","code":"shouldIntercept"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" to scope by hint, RP ID, or any other heuristic."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Origin verification."}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"WebAuthnHandler"},{"text":" builds a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"window.location.origin"},{"text":". Replace the ","type":"text"},{"type":"codeVoice","code":"isPublicSuffix"},{"text":" closure passed to ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" with a real public-suffix-list check before shipping.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"UI.","type":"text"}]},{"type":"text","text":" Swap or restyle the panels in "},{"type":"codeVoice","code":"FidoUI\/Sources\/FidoUI\/Views\/"},{"type":"text","text":" — the rest of the module is UI-agnostic."}]}]}],"type":"unorderedList"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"abstract":[{"text":"This sample shows how to build a FIDO2\/WebAuthn c
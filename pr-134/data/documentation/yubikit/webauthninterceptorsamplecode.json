{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The interceptor demonstrates how to:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Intercept ","type":"text"},{"code":"navigator.credentials.create()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"navigator.credentials.get()","type":"codeVoice"},{"text":" in a ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options","type":"reference"},{"text":" \/ ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","type":"reference"},{"text":" types.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Drive the SDK’s high-level "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"type":"text","text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Use the bundled ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface.","type":"text"}]},{"level":2,"text":"Architecture Overview","type":"heading","anchor":"Architecture-Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample itself is intentionally thin:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Interceptor.js","type":"text"}],"type":"strong"},{"text":" — injected into the ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" to monkey-patch ","type":"text"},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"text":" and shuttle requests\/responses through ","type":"text"},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"WebView.swift"}],"type":"strong"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"UIViewRepresentable"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"NSViewRepresentable"},{"type":"text","text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"WebAuthnHandler.swift"}],"type":"strong"},{"type":"text","text":" — decodes the JSON envelope, builds a "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference","isActive":true},{"type":"text","text":", and calls "},{"type":"codeVoice","code":"FidoUI.makeCredential"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"FidoUI.getAssertion"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"ContentView.swift"}],"type":"strong"},{"text":" — minimal SwiftUI shell with a URL bar and back button.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"FidoUI"}]},{"text":" (separate Swift package under ","type":"text"},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI","type":"codeVoice"},{"text":") — the reusable UI + transport layer described below.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The end-to-end flow:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Page JS calls ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.create()"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":".get()"},{"text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" decodes the JSON straight into the SDK’s strongly-typed "},{"type":"codeVoice","code":"Options"},{"type":"text","text":" and hands them to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"FidoUI","type":"codeVoice"},{"text":" opens a transport, runs the ceremony via ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":", and shows PIN \/ UV \/ error \/ success panels as needed.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The resulting ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","isActive":true,"type":"reference"},{"text":" is serialized via its built-in ","type":"text"},{"code":"toJSON()","type":"codeVoice"},{"text":" and posted back to JS.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"anchor":"Intercepting-WebAuthn-Calls","type":"heading","text":"Intercepting WebAuthn Calls"},{"level":3,"anchor":"JavaScript-Injection","type":"heading","text":"JavaScript Injection"},{"type":"paragraph","inlineContent":[{"code":"Interceptor.js","type":"codeVoice"},{"type":"text","text":" replaces "},{"code":"navigator.credentials.create","type":"codeVoice"},{"type":"text","text":" and "},{"code":"navigator.credentials.get","type":"codeVoice"},{"type":"text","text":" with versions that forward to Swift. Binary fields ("},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", "},{"code":"user.id","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"rawId"},{"type":"text","text":", …) are serialized to "},{"type":"strong","inlineContent":[{"type":"text","text":"base64url"}]},{"type":"text","text":" strings via "},{"type":"codeVoice","code":"JSON.stringify"},{"type":"text","text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed."}]},{"type":"codeListing","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"],"syntax":"javascript"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The script is injected at document start so it runs before any page code:"}]},{"type":"codeListing","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"shouldIntercept","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for any ","type":"text"},{"code":"publicKey","type":"codeVoice"},{"text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when ","type":"text"},{"code":"publicKey.hints","type":"codeVoice"},{"text":" includes ","type":"text"},{"code":"\"security-key\"","type":"codeVoice"},{"text":").","type":"text"}]},{"text":"Receiving Messages in Swift","type":"heading","level":3,"anchor":"Receiving-Messages-in-Swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Coordinator"},{"text":" is both ","type":"text"},{"type":"codeVoice","code":"WKNavigationDelegate"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:","type":"text"}]},{"type":"codeListing","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"shutdown()","type":"codeVoice"},{"text":" is called from ","type":"text"},{"code":"dismantle{UI,NS}View","type":"codeVoice"},{"text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle.","type":"text"}]},{"text":"Driving the Ceremony","type":"heading","level":2,"anchor":"Driving-the-Ceremony"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" is intentionally tiny — it decodes the envelope, builds a typed "},{"type":"codeVoice","code":"Origin"},{"type":"text","text":", and delegates to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself."}]},{"syntax":"swift","code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"handleGet"},{"type":"text","text":" is the symmetric counterpart that decodes "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","type":"reference","isActive":true},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"fidoUI.getAssertion"},{"type":"text","text":". The response JSON produced by "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to "},{"type":"codeVoice","code":"ArrayBuffer"},{"type":"text","text":" when it materializes the credential."}],"type":"paragraph"},{"anchor":"Returning-the-Response-to-JavaScript","level":2,"text":"Returning the Response to JavaScript","type":"heading"},{"inlineContent":[{"type":"text","text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:"}],"type":"paragraph"},{"syntax":"swift","code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"],"type":"codeListing"},{"inlineContent":[{"text":"JavaScript decodes the JSON and rebuilds a ","type":"text"},{"type":"codeVoice","code":"PublicKeyCredential"},{"text":"-shaped object — converting the base64url binary fields back to ","type":"text"},{"type":"codeVoice","code":"ArrayBuffer"},{"text":"s and wiring up ","type":"text"},{"type":"codeVoice","code":"getClientExtensionResults"},{"text":", ","type":"text"},{"type":"codeVoice","code":"getAuthenticatorData"},{"text":", ","type":"text"},{"type":"codeVoice","code":"getPublicKey"},{"text":", ","type":"text"},{"type":"codeVoice","code":"toJSON"},{"text":", and the rest. Errors travel through a parallel ","type":"text"},{"type":"codeVoice","code":"__webauthn_error__"},{"type":"text","text":" channel and surface to the page as a "},{"type":"codeVoice","code":"DOMException"},{"type":"text","text":" with name "},{"type":"codeVoice","code":"NotAllowedError"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"The-FidoUI-Module","text":"The FidoUI Module"},{"type":"paragraph","inlineContent":[{"code":"FidoUI","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting ","type":"text"},{"code":"navigator.credentials.*","type":"codeVoice"},{"text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Transport selection.","type":"text"}]},{"type":"text","text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Ceremony serialization.","type":"text"}],"type":"strong"},{"text":" Concurrent calls on the same ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Cancellation.","type":"text"}]},{"type":"text","text":" A single "},{"code":"cancel()","type":"codeVoice"},{"type":"text","text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The host code only needs to construct one ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" instance and call ","type":"text"},{"type":"codeVoice","code":"makeCredential"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"getAssertion"},{"text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See ","type":"text"},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/"},{"text":" for the full source.","type":"text"}],"type":"paragraph"},{"text":"Platform Notes","level":2,"type":"heading","anchor":"Platform-Notes"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"iOS."}],"type":"strong"},{"text":" The wired path goes through CryptoTokenKit (","type":"text"},{"type":"codeVoice","code":"WiredSmartCardConnection"},{"text":" — USB-C or Lightning), and the NFC path through ","type":"text"},{"type":"codeVoice","code":"NFCSmartCardConnection"},{"text":". The sample’s ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":" declares ","type":"text"},{"type":"codeVoice","code":"NFCReaderUsageDescription"},{"text":" and lists the FIDO applet AID (","type":"text"},{"type":"codeVoice","code":"A0000006472F0001"},{"text":") under ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers"},{"text":"; the entitlements turn on ","type":"text"},{"code":"com.apple.developer.nfc.readersession.formats","type":"codeVoice"},{"type":"text","text":" ("},{"code":"TAG","type":"codeVoice"},{"type":"text","text":") and "},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"macOS.","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" uses "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" and "},{"type":"codeVoice","code":"com.apple.security.device.usb"},{"type":"text","text":" so the same target builds cleanly for both platforms."}],"type":"paragraph"}]}]},{"level":2,"text":"Where to Customize","anchor":"Where-to-Customize","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Which requests get intercepted.","type":"text"}],"type":"strong"},{"type":"text","text":" Edit "},{"code":"shouldIntercept","type":"codeVoice"},{"type":"text","text":" in "},{"code":"Interceptor.js","type":"codeVoice"},{"type":"text","text":" to scope by hint, RP ID, or any other heuristic."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Origin verification."}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WebAuthnHandler"},{"text":" builds a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference","isActive":true},{"text":" from ","type":"text"},{"type":"codeVoice","code":"window.location.origin"},{"text":". Replace the ","type":"text"},{"type":"codeVoice","code":"isPublicSuffix"},{"text":" closure passed to ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" with a real public-suffix-list check before shipping.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"UI.","type":"text"}],"type":"strong"},{"text":" Swap or restyle the panels in ","type":"text"},{"code":"FidoUI\/Sources\/FidoUI\/Views\/","type":"codeVoice"},{"text":" — the rest of the module is UI-agnostic.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"sections":[],"abstract":[{"type":"text","text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts "},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"type":"text","text":" calls inside a "},{"code":"WKWebView","type":"codeVoice"},{"type":"text","text":" and routes them to a YubiKey. It uses the high-level "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"type":"text","text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" companion module."}],"seeAlsoSections":[{"title":"Sample code","generated":true,"anchor":"Sample-code","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"]}],"sampleCodeDownload":{"action":{"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample","overridingTitle":"View Source","isActive":true,"type":"reference"},"kind":"sampleDownload"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"},"metadata":{"roleHeading":"Sample Code","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","color":{"standardColorIdentifier":"yellow"},"modules":[{"name":"YubiKit"}],"role":"sampleCode"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/webauthninterceptorsamplecode"]}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"abstract":[{"type":"text","text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","isActive":true},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}],"kind":"article","url":"\/documentation\/yubikit\/pivtoolsamplecode","role":"sampleCode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","title":"PIVTool: Building PIV applications with YubiKey","type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authentication/Options"
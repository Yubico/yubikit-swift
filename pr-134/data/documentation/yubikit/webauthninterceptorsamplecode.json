ntation-header.png","alt":"YubiKeys in a row","type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png"}]},"https://github.com/Yubico/yubikit-swift/tree/main/Samples/WebAuthnInterceptorSample":{"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample","type":"download","checksum":null,"url":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"title":"YubiKit","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"url":"\/documentation\/yubikit","kind":"symbol","role":"collection","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","type":"topic","images":[{"type":"icon","identifier":"documentation-header.png"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Origin":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Origin"}],"role":"symbol","abstract":[{"type":"text","text":"A validated WebAuthn origin."}],"kind":"symbol","title":"WebAuthn.Origin","navigatorTitle":[{"kind":"identifier","text":"Origin"}],"type":"topic","url":"\/documentation\/yubikit\/webauthn\/origin"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Registration/Options":{"abstract":[{"text":"Options for registering a new passkey credential.","type":"text"}],"navigatorTitle":[{"text":"Options","kind":"identifier"}],"type":"topic","title":"WebAuthn.Registration.Options","url":"\/documentation\/yubikit\/webauthn\/registration\/options","role":"symbol","kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Options"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSampleCode":{"abstract":[{"type":"text","text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession"},{"type":"text","text":" to retrieve authentication codes, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},{"type":"text","text":" to get device information."}],"type":"topic","title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","url":"\/documentation\/yubikit\/oathsamplecode","role":"sampleCode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","kind":"article"}}}
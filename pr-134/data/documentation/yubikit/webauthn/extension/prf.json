{"seeAlsoSections":[{"generated":true,"anchor":"Supported-Extensions","title":"Supported Extensions","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/CredProtect","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/CredBlob","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/CredProps","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/LargeBlob","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/MinPinLength","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/ThirdPartyPayment","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PreviewSign"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PRF"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This WebAuthn extension wraps the CTAP2 hmac-secret extension, transforming"},{"type":"text","text":" "},{"type":"text","text":"PRF secrets into hmac-secret salts using "},{"code":"SHA-256(\"WebAuthn PRF\\0\" + secret)","type":"codeVoice"},{"type":"text","text":"."}]},{"text":"Simple Usage (single credential)","anchor":"Simple-Usage-single-credential","type":"heading","level":2},{"syntax":"swift","type":"codeListing","code":["let prf = try await WebAuthn.Extension.PRF(session: session)","let ext = try prf.getAssertion.input(first: userSecret)","let params = CTAP2.GetAssertion.Parameters(..., extensions: [ext])","let response = try await session.getAssertion(parameters: params)","if let secrets = try prf.getAssertion.output(from: response) {","    \/\/ Use derived keys","}"]},{"text":"Multi-credential Usage (evalByCredential)","anchor":"Multi-credential-Usage-evalByCredential","type":"heading","level":2},{"syntax":"swift","type":"codeListing","code":["let prf = try await WebAuthn.Extension.PRF(","    first: defaultSecret,","    evalByCredential: [credIdA: (secretA, nil), credIdB: (secretB, nil)],","    session: session",")","","\/\/ After credential selection:","let ext = try prf.getAssertion.input(for: selectedCredentialId)","let params = CTAP2.GetAssertion.Parameters(..., extensions: [ext])","let response = try await session.getAssertion(parameters: params)","if let secrets = try prf.getAssertion.output(from: response) {","    \/\/ Use derived keys","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pseudo-random function extension for deriving symmetric secrets bound to a credential."}]},{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"PRF","type":"codeVoice"},{"type":"text","text":" lets a relying party derive deterministic symmetric secrets from a credential"},{"type":"text","text":" "},{"type":"text","text":"— the same input produces the same output every time the user authenticates with"},{"type":"text","text":" "},{"type":"text","text":"that credential. It’s the "},{"type":"reference","identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/#prf-extension","isActive":true},{"type":"text","text":" "},{"type":"text","text":"for credential-bound key derivation, built on the CTAP2 "},{"code":"hmac-secret","type":"codeVoice"},{"type":"text","text":" extension."},{"type":"text","text":" "},{"type":"text","text":"The SDK transforms each PRF input with "},{"code":"SHA-256(\"WebAuthn PRF\\0\" || input)","type":"codeVoice"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"text","text":"sending it to the authenticator — that domain separation is mandated by the spec."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In a high-level WebAuthn flow, configure "},{"code":"PRF","type":"codeVoice"},{"type":"text","text":" per ceremony via"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/RegistrationInputs\/prf","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/AuthenticationInputs\/prf","isActive":true},{"type":"text","text":"; outputs come back on"},{"type":"text","text":" "},{"code":"clientExtensionResults","type":"codeVoice"},{"type":"text","text":" of the corresponding "},{"code":"Response","type":"codeVoice"},{"type":"text","text":". Registration enables"},{"type":"text","text":" "},{"type":"text","text":"PRF on a credential, optionally deriving secrets at the same time on"},{"type":"text","text":" "},{"type":"text","text":"authenticators that support hmac-secret-mc. Authentication evaluates the PRF at"},{"type":"text","text":" "},{"type":"text","text":"one or more inputs and returns the derived bytes."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Registration: enable PRF on the new credential","let regOpts = WebAuthn.Registration.Options(","    challenge: challenge,","    rp: .init(id: \"example.com\", name: \"Example\"),","    user: .init(id: userId, name: \"alice@example.com\"),","    extensions: .init(prf: .enable)",")","let registration = try await client.makeCredential(regOpts, authorization: auth).value","","\/\/ Authentication: derive a secret bound to the credential","let authOpts = WebAuthn.Authentication.Options(","    challenge: challenge,","    rpId: \"example.com\",","    allowCredentials: [.init(id: storedCredentialId)],","    extensions: .init(prf: .eval(first: encryptionSeed))",")","let assertions = try await client.getAssertion(authOpts, authorization: auth).value","let derived = assertions.first?.clientExtensionResults.prf?.results.first"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For multi-credential flows whe
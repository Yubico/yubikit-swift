":"PIVSession"}],"type":"topic","role":"symbol","title":"PIVSession"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"abstract":[{"type":"text","text":"An interface to the OATH application on the YubiKey."}],"title":"OATHSession","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"topic","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OATHSession","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"OATHSession","kind":"identifier"}],"url":"\/documentation\/yubikit\/oathsession","role":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","type":"topic","role":"sampleCode","kind":"article","abstract":[{"type":"text","text":"This sample shows how to build a FIDO2 client that intercepts WebAuthn API calls in a WKWebView and routes them to a YubiKey via NFC (iOS) or USB HID (macOS). The app demonstrates using "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference","isActive":true},{"type":"text","text":" for FIDO2 operations and handling the PRF extension for deriving secrets."}],"url":"\/documentation\/yubikit\/webauthninterceptorsamplecode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"}}}
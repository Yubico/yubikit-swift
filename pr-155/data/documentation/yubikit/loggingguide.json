{"abstract":[{"text":"Choose YubiKit’s log level and backend with ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging\/configure(logLevel:factory:)","isActive":true},{"text":".","type":"text"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/loggingguide"]}],"sections":[],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"seeAlsoSections":[{"generated":true,"title":"Preparing your project","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logging"],"anchor":"Preparing-your-project"}],"metadata":{"role":"article","title":"Logging","modules":[{"name":"YubiKit"}],"roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No setup is required. YubiKit defaults to "},{"code":"debug","type":"codeVoice"},{"type":"text","text":" on stdout when compiled with "},{"code":"DEBUG","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or "},{"code":"info","type":"codeVoice"},{"type":"text","text":" on stderr otherwise. You can override either default:"}]},{"syntax":"swift","code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","Logging.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","Logging.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","Logging.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","Logging.configure()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-log"},{"type":"text","text":"’s "},{"code":"Logging","type":"codeVoice"},{"type":"text","text":" product to your app target"},{"type":"text","text":" "},{"type":"text","text":"to use its backend types. Any SwiftLog "},{"code":"LogHandler","type":"codeVoice"},{"text":" can be supplied by the factory.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;","type":"text"},{"text":" ","type":"text"},{"text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,","type":"text"},{"text":" ","type":"text"},{"text":"though logs already in progress may use the previous settings.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,","type":"text"},{"text":" ","type":"text"},{"text":"pass its factory explicitly; global ","type":"text"},{"type":"codeVoice","code":"LoggingSystem.bootstrap"},{"text":" does not select YubiKit’s backend.","type":"text"},{"text":" ","type":"text"},{"text":"Factories may run concurrently and must not log through YubiKit themselves.","type":"text"}]},{"text":"Traffic logging","level":3,"type":"heading","anchor":"Traffic-logging"},{"code":["Logging.configure(logLevel: .trace)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Raw traffic and SCP plaintext logs require ","type":"text"},{"inlineContent":[{"text":"YubiKit to be compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"}],"type":"strong"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Neither configuration nor a custom backend can enable them in other builds.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Custom connections are responsible for their own traffic logging."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Debug logs can include account names and credential identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Trace logs can include PINs, credentials, and cryptographic keys. Protect or redact logs before sharing them.","type":"text"}]}],"style":"warning","type":"aside","name":"Warning"},{"text":"Custom backends","level":3,"type":"heading","anchor":"Custom-backends"},{"inlineContent":[{"text":"Labels identify categories, such as ","type":"text"},{"code":"com.yubico.YubiKit.OATH","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"com.yubico.YubiKit.FIDO","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Metadata carries details such as byte counts and error codes; the default backend displays"},{"type":"text","text":" "},{"type":"text","text":"these as "},{"code":"key=value","type":"codeVoice"},{"type":"text","text":" pairs. Message wording and metadata keys are not a stable API."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages."}],"type":"paragraph"}]}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/GettingStarted":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","title":"Getting Started","abstract":[{"text":"Prepare your project to connect to the YubiKey via NFC, SmartCard, Lightning and USB HID.","type":"text"}],"role":"article","url":"\/documentation\/yubikit\/gettingstarted","kind":"article","type":"topic"},"https://github.com/apple/swift-log":{"type":"link","title":"SwiftLog","titleInlineContent":[{"text":"SwiftLog","type":"text"}],"identifier":"https:\/\/github.com\/apple\/swift-log","url":"https:\/\/github.com\/apple\/swift-log"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logging/configure(logLevel:factory:)":{"type":"topic","identifier":"doc:\/\/y
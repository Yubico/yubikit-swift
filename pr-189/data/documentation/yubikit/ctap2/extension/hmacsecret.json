{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HmacSecret"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This extension allows a relying party to derive symmetric keys from a credential","type":"text"},{"text":" ","type":"text"},{"text":"using HMAC-SHA-256 with user-provided salts. The derived keys can be used for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"encryption or other cryptographic operations."}]},{"level":2,"type":"heading","text":"MakeCredential Usage","anchor":"MakeCredential-Usage"},{"inlineContent":[{"type":"text","text":"Request hmac-secret support when creating a credential:"}],"type":"paragraph"},{"type":"codeListing","code":["let hmacSecret = CTAP2.Extension.HmacSecret()","let ext = hmacSecret.makeCredential.input()","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    \/\/ hmac-secret is enabled","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Or derive secrets at registration time (CTAP 2.2 hmac-secret-mc):"}],"type":"paragraph"},{"type":"codeListing","code":["let hmacSecret = try await CTAP2.Extension.HmacSecret(session: session)","let ext = try hmacSecret.makeCredential.input(salt1: salt, salt2: salt2)","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    switch result {","    case .enabled:","        \/\/ hmac-secret-mc not supported, but hmac-secret is enabled","    case .secrets(let secrets):","        \/\/ Use derived keys (secrets.first, secrets.second)","    }","}"],"syntax":"swift"},{"anchor":"GetAssertion-Usage","type":"heading","level":2,"text":"GetAssertion Usage"},{"inlineContent":[{"type":"text","text":"Derive keys during authentication:"}],"type":"paragraph"},{"type":"codeListing","code":["let hmacSecret = try await CTAP2.Extension.HmacSecret(session: session)","let ext = try hmacSecret.getAssertion.input(salt1: salt)","let params = CTAP2.GetAssertion.Parameters(..., extensions: [ext])","let response = try await session.getAssertion(params)","if let secrets = try hmacSecret.getAssertion.output(from: response) {","    \/\/ Use derived keys (secrets.first, secrets.second)","}"],"syntax":"swift"},{"name":"See Also","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"https:\/\/fidoalliance.org\/specs\/fido-v2.2-ps-20250714\/fido-client-to-authenticator-protocol-v2.2-ps-20250714.html#sctn-hmac-secret-extension","isActive":true}],"type":"paragraph"}],"style":"note","type":"aside"},{"name":"See Also","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"https:\/\/fidoalliance.org\/specs\/fido-v2.2-ps-20250714\/fido-client-to-authenticator-protocol-v2.2-ps-20250714.html#sctn-hmac-secret-make-cred-extension","isActive":true}],"type":"paragraph"}],"style":"note","type":"aside"}]}],"metadata":{"extendedModule":"YubiKit","title":"CTAP2.Extension.HmacSecret","externalID":"s:7YubiKit5CTAP2O9ExtensionO10HmacSecretV","roleHeading":"Structure","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HmacSecret"}],"modules":[{"name":"YubiKit"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"HmacSecret"}]},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Extension\/HmacSecret","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The hmac-secret extension for deriving symmetric keys from cred
"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":" and the request, response, and","type":"text"},{"text":" ","type":"text"},{"text":"data-model types defined by the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"specification."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A passkey client and the W3C Web Authentication data model, mediated by a YubiKey."}],"type":"paragraph"},{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"WebAuthn","type":"codeVoice"},{"text":" namespace provides a high-level passkey client (","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"text":") that runs","type":"text"},{"text":" ","type":"text"},{"overridingTitle":"Web Authentication Level 3","identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/","type":"reference","isActive":true,"overridingTitleInlineContent":[{"text":"Web Authentication Level 3","type":"text"}]},{"text":" ceremonies against a","type":"text"},{"text":" ","type":"text"},{"text":"YubiKey, plus the request and response types defined by the WebAuthn specification.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A WebAuthn ceremony involves three parties: the ","type":"text"},{"inlineContent":[{"text":"authenticator","type":"text"}],"type":"strong"},{"text":" (a YubiKey), the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"client","type":"text"}],"type":"strong"},{"text":" (your app, via ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":"), and the ","type":"text"},{"inlineContent":[{"type":"text","text":"relying party"}],"type":"strong"},{"text":" (your server, which","type":"text"},{"text":" ","type":"text"},{"text":"verifies what the authenticator returns). The client is the communication path between","type":"text"},{"text":" ","type":"text"},{"text":"authenticator and relying party — and it verifies the relying party’s identity against","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the origin it’s bound to, so it can refuse to sign for a fraudulent site."}],"type":"paragraph"},{"inlineContent":[{"text":"There are two ceremonies. ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Registration"}]},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)"},{"text":") creates a new credential and supplies its","type":"text"},{"text":" ","type":"text"},{"text":"public key to the relying party for account association. ","type":"text"},{"type":"strong","inlineContent":[{"text":"Authentication","type":"text"}]},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","isActive":true,"type":"reference"},{"text":") proves to the relying party that the","type":"text"},{"text":" ","type":"text"},{"text":"YubiKey is the one registered for the user. Both ceremonies follow the same mechanical","type":"text"},{"text":" ","type":"text"},{"text":"shape: the relying party supplies a challenge, the authenticator signs it together","type":"text"},{"text":" ","type":"text"},{"text":"with the relying-party identifier, and the signature goes back to the relying party","type":"text"},{"text":" ","type":"text"},{"text":"for verification.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The pieces fit together as: a connection carries CTAP2 traffic, a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"sits on top, and ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"text":" runs ceremonies on that session. Connections come in","type":"text"},{"text":" ","type":"text"},{"text":"three flavours that all work for WebAuthn: ","type":"text"},{"code":"YubiKit\/HIDFIDOConnection","type":"codeVoice"},{"text":" on macOS,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection","type":"reference","isActive":true},{"text":" for tap-to-auth on iOS, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/USBSmartCardConnection","type":"reference","isActive":true},{"text":" on either platform. Pick the one that matches","type":"text"},{"text":" ","type":"text"},{"text":"your platform and form factor.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ macOS — USB HID FIDO","let connection = try await HIDFIDOConnection()","\/\/ iOS — tap-to-auth over NFC:","\/\/ let connection = try await NFCSmartCardConnection()","","let session = try await CTAP2.Session.makeSession(connection: connection)","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","\/\/ Register a new passkey","let registration = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value","","\/\/ Authenticate","let assertions = try await client.getAssertion(","    .init(challenge: challenge, rpId: \"example.com\"),","    authorization: .pin(\"1234\")",").value"]},{"type":"paragraph","inlineContent":[{"text":"Most apps start with ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"text":". For lower-level CTAP2 access — raw ","type":"text"},{"code":"makeCredential","type":"codeVoice"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"getAssertion"},{"type":"text","text":", credential management, bio enrollment — use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":" directly."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/webauthn"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn"},"kind":"symbol","abstract":[{"type":"text","text":"WebAuthn (Web Authentication) namespace."}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Status":{"kind":"symbol","type":"topic","title":"WebAuthn.Status","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Status","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Status","kind":"identifier"}],"navigatorTitle":[{"text":"Status","kind":"identifier"}],"abstract":[{"type":"text","text":"Status updates during WebAuthn operations."}],"url":"\/documentation\/yubikit\/webauthn\/status"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authentication":{"kind":"symbol","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication","role":"symbol","fragments":[{"text":"enum","kind":"keyw
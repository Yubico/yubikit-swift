{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/oathsamplecode"]}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"metadata":{"title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","color":{"standardColorIdentifier":"green"},"modules":[{"name":"YubiKit"}],"role":"sampleCode","roleHeading":"Sample Code"},"sections":[],"seeAlsoSections":[{"title":"Sample code","generated":true,"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"],"anchor":"Sample-code"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","interfaceLanguage":"swift"},"kind":"article","sampleCodeDownload":{"action":{"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","isActive":true,"overridingTitle":"View Source","type":"reference"},"kind":"sampleDownload"},"abstract":[{"type":"text","text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession"},{"type":"text","text":" to retrieve authentication codes, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},{"type":"text","text":" to get device information."}],"primaryContentSections":[{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"The sample creates an authenticator app that:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Establishes connections to YubiKeys via USB, Lightning, or NFC","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Manages connection lifecycle (detecting plugged\/unplugged devices)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists TOTP codes stored on the YubiKey"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Shows device information like firmware version","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Handles connection errors and user cancellations gracefully","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This sample focuses on read-only operations and doesn’t handle password-protected YubiKeys or credential management.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Connection-Management","text":"Connection Management","level":2},{"type":"heading","anchor":"Handling-Wired-Connections","text":"Handling Wired Connections","level":3},{"type":"paragraph","inlineContent":[{"text":"The app uses a ","type":"text"},{"type":"codeVoice","code":"ConnectionManager"},{"text":" to handle persistent connections to plugged-in YubiKeys. This approach ensures your app stays responsive when users plug and unplug their YubiKeys:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["private func startWiredConnection() {","    wiredConnectionTask = Task { @MainActor in","        while !Task.isCancelled {","            do {","                let newConnection = try await WiredSmartCardConnection.makeConnection()","                wiredConnection = newConnection","","                \/\/ Wait for disconnect","                let closeError = await newConnection.waitUntilClosed()","                wiredConnection = nil","            } catch {","                self.error = error","            }","        }","    }","}"]},{"inlineContent":[{"text":"The key insight here is using ","type":"text"},{"type":"codeVoice","code":"waitUntilClosed()"},{"type":"text","text":" to detect when the YubiKey is unplugged, then automatically waiting for the next connection."}],"type":"paragraph"},{"text":"NFC Connections","level":3,"anchor":"NFC-Connections","type":"heading"},{"inlineContent":[{"type":"text","text":"NFC connections work differently - they’re initiated by user action and are short-lived:"}],"type":"paragraph"},{"syntax":"swift","code":["func requestNFCConnection() async {","    do {","        nfcConnection = try await NFCSmartCardConnection()","    } catch {","        self.error = error","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"When an NFC connection is established, the app fetches data and immediately closes it with a user message:","type":"text"}]},{"syntax":"swift","code":["Task {","    await model.update(using: connection)","    await connection.close(message: \"Codes calculated\")","}"],"type":"codeListing"},{"level":2,"anchor":"Working-with-YubiKey-Data","type":"heading","text":"Working with YubiKey Data"},{"level":3,"anchor":"Reading-OATH-Codes","type":"heading","text":"Reading OATH Codes"},{"type":"paragraph","inlineContent":[{"text":"Once you have a connection, getting TOTP codes is straightforward:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["private func calculateCodes(using connection: SmartCardConnection) async {","    do {","        let session = try await OATHSession.makeSession(connection: connection)","        let result = try await session.calculateCredentialCodes()","        accounts = result.map { credential, code in","            Account(","                label: credential.label,","                code: code?.code,","                issuer: credential.issuer,","                type: credential.type","            )","        }","    } catch {","        self.error = error","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"calculateCredentialCodes()","type":"codeVoice"},{"text":" method returns a dictionary mapping credentials to their current codes. Some codes might be ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if they require touch or are password-protected.","type":"text"}]},{"level":3,"text":"Getting Device Information","anchor":"Getting-Device-Information","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"Management.Session","type":"codeVoice"},{"text":" to get YubiKey information:","type":"text"}]},{"code":["private func getKeyVersion(using connection: SmartCardConnection) async {","    do {","        let session: Management.Session = try await .makeSession(connection: connection)","        self.keyVersion = await session.version.description","    } catch {","        self.error = error","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"code":"Model","type":"codeVoice"},{"type":"text","text":" class combines both operations in a single "},{"code":"update","type":"codeVoice"},{"type":"text","text":" method:"}],"type":"paragraph"},{"code":["func update(using connection: SmartCardConnection) async {","    await calculateCodes(using: connection)","    await getKeyVersion(using: connection)","    connectionType = connection.connectionType","}"],"syntax":"swift","type":"codeListing"},{"text":"SwiftUI Integration","level":2,"anchor":"SwiftUI-Integration","type":"heading"},{"text":"Reacting to Connection Changes","level":3,"anchor":"Reacting-to-Connection-Changes","type":"heading"},{"inlineContent":[{"type":"text","text":"The app uses SwiftUI’s "},{"code":"@Published","type":"codeVoice"},{"type":"text","text":" properties and "},{"code":"onReceive","type":"codeVoice"},{"type":"text","text":" to update the UI when connections change:"}],"type":"paragraph"},{"code":[".onReceive(connectionManager.$wiredConnection) { newConnection in","    guard let connection = newConnection else {","        model.clear()  \/\/ Clear UI when YubiKey unplugged","        return","    }","    Task { await model.update(using: connection) }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This pattern ensures the UI immediately updates when YubiKeys are plugged in or removed."}],"type":"paragraph"},{"text":"Platform-Specific Features","level":3,"anchor":"Platform-Specific-Features","type":"heading"},{"inlineContent":[{"type":"text","text":"The app handles iOS vs macOS differences with conditional compilation:"}],"type":"paragraph"},{"code":["#if os(iOS)",".refreshable {","    await connectionManager.requestNFCConnection()","}","#endif"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"iOS users can pull-to-refresh to scan with NFC, while macOS users only see USB options."}],"type":"paragraph"},{"text":"Connection Type Detection","level":3,"anchor":"Connection-Type-Detection","type":"heading"},{"inlineContent":[{"type":"text","text":"The sample includes a useful extension to identify connection types:"}],"type":"paragraph"},{"code":["extension SmartCardConnection {","    var connectionType: String {","        switch self {","        case _ as NFCSmartCardConnection: return \"NFC\"","        case _ as LightningSmartCardConnection: return \"Lightning\"","        case _ as USBSmartCardConnection: return \"USB\"","        default: return \"Unknown\"","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This is helpful because NFC connections are slower than USB, and users like to know how their YubiKey is connected.","type":"text"}],"type":"paragraph"},{"text":"Architecture Decisions","level":2,"anchor":"Architecture-Decisions","type":"heading"},{"text":"Why the connection management works this way","level":3,"anchor":"Why-the-connection-management-works-this-way","type":"heading"},{"inlineContent":[{"text":"The sample uses a background loop that continuously waits for wired connections. This might seem unusual, but it solves a key problem: YubiKeys get plugged and unplugged frequently, but apps need to stay responsive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When you unplug your YubiKey, the app doesn’t crash or freeze - it detects the disconnection via ","type":"text"},{"type":"codeVoice","code":"waitUntilClosed()"},{"text":" and immediately starts waiting for the next YubiKey. This creates a smoother user experience where the app responds when you plug \/ unplug a YubiKey.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"NFC works differently since you can’t continuously scan - the user has to explicitly initiate each scan. That’s why NFC connections are handled separately through user actions like the scan button or pull-to-refresh.","type":"text"}],"type":"paragraph"},{"text":"Error handling for hardware connections","level":3,"anchor":"Error-handling-for-hardware-connections","type":"heading"},{"inlineContent":[{"text":"Hardware connections are unreliable by nature. Users will unplug devices mid-operation, walk away during NFC scans, or have connectivity issues. The sample handles this gracefully:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Connection failures are caught and stored as errors"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"User cancellations (like dismissing NFC scan) are filtered out to avoid unnecessary error alerts"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Session errors are handled similarly - show the error but maintain app functionality"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Working with Swift actors","level":3,"anchor":"Working-with-Swift-actors","type":"heading"},{"inlineContent":[{"text":"YubiKit sessions are Swift actors that handle their own threading. The sample shows how to integrate this with SwiftUI’s main actor requirements:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ConnectionManager"},{"type":"text","text":" runs on "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" so it can directly update "},{"type":"codeVoice","code":"@Published"},{"type":"text","text":" properties"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Session calls happen on the session’s actor, then results are passed back to update the UI"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Everything uses "},{"type":"codeVoice","code":"async\/await"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"title":"PIVTool: Building PIV applications with YubiKey","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","url":"\/documentation\/yubikit\/pivtoolsamplecode","role":"sampleCode","kind":"article","type":"topic","abstract":[{"type":"text","text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession"},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"PIVSession"}],"title":"PIVSession","navigatorTitle":[{"kind":"identifier","text":"PIVSession"}],"abstract":[{"type":"text","text":"An interface to the PIV application on the YubiKey."}],"type":"topic","role":"symbol","url":"\/documentation\/yubikit\/pivsession","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","kind":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","url":"\/documentation\/yubikit\/webauthninterceptorsamplecode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","role":"sampleCode","kind":"article","type":"topic","abstract":[{"type":"text","text":"This sample shows how to build a FIDO2 client that intercepts WebAuthn API calls in a WKWebView and routes them to a YubiKey via NFC (iOS) or USB HID (macOS). The app demonstrates using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":" for FIDO2 operations and handling the PRF extension for deriving secrets."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/CTAP2/Session":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Interface to the FIDO2\/CTAP authenticator on the YubiKey."}],"navigatorTitle":[{"kind":"identifier","text":"Session"}],"url":"\/documentation\/yubikit\/ctap2\/session","fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Session"}],"title":"CTAP2.Session","kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Session"}],"title":"Management.Session","navigatorTitle":[{"text":"Session","kind":"identifier"}],"abstract":[{"type":"text","text":"An interface to the Management application on the YubiKey."}],"type":"topic","role":"symbol","url":"\/documentation\/yubikit\/management\/session","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","kind":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"title":"YubiKit","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"type":"topic","images":[{"identifier":"documentation-header.png","type":"icon"}],"role":"collection","url":"\/documentation\/yubikit","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","kind":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","title":"OATHSession","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OATHSession"}],"url":"\/documentation\/yubikit\/oathsession","abstract":[{"text":"An interface to the OATH application on the YubiKey.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"OATHSession"}]},"documentation-header.png":{"alt":"YubiKeys in a row","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png"}],"type":"image","identifier":"documentation-header.png"},"https://github.com/Yubico/yubikit-swift/tree/main/Samples/OATHSample":{"url":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","checksum":null,"type":"download","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample"}}}
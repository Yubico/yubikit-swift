"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Contains the high-level passkey "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"type":"text","text":" and the request, response, and"},{"type":"text","text":" "},{"type":"text","text":"data-model types defined by the"},{"type":"text","text":" "},{"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"specification."}]},{"inlineContent":[{"type":"text","text":"A passkey client and the W3C Web Authentication data model, mediated by a YubiKey."}],"type":"paragraph"},{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"WebAuthn","type":"codeVoice"},{"type":"text","text":" namespace provides a high-level passkey client ("},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"type":"text","text":") that runs"},{"type":"text","text":" "},{"overridingTitleInlineContent":[{"text":"Web Authentication Level 3","type":"text"}],"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/","type":"reference","isActive":true,"overridingTitle":"Web Authentication Level 3"},{"type":"text","text":" ceremonies against a"},{"type":"text","text":" "},{"type":"text","text":"YubiKey, plus the request and response types defined by the WebAuthn specification."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A WebAuthn ceremony involves three parties: the "},{"type":"strong","inlineContent":[{"text":"authenticator","type":"text"}]},{"text":" (a YubiKey), the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"client"}],"type":"strong"},{"text":" (your app, via ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":"), and the ","type":"text"},{"inlineContent":[{"type":"text","text":"relying party"}],"type":"strong"},{"text":" (your server, which","type":"text"},{"text":" ","type":"text"},{"text":"verifies what the authenticator returns). The client is the communication path between","type":"text"},{"text":" ","type":"text"},{"text":"authenticator and relying party — and it verifies the relying party’s identity against","type":"text"},{"text":" ","type":"text"},{"text":"the origin it’s bound to, so it can refuse to sign for a fraudulent site.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are two ceremonies. "},{"type":"strong","inlineContent":[{"type":"text","text":"Registration"}]},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","type":"reference"},{"type":"text","text":") creates a new credential and supplies its"},{"type":"text","text":" "},{"type":"text","text":"public key to the relying party for account association. "},{"type":"strong","inlineContent":[{"type":"text","text":"Authentication"}]},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","type":"reference"},{"type":"text","text":") proves to the relying party that the"},{"type":"text","text":" "},{"type":"text","text":"YubiKey is the one registered for the user. Both ceremonies follow the same mechanical"},{"type":"text","text":" "},{"type":"text","text":"shape: the relying party supplies a challenge, the authenticator signs it together"},{"type":"text","text":" "},{"type":"text","text":"with the relying-party identifier, and the signature goes back to the relying party"},{"type":"text","text":" "},{"type":"text","text":"for verification."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pieces fit together as: a connection carries CTAP2 traffic, a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"type":"text","text":" "},{"type":"text","text":"sits on top, and "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"type":"text","text":" runs ceremonies on that session. Connections come in"},{"type":"text","text":" "},{"type":"text","text":"three flavours that all work for WebAuthn: "},{"code":"YubiKit\/HIDFIDOConnection","type":"codeVoice"},{"type":"text","text":" on macOS,"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection","type":"reference"},{"type":"text","text":" for tap-to-auth on iOS, and"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/USBSmartCardConnection","type":"reference"},{"type":"text","text":" on either platform. Pick the one that matches"},{"type":"text","text":" "},{"type":"text","text":"your platform and form factor."}]},{"type":"codeListing","code":["\/\/ macOS — USB HID FIDO","let connection = try await HIDFIDOConnection()","\/\/ iOS — tap-to-auth over NFC:","\/\/ let connection = try await NFCSmartCardConnection()","","let session = try await CTAP2.Session.makeSession(connection: connection)","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","\/\/ Register a new passkey","let registration = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value","","\/\/ Authenticate","let assertions = try await client.getAssertion(","    .init(challenge: challenge, rpId: \"example.com\"),","    authorization: .pin(\"1234\")",").value"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most apps start with "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":". For lower-level CTAP2 access — raw "},{"type":"codeVoice","code":"makeCredential"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"getAssertion"},{"type":"text","text":", credential management, bio enrollment — use "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"type":"text","text":" directly."}]}]}],"metadata":{"externalID":"s:7YubiKit8WebAuthnO","roleHeading":"Enumeration","navigatorTitle":[{"kind":"identifier","text":"WebAuthn"}],"symbolKind":"enum","title":"WebAuthn","modules":[{"name":"YubiKit"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WebAuthn","kind":"identifier"}],"role":"symbol"},"references":{"https://www.w3.org/TR/webauthn-3/#dictdef-publickeycredentialcreationoptions":{"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/#dictdef-publickeycredentialcreationoptions","titleInlineContent":[{"text":"PublicKeyCredentialCreationOptions","type":"text"}],"type":"link","title":"PublicKeyCredentialCreationOptions","url":"https:\/\/www.w3.org\/TR\/webauthn-3\/#dictdef-publickeycredentialcreationoptions"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/ClientData":{"title":"WebAuthn.ClientData","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientData"}],"navigatorTitle":[{"kind":"identifier","text":"ClientData"}],"url":"\/documentation\/yubikit\/webauthn\/clientdata","identifier"
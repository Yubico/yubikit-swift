rding and metadata keys are not a stable API.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/loggingguide"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"generated":true,"title":"Preparing your project","anchor":"Preparing-your-project"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"YubiKit"}],"title":"Logging"},"abstract":[{"type":"text","text":"Choose YubiKit’s log level and backend with "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)","type":"reference","isActive":true},{"type":"text","text":"."}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide"},"kind":"article","references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logs/configure(logLevel:factory:)":{"type":"topic","url":"\/documentation\/yubikit\/logs\/configure(loglevel:factory:)","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"configure","kind":"identifier"},{"text":"(","kind":"text"},{"text":"logLevel","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7Logging6LoggerV","text":"Logger","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Level","kind":"typeIdentifier","preciseIdentifier":"s:7Loggi
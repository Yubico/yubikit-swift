{"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NFCSmartCardConnection"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The  NFCSmartCardConnection is short lived and should be closed as soon as the commands sent to the YubiKey have finished processing. It is up to the user of"},{"type":"text","text":" "},{"type":"text","text":"the connection to close it when it no longer is needed. As long as the connection is open the NFC modal will cover the lower part of the iPhone screen."},{"type":"text","text":" "},{"type":"text","text":"In addition to the "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/close(error:)","type":"reference"},{"type":"text","text":" method defined in the SmartCardConnection protocol the NFCSmartCardConnection has an additional "},{"code":"close(success:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"method that will close the connection and set the alertMessage of the NFC alert to the provided message."}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"text":"NFC is only supported on iPhones from iPhone 6 and forward. It will not work on iPads since there’s no NFC chip in these devices.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"},{"inlineContent":[{"type":"text","text":"NFC connection to a YubiKey (iOS only)."}],"type":"paragraph"},{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"NFCSmartCardConnection establishes a connection to a YubiKey via NFC. The connection"},{"type":"text","text":" "},{"type":"text","text":"presents the system NFC dialog and waits for the user to tap their YubiKey."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"NFC connections are short-lived due to iOS timeout constraints. Perform operations quickly"},{"type":"text","text":" "},{"type":"text","text":"and close the connection with a user-visible message."}],"type":"paragraph"},{"code":["let connection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","await connection.close(message: \"Codes retrieved\")"],"type":"codeListing","syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/nfcsmartcardconnection"]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"abstract":[{"type":"text","text":"A NFC connection to the YubiKey."}],"metadata":{"modules":[{"name":"YubiKit"}],"symbolKind":"struct","role":"symbol","navigatorTitle":[{"text":"NFCSmartCardConnection","kind":"identifier"}],"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NFCSmartCardConnection"}],"externalID":"s:7YubiKit22NFCSmartCardConnectionV","title":"NFCSmartCardConnection"},"seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/USBSmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LightningSmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WiredSmartCardConnection"],"anchor":"Creating-a-SmartCardConnection-to-a-YubiKey","title":"Creating a SmartCardConnection to a YubiKey","generated":true}],"sections"
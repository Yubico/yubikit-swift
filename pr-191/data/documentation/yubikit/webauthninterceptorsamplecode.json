{"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The interceptor demonstrates how to:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Intercept ","type":"text"},{"code":"navigator.credentials.create()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"navigator.credentials.get()","type":"codeVoice"},{"text":" in a ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options","type":"reference"},{"type":"text","text":" \/ "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options"},{"type":"text","text":" types."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Drive the SDK’s high-level ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Use the bundled ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface."}],"type":"paragraph"},{"level":2,"text":"Architecture Overview","type":"heading","anchor":"Architecture-Overview"},{"inlineContent":[{"type":"text","text":"The sample itself is intentionally thin:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Interceptor.js"}]},{"text":" — injected into the ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" to monkey-patch ","type":"text"},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"text":" and shuttle requests\/responses through ","type":"text"},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"WebView.swift"}]},{"text":" — ","type":"text"},{"code":"UIViewRepresentable","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"NSViewRepresentable","type":"codeVoice"},{"text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"WebAuthnHandler.swift"}]},{"text":" — decodes the JSON envelope, builds a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference"},{"text":", and calls ","type":"text"},{"code":"FidoUI.makeCredential","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"FidoUI.getAssertion","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"ContentView.swift"}]},{"text":" — minimal SwiftUI shell with a URL bar and back button.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"FidoUI"}]},{"text":" (separate Swift package under ","type":"text"},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI","type":"codeVoice"},{"text":") — the reusable UI + transport layer described below.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The end-to-end flow:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Page JS calls ","type":"text"},{"code":"navigator.credentials.create()","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".get()","type":"codeVoice"},{"text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" decodes the JSON straight into the SDK’s strongly-typed ","type":"text"},{"code":"Options","type":"codeVoice"},{"text":" and hands them to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"FidoUI","type":"codeVoice"},{"text":" opens a transport, runs the ceremony via ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":", and shows PIN \/ UV \/ error \/ success panels as needed.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The resulting ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","type":"reference"},{"text":" is serialized via its built-in ","type":"text"},{"code":"toJSON()","type":"codeVoice"},{"text":" and posted back to JS.","type":"text"}]}]}],"type":"orderedList"},{"level":2,"text":"Intercepting WebAuthn Calls","type":"heading","anchor":"Intercepting-WebAuthn-Calls"},{"level":3,"text":"JavaScript Injection","type":"heading","anchor":"JavaScript-Injection"},{"inlineContent":[{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" replaces "},{"type":"codeVoice","code":"navigator.credentials.create"},{"type":"text","text":" and "},{"type":"codeVoice","code":"navigator.credentials.get"},{"type":"text","text":" with versions that forward to Swift. Binary fields ("},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", "},{"type":"codeVoice","code":"user.id"},{"type":"text","text":", "},{"type":"codeVoice","code":"rawId"},{"type":"text","text":", …) are serialized to "},{"type":"strong","inlineContent":[{"type":"text","text":"base64url"}]},{"type":"text","text":" strings via "},{"type":"codeVoice","code":"JSON.stringify"},{"type":"text","text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed."}],"type":"paragraph"},{"type":"codeListing","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"],"syntax":"javascript"},{"inlineContent":[{"type":"text","text":"The script is injected at document start so it runs before any page code:"}],"type":"paragraph"},{"type":"codeListing","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"shouldIntercept"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for any "},{"type":"codeVoice","code":"publicKey"},{"type":"text","text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when "},{"type":"codeVoice","code":"publicKey.hints"},{"type":"text","text":" includes "},{"type":"codeVoice","code":"\"security-key\""},{"type":"text","text":")."}],"type":"paragraph"},{"level":3,"text":"Receiving Messages in Swift","type":"heading","anchor":"Receiving-Messages-in-Swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" is both "},{"type":"codeVoice","code":"WKNavigationDelegate"},{"type":"text","text":" and "},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"type":"text","text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:"}],"type":"paragraph"},{"type":"codeListing","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"shutdown()"},{"type":"text","text":" is called from "},{"type":"codeVoice","code":"dismantle{UI,NS}View"},{"type":"text","text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle."}],"type":"paragraph"},{"level":2,"text":"Driving the Ceremony","type":"heading","anchor":"Driving-the-Ceremony"},{"inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" is intentionally tiny — it decodes the envelope, builds a typed "},{"type":"codeVoice","code":"Origin"},{"type":"text","text":", and delegates to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself."}],"type":"paragraph"},{"type":"codeListing","code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"handleGet"},{"type":"text","text":" is the symmetric counterpart that decodes "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"fidoUI.getAssertion"},{"type":"text","text":". The response JSON produced by "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to "},{"type":"codeVoice","code":"ArrayBuffer"},{"type":"text","text":" when it materializes the credential."}],"type":"paragraph"},{"level":2,"text":"Returning the Response to JavaScript","type":"heading","anchor":"Returning-the-Response-to-JavaScript"},{"inlineContent":[{"type":"text","text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:"}],"type":"paragraph"},{"type":"codeListing","code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"JavaScript decodes the JSON and rebuilds a "},{"type":"codeVoice","code":"PublicKeyCredential"},{"type":"text","text":"-shaped object — converting the base64url binary fields back to "},{"type":"codeVoice","code":"ArrayBuffer"},{"text":"s and wiring up ","type":"text"},{"type":"codeVoice","code":"getClientExtensionResults"},{"type":"text","text":", "},{"type":"codeVoice","code":"getAuthenticatorData"},{"type":"text","text":", "},{"type":"codeVoice","code":"getPublicKey"},{"type":"text","text":", "},{"type":"codeVoice","code":"toJSON"},{"type":"text","text":", and the rest. Errors travel through a parallel "},{"type":"codeVoice","code":"__webauthn_error__"},{"type":"text","text":" channel and surface to the page as a "},{"type":"codeVoice","code":"DOMException"},{"type":"text","text":" with name "},{"type":"codeVoice","code":"NotAllowedError"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"The FidoUI Module","type":"heading","anchor":"The-FidoUI-Module"},{"inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" is a "},{"code":"@MainActor","type":"codeVoice"},{"text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting ","type":"text"},{"code":"navigator.credentials.*","type":"codeVoice"},{"text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Transport selection."}]},{"type":"text","text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ceremony serialization."}]},{"type":"text","text":" Concurrent calls on the same "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Cancellation."}],"type":"strong"},{"type":"text","text":" A single "},{"code":"cancel()","type":"codeVoice"},{"type":"text","text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The host code only needs to construct one "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" instance and call "},{"type":"codeVoice","code":"makeCredential"},{"text":" \/ ","type":"text"},{"code":"getAssertion","type":"codeVoice"},{"text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See ","type":"text"},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/","type":"codeVoice"},{"text":" for the full source.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Platform Notes","type":"heading","anchor":"Platform-Notes"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS."}]},{"type":"text","text":" The wired path goes through CryptoTokenKit ("},{"code":"WiredSmartCardConnection","type":"codeVoice"},{"type":"text","text":" — USB-C or Lightning), and the NFC path through "},{"code":"NFCSmartCardConnection","type":"codeVoice"},{"type":"text","text":". The sample’s "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"NFCReaderUsageDescription"},{"type":"text","text":" and lists the FIDO applet AID ("},{"type":"codeVoice","code":"A0000006472F0001"},{"type":"text","text":") under "},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers"},{"type":"text","text":"; the entitlements turn on "},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.formats"},{"type":"text","text":" ("},{"type":"codeVoice","code":"TAG"},{"type":"text","text":") and "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" uses "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" and "},{"code":"com.apple.security.device.usb","type":"codeVoice"},{"type":"text","text":" so the same target builds cleanly for both platforms."}]}]}],"type":"unorderedList"},{"level":2,"text":"Where to Customize","type":"heading","anchor":"Where-to-Customize"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Which requests get intercepted."}]},{"type":"text","text":" Edit "},{"type":"codeVoice","code":"shouldIntercept"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" to scope by hint, RP ID, or any other heuristic."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Origin verification."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" builds a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin"},{"type":"text","text":" from "},{"type":"codeVoice","code":"window.location.origin"},{"type":"text","text":". Replace the "},{"type":"codeVoice","code":"isPublicSuffix"},{"type":"text","text":" closure passed to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" with a real public-suffix-list check before shipping."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"UI."}]},{"type":"text","text":" Swap or restyle the panels in "},{"type":"codeVoice","code":"FidoUI\/Sources\/FidoUI\/Views\/"},{"type":"text","text":" — the rest of the module is UI-agnostic."}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/yubikit\/webauthninterceptorsamplecode"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"abstract":[{"type":"text","text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts "},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"type":"text","text":" calls ins
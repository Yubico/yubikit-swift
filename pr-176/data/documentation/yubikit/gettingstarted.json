{"kind":"article","seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"title":"Preparing your project","anchor":"Preparing-your-project"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/gettingstarted"]}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The YubiKit framework is distributed using the Swift Package Manager. To add the framework to your project follow these steps:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Select your project."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Choose the “Package Dependencies” tab."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Press the plus-button to bring up the add package dialog."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"identifier":"add-framework-1.png","type":"image"}]},{"type":"orderedList","start":4,"items":[{"content":[{"inlineContent":[{"type":"text","text":"Enter "},{"type":"codeVoice","code":"https:\/\/github.com\/Yubico\/yubikit-swift\/"},{"type":"text","text":" in the search field and select the Yubico Swift Package."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Press the “Add Package” button to add the SDK to your project."}]}]}]},{"type":"paragraph","inlineContent":[{"identifier":"add-framework-2.png","type":"image"}]},{"level":3,"anchor":"NFC","type":"heading","text":"NFC"},{"type":"paragraph","inlineContent":[{"text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC","type":"text"},{"text":" ","type":"text"},{"text":"application identifiers and a NFC Privacy statement to the application.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Add Wireless entitlement"}],"type":"strong"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your project."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your application target."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the “Signing & Capabilities” tab.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Click the “+”-button to add a new capability."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select the “Near Field Communication Tag” capability."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-entitlement.png"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Add list of NFC application identifiers"}]}]},{"type":"orderedList","start":6,"items":[{"content":[{"inlineContent":[{"type":"text","text":"Choose the “Info” tab."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-identifiers.png"}]},{"type":"orderedList","start":8,"items":[{"content":[{"inlineContent":[{"type":"text","text":"Add the Yubico NFC application identifiers to enable communication with the different"},{"type":"text","text":" "},{"type":"text","text":"applications on the YubiKey."}],"type":"paragraph"}]}]},{"syntax":null,"type":"codeListing","code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-identifiers-list.png"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Add a NFC Privacy description"}]}]},{"type":"orderedList","start":9,"items":[{"content":[{"inlineContent":[{"type":"text","text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in"},{"type":"text","text":" "},{"type":"text","text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-privacy.png"}]},{"level":3,"anchor":"SmartCardUSB","type":"heading","text":"SmartCard\/USB"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" entitlement to your application."}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Select the application entitlements file."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" entitlement to the entitlement list."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"smart-card.png"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"USB SmartCard supports Yubico OTP slot programming. HMAC-SHA1 challenge-response requires"},{"type":"text","text":" "},{"type":"codeVoice","code":"HIDOTPConnection"},{"type":"text","text":" on macOS, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LightningSmartCardConnection"},{"type":"text","text":", or NFC without a touch requirement."},{"type":"text","text":" "},{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session"},{"type":"text","text":"."}]}],"type":"aside","style":"note","name":"Note"},{"level":3,"anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey","type":"heading","text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the "},{"type":"codeVoice","code":"com.yubico.ylp"},{"type":"text","text":" string to the list of External Accessories."}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Select your project."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select your application target."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Choose the “Info” tab."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If not present add the "},{"code":"Supported external accessory protocols","type":"codeVoice"},{"type":"text","text":" key and insert the string "},{"code":"com.yubico.ylp","type":"codeVoice"},{"type":"text","text":" in its list."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"identifier":"external-accessory.png","type":"image"}]},{"content":[{"inlineContent":[{"type":"text","text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for "},{"type":"codeVoice","code":"Supported external accessory protocols"},{"type":"text","text":" to "},{"type":"codeVoice","code":"com.yubico.ylp"},{"type":"text","text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"level":2,"anchor":"Making-Your-First-Connection","type":"heading","text":"Making Your First Connection"},{"inlineContent":[{"type":"text","text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device."}],"type":"paragraph"},{"text":"Understanding Connection Types","anchor":"Understanding-Connection-Types","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"YubiKit provides the following connection methods:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"NFC","type":"text"}]},{"type":"text","text":": Short-range wireless communication (iOS only)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"USB"}]},{"type":"text","text":": Direct USB connection via SmartCard interface"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Lightning","type":"text"}],"type":"strong"},{"text":": YubiKey 5Ci connected to Lightning port (iOS only)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"USB HID","type":"text"}],"type":"strong"},{"text":": Direct access to the FIDO or OTP interface (macOS only)","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Each connection type works differently, so let’s explore how to use them."}],"type":"paragraph"},{"level":3,"anchor":"NFC-Connections","text":"NFC Connections","type":"heading"},{"inlineContent":[{"type":"text","text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:"}],"type":"paragraph"},{"syntax":"swift","code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete."}],"type":"paragraph"},{"level":3,"anchor":"USB-and-Lightning-Connections","text":"USB and Lightning Connections","type":"heading"},{"inlineContent":[{"type":"text","text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:"}],"type":"paragraph"},{"syntax":"swift","code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"WiredSmartCardConnection.makeConnection()","type":"codeVoice"},{"type":"text","text":" method automatically detects whether you’re using USB or Lightning."}]},{"level":3,"type":"heading","anchor":"Specific-Connection-Types","text":"Specific Connection Types"},{"type":"paragraph","inlineContent":[{"text":"For more control, you can connect to specific interfaces:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS, use "},{"type":"codeVoice","code":"HIDOTPConnection"},{"type":"text","text":" for the OTP keyboard interface or "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the FIDO interface:"}]},{"type":"codeListing","syntax":"swift","code":["let otpConnection = try await HIDOTPConnection()"]},{"level":2,"type":"heading","anchor":"Understanding-Connection-Lifecycle","text":"Understanding Connection Lifecycle"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Critical:","type":"text"}]},{"type":"text","text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time."}]},{"text":"Connection Behavior","anchor":"Connection-Behavior","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Exclusive access"}],"type":"strong"},{"text":": Only one connection can exist per YubiKey at any time","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Manual closure required","type":"text"}]},{"text":": Dropping a connection reference does NOT automatically close it - you must call ","type":"text"},{"code":"close()","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Resource blocking","type":"text"}],"type":"strong"},{"text":": An unclosed connection prevents new connections (throws ","type":"text"},{"code":"SmartCardConnectionError.busy","type":"codeVoice"},{"text":")","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call "},{"type":"codeVoice","code":"close()"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Working with Sessions","anchor":"Working-with-Sessions","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Once you have a connection, create sessions to access different YubiKey applications:"}],"type":"paragraph"},{"text":"OATH Session (TOTP\/HOTP codes)","anchor":"OATH-Session-TOTPHOTP-codes","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"]},{"text":"Yubico OTP Session (OTP slots)","anchor":"Yubico-OTP-Session-OTP-slots","type":"heading","level":3},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session"},{"type":"text","text":" manages the two OTP slots. Create it with a "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","type":"reference"},{"type":"text","text":" or,"},{"type":"text","text":" "},{"type":"text","text":"on macOS, an "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OTPConnection","type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let session = try await YubiOTP.Session.makeSession(connection: connection)","let state = await session.configState","print(\"Slot 2 configured: \\(try state.isConfigured(.two))\")","","\/\/ Program slot 2 for HOTP, replacing its existing configuration","try await session.putConfiguration(.hotp(key: secret), in: .two)"]},{"inlineContent":[{"type":"text","text":"See "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","type":"reference"},{"type":"text","text":" for HMAC-SHA1 challenge-response, transport support, and NFC output."}],"type":"paragraph"},{"text":"PIV Session (Certificates and keys)","anchor":"PIV-Session-Certificates-and-keys","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"]},{"text":"Management Session (Device information)","anchor":"Management-Session-Device-information","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"]},{"text":"WebAuthn Client (FIDO2 \/ passkeys)","anchor":"WebAuthn-Client-FIDO2--passkeys","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"For passkey registration and authentication, "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" wraps a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"type":"text","text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" (USB HID on macOS) or any "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","isActive":true},{"type":"text","text":" "},{"type":"text","text":"(NFC \/ USB CCID)."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"]},{"inlineContent":[{"type":"text","text":"PIN and UV are supplied per ceremony via "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","isActive":true},{"type":"text","text":". For raw"},{"type":"text","text":" "},{"type":"text","text":"CTAP2 access (credential management, bio enrollment, large blobs), use"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"type":"text","text":" directly."}],"type":"paragraph"},{"text":"Connection Management Patterns","anchor":"Connection-Management-Patterns","type":"heading","level":2},{"text":"For UI Applications","anchor":"For-UI-Applications","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","isActive":true},{"type":"text","text":" for complete examples of reactive connection management patterns that automatically update your UI when YubiKeys are plugged in or removed."}],"type":"paragraph"},{"text":"For Command-Line Tools","anchor":"For-Command-Line-Tools","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"CLI applications often use a simpler approach with a single connection per operation. See "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","isActive":true},{"type":"text","text":" for examples of how command-line tools handle connections for one-time operations."}],"type":"paragraph"},{"text":"Next Steps","anchor":"Next-Steps","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Now you’re ready to build YubiKey applications! Check out the sample projects to see complete implementations:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"OATHSample","type":"text"}],"type":"strong"},{"text":": Shows how to build a TOTP authenticator app with SwiftUI","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"PIVTool","type":"text"}],"type":"strong"},{"text":": Demonstrates PIV operations for certificates and digital signatures","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"WebAuthnInterceptorSample","type":"text"}],"type":"strong"},{"text":": Routes WebAuthn calls from a ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" through ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":" to a YubiKey","type":"text"}]}]}],"type":"unorderedList"},{"text":"Build SDK documentation","anchor":"Build-SDK-documentation","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"You can also build the complete SDK documentation by selecting “Product” -> “Build Documentation” in Xcode. This gives you access to the full YubiKit API reference."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select an iOS target to include NFC and Lightning connections, or a macOS target to include"},{"type":"text","text":" "},{"type":"text","text":"USB HID connections."}]}],"type":"aside","name":"Note","style":"note"}],"kind":"content"}],"abstract":[{"type":"text","text":"Prepare your project to connect to the YubiKey via NFC, SmartCard, Lightning and USB HID."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted"},"metadata":{"title":"Getting Started","modules":[{"name":"YubiKit"}],"roleHeading":"Article","role":"article"},"references":{"nfc-identifiers-list.png":{"identifier":"nfc-identifiers-list.png","type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing the list of nfc identifiers added."},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logs":{"title":"Logs","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Logs"}],"navigatorTitle":[{"kind":"identifier","text":"Logs"}],"url":"\/documentation\/yubikit\/logs","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs","abstract":[{"text":"Configures logging for YubiKit connections and sessions.","type":"text"}],"type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authorization":{"title":"WebAuthn.Authorization","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Authorization","kind":"identifier"}],"navigatorTitle":[{"t
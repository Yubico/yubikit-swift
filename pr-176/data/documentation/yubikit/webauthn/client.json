entation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","type":"reference"},{"text":". The status stream reports ceremony","type":"text"},{"text":" ","type":"text"},{"text":"progress (","type":"text"},{"type":"codeVoice","code":".processing"},{"text":", ","type":"text"},{"type":"codeVoice","code":".waitingForUser"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".waitingForUserVerification"},{"text":", ","type":"text"},{"type":"codeVoice","code":".finished"},{"text":") only.","type":"text"}]},{"code":["let session = try await CTAP2.Session.makeSession(connection: connection)","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","\/\/ Trivial — pre-supplied PIN:","let response = try await client.makeCredential(options, authorization: .pin(\"1234\")).value","","\/\/ Custom — bridge into a UI:","let auth = WebAuthn.Authorization(providePIN: {","    guard let pin = await viewModel.askForPIN() else { return .cancel }","    return .pin(pin)","})","for try await status in await client.makeCredential(options, authorization: auth) {","    switch status {","    case .processing: showSpinner()","    case .waitingForUser(let cancel):","        showTouchPrompt(onCancel: { Task { await cancel() } })","    case .waitingForUserVerification(let cancel, let fallbackToPIN):","        showBiometricPrompt(","            onCancel: { Task { await cancel() } },","            onFallbackToPIN: fallbackToPIN.map { fallback in { Task { await fallback() } } }","        )","    case .finished(let response): return response","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"PIN attempts are one-shot: a wrong PIN throws"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/pinRejected(retriesRemaining:source:)","type":"reference"},{"text":" and the caller","type":"text"},{"text":" ","type":"text"},{"text":"decides whether to re-prompt and retry with a fresh ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Returning "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/PINReply\/cancel","isActive":true},{"type":"text","text":" from "},{"type":"codeVoice","code":"providePIN"},{"type":"text","text":" aborts"},{"type":"text","text":" "},{"type":"text","text":"the ceremony with "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/cancelled(source:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"code":"Client","type":"codeVoice"},{"text":" is a high-level passkey client that runs WebAuthn ceremonies against a YubiKey.","type":"text"}]},{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"Client","type":"codeVoice"},{"text":" is the entry point for WebAuthn in this SDK. It wraps a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference"},{"text":" ","type":"text"},{"text":"and translates W3C WebAuthn requests into CTAP2 protocol exchanges — building the","type":"text"},{"text":" ","type":"text"},{"code":"clientDataJSON","type":"codeVoice"},{"text":", validating the relying-party identifier against the configured","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin"},{"text":", selecting between PIN and built-in user verification, and","type":"text"},{"text":" ","type":"text"},{"text":"processing extensions before the request reaches the authenticator.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"Client","type":"codeVoice"},{"text":" for any app that runs passkey ceremonies. Reach for ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"directly only when you need lower-level access — raw ","type":"text"},{"type":"codeVoice","code":"makeCredential"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"getAssertion"},{"text":", credential management, or bio enrollment.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"Client","type":"codeVoice"},{"text":" is an actor; a client’s lifetime is bound to the underlying ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The constructor takes four parameters that shape every ceremony:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"origin"},{"text":" — the secure origin the client is bound to. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference"},{"text":" enforces","type":"text"},{"text":" ","type":"text"},{"text":"the W3C secure-context rule; the client refuses to sign for relying parties whose","type":"text"},{"text":" ","type":"text"},{"text":"identifier doesn’t match.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"isPublicSuffix"},{"type":"text","text":" — a closure into a Public Suffix List, used to validate that"},{"type":"text","text":" "},{"type":"text","text":"the relying-party identifier is a registrable suffix of the origin’s effective"},{"type":"text","text":" "},{"type":"text","text":"domain."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"enterpriseRpIds"},{"type":"text","text":" — relying-party identifiers allowed to receive"},{"type":"text","text":" "},{"type":"text","text":"platform-managed enterprise attestation. When the request specifies"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/AttestationPreference\/enterprise"},{"type":"text","text":", the client escalates to level 2"},{"type":"text","text":" "},{"type":"text","text":"(platform-managed) for RPs in this set, and uses level 1 (vendor-facilitated)"},{"type":"text","text":" "},{"type":"text","text":"otherwise."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"allowedExtensions","type":"codeVoice"},{"text":" — the set of WebAuthn extensions the client will process.","type":"text"},{"text":" ","type":"text"},{"text":"Anything the relying party requests outside this set is dropped before reaching","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the authenticator. Defaults to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension"},{"text":"’s standard set.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"PIN and user verification are supplied per ceremony via "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"out-of-band from the ceremony stream. Both ceremony methods return a"},{"type":"te
{"abstract":[{"type":"text","text":"Choose YubiKit’s log level and backend with "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)","type":"reference"},{"type":"text","text":"."}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/loggingguide"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide"},"sections":[],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"YubiKit"}],"title":"Logging"},"seeAlsoSections":[{"generated":true,"title":"Preparing your project","anchor":"Preparing-your-project","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"No setup is required. YubiKit defaults to "},{"type":"codeVoice","code":"debug"},{"type":"text","text":" on stdout when compiled with "},{"type":"codeVoice","code":"DEBUG"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"info","type":"codeVoice"},{"text":" on stderr otherwise. You can override either default:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","YubiKit.Logs.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","YubiKit.Logs.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","YubiKit.Logs.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","YubiKit.Logs.configure()"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Add "},{"identifier":"https:\/\/github.com\/apple\/swift-log","type":"reference","isActive":true},{"type":"text","text":"’s "},{"code":"Logging","type":"codeVoice"},{"type":"text","text":" product to your app target"},{"type":"text","text":" "},{"type":"text","text":"to use its backend types. Any SwiftLog "},{"code":"LogHandler","type":"codeVoice"},{"type":"text","text":" can be supplied by the factory."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;"},{"text":" ","type":"text"},{"text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,","type":"text"},{"text":" ","type":"text"},{"text":"though logs already in progress may use the previous settings.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,","type":"text"},{"text":" ","type":"text"},{"text":"pass its factory explicitly; global ","type":"text"},{"code":"LoggingSystem.bootstrap","type":"codeVoice"},{"text":" does not select YubiKit’s backend.","type":"text"},{"text":" ","type":"text"},{"text":"Factories may run concurrently and must not log through YubiKit themselves.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Traffic logging","type":"heading","anchor":"Traffic-logging"},{"syntax":"swift","type":"codeListing","code":["YubiKit.Logs.configure(logLevel: .trace)"]},{"inlineContent":[{"type":"text","text":"Raw traffic and SCP plaintext logs require "},{"inlineContent":[{"text":"YubiKit to be compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"}],"type":"strong"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Neither configuration nor a custom backend can enable them in other builds."},{"type":"text","text":" "},{"type":"text","text":"Custom connections are responsible for their own traffic logging."}],"type":"paragraph"},{"n
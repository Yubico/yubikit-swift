{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide"},"kind":"article","metadata":{"modules":[{"name":"YubiKit"}],"role":"article","roleHeading":"Article","title":"Logging"},"variants":[{"paths":["\/documentation\/yubikit\/loggingguide"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"Choose YubiKit’s log level and backend with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)"},{"type":"text","text":"."}],"seeAlsoSections":[{"anchor":"Preparing-your-project","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"generated":true,"title":"Preparing your project"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"No setup is required. YubiKit defaults to ","type":"text"},{"code":"debug","type":"codeVoice"},{"text":" on stdout when compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"info","type":"codeVoice"},{"text":" on stderr otherwise. You can override either default:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","YubiKit.Logs.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","YubiKit.Logs.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","YubiKit.Logs.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","YubiKit.Logs.configure()"],"syntax":"swift"},{"inlineContent":[{"text":"Add ","type":"text"},{"identifier":"https:\/\/github.com\/apple\/swift-log","isActive":true,"type":"reference"},{"text":"’s ","type":"text"},{"code":"Logging","type":"codeVoice"},{"text":" product to your app target","type":"text"},{"text":" ","type":"text"},{"text":"to use its backend types. Any SwiftLog ","type":"text"},{"code":"LogHandler","type":"codeVoice"},{"text":" can be supplied by the factory.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;","type":"text"},{"text":" ","type":"text"},{"text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,","type":"text"},{"text":" ","type":"text"},{"text":"though logs already in progress may use the previous settings.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,","type":"text"},{"text":" ","type":"text"},{"text":"pass its factory explicitly; global ","type":"text"},{"code":"LoggingSystem.bootstrap","type":"codeVoice"},{"text":" does not select YubiKit’s backend.","type":"text"},{"text":" ","type":"text"},{"text":"Factories may run concurrently and must not log through YubiKit themselves.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Traffic logging","anchor":"Traffic-logging"},{"type":"codeListing","code":["YubiKit.Logs.configure(logLevel: .trace)"],"syntax":"swift"},{"inlineContent":[{"text":"Raw traffic and SCP plaintext logs require ","type":"text"},{"inlineContent":[{"text":"YubiKit to be compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"}],"type":"strong"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Neither configuration nor a custom backend can enable them in other builds.","type":"text"},{"text":" ","type":"text"},{"text":"Custom connections are responsible for their own traffic logging.","type":"text"}],"type":"paragraph"},{"name":"Warning","style":"warning","type":"aside","content":[{"inlineContent":[{"text":"Debug logs can include account names and credential identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Trace logs can include PINs, credentials, and cryptographic keys. Protect or redact logs before sharing them.","type":"text"}],"type":"paragraph"}]},{"level":3,"type":"heading","text":"Custom backends","anchor":"Custom-backends"},{"inlineContent":[{"type":"text","text":"Labels identify categories, such as "},{"type":"codeVoice","code":"com.yubico.YubiKit.OATH"},{"type":"text","text":" or "},{"type":"codeVoice","code":"com.yubico.YubiKit.FIDO"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Metadata carries details such as byte counts and error codes; the default backend displays","type":"text"},{"text":" ","type":"text"},{"text":"these as ","type":"text"},{"code":"key=value","type":"codeVoice"},{"text":" pairs. Message wording and metadata keys are not a stable API.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"references":{"https://github.com/apple/swift-log":{"titleInlineContent":[{"text":"SwiftLog","type":"text"}],"type":"link","url":"https:\/\/github.com\/apple\/swift-log","identifier":"https:\/\/github.com\/apple\/swift-log","title":"SwiftLog"},"documentation-header.png":{"identifier":"documentation-header.png","alt":"YubiKeys in a row","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","kind":"symbol","images":[{"identifier":"documentation-header.png","type":"i
{"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The YubiKit framework is distributed using the Swift Package Manager. To add the framework to your project follow these steps:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Select your project.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Choose the “Package Dependencies” tab.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Press the plus-button to bring up the add package dialog.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"identifier":"add-framework-1.png","type":"image"}]},{"items":[{"content":[{"inlineContent":[{"text":"Enter ","type":"text"},{"code":"https:\/\/github.com\/Yubico\/yubikit-swift\/","type":"codeVoice"},{"text":" in the search field and select the Yubico Swift Package.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Press the “Add Package” button to add the SDK to your project.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList","start":4},{"type":"paragraph","inlineContent":[{"identifier":"add-framework-2.png","type":"image"}]},{"anchor":"NFC","type":"heading","level":3,"text":"NFC"},{"type":"paragraph","inlineContent":[{"text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC","type":"text"},{"text":" ","type":"text"},{"text":"application identifiers and a NFC Privacy statement to the application.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Add Wireless entitlement"}],"type":"strong"}]},{"items":[{"content":[{"inlineContent":[{"text":"Select your project.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select your application target.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Choose the “Signing & Capabilities” tab.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Click the “+”-button to add a new capability.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select the “Near Field Communication Tag” capability.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"identifier":"nfc-entitlement.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Add list of NFC application identifiers"}],"type":"strong"}]},{"items":[{"content":[{"inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList","start":6},{"type":"paragraph","inlineContent":[{"identifier":"nfc-identifiers.png","type":"image"}]},{"items":[{"content":[{"inlineContent":[{"text":"Add the Yubico NFC application identifiers to enable communication with the different","type":"text"},{"text":" ","type":"text"},{"text":"applications on the YubiKey.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList","start":8},{"type":"codeListing","syntax":null,"code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"]},{"type":"paragraph","inlineContent":[{"identifier":"nfc-identifiers-list.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Add a NFC Privacy description"}],"type":"strong"}]},{"items":[{"content":[{"inlineContent":[{"text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in","type":"text"},{"text":" ","type":"text"},{"text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”","type":"text"}],"type":"paragraph"}]}],"type":"orderedList","start":9},{"type":"paragraph","inlineContent":[{"identifier":"nfc-privacy.png","type":"image"}]},{"anchor":"SmartCardUSB","type":"heading","level":3,"text":"SmartCard\/USB"},{"type":"paragraph","inlineContent":[{"text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"text":" entitlement to your application.","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Select the application entitlements file.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":" entitlement to the entitlement list.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"identifier":"smart-card.png","type":"image"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"The SmartCard\/USB connection only support the CCID based applications on the YubiKey and does not support U2F, FIDO2 or OTP."}],"type":"paragraph"}]},{"anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey","type":"heading","level":3,"text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey"},{"type":"paragraph","inlineContent":[{"text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the ","type":"text"},{"type":"codeVoice","code":"com.yubico.ylp"},{"text":" string to the list of External Accessories.","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Select your project.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select your application target.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Choose the “Info” tab.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If not present add the ","type":"text"},{"code":"Supported external accessory protocols","type":"codeVoice"},{"text":" key and insert the string ","type":"text"},{"code":"com.yubico.ylp","type":"codeVoice"},{"text":" in its list.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"identifier":"external-accessory.png","type":"image"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for "},{"type":"codeVoice","code":"Supported external accessory protocols"},{"type":"text","text":" to "},{"type":"codeVoice","code":"com.yubico.ylp"},{"type":"text","text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework."}],"type":"paragraph"}]},{"anchor":"Making-Your-First-Connection","type":"heading","level":2,"text":"Making Your First Connection"},{"type":"paragraph","inlineContent":[{"text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device.","type":"text"}]},{"anchor":"Understanding-Connection-Types","type":"heading","level":3,"text":"Understanding Connection Types"},{"type":"paragraph","inlineContent":[{"text":"YubiKit handles three different connection methods:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"NFC"}],"type":"strong"},{"text":": Short-range wireless communication (iOS only)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"USB"}],"type":"strong"},{"text":": Direct USB connection via SmartCard interface","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Lightning"}],"type":"strong"},{"text":": YubiKey 5Ci connected to Lightning port (iOS only)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Each connection type works differently, so let’s explore how to use them.","type":"text"}]},{"anchor":"NFC-Connections","type":"heading","level":3,"text":"NFC Connections"},{"type":"paragraph","inlineContent":[{"text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"]},{"type":"paragraph","inlineContent":[{"text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete.","type":"text"}]},{"anchor":"USB-and-Lightning-Connections","type":"heading","level":3,"text":"USB and Lightning Connections"},{"type":"paragraph","inlineContent":[{"text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"WiredSmartCardConnection.makeConnection()"},{"text":" method automatically detects whether you’re using USB or Lightning.","type":"text"}]},{"anchor":"Specific-Connection-Types","type":"heading","level":3,"text":"Specific Connection Types"},{"type":"paragraph","inlineContent":[{"text":"For more control, you can connect to specific interfaces:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"]},{"anchor":"Understanding-Connection-Lifecycle","type":"heading","level":2,"text":"Understanding Connection Lifecycle"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Critical:"}],"type":"strong"},{"text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time.","type":"text"}]},{"anchor":"Connection-Behavior","type":"heading","level":3,"text":"Connection Behavior"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Exclusive access"}],"type":"strong"},{"text":": Only one connection can exist per YubiKey at any time","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Manual closure required"}],"type":"strong"},{"text":": Dropping a connection reference does NOT automatically close it - you must call ","type":"text"},{"code":"close()","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Resource blocking"}],"type":"strong"},{"text":": An unclosed connection prevents new connections (throws ","type":"text"},{"code":"SmartCardConnectionError.busy","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call ","type":"text"},{"type":"codeVoice","code":"close()"},{"text":".","type":"text"}]},{"anchor":"Working-with-Sessions","type":"heading","level":2,"text":"Working with Sessions"},{"type":"paragraph","inlineContent":[{"text":"Once you have a connection, create sessions to access different YubiKey applications:","type":"text"}]},{"anchor":"OATH-Session-TOTPHOTP-codes","type":"heading","level":3,"text":"OATH Session (TOTP\/HOTP codes)"},{"type":"codeListing","syntax":"swift","code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"]},{"anchor":"PIV-Session-Certificates-and-keys","type":"heading","level":3,"text":"PIV Session (Certificates and keys)"},{"type":"codeListing","syntax":"swift","code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"]},{"anchor":"Management-Session-Device-information","type":"heading","level":3,"text":"Management Session (Device information)"},{"type":"codeListing","syntax":"swift","code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"]},{"anchor":"WebAuthn-Client-FIDO2--passkeys","type":"heading","level":3,"text":"WebAuthn Client (FIDO2 \/ passkeys)"},{"type":"paragraph","inlineContent":[{"text":"For passkey registration and authentication, ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":" wraps a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true,"type":"reference"},{"text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"type":"codeVoice","code":"HIDFIDOConnection"},{"text":" (USB HID on macOS) or any ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"(NFC \/ USB CCID).","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"]},{"type":"paragraph","inlineContent":[{"text":"PIN and UV are supplied per ceremony via ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","isActive":true,"type":"reference"},{"text":". For raw","type":"text"},{"text":" ","type":"text"},{"text":"CTAP2 access (credential management, bio enrollment, large blobs), use","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true,"type":"reference"},{"text":" directly.","type":"text"}]},{"anchor":"Connection-Management-Patterns","type":"heading","level":2,"text":"Connection Management Patterns"},{"anchor":"For-UI-Applications","type":"heading","level":3,"text":"For UI Applications"},{"type":"paragraph","inlineContent":[{"text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","isActive":true,"type":"reference"},{"text":" for complete examples of reactive connection management patterns that automatically update your UI when YubiKeys are plugged in or removed.","type":"text"}]},{"anchor":"For-Command-Line-Tools","type":"heading","level":3,"text":"For Command-Line Tools"},{"type":"paragraph","inlineContent":[{"text":"CLI applications often use a simpler approach with a single connection per operation. See ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","isActive":true,"type":"reference"},{"text":" for examples of how command-line tools handle connections for one-time operations.","type":"text"}]},{"anchor":"Next-Steps","type":"heading","level":2,"text":"Next Steps"},{"type":"paragraph","inlineContent":[{"text":"Now you’re ready to build YubiKey applications! Check out the sample projects to see complete implementations:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"OATHSample"}],"type":"strong"},{"text":": Shows how to build a TOTP authenticator app with SwiftUI","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"PIVTool"}],"type":"strong"},{"text":": Demonstrates PIV operations for certificates and digital signatures","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"WebAuthnInterceptorSample"}],"type":"strong"},{"text":": Routes WebAuthn calls from a ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":" to a YubiKey","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Build-SDK-documentation","type":"heading","level":3,"text":"Build SDK documentation"},{"type":"paragraph","inlineContent":[{"text":"You can also build the complete SDK documentation by selecting “Product” -> “Build Documentation” in Xcode. This gives you access to the full YubiKit API reference.","type":"text"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"Select an iOS target when building documentation to include all connection types."}],"type":"paragraph"}]}]}],"metadata":{"title":"Getting Started","roleHeading":"Article","modules":[{"name":"YubiKit"}],"role":"article"},"sections":[],"abstract":[{"type":"text","text":"Prepare your project to connect to the YubiKey via NFC, SmartCard and Lightning."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/gett
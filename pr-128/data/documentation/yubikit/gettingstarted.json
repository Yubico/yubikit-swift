ation on the YubiKey."}],"type":"topic"},"nfc-privacy.png":{"variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy~dark@2x.png"}],"type":"image","alt":"An image showing how to add the NFC privacy string to a project.","identifier":"nfc-privacy.png"},"nfc-identifiers-list.png":{"variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list~dark@2x.png"}],"type":"image","alt":"An image showing the list of nfc identifiers added.","identifier":"nfc-identifiers-list.png"},"smart-card.png":{"variants":[{"url":"\/images\/yubikit-swift.YubiKit\/smart-card@2x.png","traits":["2x","light"]},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/smart-card~dark@2x.png"}],"type":"image","alt":"An image showing how to add NFC privacy string to project.","identifier":"smart-card.png"},"add-framework-1.png":{"type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1~dark@2x.png"}],"identifier":"add-framework-1.png","alt":"An image showing how to add the YubiKit SDK to your Xcode project."},"nfc-identifiers.png":{"type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers~dark@2x.png","traits":["2x","dark"]}],"identifier":"nfc-identifiers.png","alt":"An image showing how to add the nfc application identifiers."},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Session","kind":"identifier"}],"title":"Management.Session","abstract":[{"type":"text","text":"An interfa
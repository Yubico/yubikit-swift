ramework-1@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1~dark@2x.png"}],"alt":"An image showing how to add the YubiKit SDK to your Xcode project.","type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSampleCode":{"kind":"article","type":"topic","url":"\/documentation\/yubikit\/oathsamplecode","role":"sampleCode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","abstract":[{"text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession"},{"text":" to retrieve authentication codes, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},{"text":" to get device information.","type":"text"}],"title":"OATHSample: Basic OATH app showcasing how to integrate the SDK"},"nfc-entitlement.png":{"identifier":"nfc-entitlement.png","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement~dark@2x.png"}],"alt":"An image showing how to add wireless entitlements to project.","type":"image"},"nfc-identifiers-list.png":{"identifier":"nfc-identifiers-list.png","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list~dark@2x.png"}],"alt":"An image showing the list of nfc identifiers added.","type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authorization":{"title":"WebAuthn.Authorization","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Authorization"}],"url":"\/documentation\/yubikit\/webauthn\/authorization","abstract":[{"text":"PIN\/UV policy for a single WebAuthn ceremony.","type":"text"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Authorization"}],"type":"topic","kind":"symbol"},"documentation-header.png":{"identifier":"documentation-header.png","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png"}],"alt":"YubiKeys in a row","type":"image"},"external-accessory.png":{"identifier":"external-accessory.png","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/external-accessory@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/external-accessory~dark@2x.png"}],"alt":"An image showing how to support for lightning YubiKeys.","type":"image"}}}
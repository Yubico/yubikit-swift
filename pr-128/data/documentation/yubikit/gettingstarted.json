identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"topic","role":"symbol","kind":"symbol"},"smart-card.png":{"alt":"An image showing how to add NFC privacy string to project.","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/smart-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/smart-card~dark@2x.png"}],"type":"image","identifier":"smart-card.png"},"external-accessory.png":{"alt":"An image showing how to support for lightning YubiKeys.","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/external-accessory@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/external-accessory~dark@2x.png"}],"type":"image","identifier":"external-accessory.png"},"add-framework-1.png":{"alt":"An image showing how to add the YubiKit SDK to your Xcode project.","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1~dark@2x.png"}],"type":"image","identifier":"add-framework-1.png"},"nfc-identifiers.png":{"alt":"An image showing how to add the nfc application identifiers.","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers~dark@2x.png"}],"type":"image","identifier":"nfc-identifiers.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"title":"PIVSession","navigatorTitle":[{"text":"PIVSession","kind":"identifier"}],"url":"\/documentation\/yubikit\/pivsession","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}],"abstract":[{"text":"An interface to the PIV application on the YubiKey.","type":"text"}],"type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","role":"symbol","kind":"sy
CardConnection","kind":"identifier"}],"abstract":[{"type":"text","text":"An interface defining a SmartCard based connection to a YubiKey."}],"type":"topic","role":"symbol","title":"SmartCardConnection","kind":"symbol","url":"\/documentation\/yubikit\/smartcardconnection"},"nfc-identifiers-list.png":{"type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list~dark@2x.png","traits":["2x","dark"]}],"identifier":"nfc-identifiers-list.png","alt":"An image showing the list of nfc identifiers added."},"nfc-privacy.png":{"type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy~dark@2x.png","traits":["2x","dark"]}],"identifier":"nfc-privacy.png","alt":"An image showing how to add the NFC privacy string to a project."},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","title":"PIVSession","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"PIVSession","kind":"identifier"}],"type":"topic","url":"\/documentation\/yubikit\/pivsession","abstract":[{"text":"An interface to the PIV application on the YubiKey.","type":"text"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}]},"documentation-header.png":{"type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}],"identifier":"documentation-header.png","alt":"YubiKeys in a row"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Session"}],"identifier":"doc:
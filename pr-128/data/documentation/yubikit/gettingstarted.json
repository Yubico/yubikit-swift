YubiKit/documentation/YubiKit/SmartCardConnection":{"abstract":[{"text":"An interface defining a SmartCard based connection to a YubiKey.","type":"text"}],"url":"\/documentation\/yubikit\/smartcardconnection","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","navigatorTitle":[{"kind":"identifier","text":"SmartCardConnection"}],"type":"topic","kind":"symbol","role":"symbol","title":"SmartCardConnection","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SmartCardConnection"}]},"external-accessory.png":{"type":"image","identifier":"external-accessory.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to support for lightning YubiKeys."},"nfc-entitlement.png":{"type":"image","identifier":"nfc-entitlement.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to add wireless entitlements to project."},"nfc-privacy.png":{"type":"image","identifier":"nfc-privacy.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to add the NFC privacy string to a project."},"nfc-identifiers-list.png":{"type":"image","identifier":"nfc-identifiers-list.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing the list of nfc identifiers added."},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"type":"topic","kind":"symbol","title":"WebAuthn.Client","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"role":"symbol","url":"\/documentation\/yubikit\/webauthn\/client","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"navigatorTitle":[{"kind":"identifier","text":"Client"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"kind":"symbol","title":"Management.Session","type":"topic","role":"symbol","abstract":[{"type":"text","text":"An interface to the Management application on the YubiKey."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","url":"\/documentation\/yubikit\/management\/session","navigatorTitle":[{"kind":"identifier","text":"Session"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}]}}}
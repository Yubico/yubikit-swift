naging connection lifecycle, using "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","isActive":true},{"type":"text","text":" to retrieve authentication codes, and "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","isActive":true},{"type":"text","text":" to get device information."}],"url":"\/documentation\/yubikit\/oathsamplecode","role":"sampleCode","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","kind":"article"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/SmartCardConnection":{"abstract":[{"type":"text","text":"An interface defining a SmartCard based connection to a YubiKey."}],"title":"SmartCardConnection","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SmartCardConnection","kind":"identifier"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","url":"\/documentation\/yubikit\/smartcardconnection","role":"symbol","kind":"symbol","type":"topic","navigatorTitle":[{"text":"SmartCardConnection","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PIVSession"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"PIVSession"}],"type":"topic","title":"PIVSession","url":"\/documentation\/yubikit\/pivsession","abstract":[{"text":"An interface to the PIV application on the YubiKey.","type":"text"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authorization":{"abstract":[{"text":"PIN\/UV policy for a single WebAuthn ceremony.","type":"text"}],"title":"WebAuthn.Authorization","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Authorization"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","url":"\/documentation\/yubikit\/webauthn\/authorization","role":"symbol","kind":"symbol","type":"topic","navigatorTitle":[{"text":"Authorization","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"role":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","navigatorTitle":[{"kind":"identifier","text":"Client"}],"kind":"symbol","type":"topic","title":"WebAuthn.Client","url":"\/documentation\/yubikit\/webauthn\/client","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"abstract":[{"text":"Client for performing WebAuthn passkey operations.","type":"text"}]},"nfc-privacy.png":{"identifier":"nfc-privacy.png","type":"image","alt":"An image showing how to add the NFC privacy string to a project.","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy~dark@2x.png","traits":["2x","dark"]}]},"add-framework-1.png":{"alt":"An image showing how to add the YubiKit SDK to your Xcode project.","identifier":"add-framework-1.png","type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1~dark@2x.png","traits":["2x","dark"]}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"url":"\/documentation\/yubikit\/pivtoolsamplecode","role":"sampleCode","abstract":[{"text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","type":"reference","isActive":true},{"text":" for cryptographic operations, certificate management, and access control.","type":"text"}],"kind":"article","title":"PIVTool: Building PIV applications with YubiKey","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"abstract":[{"text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB.","type":"text"}],"title":"YubiKit","images":[{"type":"icon","identifier":"documentation-header.png"}],"url":"\/documentation\/yubikit","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","role":"collection","kind":"symbol","type":"topic"},"nfc-entitlement.png":{"alt":"An image showing how to add wireless entitlements to project.","identifier":"nfc-entitlement.png","type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement~dark@2x.png","traits":["2x","dark"]}]}}}
t-swift.YubiKit\/add-framework-2~dark@2x.png","traits":["2x","dark"]}],"identifier":"add-framework-2.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSampleCode":{"kind":"article","title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","role":"sampleCode","url":"\/documentation\/yubikit\/oathsamplecode","abstract":[{"type":"text","text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"reference","isActive":true},{"type":"text","text":" to retrieve authentication codes, and "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"reference","isActive":true},{"type":"text","text":" to get device information."}],"type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/SmartCardConnection":{"abstract":[{"type":"text","text":"An interface defining a SmartCard based connection to a YubiKey."}],"url":"\/documentation\/yubikit\/smartcardconnection","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"SmartCardConnection","kind":"identifier"}],"navigatorTitle":[{"text":"SmartCardConnection","kind":"identifier"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","title":"SmartCardConnection"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"abstract":[{"type":"text","text":"An interface to the OATH application on the YubiKey."}],"type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"OATHSession","kind":"identifier"}],"url":"\/documentation\/yubikit\/oathsession"
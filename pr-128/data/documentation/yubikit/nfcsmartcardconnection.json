":[{"text":"NFC connection to a YubiKey (iOS only).","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"NFCSmartCardConnection establishes a connection to a YubiKey via NFC. The connection","type":"text"},{"text":" ","type":"text"},{"text":"presents the system NFC dialog and waits for the user to tap their YubiKey.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"NFC connections are short-lived due to iOS timeout constraints. Perform operations quickly","type":"text"},{"text":" ","type":"text"},{"text":"and close the connection with a user-visible message.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let connection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","await connection.close(message: \"Codes retrieved\")"]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"metadata":{"title":"NFCSmartCardConnection","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NFCSmartCardConnection","kind":"identifier"}],"externalID":"s:7YubiKit22NFCSmartCardConnectionV","role":"symbol","symbolKind":"struct","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"NFCSmartCardConnection"}],"modules":[{"name":"YubiKit"}]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Connection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/s8SendableP","doc:\/\/yubikit-swift.YubiKit\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"kind":"symbol","sections":[],"references":{"doc://yubikit-swift.YubiKit/s8SendableP":{"title":"Swift.Sen
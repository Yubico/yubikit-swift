Sections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"WebAuthn","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Contains the high-level passkey ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":" and the request, response, and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"data-model types defined by the"},{"type":"text","text":" "},{"isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/","type":"reference"},{"type":"text","text":" "},{"text":"specification.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A passkey client and the W3C Web Authentication data model, mediated by a YubiKey."}]},{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"WebAuthn","type":"codeVoice"},{"type":"text","text":" namespace provides a high-level passkey client ("},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":") that runs"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/","overridingTitleInlineContent":[{"text":"Web Authentication Level 3","type":"text"}],"isActive":true,"overridingTitle":"Web Authentication Level 3"},{"type":"text","text":" ceremonies against a"},{"type":"text","text":" "},{"type":"text","text":"YubiKey, plus the request and response types defined by the WebAuthn specification."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A WebAuthn ceremony involves three parties: the "},{"type":"strong","inlineContent":[{"text":"authenticator","type":"text"}]},{"type":"text","text":" (a YubiKey), the"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"client","type":"text"}]},{"type":"text","text":" (your app, via "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":"), and the "},{"type":"strong","inlineContent":[{"text":"relying party","type":"text"}]},{"type":"text","text":" (your server, which"},{"type":"text","text":" "},{"type":"text","text":"verifies what the authenticator returns). The client is the communication path between"},{"type":"text","text":" "},{"type":"text","text":"authenticator and relying party — and it verifies the relying party’s identity against"},{"type":"text","text":" "},{"type":"text","text":"the origin it’s bound to, so it can refuse to sign for a fraudulent site."}]},{"type":"paragraph","inlineContent":[{"text":"There are two ceremonies. ","type":"text"},{"inlineContent":[{"type":"text","text":"Registration"}],"type":"strong"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)"},{"text":") creates a new credential and supplies its","type":"text"},{"text":" ","type":"text"},{"text":"public key to the relying party for account association. ","type":"text"},{"inlineContent":[{"type":"text","text":"Authentication"}],"type":"strong"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)"},{"text":") proves to the relying party that the","type":"text"},{"text":" ","type":"text"},{"text":"YubiKey is the one registered for the user. Both ceremonies follow the same mechanical","type":"text"},{"text":" ","type":"text"},{"text":"shape: the relying party supplies a challenge, the authenticator signs it together","type":"text"},{"text":" ","type":"text"},{"text":"with the relying-party identifier, and the signature goes back to the relying party","type":"text"},{"text":" ","type":"text"},{"text":"for verification.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The pieces fit together as: a connection carries CTAP2 traffic, a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"text":" ","type":"text"},{"text":"sits on top, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":" runs ceremonies on that session. Connections come in","type":"text"},{"text":" ","type":"text"},{"text":"three flavours that all work for WebAuthn: ","type":"text"},{"code":"YubiKit\/HIDFIDOConnection","type":"codeVoice"},{"text":" on macOS,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection"},{"text":" for tap-to-auth on iOS, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/USBSmartCardConnection"},{"text":" on either platform. Pick the one that matches","type":"text"},{"text":" ","type":"text"},{"text":"your platform and form factor.","type":"text"}]},{"code":["\/\/ macOS — USB HID FIDO","let connection = try await HIDFIDOConnection()","\/\/ iOS — tap-to-auth over NFC:","\/\/ let connection = try await NFCSmartCardConnection()","","let session = try await CTAP2.Session.makeSession(connection: connection)","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","\/\/ Register a new passkey","let registration = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value","","\/\/ Authenticate","let assertions = try await client.getAssertion(","    .init(challenge: challenge, rpId: \"example.com\"),","    authorization: .pin(\"1234\")",").value"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Most apps start with ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"text":". For lower-level CTAP2 access — raw ","type":"text"},{"code":"makeCredential","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":"getAssertion","type":"codeVoice"},{"text":", credential management, bio enrollment — use ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference","isActive":true},{"text":" directly.","type":"text"}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Transport":{"role":"symbol","url":"\/documentation\/yubikit\/webauthn\/transport","title":"WebAuthn.Transport","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Transport"}],"kind":"symbol","abstract":[{"text":"Authenticator transport identifiers.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Transport"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Transport"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/RelyingParty":{"abstract":[{"text":"Relying Party entity information.","type":"text"}],"title":"WebAuthn.RelyingParty","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\
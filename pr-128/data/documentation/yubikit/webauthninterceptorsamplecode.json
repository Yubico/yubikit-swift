{"primaryContentSections":[{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The interceptor demonstrates how to:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Intercept ","type":"text"},{"code":"navigator.credentials.create()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"navigator.credentials.get()","type":"codeVoice"},{"text":" in a ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options","type":"reference","isActive":true},{"text":" \/ ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","type":"reference","isActive":true},{"text":" types.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Drive the SDK’s high-level ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Use the bundled ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface."}],"type":"paragraph"},{"anchor":"Architecture-Overview","text":"Architecture Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The sample itself is intentionally thin:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Interceptor.js","type":"text"}],"type":"strong"},{"text":" — injected into the ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" to monkey-patch ","type":"text"},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"text":" and shuttle requests\/responses through ","type":"text"},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"WebView.swift","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"UIViewRepresentable","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"NSViewRepresentable","type":"codeVoice"},{"text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"WebAuthnHandler.swift","type":"text"}],"type":"strong"},{"text":" — decodes the JSON envelope, builds a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference","isActive":true},{"text":", and calls ","type":"text"},{"code":"FidoUI.makeCredential","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"FidoUI.getAssertion","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"ContentView.swift","type":"text"}],"type":"strong"},{"text":" — minimal SwiftUI shell with a URL bar and back button.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"FidoUI","type":"text"}],"type":"strong"},{"text":" (separate Swift package under ","type":"text"},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI","type":"codeVoice"},{"text":") — the reusable UI + transport layer described below.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"The end-to-end flow:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Page JS calls ","type":"text"},{"code":"navigator.credentials.create()","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".get()","type":"codeVoice"},{"text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" decodes the JSON straight into the SDK’s strongly-typed ","type":"text"},{"code":"Options","type":"codeVoice"},{"text":" and hands them to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"FidoUI","type":"codeVoice"},{"text":" opens a transport, runs the ceremony via ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"text":", and shows PIN \/ UV \/ error \/ success panels as needed.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The resulting ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","type":"reference","isActive":true},{"text":" is serialized via its built-in ","type":"text"},{"code":"toJSON()","type":"codeVoice"},{"text":" and posted back to JS.","type":"text"}]}]}]},{"anchor":"Intercepting-WebAuthn-Calls","text":"Intercepting WebAuthn Calls","level":2,"type":"heading"},{"anchor":"JavaScript-Injection","text":"JavaScript Injection","level":3,"type":"heading"},{"inlineContent":[{"code":"Interceptor.js","type":"codeVoice"},{"type":"text","text":" replaces "},{"code":"navigator.credentials.create","type":"codeVoice"},{"type":"text","text":" and "},{"code":"navigator.credentials.get","type":"codeVoice"},{"type":"text","text":" with versions that forward to Swift. Binary fields ("},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", "},{"code":"user.id","type":"codeVoice"},{"type":"text","text":", "},{"code":"rawId","type":"codeVoice"},{"type":"text","text":", …) are serialized to "},{"inlineContent":[{"type":"text","text":"base64url"}],"type":"strong"},{"type":"text","text":" strings via "},{"code":"JSON.stringify","type":"codeVoice"},{"type":"text","text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed."}],"type":"paragraph"},{"syntax":"javascript","type":"codeListing","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"]},{"inlineContent":[{"type":"text","text":"The script is injected at document start so it runs before any page code:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"]},{"inlineContent":[{"code":"shouldIntercept","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"type":"text","text":" for any "},{"code":"publicKey","type":"codeVoice"},{"type":"text","text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when "},{"code":"publicKey.hints","type":"codeVoice"},{"type":"text","text":" includes "},{"code":"\"security-key\"","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"anchor":"Receiving-Messages-in-Swift","text":"Receiving Messages in Swift","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"code":"Coordinator","type":"codeVoice"},{"type":"text","text":" is both "},{"code":"WKNavigationDelegate","type":"codeVoice"},{"type":"text","text":" and "},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"type":"text","text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"]},{"inlineContent":[{"code":"shutdown()","type":"codeVoice"},{"type":"text","text":" is called from "},{"code":"dismantle{UI,NS}View","type":"codeVoice"},{"type":"text","text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle."}],"type":"paragraph"},{"anchor":"Driving-the-Ceremony","text":"Driving the Ceremony","level":2,"type":"heading"},{"inlineContent":[{"code":"WebAuthnHandler","type":"codeVoice"},{"type":"text","text":" is intentionally tiny — it decodes the envelope, builds a typed "},{"code":"Origin","type":"codeVoice"},{"type":"text","text":", and delegates to "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"]},{"inlineContent":[{"type":"codeVoice","code":"handleGet"},{"type":"text","text":" is the symmetric counterpart that decodes "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","isActive":true},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"fidoUI.getAssertion"},{"type":"text","text":". The response JSON produced by "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to "},{"type":"codeVoice","code":"ArrayBuffer"},{"type":"text","text":" when it materializes the credential."}],"type":"paragraph"},{"anchor":"Returning-the-Response-to-JavaScript","text":"Returning the Response to JavaScript","level":2,"type":"heading"},{"inlineContent":[{"text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"]},{"inlineContent":[{"text":"JavaScript decodes the JSON and rebuilds a ","type":"text"},{"code":"PublicKeyCredential","type":"codeVoice"},{"text":"-shaped object — converting the base64url binary fields back to ","type":"text"},{"code":"ArrayBuffer","type":"codeVoice"},{"text":"s and wiring up ","type":"text"},{"code":"getClientExtensionResults","type":"codeVoice"},{"text":", ","type":"text"},{"code":"getAuthenticatorData","type":"codeVoice"},{"text":", ","type":"text"},{"code":"getPublicKey","type":"codeVoice"},{"text":", ","type":"text"},{"code":"toJSON","type":"codeVoice"},{"text":", and the rest. Errors travel through a parallel ","type":"text"},{"code":"__webauthn_error__","type":"codeVoice"},{"type":"text","text":" channel and surface to the page as a "},{"code":"DOMException","type":"codeVoice"},{"type":"text","text":" with name "},{"code":"NotAllowedError","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"The-FidoUI-Module","text":"The FidoUI Module","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"@MainActor"},{"text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting ","type":"text"},{"code":"navigator.credentials.*","type":"codeVoice"},{"text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Transport selection."}]},{"type":"text","text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ceremony serialization."}]},{"type":"text","text":" Concurrent calls on the same "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Cancellation."}],"type":"strong"},{"type":"text","text":" A single "},{"code":"cancel()","type":"codeVoice"},{"type":"text","text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The host code only needs to construct one ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" instance and call ","type":"text"},{"type":"codeVoice","code":"makeCredential"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"getAssertion"},{"text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See ","type":"text"},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/"},{"text":" for the full source.","type":"text"}]},{"text":"Platform Notes","anchor":"Platform-Notes","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"iOS."}],"type":"strong"},{"type":"text","text":" The wired path goes through CryptoTokenKit ("},{"type":"codeVoice","code":"WiredSmartCardConnection"},{"type":"text","text":" — USB-C or Lightning), and the NFC path through "},{"code":"NFCSmartCardConnection","type":"codeVoice"},{"type":"text","text":". The sample’s "},{"code":"Info.plist","type":"codeVoice"},{"text":" declares ","type":"text"},{"code":"NFCReaderUsageDescription","type":"codeVoice"},{"text":" and lists the FIDO applet AID (","type":"text"},{"code":"A0000006472F0001","type":"codeVoice"},{"type":"text","text":") under "},{"code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers","type":"codeVoice"},{"type":"text","text":"; the entitlements turn on "},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.formats"},{"type":"text","text":" ("},{"type":"codeVoice","code":"TAG"},{"type":"text","text":") and "},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS.","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" uses "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" and "},{"type":"codeVoice","code":"com.apple.security.device.usb"},{"type":"text","text":" so the same target builds cleanly for both platforms."}]}]}]},{"anchor":"Where-to-Customize","type":"heading","level":2,"text":"Where to Customize"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Which requests get intercepted.","type":"text"}],"type":"strong"},{"type":"text","text":" Edit "},{"code":"shouldIntercept","type":"codeVoice"},{"type":"text","text":" in "},{"code":"Interceptor.js","type":"codeVoice"},{"type":"text","text":" to scope by hint, RP ID, or any other heuristic."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Origin verification."}],"type":"strong"},{"type":"text","text":" "},{"code":"WebAuthnHandler","type":"codeVoice"},{"type":"text","text":" builds a "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference","isActive":true},{"text":" from ","type":"text"},{"code":"window.location.origin","type":"codeVoice"},{"text":". Replace the ","type":"text"},{"code":"isPublicSuffix","type":"codeVoice"},{"text":" closure passed to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" with a real public-suffix-list check before shipping.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"UI."}],"type":"strong"},{"type":"text","text":" Swap or restyle the panels in "},{"code":"FidoUI\/Sources\/FidoUI\/Views\/","type":"codeVoice"},{"type":"text","text":" — the rest of the module is UI-agnostic."}],"type":"paragraph"}]}]}],"kind":"content"}],"sampleCodeDownload":{"action":{"overridingTitle":"View Source","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample","type":"reference","isActive":true},"kind":"sampleDownload"},"variants":[{"paths":["\/documentation\/yubikit\/webauthninterceptorsamplecode"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","seeAlsoSections":[{"anchor":"Sample-code","generated":tru
{"sections":[],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"metadata":{"title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","modules":[{"name":"YubiKit"}],"roleHeading":"Sample Code","color":{"standardColorIdentifier":"yellow"},"role":"sampleCode"},"abstract":[{"text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"text":" calls inside a ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":" and routes them to a YubiKey. It uses the high-level ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" companion module.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"The interceptor demonstrates how to:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Intercept "},{"type":"codeVoice","code":"navigator.credentials.create()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"navigator.credentials.get()"},{"type":"text","text":" in a "},{"type":"codeVoice","code":"WKWebView"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options","type":"reference","isActive":true},{"text":" \/ ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","type":"reference","isActive":true},{"text":" types.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Drive the SDK’s high-level ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Use the bundled ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface.","type":"text"}],"type":"paragraph"},{"text":"Architecture Overview","level":2,"anchor":"Architecture-Overview","type":"heading"},{"inlineContent":[{"text":"The sample itself is intentionally thin:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Interceptor.js"}]},{"text":" — injected into the ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":" to monkey-patch ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"text":" and shuttle requests\/responses through ","type":"text"},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"WebView.swift"}]},{"text":" — ","type":"text"},{"type":"codeVoice","code":"UIViewRepresentable"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"NSViewRepresentable"},{"text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"WebAuthnHandler.swift"}]},{"text":" — decodes the JSON envelope, builds a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference","isActive":true},{"type":"text","text":", and calls "},{"type":"codeVoice","code":"FidoUI.makeCredential"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"FidoUI.getAssertion"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"ContentView.swift"}]},{"text":" — minimal SwiftUI shell with a URL bar and back button.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"FidoUI"}]},{"text":" (separate Swift package under ","type":"text"},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI"},{"text":") — the reusable UI + transport layer described below.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The end-to-end flow:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Page JS calls ","type":"text"},{"code":"navigator.credentials.create()","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".get()","type":"codeVoice"},{"text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" decodes the JSON straight into the SDK’s strongly-typed ","type":"text"},{"code":"Options","type":"codeVoice"},{"text":" and hands them to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"FidoUI","type":"codeVoice"},{"text":" opens a transport, runs the ceremony via ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"text":", and shows PIN \/ UV \/ error \/ success panels as needed.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The resulting ","type":"text"},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","isActive":true},{"type":"text","text":" is serialized via its built-in "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" and posted back to JS."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Intercepting-WebAuthn-Calls","text":"Intercepting WebAuthn Calls"},{"type":"heading","level":3,"anchor":"JavaScript-Injection","text":"JavaScript Injection"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Interceptor.js"},{"text":" replaces ","type":"text"},{"code":"navigator.credentials.create","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"navigator.credentials.get","type":"codeVoice"},{"text":" with versions that forward to Swift. Binary fields (","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":", ","type":"text"},{"type":"codeVoice","code":"user.id"},{"text":", ","type":"text"},{"type":"codeVoice","code":"rawId"},{"text":", …) are serialized to ","type":"text"},{"type":"strong","inlineContent":[{"text":"base64url","type":"text"}]},{"text":" strings via ","type":"text"},{"type":"codeVoice","code":"JSON.stringify"},{"text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed.","type":"text"}]},{"syntax":"javascript","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"],"type":"codeListing"},{"inlineContent":[{"text":"The script is injected at document start so it runs before any page code:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"],"type":"codeListing"},{"inlineContent":[{"code":"shouldIntercept","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for any ","type":"text"},{"code":"publicKey","type":"codeVoice"},{"type":"text","text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when "},{"type":"codeVoice","code":"publicKey.hints"},{"type":"text","text":" includes "},{"type":"codeVoice","code":"\"security-key\""},{"type":"text","text":")."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Receiving-Messages-in-Swift","text":"Receiving Messages in Swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"Coordinator","type":"codeVoice"},{"text":" is both ","type":"text"},{"code":"WKNavigationDelegate","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:","type":"text"}]},{"type":"codeListing","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shutdown()"},{"text":" is called from ","type":"text"},{"code":"dismantle{UI,NS}View","type":"codeVoice"},{"text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle.","type":"text"}]},{"type":"heading","anchor":"Driving-the-Ceremony","level":2,"text":"Driving the Ceremony"},{"inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" is intentionally tiny — it decodes the envelope, builds a typed "},{"type":"codeVoice","code":"Origin"},{"type":"text","text":", and delegates to "},{"type":"codeVoice","code":"FidoUI"},{"text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself.","type":"text"}],"type":"paragraph"},{"code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"handleGet"},{"type":"text","text":" is the symmetric counterpart that decodes "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","isActive":true},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"fidoUI.getAssertion"},{"type":"text","text":". The response JSON produced by "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to "},{"type":"codeVoice","code":"ArrayBuffer"},{"text":" when it materializes the credential.","type":"text"}],"type":"paragraph"},{"text":"Returning the Response to JavaScript","anchor":"Returning-the-Response-to-JavaScript","type":"heading","level":2},{"inlineContent":[{"text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:","type":"text"}],"type":"paragraph"},{"code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"JavaScript decodes the JSON and rebuilds a ","type":"text"},{"code":"PublicKeyCredential","type":"codeVoice"},{"text":"-shaped object — converting the base64url binary fields back to ","type":"text"},{"code":"ArrayBuffer","type":"codeVoice"},{"text":"s and wiring up ","type":"text"},{"code":"getClientExtensionResults","type":"codeVoice"},{"text":", ","type":"text"},{"code":"getAuthenticatorData","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"getPublicKey"},{"type":"text","text":", "},{"code":"toJSON","type":"codeVoice"},{"text":", and the rest. Errors travel through a parallel ","type":"text"},{"type":"codeVoice","code":"__webauthn_error__"},{"type":"text","text":" channel and surface to the page as a "},{"type":"codeVoice","code":"DOMException"},{"type":"text","text":" with name "},{"type":"codeVoice","code":"NotAllowedError"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"The FidoUI Module","anchor":"The-FidoUI-Module","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"FidoUI","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting ","type":"text"},{"code":"navigator.credentials.*","type":"codeVoice"},{"text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell."}]},{"type":"paragraph","inlineContent":[{"text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Transport selection.","type":"text"}]},{"text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Ceremony serialization.","type":"text"}]},{"text":" Concurrent calls on the same ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Cancellation.","type":"text"}]},{"text":" A single ","type":"text"},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The host code only needs to construct one ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" instance and call ","type":"text"},{"code":"makeCredential","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"getAssertion"},{"text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See ","type":"text"},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/"},{"text":" for the full source.","type":"text"}]},{"type":"heading","anchor":"Platform-Notes","level":2,"text":"Platform Notes"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"iOS.","type":"text"}],"type":"strong"},{"text":" The wired path goes through CryptoTokenKit (","type":"text"},{"code":"WiredSmartCardConnection","type":"codeVoice"},{"text":" — USB-C or Lightning), and the NFC path through ","type":"text"},{"type":"codeVoice","code":"NFCSmartCardConnection"},{"text":". The sample’s ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" declares ","type":"text"},{"code":"NFCReaderUsageDescription","type":"codeVoice"},{"text":" and lists the FIDO applet AID (","type":"text"},{"code":"A0000006472F0001","type":"codeVoice"},{"text":") under ","type":"text"},{"code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers","type":"codeVoice"},{"text":"; the entitlements turn on ","type":"text"},{"code":"com.apple.developer.nfc.readersession.formats","type":"codeVoice"},{"text":" (","type":"text"},{"code":"TAG","type":"codeVoice"},{"text":") and ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS.","type":"text"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" uses ","type":"text"},{"type":"codeVoice","code":"HIDFIDOConnection"},{"text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables ","type":"text"},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"com.apple.security.device.usb"},{"text":" so the same target builds cleanly for both platforms.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Where-to-Customize","level":2,"text":"Where to Customize"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Which requests get intercepted.","type":"text"}],"type":"strong"},{"text":" Edit ","type":"text"},{"code":"shouldIntercept","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"Interceptor.js","type":"codeVoice"},{"text":" to scope by hint, RP ID, or any other heuristic.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Origin verification.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" builds a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference"},{"text":" from ","type":"text"},{"code":"window.location.origin","type":"codeVoice"},{"text":". Replace the ","type":"text"},{"code":"isPublicSuffix","type":"codeVoice"},{"text":" closure passed to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" with a real public-suffix-list check before shipping.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"UI.","type":"text"}],"type":"strong"},{"text":" Swap or restyle the panels in ","type":"text"},{"code":"FidoUI\/Sources\/FidoUI\/Views\/","type":"codeVoice"},{"text":" — the rest of the module is UI-agnostic.","type":"text"}],"type":"paragraph"}]}]}],"kind":"content"}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"type":"reference","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample","isActive":true,"overridingTitle":"View Source"}},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/yubikit\/webauthninterceptorsamplecode"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Sample code","anchor":"Sample-code","generated":true,"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"]}],"kind":"article","references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Registration/Response":{"url":"\/documentation\/yubikit\/webauthn\/registration\/response","role":"symbol","abstract":[{"text":"Authenticator response from a successful credential creation.","type":"text"}],"kind":"symbol","title":"WebAuthn.Registration.Response","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Response","kind":"identifier"}],"navigatorTitle":[{"text":"Response","kind":"identifier"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authentication/Response":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","kind":"s
,"abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"images":[{"type":"icon","identifier":"documentation-header.png"}],"title":"YubiKit"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","navigatorTitle":[{"kind":"identifier","text":"Client"}],"url":"\/documentation\/yubikit\/webauthn\/client","role":"symbol","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"title":"WebAuthn.Client","type":"topic"},"documentation-header.png":{"identifier":"documentation-header.png","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png"}],"alt":"YubiKeys in a row","type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"title":"OATHSession","navigatorTitle":[{"text":"OATHSession","kind":"identifier"}],"url":"\/documentation\/yubikit\/oathsession","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OATHSession","kind":"identifier"}],"abstract":[{"text":"An interface to the OATH application on the YubiKey.","type":"text"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"topic","role":"symbol","kind":"symbol"}}}
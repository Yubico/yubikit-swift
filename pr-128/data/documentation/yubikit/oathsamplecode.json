{"abstract":[{"text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"reference","isActive":true},{"text":" to retrieve authentication codes, and ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"reference","isActive":true},{"text":" to get device information.","type":"text"}],"seeAlsoSections":[{"generated":true,"title":"Sample code","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"],"anchor":"Sample-code"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/oathsamplecode"]}],"sampleCodeDownload":{"action":{"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","type":"reference","isActive":true,"overridingTitle":"View Source"},"kind":"sampleDownload"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"The sample creates an authenticator app that:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Establishes connections to YubiKeys via USB, Lightning, or NFC","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Manages connection lifecycle (detecting plugged\/unplugged devices)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists TOTP codes stored on the YubiKey","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Shows device information like firmware version","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Handles connection errors and user cancellations gracefully","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This sample focuses on read-only operations and doesn’t handle password-protected YubiKeys or credential management.","type":"text"}],"type":"paragraph"},{"text":"Connection Management","level":2,"anchor":"Connection-Management","type":"heading"},{"text":"Handling Wired Connections","level":3,"anchor":"Handling-Wired-Connections","type":"heading"},{"inlineContent":[{"text":"The app uses a ","type":"text"},{"code":"ConnectionManager","type":"codeVoice"},{"text":" to handle persistent connections to plugged-in YubiKeys. This approach ensures your app stays responsive when users plug and unplug their YubiKeys:","type":"text"}],"type":"paragraph"},{"code":["private func startWiredConnection() {","    wiredConnectionTask = Task { @MainActor in","        while !Task.isCancelled {","            do {","                let newConnection = try await WiredSmartCardConnection.makeConnection()","                wiredConnection = newConnection","","                \/\/ Wait for disconnect","                let closeError = await newConnection.waitUntilClosed()","                wiredConnection = nil","            } catch {","                self.error = error","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The key insight here is using ","type":"text"},{"code":"waitUntilClosed()","type":"codeVoice"},{"text":" to detect when the YubiKey is unplugged, then automatically waiting for the next connection.","type":"text"}],"type":"paragraph"},{"text":"NFC Connections","level":3,"anchor":"NFC-Connections","type":"heading"},{"inlineContent":[{"text":"NFC connections work differently - they’re initiated by user action and are short-lived:","type":"text"}],"type":"paragraph"},{"code":["func requestNFCConnection() async {","    do {","        nfcConnection = try await NFCSmartCardConnection()","    } catch {","        self.error = error","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"When an NFC connection is established, the app fetches data and immediately closes it with a user message:","type":"text"}],"type":"paragraph"},{"code":["Task {","    await model.update(using: connection)","    await connection.close(message: \"Codes calculated\")","}"],"type":"codeListing","syntax":"swift"},{"text":"Working with YubiKey Data","level":2,"anchor":"Working-with-YubiKey-Data","type":"heading"},{"text":"Reading OATH Codes","level":3,"anchor":"Reading-OATH-Codes","type":"heading"},{"inlineContent":[{"text":"Once you have a connection, getting TOTP codes is straightforward:","type":"text"}],"type":"paragraph"},{"code":["private func calculateCodes(using connection: SmartCardConnection) async {","    do {","        let session = try await OATHSession.makeSession(connection: connection)","        let result = try await session.calculateCredentialCodes()","        accounts = result.map { credential, code in","            Account(","                label: credential.label,","                code: code?.code,","                issuer: credential.issuer,","                type: credential.type","            )","        }","    } catch {","        self.error = error","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"calculateCredentialCodes()","type":"codeVoice"},{"text":" method returns a dictionary mapping credentials to their current codes. Some codes might be ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if they require touch or are password-protected.","type":"text"}],"type":"paragraph"},{"text":"Getting Device Information","level":3,"anchor":"Getting-Device-Information","type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"Management.Session","type":"codeVoice"},{"text":" to get YubiKey information:","type":"text"}],"type":"paragraph"},{"code":["private func getKeyVersion(using connection: SmartCardConnection) async {","    do {","        let session: Management.Session = try await .makeSession(connection: connection)","        self.keyVersion = await session.version.description","    } catch {","        self.error = error","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"Model","type":"codeVoice"},{"text":" class combines both operations in a single ","type":"text"},{"code":"update","type":"codeVoice"},{"text":" method:","type":"text"}],"type":"paragraph"},{"code":["func update(using connection: SmartCardConnection) async {","    await calculateCodes(using: connection)","    await getKeyVersion(using: connection)","    connectionType = connection.connectionType","}"],"type":"codeListing","syntax":"swift"},{"text":"SwiftUI Integration","level":2,"anchor":"SwiftUI-Integration","type":"heading"},{"text":"Reacting to Connection Changes","level":3,"anchor":"Reacting-to-Connection-Changes","type":"heading"},{"inlineContent":[{"text":"The app uses SwiftUI’s ","type":"text"},{"code":"@Published","type":"codeVoice"},{"text":" properties and ","type":"text"},{"code":"onReceive","type":"codeVoice"},{"text":" to update the UI when connections change:","type":"text"}],"type":"paragraph"},{"code":[".onReceive(connectionManager.$wiredConnection) { newConnection in","    guard let connection = newConnection else {","        model.clear()  \/\/ Clear UI when YubiKey unplugged","        return","    }","    Task { await model.update(using: connection) }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"This pattern ensures the UI immediately updates when YubiKeys are plugged in or removed.","type":"text"}],"type":"paragraph"},{"text":"Platform-Specific Features","level":3,"anchor":"Platform-Specific-Features","type":"heading"},{"inlineContent":[{"text":"The app handles iOS vs macOS differences with conditional compilation:","type":"text"}],"type":"paragraph"},{"code":["#if os(iOS)",".refreshable {","    await connectionManager.requestNFCConnection()","}","#endif"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"iOS users can pull-to-refresh to scan with NFC, while macOS users only see USB options.","type":"text"}],"type":"paragraph"},{"text":"Connection Type Detection","level":3,"anchor":"Connection-Type-Detection","type":"heading"},{"inlineContent":[{"text":"The sample includes a useful extension to identify connection types:","type":"text"}],"type":"paragraph"},{"code":["extension SmartCardConnection {","    var connectionType: String {","        switch self {","        case _ as NFCSmartCardConnection: return \"NFC\"","        case _ as LightningSmartCardConnection: return \"Lightning\"","        case _ as USBSmartCardConnection: return \"USB\"","        default: return \"Unknown\"","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"This is helpful because NFC connections are slower than USB, and users like to know how their YubiKey is connected.","type":"text"}],"type":"paragraph"},{"text":"Architecture Decisions","level":2,"anchor":"Architecture-Decisions","type":"heading"},{"text":"Why the connection management works this way","level":3,"anchor":"Why-the-connection-management-works-this-way","type":"heading"},{"inlineContent":[{"text":"The sample uses a background loop that continuously waits for wired connections. This might seem unusual, but it solves a key problem: YubiKeys get plugged and unplugged frequently, but apps need to stay responsive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When you unplug your YubiKey, the app doesn’t crash or freeze - it detects the disconnection via ","type":"text"},{"code":"waitUntilClosed()","type":"codeVoice"},{"text":" and immediately starts waiting for the next YubiKey. This creates a smoother user experience where the app responds when you plug \/ unplug a YubiKey.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"NFC works differently since you can’t continuously scan - the user has to explicitly initiate each scan. That’s why NFC connections are handled separately through user actions like the scan button or pull-to-refresh.","type":"text"}],"type":"paragraph"},{"text":"Error handling for hardware connections","level":3,"anchor":"Error-handling-for-hardware-connections","type":"heading"},{"inlineContent":[{"text":"Hardware connections are unreliable by nature. Users will unplug devices mid-operation, walk away during NFC scans, or have connectivity issues. The sample handles this gracefully:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Connection failures are caught and stored as errors","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"User cancellations (like dismissing NFC scan) are filtered out to avoid unnecessary error alerts","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Session errors are handled similarly - show the error but maintain app functionality","type":"text"}]}]}],"type":"unorderedList"},{"text":"Working with Swift actors","level":3,"anchor":"Working-with-Swift-actors","type":"heading"},{"inlineContent":[{"text":"YubiKit sessions are Swift actors that handle their own threading. The sample shows how to integrate this with SwiftUI’s main actor requirements:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ConnectionManager"},{"text":" runs on ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" so it can directly update ","type":"text"},{"type":"codeVoice","code":"@Published"},{"text":" properties","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Session calls happen on the session’s actor, then results are passed back to update the UI","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Everything uses ","type":"text"},{"type":"codeVoice","code":"async\/await"}]}]}],"type":"unorderedList"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Sample Code","modules":[{"name":"YubiKit"}],"title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","role":"sampleCode","color":{"standardColorIdentifier":"green"}},"sections":[],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"kind":"article","references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"url":"\/documentation\/yubikit\/management\/session","abstract":[{"text":"An interface to the Management application on the YubiKey.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"topic","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}],"title":"Management.Session","navigatorTitle":[{"kind":"identifier","text":"Session"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"navigatorTitle":[{"text":"Client","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/yubikit\/webauthn\/client","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"title":"WebAuthn.Client","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","role":"sampleCode","kind":"article","abstract":[{"type":"text","text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts "},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"type":"text","text":" calls inside a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" and routes them to a YubiKey. It uses the high-level "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" companion module."}],"url":"\/documentation\/yubikit\/webauthninterceptorsamplecode","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"},"documentation-header.png":{"variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}],"identifier":"documentation-header.png","alt":"YubiKeys in a row","type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"url":"\/documentation\/yubikit","kind":"symbol","abstract":[{"text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB.","type":"text"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","type":"topic","role":"collection","images":[{"identifier":"documentation-header.png","type":"icon"}],"title":"YubiKit"},"https://github.com/Yubico/yubikit-swift/tree/main/Samples/OATHSample":{"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","checksum":null,"url":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","type":"download"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVToolSampleCode":{"title":"PIVTool: Building PIV applications with YubiKey","role":"sampleCode"
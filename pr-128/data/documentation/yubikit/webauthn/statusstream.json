{"anchor":"Usage","level":2,"text":"Usage","type":"heading"},{"inlineContent":[{"type":"text","text":"For simple cases without UI feedback, drain the stream with "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/StatusStream\/value","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let response = try await client.makeCredential(opts, authorization: .pin(pin)).value"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"For UI feedback or cancellation support, iterate the stream:"}],"type":"paragraph"},{"code":["let stream = await client.makeCredential(opts, authorization: .pin(pin))","","for try await status in stream {","    switch status {","    case .processing:","        showSpinner()","    case .waitingForUser(let cancel):","        showTouchPrompt(onCancel: { Task { await cancel() } })","    case .finished(let response):","        return response","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"PIN entry and UV decisions are handled out-of-band via the"},{"type":"text","text":" "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","type":"reference","isActive":true},{"type":"text","text":" parameter on "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Async sequence yielding progress updates during a WebAuthn ceremony."}],"type":"paragraph"},{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/yubikit-swift.Yubi
rovidePIN"},{"type":"text","text":" "},{"type":"text","text":"closure the SDK invokes when a PIN is needed, and a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/UVPolicy","isActive":true},{"type":"text","text":" deciding whether"},{"type":"text","text":" "},{"type":"text","text":"built-in user verification (e.g. fingerprint on a YubiKey Bio) is attempted."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"PIN entry happens out-of-band: the SDK never surfaces a PIN prompt on the"},{"type":"text","text":" "},{"type":"text","text":"ceremony’s "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/StatusStream","isActive":true},{"type":"text","text":". The closure is invoked when the ceremony"},{"type":"text","text":" "},{"type":"text","text":"requires user verification and the PIN path is chosen — when built-in UV isn’t"},{"type":"text","text":" "},{"type":"text","text":"available, has been blocked, or is ruled out by the "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/UVPolicy","isActive":true},{"type":"text","text":" on this"},{"type":"text","text":" "},{"type":"codeVoice","code":"Authorization"},{"type":"text","text":". If built-in UV succeeds, the closure is never called. PIN"},{"type":"text","text":" "},{"type":"text","text":"attempts are one-shot: a wrong PIN throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/pinRejected(retriesRemaining:source:)","isActive":true},{"type":"text","text":" and the caller"},{"type":"text","text":" "},{"type":"text","text":"re-invokes the ceremony with a fresh "},{"type":"codeVoice","code":"Authorization"},{"type":"text","text":". Returning "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/PINReply\/cancel","isActive":true},{"type":"text","text":" "},{"type":"text","text":"aborts with "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/cancelled(source:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"code":["\/\/ Pre-supplied PIN — skips built-in UV.","let r = try await client.makeCredential(opts, authorization: .pin(\"1234\")).value","","\/\/ Built-in UV only — the PIN closure is never invoked.","let r = try await client.makeCredential(opts, authorization: .uvOnly).value","","\/\/ Custom — bridge into a UI.","let auth = WebAuthn.Authorization(providePIN: {","    guard let pin = await viewModel.askForPIN() else { return .cancel }","    return .pin(pin)","}, uv: .preferred)"],"syntax":"swift","type":"codeListing"}]}],"topicSections":[{"title":"Creating an Authorization","anchor":"Creating-an-Authorization","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/init(providePIN:uv:)","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/pin(_:)","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/uvOnly"]},{"title":"Properties","anchor":"Properties","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/providePIN","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/uv"]},{"title":"Replies and Policy","anchor":"Replies-and-Policy","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/PINReply","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/UVPolicy"]}],"metadata":{"modules":[{"name":"YubiKit"}],"navigatorTitle":[{"kind":"identifier","text":"Authorization"}],"externalID":"s:7YubiKit8WebAuthnO13AuthorizationV","title":"WebAuthn.Authorization","role":"symbol","symbolKind":"struct","fragments":[{"kind":"keyword","text":"stru
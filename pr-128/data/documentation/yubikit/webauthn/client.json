dModule":"YubiKit","title":"WebAuthn.Client","symbolKind":"class"},"abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"mentions":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted"],"kind":"mentions"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provides a unified interface for passkey registration and authentication"},{"type":"text","text":" "},{"type":"text","text":"backed by a YubiKey via CTAP2 protocol (USB\/NFC)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"PIN entry and UV decisions are supplied per ceremony via the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization"},{"type":"text","text":" parameter on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)"},{"type":"text","text":". The status stream reports ceremony"},{"type":"text","text":" "},{"type":"text","text":"progress ("},{"code":".processing","type":"codeVoice"},{"type":"text","text":", "},{"code":".waitingForUser","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":".waitingForUserVerification","type":"codeVoice"},{"type":"text","text":", "},{"code":".finished","type":"codeVoice"},{"type":"text","text":") only."}]},{"type":"codeListing","syntax":"swift","code":["let session = try await CTAP2.Session.makeSession(connection: connection)","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","\/\/ Trivial — pre-supplied PIN:","let response = try await client.makeCredential(options, authorization: .pin(\"1234\")).value","","\/\/ Custom — bridge into a UI:","let auth = WebAuthn.Authorization(providePIN: {","    guard let pin = await viewModel.askForPIN() else { return .cancel }","    return .pin(pin)","})","for try await status in await client.makeCredential(options, authorization: auth) {","    switch status {","    case .processing: showSpinner()","    case .waitingForUser(let cancel):","        showTouchPrompt(onCancel: { Task { await cancel() } })","    case .waitingForUserVerification(let cancel, let fallbackToPIN):","        showBiometricPrompt(","            onCancel: { Task { await cancel() } },","            onFallbackToPIN: fallbackToPIN.map { fallback in { Task { await fallback() } } }","        )","    case .finished(let response): return response","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"PIN attempts are one-shot: a wrong PIN throws"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/pinRejected(retriesRemaining:source:)"},{"type":"text","text":" and the caller"},{"type":"text","text":" "},{"type":"text","text":"decides whether to re-prompt and retry with a fresh "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Returning "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/PINReply\/cancel"},{"type":"text","text":" from "},{"code":"providePIN","type":"codeVoice"},{"type":"text","text":" aborts"},{"type":"text","text":" "},{"type":"text","text":"the ceremony with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/cancelled(source:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"code":"Client","type":"codeVoice"},{"type":"text","text":" is a high-level passkey client that runs WebAuthn ceremonies against a YubiKey."}]},{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"Client","type":"codeVoice"},{"type":"text","text":" is the entry point for WebAuthn in this SDK. It wraps a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":" "},{"type":"text","text":"and translates W3C WebAuthn requests into CTAP2 protocol exchanges — building the"},{"type":"text","text":" "},{"code":"clientDataJSON","type":"codeVoice"},{"type":"text","text":", validating the relying-party identifier against the configured"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin"},{"type":"text","text":", selecting between PIN and built-in user verification, and"},{"type":"text","text":" "},{"type":"text","text":"processing extensions before the request reaches the authenticator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"Client","type":"codeVoice"},{"type":"text","text":" for any app that runs passkey ceremonies. Reach for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":" "},{"type":"text","text":"directly only when you need lower-level access — raw "},{"code":"makeCredential","type":"codeVoice"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"code":"getAssertion","type":"codeVoice"},{"type":"text","text":", credential management, or bio enrollment."}]},{"type":"paragraph","inlineContent":[{"code":"Client","type":"codeVoice"},{"type":"text","text":" is an actor; a client’s lifetime is bound to the underlying "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The constructor takes four parameters that shape every ceremony:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"origin"},{"type":"text","text":" — the secure origin the client is bound to. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin"},{"type":"text","text":" enforces"},{"type":"text","text":" "},{"type":"text","text":"the W3C secure-context rule; the client refuses to sign for relying parties whose"},{"type":"text","text":" "},{"type":"text","text":"identifier doesn’t match."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isPublicSuffix"},{"type":"text","text":" — a closure into a Public Suffix List, used to validate that"},{"type":"text","text":" "},{"type":"text","text":"the relying-party identifier is a registrable suffix of the origin’s effective"},{"type":"text","text":" "},{"type":"text","text":"domain."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"enterpriseRpIds"},{"type":"text","text":" — relying-party identifiers allowed to receive"},{"type":"text","text":" "},{"type":"text","text":"platform-managed enterprise attestation. When the request specifies"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/AttestationPreference\/enterprise"},{"type":"text","text":", the client escalates to level 2"},{"type":"text","text":" "},{"type":"text","text":"(platform-managed) for RPs in this set, and uses level 1 (vendor-facilitated)"},{"type":"text","text":" "},{"type":"text","text":"otherwise."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"allowedExtensions"},{"type":"text","text":" — the set of WebAuthn extensions the client will process."},{"type":"text","text":" "},{"type":"text","text":"Anything the relying party requests outside this set is dropped before reaching"},{"type":"text","text":" "},{"type":"text","text":"the authenticator. Defaults to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension"},{"type":"text","text":"’s standard set."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"PIN and user verification are supplied per ceremony via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"out-of-band from the ceremony stream. Both ceremony methods return a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/StatusStream"},{"type":"text","text":" — drain it with "},{"code":"value()","type":"codeVoice"},{"type":"text","text":" for non-UI callers, or iterate"},{"type":"text","text":" "},{"type":"text","text":"to drive cancel buttons and biometric prompts."}]},{"type":"codeListing","syntax":"swift","code":["let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","for try await status in await client.makeCredential(opts, authorization: .pin(\"1234\")) {","    switch status {","    case .processing:","        showSpinner()","    case .waitingForUser(let cancel):","        showTouchPrompt(onCancel: { Task { await cancel() } })","    case .waitingForUserVerification(let cancel, _):","        showBiometricPrompt(onCancel: { Task { await cancel() } })","    case .finished(let response):","        return response","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"clientData:","type":"codeVoice"},{"type":"text","text":" overloads accept a pre-built "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientData"},{"type":"text","text":" instead of"},{"type":"text","text":" "},{"type":"text","text":"building one from "},{"code":"origin","type":"codeVoice"},{"type":"text","text":" + challenge. Use them in iOS Credential Provider \/"},{"type":"text","text":" "},{"type":"text","text":"AutoFill flows, where the system supplies a precomputed "},{"code":"clientDataHash","type":"codeVoice"},{"type":"text","text":" rather"},{"type":"text","text":" "},{"type":"text","text":"than the full "},{"code":"clientDataJSON","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn"]]},"kind":"symbol","seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn"],"generated":true,"title":"WebAuthn Client","anchor":"WebAuthn-Client"}],"relationshipsSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/s8SendableP","doc:\/\/yubikit-swift.YubiKit\/s16SendableMetatypeP","doc:\/\/yubikit-swift.YubiKit\/ScA"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"variants":[{"paths":["\/documentation\/yubikit\/webauthn\/client
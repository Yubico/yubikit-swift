ype":"text"}]},{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PRF"},{"type":"text","text":" lets a relying party derive deterministic symmetric secrets from a credential"},{"type":"text","text":" "},{"type":"text","text":"— the same input produces the same output every time the user authenticates with"},{"type":"text","text":" "},{"type":"text","text":"that credential. It’s the "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/#prf-extension"},{"type":"text","text":" "},{"type":"text","text":"for credential-bound key derivation, built on the CTAP2 "},{"type":"codeVoice","code":"hmac-secret"},{"type":"text","text":" extension."},{"type":"text","text":" "},{"type":"text","text":"The SDK transforms each PRF input with "},{"type":"codeVoice","code":"SHA-256(\"WebAuthn PRF\\0\" || input)"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"text","text":"sending it to the authenticator — that domain separation is mandated by the spec."}]},{"type":"paragraph","inlineContent":[{"text":"In a high-level WebAuthn flow, configure ","type":"text"},{"type":"codeVoice","code":"PRF"},{"text":" per ceremony via","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/RegistrationInputs\/prf"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/AuthenticationInputs\/prf"},{"text":"; outputs come back on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"clientExtensionResults"},{"text":" of the corresponding ","type":"text"},{"code":"Response","type":"codeVoice"},{"text":". Registration enables","type":"text"},{"text":" ","type":"text"},{"text":"PRF on a credential, optionally deriving
{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"NFCSmartCardConnection"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The  NFCSmartCardConnection is short lived and should be closed as soon as the commands sent to the YubiKey have finished processing. It is up to the user of"},{"type":"text","text":" "},{"type":"text","text":"the connection to close it when it no longer is needed. As long as the connection is open the NFC modal will cover the lower part of the iPhone screen."},{"type":"text","text":" "},{"type":"text","text":"In addition to the "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/close(error:)","isActive":true},{"type":"text","text":" method defined in the SmartCardConnection protocol the NFCSmartCardConnection has an additional "},{"type":"codeVoice","code":"close(success:)"},{"type":"text","text":" "},{"type":"text","text":"method that will close the connection and set the alertMessage of the NFC alert to the provided message."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"NFC is only supported on iPhones from iPhone 6 and forward. It will not work on iPads since there’s no NFC chip in these devices."}]}],"style":"note","name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"NFC connection to a YubiKey (iOS only)."}]},{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"NFCSmartCardConnection establishes a connection to a YubiKey via NFC. The connection"},{"type":"text","text":" "},{"type":"text","text":"presents the system NFC dialog and waits for the user to tap their YubiKey."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"NFC connections are short-lived due to iOS timeout constraints. Perform operations quickly"},{"type":"text","text":" "},{"type":"text","text":"and close the connection with a user-visible message."}]},{"type":"codeListing","code":["let connection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","await connection.close(message: \"Codes retrieved\")"],"syntax":"swift"}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Connection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/s8SendableP","doc:\/\/yubikit-swift.YubiKit\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection"},"metadata":{"externalID":"s:7YubiKit22NFCSmartCardConnectionV","modules":[{"name":"YubiKit"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NFCSmartCardConnection"}],"symbolKind":"struct","role":"symbol","title":"NFCSmartCardConnection","navigatorTitle":[{"kind":"identifier","text":"NFCSmartCardConnection"}],"roleHeading":"Structure"},"abstract":[{"type":"text","text":"A NFC connection to the YubiKey."}],"kind":"symbol","variants":[{"paths":["\/documentation\/yubikit\/nfcsmartcardconnection"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"topicSections":[{"anchor":"Creating-a-Connection","title":"Creating a Connection","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/init()","doc:\/\
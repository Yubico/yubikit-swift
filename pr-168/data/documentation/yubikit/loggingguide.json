{"variants":[{"paths":["\/documentation\/yubikit\/loggingguide"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"No setup is required. YubiKit defaults to "},{"type":"codeVoice","code":"debug"},{"type":"text","text":" on stdout when compiled with "},{"type":"codeVoice","code":"DEBUG"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"info"},{"type":"text","text":" on stderr otherwise. You can override either default:"}],"type":"paragraph"},{"syntax":"swift","code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","YubiKit.Logs.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","YubiKit.Logs.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","YubiKit.Logs.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","YubiKit.Logs.configure()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Add "},{"identifier":"https:\/\/github.com\/apple\/swift-log","isActive":true,"type":"reference"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"Logging"},{"type":"text","text":" product to your app target"},{"type":"text","text":" "},{"type":"text","text":"to use its backend types. Any SwiftLog "},{"type":"codeVoice","code":"LogHandler"},{"type":"text","text":" can be supplied by the factory."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;"},{"type":"text","text":" "},{"type":"text","text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,"},{"type":"text","text":" "},{"type":"text","text":"though logs already in progress may use the previous settings."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,"},{"type":"text","text":" "},{"type":"text","text":"pass its factory explicitly; global "},{"type":"codeVoice","code":"LoggingSystem.bootstrap"},{"type":"text","text":" does not select YubiKit’s backend."},{"type":"text","text":" "},{"type":"text","text":"Factories may run concurrently and must not log through YubiKit themselves."}],"type":"paragraph"},{"text":"Traffic logging","level":3,"anchor":"Traffic-logging","type":"heading"},{"syntax":"swift","code":["YubiKit.Logs.configure(logLevel: .trace)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Raw traffic and SCP plaintext logs require "},{"inlineContent":[{"type":"text","text":"YubiKit to be compiled with "},{"type":"codeVoice","code":"DEBUG"}],"type":"strong"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Neither configuration nor a custom backend can enable them in other builds."},{"type":"text","text":" "},{"type":"text","text":"Custom connections are responsible for their own traffic logging."}],"type":"paragraph"},{"style":"warning","name":"Warning","content":[{"inlineContent":[{"type":"text","text":"Debug logs can include account names and credential identifiers."},{"type":"text","text":" "},{"type":"text","text":"Trace logs can include PINs, credentials, and cryptographic keys. Protect or redact logs before sharing them."}],"type":"paragraph"}],"type":"aside"},{"text":"Custom backends","level":3,"anchor":"Custom-backends","type":"heading"},{"inlineContent":[{"type":"text","text":"Labels identify categories, such as "},{"type":"codeVoice","code":"com.yubico.YubiKit.OATH"},{"type":"text","text":" or "},{"type":"codeVoice","code":"com.yubico.YubiKit.FIDO"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Metadata carries details such as byte counts and error codes; the default backend displays"},{"type":"text","text":" "},{"type":"text","text":"these as "},{"type":"codeVoice","code":"key=value"},{"type":"text","text":" pairs. Message wording and metadata keys are not a stable API."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","interfaceLanguage":"swift"},"metadata":{"title":"Logging","modules":[{"name":"YubiKit"}],"roleHeading":"Article","role":"article"},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"title":"Preparing your project","generated":true,"anchor":"Preparing-your-project"}],"sections":[],"abstract":[{"text":"Choose YubiKit’s log level and backend with ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"kind":"symbol","title":"YubiKit","role":"collection","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"images":[{"identifier":"documentation-header.png","type":"icon"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","url":"\/documentation\/yubikit","type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logs":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Logs"}],"url":"\/documentation\/yubikit\/logs","type":"topic","kind":"symbol","role":"symbol","title":"Logs","navigatorTitl
{"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Extension\/HmacSecret","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HmacSecret"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This extension allows a relying party to derive symmetric keys from a credential"},{"type":"text","text":" "},{"type":"text","text":"using HMAC-SHA-256 with user-provided salts. The derived keys can be used for"},{"type":"text","text":" "},{"type":"text","text":"encryption or other cryptographic operations."}]},{"type":"heading","level":2,"text":"MakeCredential Usage","anchor":"MakeCredential-Usage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Request hmac-secret support when creating a credential:"}]},{"type":"codeListing","syntax":"swift","code":["let hmacSecret = CTAP2.Extension.HmacSecret()","let ext = hmacSecret.makeCredential.input()","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    \/\/ hmac-secret is enabled","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or derive secrets at registration time (CTAP 2.2 hmac-secret-mc):"}]},{"type":"codeListing","syntax":"swift","code":["let hmacSecret = try await CTAP2.Extension.HmacSecret(session: session)","let ext = try hmacSecret.makeCredential.input(salt1: salt, salt2: salt2)","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    switc
{"sections":[],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","interfaceLanguage":"swift"},"kind":"article","metadata":{"title":"Logging","role":"article","modules":[{"name":"YubiKit"}],"roleHeading":"Article"},"abstract":[{"text":"Choose YubiKit’s log level and backend with ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"No setup is required. YubiKit defaults to ","type":"text"},{"code":"debug","type":"codeVoice"},{"text":" on stdout when compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"info","type":"codeVoice"},{"text":" on stderr otherwise. You can override either default:","type":"text"}]},{"type":"codeListing","code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","YubiKit.Logs.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","YubiKit.Logs.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","YubiKit.Logs.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","YubiKit.Logs.configure()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"identifier":"https:\/\/github.com\/apple\/swift-log","isActive":true,"type":"reference"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"Logging"},{"text":" product to your app target","type":"text"},{"text":" ","type":"text"},{"text":"to use its backend types. Any SwiftLog ","type":"text"},{"type":"codeVoice","code":"LogHandler"},{"type":"text","text":" can be supplied by the factory."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;"},{"type":"text","text":" "},{"type":"text","text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,"},{"type":"text","text":" "},{"type":"text","text":"though logs already in progress may use the previous settings."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,"},{"type":"text","text":" "},{"type":"text","text":"pass its factory explicitly; global "},{"type":"codeVoice","code":"LoggingSystem.bootstrap"},{"type":"text","text":" does not select YubiKit’s backend."},{"type":"text","text":" "},{"type":"text","text":"Factories may run concurrently and must not log through YubiKit themselves."}]},{"level":3,"type":"heading","text":"Traffic logging","anchor":"Traffic-logging"},{"type":"codeListing","code":["YubiKit.Logs.configure(logLevel: .trace)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Raw traffic and SCP plaintext logs require "},{"inlineContent":[{"type":"text","text":"YubiKit to be compiled with "},{"type":"codeVoice","code":"DEBUG"}],"type":"strong"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Neither configuration nor a custom backend can enable them in other builds."},{"type":"text","text":" "},{"text":"Custom connections are responsible for their own traffic logging.","type":"text"}]},{"style":"warning","type":"aside","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"text":"Debug logs can include account names and credential identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Trace logs can include PINs, credentials, and cryptographic keys. Protect or redact logs before sharing them.","type":"text"}]}]},{"level":3,"text":"Custom backends","type":"heading","anchor":"Custom-backends"},{"inlineContent":[{"type":"text","text":"Labels identify categories, such as "},{"type":"codeVoice","code":"com.yubico.YubiKit.OATH"},{"type":"text","text":" or "},{"type":"codeVoice","code":"com.yubico.YubiKit.FIDO"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Metadata carries details such as byte counts and error codes; the default backend displays"},{"type":"text","text":" "},{"type":"text","text":"these as "},{"type":"codeVoice","code":"key=value"},{"type":"text","text":" pairs. Message wording and metadata keys are not a stable API."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/yubikit\/loggingguide"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"generated":true,"title":"Preparing your project","anchor":"Preparing-your-project"}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/GettingStarted":{"title":"Getting Started","url":"\/documentation\/yubikit\/gettingstarted","type":"topic","abstract":[{"text":"Prepare your project to connect to the YubiKey via NFC, SmartCard, Lightning and USB HID.","type":"text"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","kind":"article","role":"article"},"documentation-header.png":{"type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png"}],"identifier":"documentation-header.png","alt":"YubiKeys in a row"},"doc://yubikit-swift.Y
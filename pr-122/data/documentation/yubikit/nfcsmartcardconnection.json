{"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A NFC connection to the YubiKey."}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Connection","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","doc:\/\/yubikit-swift.YubiKit\/s8SendableP","doc:\/\/yubikit-swift.YubiKit\/s16SendableMetatypeP"],"kind":"relationships"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Creating a Connection","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/init()","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/init(alertMessage:)","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/setAlertMessage(_:)"],"anchor":"Creating-a-Connection"},{"title":"Connection Lifecycle","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/close(error:)","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/close(message:)","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/waitUntilClosed()"],"anchor":"Connection-Lifecycle"},{"title":"Sending Data","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/send(data:)"],"anchor":"Sending-Data"},{"title":"Errors","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnectionError"],"anchor":"Errors"},{"generated":true,"title":"Type Methods","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/makeConnection()","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/makeConnection(alertMessage
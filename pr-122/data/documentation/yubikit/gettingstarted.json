":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/CTAP2/Session":{"role":"symbol","title":"CTAP2.Session","kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","abstract":[{"type":"text","text":"Interface to the FIDO2\/CTAP authenticator on the YubiKey."}],"url":"\/documentation\/yubikit\/ctap2\/session","navigatorTitle":[{"kind":"identifier","text":"Session"}],"type":"topic"},"nfc-entitlement.png":{"type":"image","identifier":"nfc-entitlement.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to add wireless entitlements to project."},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authorization":{"abstract":[{"type":"text","text":"PIN\/UV policy for a single WebAuthn ceremony."}],"type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","navigatorTitle":[{"kind":"identifier","text":"Authorization"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Authorization"}],"role":"symbol","kind":"symbol","title":"WebAuthn.Authorization","url":"\/documentation\/yubikit\/webauthn\/authorization"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"role":"collection","title":"YubiKit","images":[{"type":"icon","identifier":"documentation-header.png"}],"url":"\/documentation\/yubikit","kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","type":"topic"},"nfc-privacy.png":{"type":"image","identifier":"nfc-privacy.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to add the NFC privacy string to a project."},"smart-card.png":{"type":"image","identifier":"smart-card.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/smart-card@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/smart-card~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing how to add NFC privacy string to project."},"nfc-identifiers-list.png":{"type":"image","identifier":"nfc-identifiers-list.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list~dark@2x.png","traits":["2x","dark"]}],"alt":"An image showing the list of nfc identifiers added."},"external-accessory.png":{"identifier":"external-accessory.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory~dark@2x.png","traits":["2x","dark"]}],"type":"image","alt":"An image showing how to support for lightning YubiKeys."},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"role":"symbol","title":"WebAuthn.Client","url":"\/documentation\/yubikit\/webauthn\/client","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","navigatorTitle":[{"text":"Client","kind":"identifier"}],"type":"topic"},"documentation-header.png":{"alt":"YubiKeys in a row","type":"image","identifier":"documentation-header.png","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swi
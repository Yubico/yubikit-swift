:"\/images\/yubikit-swift.YubiKit\/nfc-entitlement@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement~dark@2x.png","traits":["2x","dark"]}],"identifier":"nfc-entitlement.png","type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/CTAP2/Session":{"title":"CTAP2.Session","navigatorTitle":[{"kind":"identifier","text":"Session"}],"role":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","kind":"symbol","type":"topic","url":"\/documentation\/yubikit\/ctap2\/session","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Session"}],"abstract":[{"type":"text","text":"Interface to the FIDO2\/CTAP authenticator on the YubiKey."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"type":"topic","abstract":[{"type":"text","text":"An interface to the Management application on the YubiKey."}],"title":"Management.Session","url":"\/documentation\/yubikit\/management\/session","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"text":"Session","kind":"identifier"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Session","kind":"identifier"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},"external-accessory.png":{"alt":"An image showing how to support for lightning YubiKeys.","type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory~dark@2x.png","traits":["2x","dark"]}],"identifier":"external-accessory.png"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"title":"YubiKit","role":"collection","url":"\/documentation\/yubikit","kind":"symbol","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","images":[{"type":"icon","identifier":"documentation-header.png"}],"abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSampleCode":{"role":"sampleCode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","type":"topic","url":"\/documentation\/yubikit\/oathsamplecode","title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","kind":"article","abstract":[{"text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"reference"},{"text":" to retrieve authentication codes, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"reference"},{"text":" to get device information.","type":"text"}]}}}
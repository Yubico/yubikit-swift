lient\/makeCredential(_:authorization:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use a built-in factory for trivial cases:"}],"type":"paragraph"},{"code":["let r = try await client.makeCredential(opts, authorization: .pin(\"1234\")).value"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or build a custom instance to bridge into a UI:"}],"type":"paragraph"},{"code":["let auth = WebAuthn.Authorization(providePIN: {","    guard let pin = await viewModel.askForPIN() else { return .cancel }","    return .pin(pin)","})","let r = try await client.makeCredential(opts, authorization: auth).value"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"PIN attempts are one-shot: a wrong PIN throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/pinRejected(retriesRemaining:source:)","isActive":true},{"type":"text","text":" and the caller"},{"type":"text","text":" "},{"type":"text","text":"decides whether to re-prompt and retry the ceremony with a fresh"},{"type":"text","text":" "},{"type":"codeVoice","code":"Authorization"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"PIN and user-verification policy for a single WebAuthn ceremony."}],"type":"paragraph"},{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"Authorization"},{"type":"text","text":" is supplied per ceremony to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","isActive":true},{"type":"text","text":". It carries a "},{"type":"codeVoice","code":"providePIN"},{"type":"text","text":" "},{"type":"text","text":"closure the SDK invokes when a PIN is needed, and a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/UVPolicy","isActive":true},{"type":"text","text":" deciding whether"},{"type":"text","text":" "},{"type":"text","text":"built-in user verification (e.g. fingerprint on a YubiKey Bio) is attempted."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"PIN entry happens out-of-band: the SDK never surfaces a PIN prompt on the"},{"type":"text","text":" "},{"type":"text","text":"ceremony’s "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/StatusStream","isActive":true},{"type":"text","text":". The closure is invoked when the ceremony"},{"type":"text","text":" "},{"type":"text","text":"requires user verification and the PIN path is chosen — when built-in UV isn’t"},{"type":"text","text":" "},{"type":"text","text":"available, has been blocked, or is ruled out by the "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/UVPolicy","isActive":true},{"type":"text","text":" on this"},{"type":"text","text":" "},{"type":"codeVoice","code":"Authorization"},{"type":"text","text":". If built-in UV succeeds, the closure is never called. PIN"},{"type":"text","text":" "},{"type":"text","text":"attempts are one-shot: a wrong PIN throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/pinRejected(retriesRemaining:source:)","isActive":true},{"type":"text","text":" an
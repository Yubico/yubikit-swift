,{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" companion module."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"role":"symbol","url":"\/documentation\/yubikit\/management\/session","kind":"symbol","navigatorTitle":[{"text":"Session","kind":"identifier"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Session","kind":"identifier"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","title":"Management.Session","type":"topic","abstract":[{"type":"text","text":"An interface to the Management application on the YubiKey."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"title":"WebAuthn.Client","type":"topic","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"navigatorTitle":[{"text":"Client","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}],"url":"\/documentation\/yubikit\/webauthn\/client"},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"title":"YubiKit","images":[{"identifier":"documentation-header.png","type":"icon"}],"abstract":[{"text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB.","type":"text"}],"url":"\/documentation\/yubikit","type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"}}}
ort connecting using NFC, Lightning and USB."}],"title":"YubiKit","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"},"nfc-privacy.png":{"alt":"An image showing how to add the NFC privacy string to a project.","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-privacy~dark@2x.png","traits":["2x","dark"]}],"identifier":"nfc-privacy.png","type":"image"},"documentation-header.png":{"alt":"YubiKeys in a row","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","traits":["2x","dark"]}],"identifier":"documentation-header.png","type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"url":"\/documentation\/yubikit\/oathsession","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"OATHSession"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"OATHSession"}],"abstract":[{"text":"An interface to the OATH application on the YubiKey.","type":"text"}],"title":"OATHSession","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}],"navigatorTitle":[{"text":"PIVSession","kind":"identifier"}],"title":"PIVSession","abstract":[{"type":"text","text":"An interface to the PIV application on the YubiKey."}],"url":"\/documentation\/yubikit\/pivsession","role":"symbol","type":"topic","kind":"symbol"},"nfc-identifiers-list.png":{"alt":"An image showing the list of nfc identifiers added.","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list~dark@2x.png","traits":["2x","dark"]}],"identifier":"nfc-identifiers-list.png","type":"image"},"smart-card.png":{"alt":"An image showing how to add NFC privacy string to project.","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/smart-card@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/smart-card~dark@2x.png","traits":["2x","dark"]}],"identifier":"smart-card.png","type":"image"},"nfc-identifiers.png":{"alt":"An image showing how to add the nfc application identifiers.","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers~dark@2x.png","traits":["2x","dark"]}],"identifier":"nfc-identifiers.png","type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/SmartCardConnection":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SmartCardConnection","kind":"identifier"}],"navigatorTitle":[{"text":"SmartCardConnection","kind":"identifier"}],"title":"SmartCardConnection","abstract":[{"type":"text","text":"An interface defining a SmartCard based connection to a YubiKey."}],"url":"\/documentation\/yubikit\/smartcardconnection","role":"symbol","type":"topic","kind":"symbol"},"add-framework-1.png":{"alt":"An image showing how to add the YubiKit SDK to your Xcode project.","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/add-framework-1~dark@2x.png","traits":["2x","dark"]}],"identifier":"add-framework-1.png","type":"image"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSampleCode":{"role":"sampleCode","type":"topic","url":"\/documentation\/yubikit\/oathsamplecode","abstract":[{"text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession"},{"text":" to retrieve authentication codes, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},{"text":" to get device information.","type":"text"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","kind":"article"},"external-accessory.png":{"alt":"An image showing how to support for lightning YubiKeys.","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory~dark@2x.png","traits":["2x","dark"]}],"identifier":"external-accessory.png","type":"image"}}}
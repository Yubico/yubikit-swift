 Bio).","type":"text"}]},{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"BioEnrollment manages fingerprint enrollments on biometric authenticators. It requires a","type":"text"},{"text":" ","type":"text"},{"text":"PIN\/UV auth token with the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/ClientPin\/Permission\/bioEnrollment"},{"type":"text","text":" permission."}],"type":"paragraph"},{"code":["let token = try await session.getPinUVToken(","    using: .pin(\"123456\"),","    permissions: [.bioEnrollment]",")","let bio = try await session.bioEnrollment(token: token)","","\/\/ Check sensor capabilities","let sensorInfo = try await bio.getFingerprintSensorInfo()","","\/\/ Enroll a new fingerprint","for try await sample in bio.enroll(timeout: 10000) {","    switch sample {","    case .waitingForUser:","        print(\"Touch the sensor...\")","    case .sample(let status, let remaining):","        print(\"Captured: \\(status), \\(remaining) remaining\")","    case .completed(let templateId, _):","        print(\"Enrollment complete!\")","    }","}","","\/\/ List existing enrollments","for try await enrollment in bio.enrollments {","    print(\"\\(enrollment.templateId): \\(enrollment.friendlyName ?? \"unnamed\")\")","}"],"syntax":"swift","type":"codeListing"}]}],"variants":[{"paths":["\/documentation\/yubikit\/ctap2\/bioenrollment"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"YubiKit"}],"symbolKind":"struct","role":"symbol","externalID":"s:7YubiKit5CTAP2O13BioEnrollmentV","roleHeading":"Structure","extendedModule":"YubiKit","navigatorTitle":[{"text":"BioEnrollment","kind":"identifier"}],"title":"CTAP2.BioEnrollment","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BioEnrollment","kind":"identifier"}]},"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/CTAP2/BioEnrollm
hmac-secret extension for deriving symmetric keys from credentials.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HmacSecret","kind":"identifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"This extension allows a relying party to derive symmetric keys from a credential"},{"type":"text","text":" "},{"type":"text","text":"using HMAC-SHA-256 with user-provided salts. The derived keys can be used for"},{"text":" ","type":"text"},{"text":"encryption or other cryptographic operations.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"MakeCredential-Usage","text":"MakeCredential Usage","type":"heading"},{"inlineContent":[{"text":"Request hmac-secret support when creating a credential:","type":"text"}],"type":"paragraph"},{"code":["let hmacSecret = CTAP2.Extension.HmacSecret()","let ext = hmacSecret.makeCredential.input()","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    \/\/ hmac-secret is enabled","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Or derive secrets at registration time (CTAP 2.2 hmac-secret-mc):","type":"text"}],"type":"paragraph"},{"code":["let hmacSecret = try await CTAP2.Extension.HmacSecret(session: session)","let ext = try hmacSecret.makeCredential.input(salt1: salt, salt2: salt2)","let params = CTAP2.MakeCredential.Parameters(..., extensions: [ext])","let response = try await session.makeCredential(params)","if let result = try hmacSecret.makeCredential.output(from: response) {","    switch result {","    case .enabled:","        \/\/ hmac-secret-mc not supported, but hmac-secret is enabled","    case .secrets(let secrets):","        \/\/ Use derived keys (secrets.first, secrets.second)","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"GetAssertion-Usage","text":"GetAssertion Usage","type":"heading"},{"inlineContent":[{"text":"Derive keys during authentication:","type":"text"}],"type":"paragraph"},{"code":["let hmacSecret = try await CTAP2.Extension.HmacSecret(session: session)","let ext = try hmacSecret.getAssertion.input(salt1: salt)","let params = CTAP2.GetAssertion.Parameters(..., extensions: [ext])","let response = try await session.getAssertion(params)","if let secrets = try hmacSecret.getAssertion.output(from: response) {","    \/\/ Use derived keys (secrets.first, secrets.second)","}"],"syntax":"swift","type":"codeListing"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"https:\/\/fidoalliance.org\/specs\/fido-v2.2-ps-20250714\/fido-client-to-authenticator-protocol-v2.2-ps-20250714.html#sctn-hmac-secret-extension"}],"type":"paragraph"}],"name":"See Also","style":"note","type":"aside"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"https:\/\/fidoalliance.org\/specs\/fido-v2.2-ps-20250714\/fido-client-to-authenticator-protocol-v2.2-ps-20250714.html#sctn-hmac-secret-make-cred-extension"}],"type":"paragraph"}],"name":"See Also","style":"note","type":"aside"}]}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Extension"]]},"sections":[],"kind":"symbol","seeAlsoSections":[{"title":"Available Extensions","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Extension\/CredProtect","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Extension\/CredBlob","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Extensio
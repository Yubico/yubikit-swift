Package” button to add the SDK to your project."}],"type":"paragraph"}]}],"start":4},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"add-framework-2.png"}]},{"type":"heading","text":"NFC","anchor":"NFC","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want your app to communicate with YubiKeys via NFC you need to add the wireless entitlement, list of NFC"},{"type":"text","text":" "},{"type":"text","text":"application identifiers and a NFC Privacy statement to the application."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Add Wireless entitlement"}]}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Select your project."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select your application target."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Choose the “Signing & Capabilities” tab."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Click the “+”-button to add a new capability."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select the “Near Field Communication Tag” capability."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-entitlement.png"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Add list of NFC application identifiers"}]}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Choose the “Info” tab."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the “ISO7816 application identifiers for NFC” key to the “Custom iOS Target Properties”."}],"type":"paragraph"}]}],"start":6},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-identifiers.png"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Add the Yubico NFC application identifiers to enable communication with the different"},{"type":"text","text":" "},{"type":"text","text":"applications on the YubiKey."}],"type":"paragraph"}]}],"start":8},{"type":"codeListing","code":["A000000527471117  \/\/ YubiKey Management Application","A0000006472F0001  \/\/ FIDO\/U2F","A0000005272101    \/\/ OATH","A000000308        \/\/ PIV","A000000527200101  \/\/ YubiKey application\/OTP (for HMAC SHA1 challenge-response)","A000000151000000  \/\/ Security Domain"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-identifiers-list.png"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Add a NFC Privacy description"}]}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Add the “Privacy - NFC Usage Scan Description” key and a string that describes what you will use NFC for in"},{"type":"text","text":" "},{"type":"text","text":"the application e.g “The application needs access to NFC reading to communicate with your YubiKey.”"}],"type":"paragraph"}]}],"start":9},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"nfc-privacy.png"}]},{"type":"heading","text":"SmartCard\/USB","anchor":"SmartCardUSB","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"To support YubiKeys connected via the USB port on a device running iOS 16 or higher, you need to add the"},{"type":"text","text":" "},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"type":"text","text":" entitlement to your application."}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Select the application entitlements file."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" entitlement to the entitlement list."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"smart-card.png"}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"USB SmartCard supports Yubico OTP slot programming. HMAC-SHA1 challenge-response requires"},{"type":"text","text":" "},{"type":"codeVoice","code":"HIDOTPConnection"},{"type":"text","text":" on macOS, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LightningSmartCardConnection"},{"type":"text","text":", or NFC without a touch requirement."},{"type":"text","text":" "},{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session"},{"type":"text","text":"."}]}]},{"type":"heading","text":"Lightning\/AccessoryConnection i.e 5Ci YubiKey","anchor":"LightningAccessoryConnection-ie-5Ci-YubiKey","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for the 5Ci YubiKey that connect to the iPhone via the Lightning port you need to add the "},{"code":"com.yubico.ylp","type":"codeVoice"},{"type":"text","text":" string to the list of External Accessories."}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Select your project."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select your application target."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Choose the “Info” tab."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If not present add the "},{"type":"codeVoice","code":"Supported external accessory protocols"},{"type":"text","text":" key and insert the string "},{"type":"codeVoice","code":"com.yubico.ylp"},{"type":"text","text":" in its list."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"external-accessory.png"}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The YubiKey 5Ci is an Apple MFi certified external accessory and communicates over iAP2. Setting the value for "},{"type":"codeVoice","code":"Supported external accessory protocols"},{"type":"text","text":" to "},{"type":"codeVoice","code":"com.yubico.ylp"},{"type":"text","text":" will tell the app that all communication with the 5Ci YubiKey via the Lightning port is done using the External Accessory framework."}]}]},{"type":"heading","text":"Making Your First Connection","anchor":"Making-Your-First-Connection","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Now that your project is configured, you can start connecting to YubiKeys. YubiKit provides different connection types depending on how the YubiKey is connected to the device."}]},{"type":"heading","text":"Understanding Connection Types","anchor":"Understanding-Connection-Types","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit provides the following connection methods:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"NFC","type":"text"}]},{"type":"text","text":": Short-range wireless communication (iOS only)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"USB","type":"text"}]},{"type":"text","text":": Direct USB connection via SmartCard interface"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Lightning","type":"text"}]},{"type":"text","text":": YubiKey 5Ci connected to Lightning port (iOS only)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"USB HID","type":"text"}]},{"type":"text","text":": Direct access to the FIDO or OTP interface (macOS only)"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each connection type works differently, so let’s explore how to use them."}]},{"type":"heading","text":"NFC Connections","anchor":"NFC-Connections","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"NFC connections are user-initiated and short-lived. The user must bring their YubiKey close to their device:"}]},{"type":"codeListing","code":["import YubiKit","","\/\/ Start an NFC scan","do {","    let connection = try await NFCSmartCardConnection()","","    \/\/ Use the connection quickly - NFC sessions have a timeout","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Always close NFC connections with a user message","    await connection.close(message: \"OATH codes retrieved\")","","} catch {","    \/\/ Handle connection errors (user cancelled, no YubiKey found, etc.)","    print(\"NFC connection failed: \\(error)\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"NFC connections automatically show the iOS NFC interface and require user interaction to complete."}]},{"type":"heading","text":"USB and Lightning Connections","anchor":"USB-and-Lightning-Connections","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wired connections are persistent - they stay connected until the YubiKey is unplugged:"}]},{"type":"codeListing","code":["import YubiKit","","\/\/ Connect to any wired YubiKey (USB or Lightning)","do {","    let connection = try await WiredSmartCardConnection.makeConnection()","","    \/\/ Perform operations - connection stays active","    let session = try await OATHSession.makeSession(connection: connection)","    let codes = try await session.calculateCredentialCodes()","","    \/\/ Monitor for disconnection or close when done","    let error = await connection.waitUntilClosed()","    if let error = error {","        print(\"Connection closed with error: \\(error)\")","    }","","} catch {","    print(\"Wired connection failed: \\(error)\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"WiredSmartCardConnection.makeConnection()","type":"codeVoice"},{"type":"text","text":" method automatically detects whether you’re using USB or Lightning."}]},{"type":"heading","text":"Specific Connection Types","anchor":"Specific-Connection-Types","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more control, you can connect to specific interfaces:"}]},{"type":"codeListing","code":["\/\/ USB only","let usbConnection = try await USBSmartCardConnection()","","\/\/ Lightning only (iOS)","let lightningConnection = try await LightningSmartCardConnection()","","\/\/ NFC with custom message (iOS)","let nfcConnection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS, use "},{"code":"HIDOTPConnection","type":"codeVoice"},{"type":"text","text":" for the OTP keyboard interface or "},{"code":"HIDFIDOConnection","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the FIDO interface:"}]},{"type":"codeListing","code":["let otpConnection = try await HIDOTPConnection()"],"syntax":"swift"},{"type":"heading","text":"Understanding Connection Lifecycle","anchor":"Understanding-Connection-Lifecycle","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Critical:"}]},{"type":"text","text":" Connections must be explicitly closed. You can only have one active connection to a YubiKey at any time."}]},{"type":"heading","text":"Connection Behavior","anchor":"Connection-Behavior","level":3},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Exclusive access","type":"text"}]},{"type":"text","text":": Only one connection can exist per YubiKey at any time"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Manual closure required","type":"text"}]},{"type":"text","text":": Dropping a connection reference does NOT automatically close it - you must call "},{"type":"codeVoice","code":"close()"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Resource blocking","type":"text"}]},{"type":"text","text":": An unclosed connection prevents new connections (throws "},{"type":"codeVoice","code":"SmartCardConnectionError.busy"},{"type":"text","text":")"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each connection is a lightweight value type that identifies an active hardware session. Copying a connection creates another handle to the same session, not a new connection - the hardware is only released when you call "},{"code":"close()","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","text":"Working with Sessions","anchor":"Working-with-Sessions","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once you have a connection, create sessions to access different YubiKey applications:"}]},{"type":"heading","text":"OATH Session (TOTP\/HOTP codes)","anchor":"OATH-Session-TOTPHOTP-codes","level":3},{"type":"codeListing","code":["let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","","for (credential, code) in codes {","    print(\"\\(credential.label): \\(code?.code ?? \"Touch required\")\")","}"],"syntax":"swift"},{"type":"heading","text":"Yubico OTP Session (OTP slots)","anchor":"Yubico-OTP-Session-OTP-slots","level":3},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","isActive":true},{"type":"text","text":" manages the two OTP slots. Create it with a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","isActive":true},{"type":"text","text":" or,"},{"type":"text","text":" "},{"type":"text","text":"on macOS, an "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OTPConnection","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","code":["let session = try await YubiOTP.Session.makeSession(connection: connection)","let state = await session.configState","print(\"Slot 2 configured: \\(try state.isConfigured(.two))\")","","\/\/ Program slot 2 for HOTP, replacing its existing configuration","try await session.putConfiguration(.hotp(key: secret), in: .two)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/YubiOTP\/Session","isActive":true},{"type":"text","text":" for HMAC-SHA1 challenge-response, transport support, and NFC output."}]},{"type":"heading","text":"PIV Session (Certificates and keys)","anchor":"PIV-Session-Certificates-and-keys","level":3},{"type":"codeListing","code":["let session = try await PIVSession.makeSession(connection: connection)","let certificate = try await session.getCertificate(in: .authentication)","print(\"Found certificate: \\(certificate.subject)\")"],"syntax":"swift"},{"type":"heading","text":"Management Session (Device information)","anchor":"Management-Session-Device-information","level":3},{"type":"codeListing","code":["let session: Management.Session = try await .makeSession(connection: connection)","print(\"YubiKey version: \\(await session.version)\")","","let deviceInfo = try await session.getDeviceInfo()","print(\"Device info: \\(deviceInfo)\")"],"syntax":"swift"},{"type":"heading","text":"WebAuthn Client (FIDO2 \/ passkeys)","anchor":"WebAuthn-Client-FIDO2--passkeys","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For passkey registration and authentication, "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" wraps a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"type":"text","text":" and runs the W3C ceremonies end-to-end. CTAP2 sessions can"},{"type":"text","text":" "},{"type":"text","text":"use "},{"code":"HIDFIDOConnection","type":"codeVoice"},{"type":"text","text":" (USB HID on macOS) or any "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","isActive":true},{"type":"text","text":" "},{"type":"text","text":"(NFC \/ USB CCID)."}]},{"type":"codeListing","code":["let connection = try await HIDFIDOConnection()","let session = try await CTAP2.Session.makeSession(connection: connection)","","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","let response = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"PIN and UV are supplied per ceremony via "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","isActive":true},{"type":"text","text":". For raw"},{"type":"text","text":" "},{"type":"text","text":"CTAP2 access (credential management, bio enrollment, large blobs), use"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"type":"text","text":" directly."}]},{"type":"heading","text":"Connection Management Patterns","anchor":"Connection-Management-Patterns","level":2},{"type":"heading","text":"For UI Applications","anchor":"For-UI-Applications","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"In SwiftUI or UIKit apps, you typically want to maintain persistent connections and react to connection changes. See "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","isActive":true},{"type":"text","text":" for complete examples of reactive connection management patterns that automatically update your UI when YubiKeys are plugged in or removed."}]},{"type":"heading","text":"For Command-Line Tools","anchor":"For-Command-Line-Tools","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"CLI applications often use a simpler approach with a single connection per operation. See "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","isActive":true},{"type":"text","text":" for examples of how command-line tools handle connections for one-time operations."}]},{"type":"heading","text":"Next Steps","anchor":"Next-Steps","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Now you’re ready to build YubiKey applications! Check out the sample projects to see complete implementations:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"OATHSample","type":"text"}]},{"type":"text","text":": Shows how to build a TOTP authenticator app with SwiftUI"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"PIVTool","type":"text"}]},{"type":"text","text":": Demonstrates PIV operations for certificates and digital signatures"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"WebAuthnInterceptorSample","type":"text"}]},{"type":"text","text":": Routes WebAuthn calls from a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" through "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" to a YubiKey"}],"type":"paragraph"}]}]},{"type":"heading","text":"Build SDK documentation","anchor":"Build-SDK-documentation","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also build the complete SDK documentation by selecting “Product” -> “Build Documentation” in Xcode. This gives you access to the full YubiKit API reference."}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select an iOS target to include NFC and Lightning connections, or a macOS target to include"},{"type":"text","text":" "},{"type":"text","text":"USB HID connections."}]}]}]}],"kind":"article","references":{"nfc-entitlement.png":{"type":"image","identifier":"nfc-entitlement.png","alt":"An image showing how to add wireless entitlements to project.","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement~dark@2x.png"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"navigatorTitle":[{"text":"Client","kind":"identifier"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}],"url":"\/documentation\/yubikit\/webauthn\/client","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"type":"topic","title":"WebAuthn.Client","kind":"symbol","role":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"navigatorTitle":[{"text":"PIVSession","kind":"identifier"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}],"url":
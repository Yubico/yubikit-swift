or":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This WebAuthn extension wraps the CTAP2 hmac-secret extension, transforming"},{"type":"text","text":" "},{"type":"text","text":"PRF secrets into hmac-secret salts using "},{"type":"codeVoice","code":"SHA-256(\"WebAuthn PRF\\0\" + secret)"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Simple-Usage-single-credential","text":"Simple Usage (single credential)"},{"type":"codeListing","code":["let prf = try await WebAuthn.Extension.PRF(session: session)","let ext = try prf.getAssertion.input(first: userSecret)","let params = CTAP2.GetAssertion.Parameters(..., extensions: [ext])","let response = try await session.getAssertion(parameters: params)","if let secrets = try prf.getAssertion.output(from: response) {","    \/\/ Use derived keys","}"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Multi-credential-Usage-evalByCredential","text":"Multi-credential Usage (evalByCredential)"},{"type":"codeListing","syntax":"swift","code":["let prf = try await WebAuthn.Extension.PRF(","    first: defaultSecret,","    evalByCredential: [credIdA: (secretA, nil), credIdB: (secretB, nil)],","    session: session",")","","\/\/ After credential selection:","let ext = try prf.getAssertion.input(for: selectedCredentialId)","let params = CTAP2.GetAssertion.Parameters(..., extensions: [ext])","let response = try await session.getAssertion(parameters: params)","if let secrets = try prf.getAssertion.output(from: response) {","    \/\/ Use derived keys","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pseudo-random function extension for deriving symmetric secrets bound to a credential."}]},{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PRF"},{"type":"text","text":" lets a relying party derive deterministic symmetric secrets from a credential"},{"type":"text","text":" "},{"type":"text","text":"— the same input produces the same output every time the user authenticates with"},{"type":"text","text":" "},{"type":"text","text":"that credential. It’s the "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/#prf-extension"},{"type":"text","text":" "},{"type":"text","text":"for credential-bound key derivation, built on the CTAP2 "},{"type":"codeVoice","code":"hmac-secret"},{"type":"text","text":" extension."},{"type":"text","text":" "},{"type":"text","text":"The SDK transforms each PRF input with "},{"type":"codeVoice","code":"SHA-256(\"WebAuthn PRF\\0\" || input)"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"text","text":"sending it to the authenticator — that domain separation is mandated by the spec."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In a high-level WebAuthn flow, configure "},{"type":"codeVoice","code":"PRF"},{"type":"text","text":" per ceremony via"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/RegistrationInputs\/prf"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/AuthenticationInputs\/prf"},{"type":"text","text":"; outputs come back on"},{"type":"text","text":" "},{"type":"codeVoice","code":"clientExtensionResults"},{"type":"text","text":" of the corresponding "},{"type":"codeVoice","code":"Response"},{"type":"text","text":". Registration enables"},{"type":"text","text":" "},{"type":"text","text":"PRF on a credential, optionally deriving secrets at the same time on"},{"type":"text","text":" "},{"type":"text","text":"authenticators that support hmac-secret-mc. Authentication evaluates the PRF at"},{"type":"text","text":" "},{"type":"text","text":"one or more inputs and returns the derived bytes."}]},{"type":"codeListing","code":["\/\/ Registration: enable PRF on the new credential","let regOpts = WebAuthn.Registration.Options(","    challenge: challenge,","    rp: .init(id: \"example.com\", name: \"Example\"),","    user: .init(id: userId, name: \"alice@example.com\"),","    extensions: .init(prf: .enable)",")","let registration = try await client.makeCredential(regOpts, authorization: auth).value","","\/\/ Authentication: derive a secret bound to the credential","let authOpts = WebAuthn.Authentication.Options(","    challenge: challenge,","    rpId: \"example.com\",","    allowCredentials: [.init(id: storedCredentialId)],","    extensions: .init(prf: .eval(first: encryptionSeed))",")","let assertions = try await client.getAssertion(authOpts, authorization: auth).value","let derived = assertions.first?.clientExtensionResults.prf?.results.first"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For multi-credential flows where each credential needs different inputs, populate"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PRF\/Authentication\/Input\/evalByCredential"},{"type":"text","text":" with secrets keyed by credential id, with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PRF\/Authentication\/Input\/eval"},{"type":"text","text":" as the default for credentials not in the map."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PRF"},{"type":"text","text":" can also be used directly against a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"type":"text","text":" — bypassing"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"type":"text","text":" — for callers that drive CTAP2 themselves. Construct an"},{"type":"text","text":" "},{"type":"text","text":"instance with "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PRF\/init(session:)","isActive":true},{"type":"text","text":" (or one of the secret-carrying initialisers),"},{"type":"text","text":" "},{"type":"text","text":"then use "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PRF\/makeCredential","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PRF\/getAssertion","isActive":true},{"type":"text","text":" to build CTAP2 extension inputs"},{"type":"text","text":" "},{"type":"text","text":"and parse outputs."}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/yubikit-swift.YubiKit\/s8SendableP","doc:\/\/yubikit-swift.YubiKit\/s16SendableMetatypeP"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/webauthn\/extension\/prf"]}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Extension/PRF/Results":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Results"}],"abstract":[{"text":"Derived PRF secrets (first and optional second).","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Results"}],"title":"WebAuthn.Extension.PRF.Results","url":"\/documentation\/yubikit\/webauthn\/extension\/prf\/results","kind":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/PRF\/Results","role":"symbol"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Extension/PRF/Registration":{"abstract"
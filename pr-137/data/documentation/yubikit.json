{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"The YubiKit Swift SDK provides a modern async\/await version of the YubiKit framework, making it easy to integrate","type":"text"},{"type":"text","text":" "},{"type":"text","text":"in Swift and SwiftUI based applications. The async\/await syntax provides an easy to read and powerful way of"},{"type":"text","text":" "},{"type":"text","text":"creating connections and sending commands to the different applications on the YubiKey."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let connection = try await NFCSmartCardConnection()","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()"]},{"style":"warning","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"text":"This SDK does not perform zeroization of sensitive data in memory. Cryptographic keys, PIN tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and other secrets are not securely erased when no longer in use. This is currently out of scope but may be","type":"text"},{"type":"text","text":" "},{"text":"addressed in a future release.","type":"text"}]}],"type":"aside"}]}],"metadata":{"color":{"standardColorIdentifier":"green"},"modules":[{"name":"YubiKit"}],"role":"collection","platforms":[{"introducedAt":"16.0","beta":false,"name":"iOS"},{"beta":false,"name":"macOS","introducedAt":"13.0"}],"externalID":"YubiKit","symbolKind":"module","roleHeading":"Framework","images":[{"type":"icon","identifier":"documentation-header.png"}],"title":"YubiKit"},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit"]}],"hierarchy":{"paths":[[]]},"topicSections":[{"ti
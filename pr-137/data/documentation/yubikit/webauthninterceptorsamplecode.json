{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The interceptor demonstrates how to:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Intercept "},{"type":"codeVoice","code":"navigator.credentials.create()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"navigator.credentials.get()"},{"type":"text","text":" in a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options"},{"type":"text","text":" \/ "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options"},{"type":"text","text":" types."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Drive the SDK’s high-level "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the bundled "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface."}]},{"level":2,"anchor":"Architecture-Overview","type":"heading","text":"Architecture Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample itself is intentionally thin:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Interceptor.js"}]},{"type":"text","text":" — injected into the "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" to monkey-patch "},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"type":"text","text":" and shuttle requests\/responses through "},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"WebView.swift"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"UIViewRepresentable"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"NSViewRepresentable"},{"type":"text","text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"WebAuthnHandler.swift"}]},{"type":"text","text":" — decodes the JSON envelope, builds a "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","isActive":true,"type":"reference"},{"type":"text","text":", and calls "},{"type":"codeVoice","code":"FidoUI.makeCredential"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"FidoUI.getAssertion"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"ContentView.swift"}]},{"type":"text","text":" — minimal SwiftUI shell with a URL bar and back button."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"FidoUI"}]},{"type":"text","text":" (separate Swift package under "},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI"},{"type":"text","text":") — the reusable UI + transport layer described below."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The end-to-end flow:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page JS calls "},{"type":"codeVoice","code":"navigator.credentials.create()"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".get()"},{"type":"text","text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" decodes the JSON straight into the SDK’s strongly-typed "},{"type":"codeVoice","code":"Options"},{"type":"text","text":" and hands them to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" opens a transport, runs the ceremony via "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"type":"text","text":", and shows PIN \/ UV \/ error \/ success panels as needed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The resulting "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","isActive":true,"type":"reference"},{"type":"text","text":" is serialized via its built-in "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" and posted back to JS."}]}]}]},{"type":"heading","text":"Intercepting WebAuthn Calls","anchor":"Intercepting-WebAuthn-Calls","level":2},{"type":"heading","text":"JavaScript Injection","anchor":"JavaScript-Injection","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" replaces "},{"type":"codeVoice","code":"navigator.credentials.create"},{"type":"text","text":" and "},{"type":"codeVoice","code":"navigator.credentials.get"},{"type":"text","text":" with versions that forward to Swift. Binary fields ("},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", "},{"type":"codeVoice","code":"user.id"},{"type":"text","text":", "},{"type":"codeVoice","code":"rawId"},{"type":"text","text":", …) are serialized to "},{"type":"strong","inlineContent":[{"type":"text","text":"base64url"}]},{"type":"text","text":" strings via "},{"type":"codeVoice","code":"JSON.stringify"},{"type":"text","text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed."}]},{"type":"codeListing","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"],"syntax":"javascript"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The script is injected at document start so it runs before any page code:"}]},{"type":"codeListing","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shouldIntercept"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for any "},{"type":"codeVoice","code":"publicKey"},{"type":"text","text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when "},{"type":"codeVoice","code":"publicKey.hints"},{"type":"text","text":" includes "},{"type":"codeVoice","code":"\"security-key\""},{"type":"text","text":")."}]},{"type":"heading","text":"Receiving Messages in Swift","anchor":"Receiving-Messages-in-Swift","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" is both "},{"type":"codeVoice","code":"WKNavigationDelegate"},{"type":"text","text":" and "},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"type":"text","text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:"}]},{"type":"codeListing","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shutdown()"},{"type":"text","text":" is called from "},{"type":"codeVoice","code":"dismantle{UI,NS}View"},{"type":"text","text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle."}]},{"type":"heading","text":"Driving the Ceremony","anchor":"Driving-the-Ceremony","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" is intentionally tiny — it decodes the envelope, builds a typed "},{"type":"codeVoice","code":"Origin"},{"type":"text","text":", and delegates to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself."}]},{"type":"codeListing","code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"handleGet"},{"type":"text","text":" is the symmetric counterpart that decodes "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"fidoUI.getAssertion"},{"type":"text","text":". The response JSON produced by "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to "},{"type":"codeVoice","code":"ArrayBuffer"},{"type":"text","text":" when it materializes the credential."}]},{"type":"heading","text":"Returning the Response to JavaScript","anchor":"Returning-the-Response-to-JavaScript","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:"}]},{"type":"codeListing","code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"JavaScript decodes the JSON and rebuilds a "},{"type":"codeVoice","code":"PublicKeyCredential"},{"type":"text","text":"-shaped object — converting the base64url binary fields back to "},{"type":"codeVoice","code":"ArrayBuffer"},{"type":"text","text":"s and wiring up "},{"type":"codeVoice","code":"getClientExtensionResults"},{"type":"text","text":", "},{"type":"codeVoice","code":"getAuthenticatorData"},{"type":"text","text":", "},{"type":"codeVoice","code":"getPublicKey"},{"type":"text","text":", "},{"type":"codeVoice","code":"toJSON"},{"type":"text","text":", and the rest. Errors travel through a parallel "},{"type":"codeVoice","code":"__webauthn_error__"},{"type":"text","text":" channel and surface to the page as a "},{"type":"codeVoice","code":"DOMException"},{"type":"text","text":" with name "},{"type":"codeVoice","code":"NotAllowedError"},{"type":"text","text":"."}]},{"type":"heading","text":"The FidoUI Module","anchor":"The-FidoUI-Module","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting "},{"type":"codeVoice","code":"navigator.credentials.*"},{"type":"text","text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Transport selection."}]},{"type":"text","text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ceremony serialization."}]},{"type":"text","text":" Concurrent calls on the same "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Cancellation."}]},{"type":"text","text":" A single "},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The host code only needs to construct one "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" instance and call "},{"type":"codeVoice","code":"makeCredential"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"getAssertion"},{"type":"text","text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See "},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/"},{"type":"text","text":" for the full source."}]},{"type":"heading","text":"Platform Notes","anchor":"Platform-Notes","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS."}]},{"type":"text","text":" The wired path goes through CryptoTokenKit ("},{"type":"codeVoice","code":"WiredSmartCardConnection"},{"type":"text","text":" — USB-C or Lightning), and the NFC path through "},{"type":"codeVoice","code":"NFCSmartCardConnection"},{"type":"text","text":". The sample’s "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"NFCReaderUsageDescription"},{"type":"text","text":" and lists the FIDO applet AID ("},{"type":"codeVoice","code":"A0000006472F0001"},{"type":"text","text":") under "},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers"},{"type":"text","text":"; the entitlements turn on "},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.formats"},{"type":"text","text":" ("},{"type":"codeVoice","code":"TAG"},{"type":"text","text":") and "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" uses "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" and "},{"type":"codeVoice","code":"com.apple.security.device.usb"},{"type":"text","text":" so the same target builds cleanly for both platforms."}]}]}]},{"type":"heading","text":"Where to Customize","anchor":"Where-to-Customize","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Which requests get intercepted."}]},{"type":"text","text":" Edit "},{"type":"codeVoice","code":"shouldIntercept"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" to scope by hint, RP ID, or any other heuristic."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Origin verification."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" builds a "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","isActive":true,"type":"reference"},{"type":"text","text":" from "},{"type":"codeVoice","code":"window.location.origin"},{"type":"text","text":". Replace the "},{"type":"codeVoice","code":"isPublicSuffix"},{"type":"text","text":" closure passed to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" with a real public-suffix-list check before shipping."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"UI."}]},{"type":"text","text":" Swap or restyle the panels in "},{"type":"codeVoice","code":"FidoUI\/Sources\/FidoUI\/Views\/"},{"type":"text","text":" — the rest of the module is UI-agnostic."}],"type":"paragraph"}]}]}]}],"abstract":[{"type":"text","text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts "},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"type":"text","text":" calls inside a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" and routes them to a YubiKey. It uses the high-level "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"type":"text","text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" companion module."}],"kind":"article","sections":[],"variants":[{"paths":["\/documentation\/yubikit\/webauthninterceptorsamplecode"],"traits":[{"interfaceLanguage":"swift"}]}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"overridingTitle":"View Source","type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample"}},"metadata":{"color":{"standardColorIdentifier":"yellow"},"modules":[{"name":"YubiKit"}],"role":"sampleCode","roleHeading":"Sample Code","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView"},"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"],"anchor":"Sample-code","title":"Sample code","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"https://github.com/Yubico/yubikit-swift/tree/main/Samples/WebAuthnInterceptorSample":{"url":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample","checksum":null,"type":"download"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Registration/Options":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Options"}],"abstract":[{"text":"Options for registering a new passkey credential.","type":"text"}],"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"Options","kind":"identifier"}],"title":"WebAuthn.Registration.Options","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options","url":"\/documentation\/yubikit\/webauthn\/registration\/options"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authentication/Response":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Response"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Authenticator response from a successful credential authentication."}],"navigatorTitle":[{"kind":"identifier","text":"Response"}],"title":"WebAuthn.Authentication.Response","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","url":"\/documentation\/yubikit\/webauthn\/authentication\/response"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Authentication/Options":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Options"}],"role":"symbol","abstract":[{"type":"text","text":"Options for authenticating with an existing passkey credential."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Options"}],"title":"WebAuthn.Authentication.Options","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","url":"\/documentation\/yubikit\/webauthn\/authentication\/options"},"documentation-header.png":{"variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png"}],"identifier":"documentation-header.png","type":"image","alt":"YubiKeys in a row"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Origin":{"type":"topic","url":"\/documentation\/yubikit\/webauthn\/origin","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Origin","kind":"identifier"}],"abstract":[{"type":"text","text":"A validated WebAut
ccessory@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/external-accessory~dark@2x.png","traits":["2x","dark"]}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSampleCode":{"title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","type":"topic","abstract":[{"text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","type":"reference"},{"text":" to retrieve authentication codes, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"reference"},{"text":" to get device information.","type":"text"}],"url":"\/documentation\/yubikit\/oathsamplecode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","role":"sampleCode","kind":"article"}}}
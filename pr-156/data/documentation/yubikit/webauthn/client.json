eter on ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","type":"reference","isActive":true},{"text":". The status stream reports ceremony","type":"text"},{"text":" ","type":"text"},{"text":"progress (","type":"text"},{"type":"codeVoice","code":".processing"},{"text":", ","type":"text"},{"type":"codeVoice","code":".waitingForUser"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".waitingForUserVerification"},{"text":", ","type":"text"},{"type":"codeVoice","code":".finished"},{"text":") only.","type":"text"}],"type":"paragraph"},{"code":["let session = try await CTAP2.Session.makeSession(connection: connection)","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","\/\/ Trivial — pre-supplied PIN:","let response = try await client.makeCredential(options, authorization: .pin(\"1234\")).value","","\/\/ Custom — bridge into a UI:","let auth = WebAuthn.Authorization(providePIN: {","    guard let pin = await viewModel.askForPIN() else { return .cancel }","    return .pin(pin)","})","for try await status in await client.makeCredential(options, authorization: auth) {","    switch status {","    case .processing: showSpinner()","    case .waitingForUser(let cancel):","        showTouchPrompt(onCancel: { Task { await cancel() } })","    case .waitingForUserVerification(let cancel, let fallbackToPIN):","        showBiometricPrompt(","            onCancel: { Task { await cancel() } },","            onFallbackToPIN: fallbackToPIN.map { fallback in { Task { await fallback() } } }","        )","    case .finished(let response): return response","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"PIN attempts are one-shot: a wrong PIN throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/pinRejected(retriesRemaining:source:)","type":"reference","isActive":true},{"text":" and the caller","type":"text"},{"text":" ","type":"text"},{"text":"decides whether to re-prompt and retry with a fresh ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Returning ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authorization\/PINReply\/cancel","type":"reference","isActive":true},{"text":" from ","type":"text"},{"type":"codeVoice","code":"providePIN"},{"text":" aborts","type":"text"},{"text":" ","type":"text"},{"text":"the ceremony with ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientError\/cancelled(source:)","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Client"},{"text":" is a high-level passkey client that runs WebAuthn ceremonies against a YubiKey.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"Client"},{"text":" is the entry point for WebAuthn in this SDK. It wraps a ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"and translates W3C WebAuthn requests into CTAP2 protocol exchanges — building the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"clientDataJSON"},{"text":", validating the relying-party identifi
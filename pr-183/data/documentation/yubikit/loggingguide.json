{"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No setup is required. YubiKit defaults to "},{"code":"debug","type":"codeVoice"},{"type":"text","text":" on stdout when compiled with "},{"code":"DEBUG","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or "},{"code":"info","type":"codeVoice"},{"type":"text","text":" on stderr otherwise. You can override either default:"}]},{"syntax":"swift","type":"codeListing","code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","YubiKit.Logs.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","YubiKit.Logs.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","YubiKit.Logs.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","YubiKit.Logs.configure()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"identifier":"https:\/\/github.com\/apple\/swift-log","type":"reference","isActive":true},{"type":"text","text":"’s "},{"code":"Logging","type":"codeVoice"},{"type":"text","text":" product to your app target"},{"type":"text","text":" "},{"type":"text","text":"to use its backend types. Any SwiftLog "},{"code":"LogHandler","type":"codeVoice"},{"type":"text","text":" can be supplied by the factory."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;"},{"type":"text","text":" "},{"type":"text","text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,"},{"type":"text","text":" "},{"type":"text","text":"though logs already in progress may use the previous settings."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,"},{"type":"text","text":" "},{"type":"text","text":"pass its factory explicitly; global "},{"code":"LoggingSystem.bootstrap","type":"codeVoice"},{"type":"text","text":" does not select YubiKit’s backend."},{"type":"text","text":" "},{"type":"text","text":"Factories may run concurrently and must not log through YubiKit themselves."}]},{"type":"heading","anchor":"Traffic-logging","level":3,"text":"Traffic logging"},{"syntax":"swift","type":"codeListing","code":["YubiKit.Logs.configure(logLevel: .trace)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Raw traffic and SCP plaintext logs require "},{"inlineContent":[{"text":"YubiKit to be compiled with ","type":"text"},{"code":"DEBUG","type":"codeVoice"}],"type":"strong"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Neither configuration nor a custom backend can enable them in other builds."},{"type":"text","text":" "},{"type":"text","text":"Custom connections are responsible for their own traffic logging."}]},{"content":[{"inlineContent":[{"text":"Debug logs can include account names and credential identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Trace logs can include PINs, credentials, and cryptographic keys. Protect or redact logs before sharing them.","type":"text"}],"type":"paragraph"}],"name":"Warning","type":"aside","style":"warning"},{"type":"heading","anchor":"Custom-backends","level":3,"text":"Custom backends"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Labels identify categories, such as "},{"code":"com.yubico.YubiKit.OATH","type":"codeVoice"},{"type":"text","text":" or "},{"code":"com.yubico.YubiKit.FIDO","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Metadata carries details such as byte counts and error codes; the default backend displays"},{"type":"text","text":" "},{"type":"text","text":"these as "},{"code":"key=value","type":"codeVoice"},{"type":"text","text":" pairs. Message wording and metadata keys are not a stable API."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/yubikit\/loggingguide"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"seeAlsoSections":[{"generated":true,"title":"Preparing your project","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"anchor":"Preparing-your-project"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","metadata":{"title":"Logging","modules":[{"name":"YubiKit"}],"roleHeading":"Article","role":"article"},"sections":[],"abstract":[{"type":"text","text":"Choose YubiKit’s log level and backend with "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)","type":"reference","isActive":true},{"type":"text","text":"."}],"references":{"documentation-header.png":{"alt":"YubiKeys in a row","type":"image","identifier":"documentation-header.png","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"kind":"symbol","role":"collection","title":"YubiKit","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","url":"\/documentation\/yubikit","abstract":[{"text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB.","type":"text"}],"images":[{"identifier":"documentation-header.png
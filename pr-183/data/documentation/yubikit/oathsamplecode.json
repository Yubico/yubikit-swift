c:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","kind":"article","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","type":"topic","url":"\/documentation\/yubikit\/webauthninterceptorsamplecode","role":"sampleCode","abstract":[{"text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts ","type":"text"},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"text":" calls inside a ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":" and routes them to a YubiKey. It uses the high-level ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" companion module.","type":"text"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"kind":"symbol","url":"\/documentation\/yubikit\/pivsession","abstract":[{"type":"text","text":"An interface to the PIV application on the YubiKey."}],"role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"PIVSession"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"PIVSession"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","title":"PIVSession"}}}
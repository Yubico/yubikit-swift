/documentation/YubiKit/OATHSession":{"abstract":[{"type":"text","text":"An interface to the OATH application on the YubiKey."}],"title":"OATHSession","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"OATHSession"}],"navigatorTitle":[{"text":"OATHSession","kind":"identifier"}],"url":"\/documentation\/yubikit\/oathsession","role":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","kind":"symbol","type":"topic"},"nfc-entitlement.png":{"identifier":"nfc-entitlement.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-entitlement~dark@2x.png","traits":["2x","dark"]}],"type":"image","alt":"An image showing how to add wireless entitlements to project."},"nfc-identifiers-list.png":{"identifier":"nfc-identifiers-list.png","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/nfc-identifiers-list~dark@2x.png","traits":["2x","dark"]}],"type":"image","alt":"An image showing the list of nfc identifiers added."},"add-framework-2.png":{"identifier":"add-framework-2.png","variants":[{"traits":["2x","light"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-2@2x.png"},{"traits":["2x","dark"],"url":"\/images\/yubikit-swift.YubiKit\/add-framework-2~dark@2x.png"}],"type":"image","alt":"An image showing how to add the YubiKit SDK to your Xcode project."},"doc://yubikit-swift.YubiKit/documentation/YubiKit/SmartCardConnection":{"abstract":[{"type":"text","text":"An interface defining a SmartCard based connection to a YubiKey."}],"title":"SmartCardConnection","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SmartCardConnection","kind":"identifier"}],"navigatorTitle":[{"text":"SmartCardConnection","kind":"identifier"}],"url":"\/documentation\/yubikit\/smartcardconnection","role":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/SmartCardConnection","kind":"symbol","type":"topic"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSampleCode":{"abstract":[{"type":"text","text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","isActive":true},{"type":"text","text":" to retrieve authentication codes, and "},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","type":"reference"},{"type":"text","text":" to get device information."}],"kind":"article","type":"topic","role":"sampleCode","url":"\/documentation\/yubikit\/oathsamplecode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","title":"OATHSample: Basic OATH app showcasing how to integrate the SDK"}}}
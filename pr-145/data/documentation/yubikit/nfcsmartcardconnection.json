 will cover the lower part of the iPhone screen.","type":"text"},{"type":"text","text":" "},{"text":"In addition to the ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection\/close(error:)","isActive":true,"type":"reference"},{"type":"text","text":" method defined in the SmartCardConnection protocol the NFCSmartCardConnection has an additional "},{"type":"codeVoice","code":"close(success:)"},{"text":" ","type":"text"},{"type":"text","text":"method that will close the connection and set the alertMessage of the NFC alert to the provided message."}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"NFC is only supported on iPhones from iPhone 6 and forward. It will not work on iPads since there’s no NFC chip in these devices.","type":"text"}],"type":"paragraph"}],"name":"Note"},{"inlineContent":[{"text":"NFC connection to a YubiKey (iOS only).","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"NFCSmartCardConnection establishes a connection to a YubiKey via NFC. The connection"},{"type":"text","text":" "},{"type":"text","text":"presents the system NFC dialog and waits for the user to tap their YubiKey."}]},{"type":"paragraph","inlineContent":[{"text":"NFC connections are short-lived due to iOS timeout constraints. Perform operations quickly","type":"text"},{"text":" ","type":"text"},{"text":"and close the connection with a user-visible message.","type":"text"}]},{"code":["let connection = try await NFCSmartCardConnection(","    alertMessage: \"Hold your YubiKey near the phone\"",")","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()","await connection.close(message: \"Codes retrieved\")"],"syntax":"swift","type":"codeListing"}]}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"url":"\
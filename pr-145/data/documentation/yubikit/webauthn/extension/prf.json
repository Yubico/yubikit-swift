xt","text":" per ceremony via"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/RegistrationInputs\/prf","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Extension\/AuthenticationInputs\/prf","isActive":true},{"type":"text","text":"; outputs come back on"},{"type":"text","text":" "},{"code":"clientExtensionResults","type":"codeVoice"},{"type":"text","text":" of the corresponding "},{"code":"Response","type":"codeVoice"},{"type":"text","text":". Registration enables"},{"type":"text","text":" "},{"type":"text","text":"PRF on a credential, optionally deriving secrets at the same time on"},{"type":"text","text":" "},{"type":"text","text":"authenticators that support hmac-secret-mc. Authentication evaluates the PRF at"},{"type":"text","text":" "},{"type":"text","text":"one or more inputs and returns the derived bytes."}],"type":"paragraph"},{"code":["\/\/ Registration: enable PRF on the new credential","let regOpts = WebAuthn.Registration.Options(","    challenge: challenge,","    rp: .init(id: \"example.com\", name: \"Example\"),","    user: .init(id: userId, name: \"alice@example.com\"),","    extensions: .init(prf: .enable)",")","let registration = try await client.makeCredential(regOpts, authorization: auth).value","","\/\/ Authentication: derive a secret bound to the credential","let authOpts = WebAuthn.Authentication.Options(","    challenge: challenge,","    rpId: \"example.com\",","    allowCredentials: [.init(id: storedCredentialId)],","    extensions: .init(prf: .eval(first: encryptionSeed))",")","let assertions = try await client.getAssertion(authOpts, authorization: auth).value","let derived = assertions.first?.clientExtensionResults.prf?.results.first"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"For multi-credenti
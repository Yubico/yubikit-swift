{"metadata":{"role":"sampleCode","title":"OATHSample: Basic OATH app showcasing how to integrate the SDK","roleHeading":"Sample Code","color":{"standardColorIdentifier":"green"},"modules":[{"name":"YubiKit"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/oathsamplecode"]}],"sections":[],"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample creates an authenticator app that:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Establishes connections to YubiKeys via USB, Lightning, or NFC","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Manages connection lifecycle (detecting plugged\/unplugged devices)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists TOTP codes stored on the YubiKey"}]}]},{"content":[{"inlineContent":[{"text":"Shows device information like firmware version","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Handles connection errors and user cancellations gracefully","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This sample focuses on read-only operations and doesn’t handle password-protected YubiKeys or credential management."}]},{"text":"Connection Management","level":2,"type":"heading","anchor":"Connection-Management"},{"text":"Handling Wired Connections","level":3,"type":"heading","anchor":"Handling-Wired-Connections"},{"inlineContent":[{"type":"text","text":"The app uses a "},{"type":"codeVoice","code":"ConnectionManager"},{"type":"text","text":" to handle persistent connections to plugged-in YubiKeys. This approach ensures your app stays responsive when users plug and unplug their YubiKeys:"}],"type":"paragraph"},{"code":["private func startWiredConnection() {","    wiredConnectionTask = Task { @MainActor in","        while !Task.isCancelled {","            do {","                let newConnection = try await WiredSmartCardConnection.makeConnection()","                wiredConnection = newConnection","","                \/\/ Wait for disconnect","                let closeError = await newConnection.waitUntilClosed()","                wiredConnection = nil","            } catch {","                self.error = error","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The key insight here is using ","type":"text"},{"code":"waitUntilClosed()","type":"codeVoice"},{"text":" to detect when the YubiKey is unplugged, then automatically waiting for the next connection.","type":"text"}],"type":"paragraph"},{"level":3,"text":"NFC Connections","anchor":"NFC-Connections","type":"heading"},{"inlineContent":[{"type":"text","text":"NFC connections work differently - they’re initiated by user action and are short-lived:"}],"type":"paragraph"},{"code":["func requestNFCConnection() async {","    do {","        nfcConnection = try await NFCSmartCardConnection()","    } catch {","        self.error = error","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When an NFC connection is established, the app fetches data and immediately closes it with a user message:","type":"text"}],"type":"paragraph"},{"code":["Task {","    await model.update(using: connection)","    await connection.close(message: \"Codes calculated\")","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Working with YubiKey Data","anchor":"Working-with-YubiKey-Data","type":"heading"},{"level":3,"text":"Reading OATH Codes","anchor":"Reading-OATH-Codes","type":"heading"},{"inlineContent":[{"type":"text","text":"Once you have a connection, getting TOTP codes is straightforward:"}],"type":"paragraph"},{"code":["private func calculateCodes(using connection: SmartCardConnection) async {","    do {","        let session = try await OATHSession.makeSession(connection: connection)","        let result = try await session.calculateCredentialCodes()","        accounts = result.map { credential, code in","            Account(","                label: credential.label,","                code: code?.code,","                issuer: credential.issuer,","                type: credential.type","            )","        }","    } catch {","        self.error = error","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"calculateCredentialCodes()"},{"type":"text","text":" method returns a dictionary mapping credentials to their current codes. Some codes might be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if they require touch or are password-protected."}],"type":"paragraph"},{"level":3,"text":"Getting Device Information","anchor":"Getting-Device-Information","type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"Management.Session","type":"codeVoice"},{"text":" to get YubiKey information:","type":"text"}],"type":"paragraph"},{"code":["private func getKeyVersion(using connection: SmartCardConnection) async {","    do {","        let session: Management.Session = try await .makeSession(connection: connection)","        self.keyVersion = await session.version.description","    } catch {","        self.error = error","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"code":"Model","type":"codeVoice"},{"text":" class combines both operations in a single ","type":"text"},{"type":"codeVoice","code":"update"},{"type":"text","text":" method:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func update(using connection: SmartCardConnection) async {","    await calculateCodes(using: connection)","    await getKeyVersion(using: connection)","    connectionType = connection.connectionType","}"]},{"type":"heading","level":2,"text":"SwiftUI Integration","anchor":"SwiftUI-Integration"},{"type":"heading","level":3,"text":"Reacting to Connection Changes","anchor":"Reacting-to-Connection-Changes"},{"inlineContent":[{"text":"The app uses SwiftUI’s ","type":"text"},{"code":"@Published","type":"codeVoice"},{"text":" properties and ","type":"text"},{"code":"onReceive","type":"codeVoice"},{"text":" to update the UI when connections change:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":[".onReceive(connectionManager.$wiredConnection) { newConnection in","    guard let connection = newConnection else {","        model.clear()  \/\/ Clear UI when YubiKey unplugged","        return","    }","    Task { await model.update(using: connection) }","}"]},{"inlineContent":[{"text":"This pattern ensures the UI immediately updates when YubiKeys are plugged in or removed.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Platform-Specific Features","anchor":"Platform-Specific-Features"},{"inlineContent":[{"type":"text","text":"The app handles iOS vs macOS differences with conditional compilation:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["#if os(iOS)",".refreshable {","    await connectionManager.requestNFCConnection()","}","#endif"]},{"inlineContent":[{"text":"iOS users can pull-to-refresh to scan with NFC, while macOS users only see USB options.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Connection Type Detection","anchor":"Connection-Type-Detection"},{"inlineContent":[{"type":"text","text":"The sample includes a useful extension to identify connection types:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension SmartCardConnection {","    var connectionType: String {","        switch self {","        case _ as NFCSmartCardConnection: return \"NFC\"","        case _ as LightningSmartCardConnection: return \"Lightning\"","        case _ as USBSmartCardConnection: return \"USB\"","        default: return \"Unknown\"","        }","    }","}"]},{"inlineContent":[{"text":"This is helpful because NFC connections are slower than USB, and users like to know how their YubiKey is connected.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Architecture Decisions","anchor":"Architecture-Decisions"},{"type":"heading","level":3,"text":"Why the connection management works this way","anchor":"Why-the-connection-management-works-this-way"},{"inlineContent":[{"type":"text","text":"The sample uses a background loop that continuously waits for wired connections. This might seem unusual, but it solves a key problem: YubiKeys get plugged and unplugged frequently, but apps need to stay responsive."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When you unplug your YubiKey, the app doesn’t crash or freeze - it detects the disconnection via "},{"code":"waitUntilClosed()","type":"codeVoice"},{"type":"text","text":" and immediately starts waiting for the next YubiKey. This creates a smoother user experience where the app responds when you plug \/ unplug a YubiKey."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"NFC works differently since you can’t continuously scan - the user has to explicitly initiate each scan. That’s why NFC connections are handled separately through user actions like the scan button or pull-to-refresh."}],"type":"paragraph"},{"anchor":"Error-handling-for-hardware-connections","type":"heading","level":3,"text":"Error handling for hardware connections"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hardware connections are unreliable by nature. Users will unplug devices mid-operation, walk away during NFC scans, or have connectivity issues. The sample handles this gracefully:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Connection failures are caught and stored as errors"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"User cancellations (like dismissing NFC scan) are filtered out to avoid unnecessary error alerts"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Session errors are handled similarly - show the error but maintain app functionality"}],"type":"paragraph"}]}]},{"text":"Working with Swift actors","type":"heading","level":3,"anchor":"Working-with-Swift-actors"},{"type":"paragraph","inlineContent":[{"text":"YubiKit sessions are Swift actors that handle their own threading. The sample shows how to integrate this with SwiftUI’s main actor requirements:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ConnectionManager"},{"type":"text","text":" runs on "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" so it can directly update "},{"type":"codeVoice","code":"@Published"},{"type":"text","text":" properties"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Session calls happen on the session’s actor, then results are passed back to update the UI","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Everything uses ","type":"text"},{"type":"codeVoice","code":"async\/await"}],"type":"paragraph"}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"seeAlsoSections":[{"title":"Sample code","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"],"generated":true,"anchor":"Sample-code"}],"kind":"article","sampleCodeDownload":{"kind":"sampleDownload","action":{"type":"reference","identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/OATHSample","isActive":true,"overridingTitle":"View Source"}},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"This sample shows how to build an iOS and macOS app that reads TOTP codes from YubiKeys. The app demonstrates establishing connections, managing connection lifecycle, using ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession"},{"text":" to retrieve authentication codes, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session"},{"text":" to get device information.","type":"text"}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"kind":"symbol","url":"\/documentation\/yubikit","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit","title":"YubiKit","type":"topic","role":"collection","images":[{"identifier":"documentation-header.png","type":"icon"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Management/Session":{"title":"Management.Session","role":"symbol","type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Management\/Session","url":"\/documentation\/yubikit\/management\/session","navigatorTitle":[{"text":"Session","kind":"identifier"}],"abstract":[{"text":"An interface to the Management application on the YubiKey.","type":"text"}],"kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Session","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/OATHSession":{"kind":"symbol","title":"OATHSession","abstract":[{"type":"text","text":"An interface to the OATH application on the YubiKey."}],"navigatorTitle":[{"text":"OATHSession","kind":"identifier"}],"type":"topic","url":"\/documentation\/yubikit\/oathsession","role":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSession","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"text":"OATHSession","kind":"identifier"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthnInterceptorSampleCode":{"type":"topic","url":"\/documentation\/yubikit\/webauthninterceptorsamplecode","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode","title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","abstract":[{"type":"text","text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts "},{"code":"navigator.credentials.{create,get}","type":"codeVoice"},{"type":"text","text":" calls inside a "},{"code":"WKWebView","type":"codeVoice"},{"type":"text","text":" and routes them to a YubiKey. It uses the high-level "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference","isActive":true},{"type":"text","text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" companion module."}],"kind":"article","role":"sampleCode"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/PIVSession":{"role":"symbol","navigatorTitle":[{"text":"PIVSession","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PIVSession","kind":"identifier"}],"abstract":[{"type":"text","text":"An interface to the PIV application on the YubiKey."}],"type":"topic","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession","title":"PIVSession","url":"\/documentation\/yubikit\/pivsession"},"documentation-header.png":{"type":"image","variants":[{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header@2x.png","traits":["2x","light"]},{"url":"\/images\/yubikit-swift.YubiKit\/documentation-header~dark@2x.png","tr
{"sampleCodeDownload":{"kind":"sampleDownload","action":{"isActive":true,"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample","type":"reference","overridingTitle":"View Source"}},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The interceptor demonstrates how to:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Intercept ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.create()"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.get()"},{"text":" in a ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options","type":"reference"},{"text":" \/ ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","type":"reference"},{"text":" types.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Drive the SDK’s high-level ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Use the bundled ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface."}]},{"type":"heading","level":2,"anchor":"Architecture-Overview","text":"Architecture Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample itself is intentionally thin:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Interceptor.js","type":"text"}]},{"text":" — injected into the ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":" to monkey-patch ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"text":" and shuttle requests\/responses through ","type":"text"},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"WebView.swift","type":"text"}]},{"text":" — ","type":"text"},{"type":"codeVoice","code":"UIViewRepresentable"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"NSViewRepresentable"},{"text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"WebAuthnHandler.swift","type":"text"}]},{"text":" — decodes the JSON envelope, builds a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","type":"reference"},{"text":", and calls ","type":"text"},{"type":"codeVoice","code":"FidoUI.makeCredential"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"FidoUI.getAssertion"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"ContentView.swift","type":"text"}]},{"text":" — minimal SwiftUI shell with a URL bar and back button.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"FidoUI","type":"text"}]},{"text":" (separate Swift package under ","type":"text"},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI"},{"text":") — the reusable UI + transport layer described below.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The end-to-end flow:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Page JS calls ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.create()"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":".get()"},{"text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"text":" decodes the JSON straight into the SDK’s strongly-typed ","type":"text"},{"type":"codeVoice","code":"Options"},{"text":" and hands them to ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"text":" opens a transport, runs the ceremony via ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","type":"reference"},{"text":", and shows PIN \/ UV \/ error \/ success panels as needed.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The resulting ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","type":"reference"},{"text":" is serialized via its built-in ","type":"text"},{"type":"codeVoice","code":"toJSON()"},{"text":" and posted back to JS.","type":"text"}]}]}],"type":"orderedList"},{"type":"heading","level":2,"anchor":"Intercepting-WebAuthn-Calls","text":"Intercepting WebAuthn Calls"},{"type":"heading","level":3,"anchor":"JavaScript-Injection","text":"JavaScript Injection"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" replaces "},{"type":"codeVoice","code":"navigator.credentials.create"},{"type":"text","text":" and "},{"type":"codeVoice","code":"navigator.credentials.get"},{"type":"text","text":" with versions that forward to Swift. Binary fields ("},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", "},{"type":"codeVoice","code":"user.id"},{"type":"text","text":", "},{"type":"codeVoice","code":"rawId"},{"type":"text","text":", …) are serialized to "},{"type":"strong","inlineContent":[{"type":"text","text":"base64url"}]},{"type":"text","text":" strings via "},{"type":"codeVoice","code":"JSON.stringify"},{"type":"text","text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed."}]},{"syntax":"javascript","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The script is injected at document start so it runs before any page code:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"]},{"type":"paragraph","inlineContent":[{"code":"shouldIntercept","type":"codeVoice"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for any "},{"code":"publicKey","type":"codeVoice"},{"type":"text","text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when "},{"code":"publicKey.hints","type":"codeVoice"},{"type":"text","text":" includes "},{"type":"codeVoice","code":"\"security-key\""},{"type":"text","text":")."}]},{"level":3,"text":"Receiving Messages in Swift","anchor":"Receiving-Messages-in-Swift","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"Coordinator","type":"codeVoice"},{"text":" is both ","type":"text"},{"code":"WKNavigationDelegate","type":"codeVoice"},{"type":"text","text":" and "},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"type":"text","text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:"}]},{"syntax":"swift","type":"codeListing","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"shutdown()","type":"codeVoice"},{"text":" is called from ","type":"text"},{"type":"codeVoice","code":"dismantle{UI,NS}View"},{"type":"text","text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle."}]},{"type":"heading","anchor":"Driving-the-Ceremony","level":2,"text":"Driving the Ceremony"},{"type":"paragraph","inlineContent":[{"code":"WebAuthnHandler","type":"codeVoice"},{"type":"text","text":" is intentionally tiny — it decodes the envelope, builds a typed "},{"code":"Origin","type":"codeVoice"},{"type":"text","text":", and delegates to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself."}]},{"syntax":"swift","type":"codeListing","code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"handleGet"},{"type":"text","text":" is the symmetric counterpart that decodes "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","isActive":true,"type":"reference"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"fidoUI.getAssertion"},{"type":"text","text":". The response JSON produced by "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to "},{"type":"codeVoice","code":"ArrayBuffer"},{"type":"text","text":" when it materializes the credential."}]},{"type":"heading","anchor":"Returning-the-Response-to-JavaScript","level":2,"text":"Returning the Response to JavaScript"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:"}]},{"code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"JavaScript decodes the JSON and rebuilds a "},{"code":"PublicKeyCredential","type":"codeVoice"},{"type":"text","text":"-shaped object — converting the base64url binary fields back to "},{"code":"ArrayBuffer","type":"codeVoice"},{"text":"s and wiring up ","type":"text"},{"type":"codeVoice","code":"getClientExtensionResults"},{"type":"text","text":", "},{"type":"codeVoice","code":"getAuthenticatorData"},{"text":", ","type":"text"},{"code":"getPublicKey","type":"codeVoice"},{"type":"text","text":", "},{"code":"toJSON","type":"codeVoice"},{"type":"text","text":", and the rest. Errors travel through a parallel "},{"code":"__webauthn_error__","type":"codeVoice"},{"type":"text","text":" channel and surface to the page as a "},{"code":"DOMException","type":"codeVoice"},{"type":"text","text":" with name "},{"type":"codeVoice","code":"NotAllowedError"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"The FidoUI Module","type":"heading","anchor":"The-FidoUI-Module"},{"inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting "},{"type":"codeVoice","code":"navigator.credentials.*"},{"type":"text","text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell."}],"type":"paragraph"},{"inlineContent":[{"text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Transport selection."}],"type":"strong"},{"type":"text","text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ceremony serialization."}]},{"text":" Concurrent calls on the same ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Cancellation."}]},{"text":" A single ","type":"text"},{"type":"codeVoice","code":"cancel()"},{"text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The host code only needs to construct one "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" instance and call "},{"code":"makeCredential","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"getAssertion","type":"codeVoice"},{"type":"text","text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See "},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/","type":"codeVoice"},{"type":"text","text":" for the full source."}]},{"type":"heading","anchor":"Platform-Notes","level":2,"text":"Platform Notes"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"iOS.","type":"text"}],"type":"strong"},{"text":" The wired path goes through CryptoTokenKit (","type":"text"},{"code":"WiredSmartCardConnection","type":"codeVoice"},{"text":" — USB-C or Lightning), and the NFC path through ","type":"text"},{"type":"codeVoice","code":"NFCSmartCardConnection"},{"text":". The sample’s ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" declares ","type":"text"},{"type":"codeVoice","code":"NFCReaderUsageDescription"},{"type":"text","text":" and lists the FIDO applet AID ("},{"type":"codeVoice","code":"A0000006472F0001"},{"type":"text","text":") under "},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers"},{"text":"; the entitlements turn on ","type":"text"},{"code":"com.apple.developer.nfc.readersession.formats","type":"codeVoice"},{"type":"text","text":" ("},{"code":"TAG","type":"codeVoice"},{"text":") and ","type":"text"},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" uses "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" and "},{"type":"codeVoice","code":"com.apple.security.device.usb"},{"type":"text","text":" so the same target builds cleanly for both platforms."}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"anchor":"Where-to-Customize","text":"Where to Customize"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Which requests get intercepted.","type":"text"}]},{"type":"text","text":" Edit "},{"type":"codeVoice","code":"shouldIntercept"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" to scope by hint, RP ID, or any other heuristic."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Origin verification.","type":"text"}]},{"text":" ","type":"text"},{"code":"WebAuthnHandler","type":"codeVoice"},{"type":"text","text":" builds a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin"},{"text":" from ","type":"text"},{"code":"window.location.origin","type":"codeVoice"},{"text":". Replace the ","type":"text"},{"code":"isPublicSuffix","type":"codeVoice"},{"type":"text","text":" closure passed to "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" with a real public-suffix-list check before shipping."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"UI."}],"type":"strong"},{"text":" Swap or restyle the panels in ","type":"text"},{"code":"FidoUI\/Sources\/FidoUI\/Views\/","type":"codeVoice"},{"text":" — the rest of the module is UI-agnostic.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"sections":[],"metadata":{"role":"sampleCode","color":{"standardColorIdentifier":"yellow"},"title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","modules":[{"name":"YubiKit"}],"roleHeading":"Sample Code"},"variants":[{"paths":["\/documentation\/yubikit\/webauthninterceptorsamplecode"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","seeAlsoSections"
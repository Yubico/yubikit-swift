t\/documentation\/YubiKit\/PIVToolSampleCode","role":"sampleCode","type":"topic","kind":"article","url":"\/documentation\/yubikit\/pivtoolsamplecode","abstract":[{"type":"text","text":"This sample shows how to build applications that use YubiKeys for PIV (Personal Identity Verification) operations. The command-line tool demonstrates using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVSession"},{"type":"text","text":" for cryptographic operations, certificate management, and access control."}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Origin":{"type":"topic","title":"WebAuthn.Origin","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Origin"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Origin"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","url":"\/documentation\/yubikit\/webauthn\/origin","abstract":[{"text":"A validated WebAuthn origin.","type":"text"}]}}}
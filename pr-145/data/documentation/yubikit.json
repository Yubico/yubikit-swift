{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"inlineContent":[{"text":"The YubiKit Swift SDK provides a modern async\/await version of the YubiKit framework, making it easy to integrate","type":"text"},{"text":" ","type":"text"},{"text":"in Swift and SwiftUI based applications. The async\/await syntax provides an easy to read and powerful way of","type":"text"},{"text":" ","type":"text"},{"text":"creating connections and sending commands to the different applications on the YubiKey.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let connection = try await NFCSmartCardConnection()","let session = try await OATHSession.makeSession(connection: connection)","let codes = try await session.calculateCredentialCodes()"]},{"style":"warning","name":"Warning","type":"aside","content":[{"inlineContent":[{"text":"This SDK does not perform zeroization of sensitive data in memory. Cryptographic keys, PIN tokens,","type":"text"},{"text":" ","type":"text"},{"text":"and other secrets are not securely erased when no longer in use. This is currently out of scope but may be","type":"text"},{"text":" ","type":"text"},{"text":"addressed in a future release.","type":"text"}],"type":"paragraph"}]}]}],"variants":[{"paths":["\/documentation\/yubikit"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"hierarchy":{"paths":[[]]},"metadata":{"roleHeading":"Framework","modules":[{"name":"YubiKit"}],"color":{"standardColorIdentifier":"green"},"externalID":"YubiKit","role":"collection","platforms":[{"name":"iOS","beta":false,"introducedAt":"16.0"},{"name":"macOS","beta":false,"introducedAt":"13.0"}],"title":"YubiKit","symbolKind":"module","images":[{"identifier":"documentation
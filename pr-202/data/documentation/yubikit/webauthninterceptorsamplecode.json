},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".get()"},{"text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" decodes the JSON straight into the SDK’s strongly-typed "},{"type":"codeVoice","code":"Options"},{"type":"text","text":" and hands them to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" opens a transport, runs the ceremony via "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":", and shows PIN \/ UV \/ error \/ success panels as needed."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The resulting ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","type":"reference"},{"text":" is serialized via its built-in ","type":"text"},{"type":"codeVoice","code":"toJSON()"},{"text":" and posted back to JS.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"type":"heading","text":"Intercepting WebAuthn Calls","anchor":"Intercepting-WebAuthn-Calls"},{"level":3,"type":"heading","text":"JavaScript Injection","anchor":"JavaScript-Injection"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" replaces "},{"type":"codeVoice","code":"navigator.credentials.create"},{"type":"text","text":" and "},{"type":"codeVoice","code":"navigator.credentials.get"},{"type":"text","text":" with versions that forward to Swift. Binary fields ("},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", "},{"type":"codeVoice","code":"user.id"},{"type":"text","text":", "},{"type":"codeVoice","code":"rawId"},{"type":"text","text":", …) are serialized to "},{"inlineContent":[{"type":"text","text":"base64url"}],"type":"strong"},{"type":"text","text":" strings via "},{"type":"codeVoice","code":"JSON.stringify"},{"type":"text","text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed."}]},{"type":"codeListing","syntax":"javascript","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The script is injected at document start so it runs before any page code:"}]},{"type":"codeListing","syntax":"swift","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"]},{"type":"paragraph","inlineContent":[{"code":"shouldIntercept","type":"codeVoice"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"text":" for any ","type":"text"},{"type":"codeVoice","code":"publicKey"},{"type":"text","text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when "},{"code":"publicKey.hints","type":"codeVoice"},{"type":"text","text":" includes "},{"code":"\"security-key\"","type":"codeVoice"},{"type":"text","text":")."}]},{"type":"heading","level":3,"text":"Receiving Messages in Swift","anchor":"Receiving-Messages-in-Swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Coordinator"},{"text":" is both ","type":"text"},{"code":"WKNavigationDelegate","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:","type":"text"}]},{"syntax":"swift","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"shutdown()"},{"text":" is called from ","type":"text"},{"type":"codeVoice","code":"dismantle{UI,NS}View"},{"text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle.","type":"text"}],"type":"paragraph"},{"text":"Driving the Ceremony","type":"heading","level":2,"anchor":"Driving-the-Ceremony"},{"inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" is intentionally tiny — it decodes the envelope, builds a typed "},{"code":"Origin","type":"codeVoice"},{"type":"text","text":", and delegates to "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"handleGet"},{"type":"text","text":" is the symmetric counterpart that decodes "},{"isActive":true,"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"fidoUI.getAssertion"},{"type":"text","text":". The response JSON produced by "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to "},{"type":"codeVoice","code":"ArrayBuffer"},{"type":"text","text":" when it materializes the credential."}]},{"level":2,"type":"heading","text":"Returning the Response to JavaScript","anchor":"Returning-the-Response-to-JavaScript"},{"inlineContent":[{"text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"JavaScript decodes the JSON and rebuilds a "},{"code":"PublicKeyCredential","type":"codeVoice"},{"text":"-shaped object — converting the base64url binary fields back to ","type":"text"},{"code":"ArrayBuffer","type":"codeVoice"},{"text":"s and wiring up ","type":"text"},{"code":"getClientExtensionResults","type":"codeVoice"},{"text":", ","type":"text"},{"code":"getAuthenticatorData","type":"codeVoice"},{"text":", ","type":"text"},{"code":"getPublicKey","type":"codeVoice"},{"text":", ","type":"text"},{"code":"toJSON","type":"codeVoice"},{"text":", and the rest. Errors travel through a parallel ","type":"text"},{"code":"__webauthn_error__","type":"codeVoice"},{"text":" channel and surface to the page as a ","type":"text"},{"code":"DOMException","type":"codeVoice"},{"text":" with name ","type":"text"},{"code":"NotAllowedError","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"The FidoUI Module","anchor":"The-FidoUI-Module","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.*"},{"text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Transport selection."}]},{"type":"text","text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Ceremony serialization.","type":"text"}]},{"type":"text","text":" Concurrent calls on the same "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Cancellation."}],"type":"strong"},{"text":" A single ","type":"text"},{"code":"cancel()","type":"codeVoice"},{"text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The host code only needs to construct one ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" instance and call ","type":"text"},{"type":"codeVoice","code":"makeCredential"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"getAssertion"},{"text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See ","type":"text"},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/"},{"type":"text","text":" for the full source."}]},{"anchor":"Platform-Notes","type":"heading","level":2,"text":"Platform Notes"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"iOS.","type":"text"}],"type":"strong"},{"text":" The wired path goes through CryptoTokenKit (","type":"text"},{"code":"WiredSmartCardConnection","type":"codeVoice"},{"text":" — USB-C or Lightning), and the NFC path through ","type":"text"},{"code":"NFCSmartCardConnection","type":"codeVoice"},{"text":". The sample’s ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" declares ","type":"text"},{"type":"codeVoice","code":"NFCReaderUsageDescription"},{"text":" and lists the FIDO applet AID (","type":"text"},{"type":"codeVoice","code":"A0000006472F0001"},{"text":") under ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers"},{"text":"; the entitlements turn on ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.formats"},{"text":" (","type":"text"},{"type":"codeVoice","code":"TAG"},{"text":") and ","type":"text"},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS.","type":"text"}]},{"type":"text","text":" "},{"code":"FidoUI","type":"codeVoice"},{"type":"text","text":" uses "},{"code":"HIDFIDOConnection","type":"codeVoice"},{"type":"text","text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables "},{"code":"com.apple.security.smartcard","type":"codeVoice"},{"type":"text","text":" and "},{"code":"com.apple.security.device.usb","type":"codeVoice"},{"type":"text","text":" so the same target builds cleanly for both platforms."}]}]}],"type":"unorderedList"},{"anchor":"Where-to-Customize","type":"heading","level":2,"text":"Where to Customize"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Which requests get intercepted.","type":"text"}]},{"type":"text","text":" Edit "},{"type":"codeVoice","code":"shouldIntercept"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" to scope by hint, RP ID, or any other heuristic."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"t
{"metadata":{"title":"Logging","role":"article","roleHeading":"Article","modules":[{"name":"YubiKit"}]},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No setup is required. YubiKit defaults to "},{"type":"codeVoice","code":"debug"},{"type":"text","text":" on stdout when compiled with "},{"type":"codeVoice","code":"DEBUG"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"info"},{"type":"text","text":" on stderr otherwise. You can override either default:"}]},{"type":"codeListing","syntax":"swift","code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","YubiKit.Logs.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","YubiKit.Logs.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","YubiKit.Logs.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","YubiKit.Logs.configure()"]},{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"identifier":"https:\/\/github.com\/apple\/swift-log","type":"reference","isActive":true},{"text":"’s ","type":"text"},{"code":"Logging","type":"codeVoice"},{"text":" product to your app target","type":"text"},{"text":" ","type":"text"},{"text":"to use its backend types. Any SwiftLog ","type":"text"},{"type":"codeVoice","code":"LogHandler"},{"type":"text","text":" can be supplied by the factory."}]},{"type":"paragraph","inlineContent":[{"text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;","type":"text"},{"text":" ","type":"text"},{"text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,","type":"text"},{"text":" ","type":"text"},{"text":"though logs already in progress may use the previous settings.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,","type":"text"},{"text":" ","type":"text"},{"text":"pass its factory explicitly; global ","type":"text"},{"code":"LoggingSystem.bootstrap","type":"codeVoice"},{"text":" does not select YubiKit’s backend.","type":"text"},{"text":" ","type":"text"},{"text":"Factories may run concurrently and must not log through YubiKit themselves.","type":"text"}]},{"level":3,"type":"heading","text":"Traffic logging","anchor":"Traffic-logging"},{"code":["YubiKit.Logs.configure(logLevel: .trace)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Raw traffic and SCP plaintext logs require "},{"type":"strong","inlineContent":[{"type":"text","text":"YubiKit to be compiled with "},{"type":"codeVoice","code":"DEBUG"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Neither configuration nor a custom backend can enable them in other builds."},{"type":"text","text":" "},{"type":"text","text":"Custom connections are responsible for their own traffic logging."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Debug logs can include account names and credential identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Trace logs can include PINs, credentials, and cryptographic keys. Protect or redact logs before sharing them.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Warning","style":"warning"},{"level":3,"type":"heading","text":"Custom backends","anchor":"Custom-backends"},{"inlineContent":[{"type":"text","text":"Labels identify categories, such as "},{"code":"com.yubico.YubiKit.OATH","type":"codeVoice"},{"type":"text","text":" or "},{"code":"com.yubico.YubiKit.FIDO","type":"codeVoice"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Metadata carries details such as byte counts and error codes; the default backend displays","type":"text"},{"text":" ","type":"text"},{"text":"these as ","type":"text"},{"type":"codeVoice","code":"key=value"},{"text":" pairs. Message wording and metadata keys are not a stable API.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Preparing your project","generated":true,"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"anchor":"Preparing-your-project"}],"sections":[],"variants":[{"paths":["\/documentation\/yubikit\/loggingguide"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Choose YubiKit’s log level and backend with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)"},{"type":"text","text":"."}],"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logs":{"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Logs"}],"url":"\/documentation\/yubikit\/logs","title":"Logs","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Logs"}],"type":"topic","abstract":[{"text":"Configures logging for YubiKit connections and sessions.","type":"text"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit":{"type":"topic","abstract":[{"type":"text","text":"Connect and run commands on the different applications on a YubiKey. The framework support connecting using NFC, Lightning and USB."}],"title":"Yub
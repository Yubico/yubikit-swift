{"metadata":{"modules":[{"name":"YubiKit"}],"roleHeading":"Article","role":"article","title":"Logging"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"No setup is required. YubiKit defaults to "},{"type":"codeVoice","code":"debug"},{"type":"text","text":" on stdout when compiled with "},{"type":"codeVoice","code":"DEBUG"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"info"},{"type":"text","text":" on stderr otherwise. You can override either default:"}],"type":"paragraph"},{"syntax":"swift","code":["import YubiKit","import Logging","","\/\/ Show warnings and errors.","YubiKit.Logs.configure(logLevel: .warning)","","\/\/ Use your preferred backend.","YubiKit.Logs.configure(logLevel: .debug) { label in","    StreamLogHandler.standardOutput(label: label)","}","","\/\/ Turn logging off.","YubiKit.Logs.configure { _ in SwiftLogNoOpLogHandler() }","","\/\/ Restore defaults.","YubiKit.Logs.configure()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Add "},{"type":"reference","identifier":"https:\/\/github.com\/apple\/swift-log","isActive":true},{"type":"text","text":"’s "},{"type":"codeVoice","code":"Logging"},{"type":"text","text":" product to your app target"},{"type":"text","text":" "},{"type":"text","text":"to use its backend types. Any SwiftLog "},{"type":"codeVoice","code":"LogHandler"},{"type":"text","text":" can be supplied by the factory."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each call replaces both settings. Omitting the factory restores YubiKit’s backend;"},{"type":"text","text":" "},{"type":"text","text":"omitting the level uses the selected handler’s level. Changes apply to existing sessions,"},{"type":"text","text":" "},{"type":"text","text":"though logs already in progress may use the previous settings."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"YubiKit’s configuration does not affect other libraries. To share your app’s backend,"},{"type":"text","text":" "},{"type":"text","text":"pass its factory explicitly; global "},{"type":"codeVoice","code":"LoggingSystem.bootstrap"},{"text":" does not select YubiKit’s backend.","type":"text"},{"type":"text","text":" "},{"text":"Factories may run concurrently and must not log through YubiKit themselves.","type":"text"}],"type":"paragraph"},{"anchor":"Traffic-logging","level":3,"text":"Traffic logging","type":"heading"},{"syntax":"swift","code":["YubiKit.Logs.configure(logLevel: .trace)"],"type":"codeListing"},{"inlineContent":[{"text":"Raw traffic and SCP plaintext logs require ","type":"text"},{"inlineContent":[{"text":"YubiKit to be compiled with ","type":"text"},{"type":"codeVoice","code":"DEBUG"}],"type":"strong"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Neither configuration nor a custom backend can enable them in other builds.","type":"text"},{"text":" ","type":"text"},{"text":"Custom connections are responsible for their own traffic logging.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Debug logs can include account names and credential identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"Trace logs can include PINs, credentials, and cryptographic keys. Protect or redact logs before sharing them.","type":"text"}],"type":"paragraph"}],"style":"warning","name":"Warning","type":"aside"},{"anchor":"Custom-backends","level":3,"text":"Custom backends","type":"heading"},{"inlineContent":[{"text":"Labels identify categories, such as ","type":"text"},{"code":"com.yubico.YubiKit.OATH","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"com.yubico.YubiKit.FIDO","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Metadata carries details such as byte counts and error codes; the default backend displays","type":"text"},{"text":" ","type":"text"},{"text":"these as ","type":"text"},{"code":"key=value","type":"codeVoice"},{"text":" pairs. Message wording and metadata keys are not a stable API.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Your backend controls formatting, storage, and export. YubiKit does not retain log messages.","type":"text"}],"type":"paragraph"}]}],"kind":"article","identifier":{"url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/LoggingGuide","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/loggingguide"]}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/GettingStarted","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs"],"title":"Preparing your project","anchor":"Preparing-your-project"}],"abstract":[{"text":"Choose YubiKit’s log level and backend with ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"references":{"https://github.com/apple/swift-log":{"url":"https:\/\/github.com\/apple\/swift-log","type":"link","identifier":"https:\/\/github.com\/apple\/swift-log","title":"SwiftLog","titleInlineContent":[{"text":"SwiftLog","type":"text"}]},"doc://yubikit-swift.YubiKit/documentation/YubiKit/Logs/configure(logLevel:factory:)":{"type":"topic","title":"configure(logLevel:factory:)","abstract":[{"type":"text","text":"Sets YubiKit’s log level and backend."}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/Logs\/configure(logLevel:factory:)","kind":"symbol","role":"symbol","url":"\/documentation\/yubikit\/logs\/configure(loglevel:factory:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","k
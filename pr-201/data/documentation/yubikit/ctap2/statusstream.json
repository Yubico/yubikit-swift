{"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusStream","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"This sequence streams ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Status","type":"reference"},{"text":" updates during long-running CTAP operations.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Usage","type":"heading","text":"Usage"},{"inlineContent":[{"text":"For simple cases where you don’t need status updates, use the ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/StatusStream\/value","isActive":true,"type":"reference"},{"text":" property:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let credential = try await session.makeCredential(parameters: params).value"],"type":"codeListing"},{"inlineContent":[{"text":"For UI or when you need to react to status updates, iterate the stream:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["for try await status in await session.makeCredential(parameters: params) {","    switch status {","    case .processing:","        print(\"Processing...\")","    case .waitingForUser:","        showMessage(\"Touch your YubiKey\")","    case .finished(let response):","        return response","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Async sequence for consuming CTAP2 operation status up
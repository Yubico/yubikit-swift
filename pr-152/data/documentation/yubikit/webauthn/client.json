n.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","for try await status in await client.makeCredential(opts, authorization: .pin(\"1234\")) {","    switch status {","    case .processing:","        showSpinner()","    case .waitingForUser(let cancel):","        showTouchPrompt(onCancel: { Task { await cancel() } })","    case .waitingForUserVerification(let cancel, _):","        showBiometricPrompt(onCancel: { Task { await cancel() } })","    case .finished(let response):","        return response","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"clientData:","type":"codeVoice"},{"text":" overloads accept a pre-built ","type":"text"},{"isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/ClientData","type":"reference"},{"text":" instead of","type":"text"},{"text":" ","type":"text"},{"text":"building one from ","type":"text"},{"code":"origin","type":"codeVoice"},{"text":" + challenge. Use them in iOS Credential Provider \/","type":"text"},{"text":" ","type":"text"},{"text":"AutoFill flows, where the system supplies a precomputed ","type":"text"},{"code":"clientDataHash","type":"codeVoice"},{"text":" rather","type":"text"},{"text":" ","type":"text"},{"text":"than the full ","type":"text"},{"code":"clientDataJSON","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"metadata":{"title":"WebAuthn.Client","modules":[{"name":"YubiKit"}],"symbolKind":"class","externalID":"s:7YubiKit8WebAuthnO6ClientC","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Client","kind":"identifier"}],"extendedModule":"YubiKit","navigatorTitle":[{"text":"Client","kind":"identifier"}],"roleHeading":"Class"},"kind":"symbol","seeAlsoSections":[{"generated":true,"title":"WebAuthn Client","anchor":"WebAuthn-Client","identifiers":["doc:\/\/yubikit-swift.
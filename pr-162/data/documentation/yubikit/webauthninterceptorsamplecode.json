{"sampleCodeDownload":{"action":{"identifier":"https:\/\/github.com\/Yubico\/yubikit-swift\/tree\/main\/Samples\/WebAuthnInterceptorSample","overridingTitle":"View Source","isActive":true,"type":"reference"},"kind":"sampleDownload"},"kind":"article","seeAlsoSections":[{"anchor":"Sample-code","identifiers":["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/OATHSampleCode","doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/PIVToolSampleCode"],"title":"Sample code","generated":true}],"metadata":{"title":"WebAuthnInterceptorSample: FIDO2\/WebAuthn client for WKWebView","roleHeading":"Sample Code","color":{"standardColorIdentifier":"yellow"},"modules":[{"name":"YubiKit"}],"role":"sampleCode"},"variants":[{"paths":["\/documentation\/yubikit\/webauthninterceptorsamplecode"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthnInterceptorSampleCode"},"abstract":[{"text":"This sample shows how to build a FIDO2\/WebAuthn client that intercepts ","type":"text"},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"text":" calls inside a ","type":"text"},{"type":"codeVoice","code":"WKWebView"},{"text":" and routes them to a YubiKey. It uses the high-level ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"text":" API and delegates the entire ceremony — transport, PIN\/UV prompts, errors, cancellation — to a small ","type":"text"},{"type":"codeVoice","code":"FidoUI"},{"text":" companion module.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"text":"The interceptor demonstrates how to:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Intercept "},{"type":"codeVoice","code":"navigator.credentials.create()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"navigator.credentials.get()"},{"type":"text","text":" in a "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Round-trip WebAuthn Level 3 JSON directly into the SDK’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Options"},{"type":"text","text":" \/ "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options"},{"type":"text","text":" types."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Drive the SDK’s high-level "},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"type":"text","text":" ceremony without hand-rolling CTAP2 plumbing, PIN retry, or extension wiring."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Use the bundled "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" module for transport selection (USB-C \/ Lightning \/ NFC on iOS, HID on macOS) and for the PIN, UV, error, and success panels."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"By bypassing WebKit’s built-in WebAuthn implementation you get full control over which authenticator handles the request, the look and feel of the prompts, and access to extensions that the platform doesn’t otherwise surface.","type":"text"}],"type":"paragraph"},{"text":"Architecture Overview","level":2,"type":"heading","anchor":"Architecture-Overview"},{"inlineContent":[{"text":"The sample itself is intentionally thin:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Interceptor.js"}]},{"type":"text","text":" — injected into the "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" to monkey-patch "},{"type":"codeVoice","code":"navigator.credentials.{create,get}"},{"type":"text","text":" and shuttle requests\/responses through "},{"type":"codeVoice","code":"WKScriptMessageHandler"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"WebView.swift"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"UIViewRepresentable"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"NSViewRepresentable"},{"type":"text","text":" wrapper that installs the script, registers message handlers, and coordinates ceremony lifecycle (cancel on dismiss, cancel-and-replace on a new request)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"WebAuthnHandler.swift"}]},{"type":"text","text":" — decodes the JSON envelope, builds a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","isActive":true},{"type":"text","text":", and calls "},{"type":"codeVoice","code":"FidoUI.makeCredential"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"FidoUI.getAssertion"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"ContentView.swift"}]},{"type":"text","text":" — minimal SwiftUI shell with a URL bar and back button."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"FidoUI"}]},{"type":"text","text":" (separate Swift package under "},{"type":"codeVoice","code":"Samples\/WebAuthnInterceptorSample\/FidoUI"},{"type":"text","text":") — the reusable UI + transport layer described below."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The end-to-end flow:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Page JS calls ","type":"text"},{"code":"navigator.credentials.create()","type":"codeVoice"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".get()"},{"type":"text","text":"; the interceptor serializes the options as WebAuthn Level 3 JSON and posts it to Swift."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" decodes the JSON straight into the SDK’s strongly-typed "},{"type":"codeVoice","code":"Options"},{"type":"text","text":" and hands them to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" opens a transport, runs the ceremony via "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":", and shows PIN \/ UV \/ error \/ success panels as needed."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The resulting "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Registration\/Response","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Response","isActive":true},{"type":"text","text":" is serialized via its built-in "},{"type":"codeVoice","code":"toJSON()"},{"type":"text","text":" and posted back to JS."}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Intercepting WebAuthn Calls","level":2,"type":"heading","anchor":"Intercepting-WebAuthn-Calls"},{"text":"JavaScript Injection","level":3,"type":"heading","anchor":"JavaScript-Injection"},{"inlineContent":[{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" replaces "},{"type":"codeVoice","code":"navigator.credentials.create"},{"type":"text","text":" and "},{"type":"codeVoice","code":"navigator.credentials.get"},{"type":"text","text":" with versions that forward to Swift. Binary fields ("},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", "},{"type":"codeVoice","code":"user.id"},{"type":"text","text":", "},{"type":"codeVoice","code":"rawId"},{"type":"text","text":", …) are serialized to "},{"inlineContent":[{"text":"base64url","type":"text"}],"type":"strong"},{"text":" strings via ","type":"text"},{"type":"codeVoice","code":"JSON.stringify"},{"type":"text","text":" with a replacer — this matches the WebAuthn Level 3 JSON format the SDK consumes natively, so no custom binary-wrapping protocol is needed."}],"type":"paragraph"},{"syntax":"javascript","type":"codeListing","code":["function interceptWebAuthn(type, options, originalFn) {","    if (!shouldIntercept(options)) return originalFn(options);","","    return new Promise((resolve, reject) => {","        pendingResolve = resolve;","        pendingReject = reject;","","        const publicKey = serializePublicKeyOptionsToJSON(options.publicKey);","        if (type === 'create' && publicKey.rp && !publicKey.rp.id) {","            publicKey.rp.id = window.location.hostname;","        }","","        const request = { type, origin: window.location.origin, request: publicKey };","        window.webkit.messageHandlers[`__webauthn_${type}__`]","            .postMessage(btoa(JSON.stringify(request)));","    });","}"]},{"inlineContent":[{"text":"The script is injected at document start so it runs before any page code:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let script = WKUserScript(","    source: interceptorScript,","    injectionTime: .atDocumentStart,","    forMainFrameOnly: true",")","config.userContentController.addUserScript(script)"]},{"inlineContent":[{"code":"shouldIntercept","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for any ","type":"text"},{"code":"publicKey","type":"codeVoice"},{"text":"-bearing request, but is the natural seam for narrower policies (e.g. only intercept when ","type":"text"},{"code":"publicKey.hints","type":"codeVoice"},{"text":" includes ","type":"text"},{"code":"\"security-key\"","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"text":"Receiving Messages in Swift","level":3,"type":"heading","anchor":"Receiving-Messages-in-Swift"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"Coordinator","type":"codeVoice"},{"text":" is both ","type":"text"},{"code":"WKNavigationDelegate","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"WKScriptMessageHandler","type":"codeVoice"},{"text":". Each incoming message starts a fresh ceremony, cancelling any in-flight one first:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func userContentController(","    _ userContentController: WKUserContentController,","    didReceive message: WKScriptMessage",") {","    guard let base64 = message.body as? String,","          let data = Data(base64Encoded: base64) else { return }","","    ceremonyGeneration += 1","    let generation = ceremonyGeneration","    activeTask?.cancel()","    activeTask = Task {","        await handler.cancelActiveCeremony()","        await handleWebAuthnMessage(name: message.name, data: data, generation: generation)","    }","}"]},{"inlineContent":[{"code":"shutdown()","type":"codeVoice"},{"text":" is called from ","type":"text"},{"code":"dismantle{UI,NS}View","type":"codeVoice"},{"text":" so navigating away mid-ceremony unwinds the open NFC\/HID handle.","type":"text"}],"type":"paragraph"},{"text":"Driving the Ceremony","level":2,"type":"heading","anchor":"Driving-the-Ceremony"},{"inlineContent":[{"code":"WebAuthnHandler","type":"codeVoice"},{"text":" is intentionally tiny — it decodes the envelope, builds a typed ","type":"text"},{"code":"Origin","type":"codeVoice"},{"text":", and delegates to ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":". There is no manual CTAP2 code, no PIN loop, and no extension plumbing in the sample itself.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct WebAuthnRequest<Options: Decodable>: Decodable {","    let origin: String","    let publicKey: Options","    enum CodingKeys: String, CodingKey { case origin; case publicKey = \"request\" }","}","","func handleCreate(_ data: Data) async throws -> String {","    let request = try JSONDecoder().decode(","        WebAuthnRequest<WebAuthn.Registration.Options>.self,","        from: data","    )","    let origin = try WebAuthn.Origin(request.origin)","    let response = try await fidoUI.makeCredential(","        request.publicKey,","        origin: origin,","        serviceName: origin.host","    )","    return String(decoding: try response.toJSON(), as: UTF8.self)","}"]},{"inlineContent":[{"code":"handleGet","type":"codeVoice"},{"text":" is the symmetric counterpart that decodes ","type":"text"},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Authentication\/Options","isActive":true,"type":"reference"},{"text":" and calls ","type":"text"},{"code":"fidoUI.getAssertion","type":"codeVoice"},{"text":". The response JSON produced by ","type":"text"},{"code":"toJSON()","type":"codeVoice"},{"text":" is already in WebAuthn Level 3 format with base64url-encoded binary fields, so the JS side just decodes those back to ","type":"text"},{"code":"ArrayBuffer","type":"codeVoice"},{"text":" when it materializes the credential.","type":"text"}],"type":"paragraph"},{"text":"Returning the Response to JavaScript","level":2,"type":"heading","anchor":"Returning-the-Response-to-JavaScript"},{"inlineContent":[{"text":"The Swift-side response is JSON-encoded, base64-wrapped for the bridge, and handed back via a callback installed by the interceptor:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let encodedResponse = Data(response.utf8).base64EncodedString()","_ = try? await webView?.evaluateJavaScript(","    \"__webauthn_callback__('\\(encodedResponse)')\"",")"]},{"inlineContent":[{"text":"JavaScript decodes the JSON and rebuilds a ","type":"text"},{"code":"PublicKeyCredential","type":"codeVoice"},{"text":"-shaped object — converting the base64url binary fields back to ","type":"text"},{"code":"ArrayBuffer","type":"codeVoice"},{"text":"s and wiring up ","type":"text"},{"code":"getClientExtensionResults","type":"codeVoice"},{"text":", ","type":"text"},{"code":"getAuthenticatorData","type":"codeVoice"},{"text":", ","type":"text"},{"code":"getPublicKey","type":"codeVoice"},{"text":", ","type":"text"},{"code":"toJSON","type":"codeVoice"},{"text":", and the rest. Errors travel through a parallel ","type":"text"},{"code":"__webauthn_error__","type":"codeVoice"},{"text":" channel and surface to the page as a ","type":"text"},{"code":"DOMException","type":"codeVoice"},{"text":" with name ","type":"text"},{"code":"NotAllowedError","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"The FidoUI Module","level":2,"type":"heading","anchor":"The-FidoUI-Module"},{"inlineContent":[{"code":"FidoUI","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" Swift package shipped alongside the sample, and it does most of the work. Intercepting ","type":"text"},{"code":"navigator.credentials.*","type":"codeVoice"},{"text":" means giving up the platform’s built-in WebAuthn sheets (tap prompt, PIN entry, errors, success) — ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" replaces them end-to-end with a complete ceremony UI: connect \/ touch, PIN entry with retry counters, PIN change, first-time PIN setup, forced PIN-change recovery, fingerprint enrollment, credential picker, and error \/ success results. The host app stays a thin shell.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Beyond the panels, it owns the moving parts that you’d otherwise re-implement per app:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Transport selection."}]},{"type":"text","text":" On iOS it tries wired (USB-C \/ Lightning) first and falls back to NFC; on macOS it uses HID FIDO. Connections are polled and reused across a ceremony."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ceremony serialization."}]},{"type":"text","text":" Concurrent calls on the same "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" instance are queued so they don’t fight over the alert window, transport, or shared panel state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Cancellation."}]},{"type":"text","text":" A single "},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":" call (used by the WebView coordinator on dismiss \/ new message) tears down the active transport and dismisses any visible panel."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The host code only needs to construct one ","type":"text"},{"code":"FidoUI","type":"codeVoice"},{"text":" instance and call ","type":"text"},{"code":"makeCredential","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"getAssertion","type":"codeVoice"},{"text":" per request — everything else (PIN prompts, UV policy, transport lifecycle, error UI) is handled internally. See ","type":"text"},{"code":"Samples\/WebAuthnInterceptorSample\/FidoUI\/","type":"codeVoice"},{"text":" for the full source.","type":"text"}],"type":"paragraph"},{"text":"Platform Notes","level":2,"type":"heading","anchor":"Platform-Notes"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS."}]},{"type":"text","text":" The wired path goes through CryptoTokenKit ("},{"type":"codeVoice","code":"WiredSmartCardConnection"},{"type":"text","text":" — USB-C or Lightning), and the NFC path through "},{"type":"codeVoice","code":"NFCSmartCardConnection"},{"type":"text","text":". The sample’s "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"NFCReaderUsageDescription"},{"type":"text","text":" and lists the FIDO applet AID ("},{"type":"codeVoice","code":"A0000006472F0001"},{"type":"text","text":") under "},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.iso7816.select-identifiers"},{"type":"text","text":"; the entitlements turn on "},{"type":"codeVoice","code":"com.apple.developer.nfc.readersession.formats"},{"type":"text","text":" ("},{"type":"codeVoice","code":"TAG"},{"type":"text","text":") and "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" uses "},{"type":"codeVoice","code":"HIDFIDOConnection"},{"type":"text","text":" directly. The HID path itself doesn’t need the smart-card entitlement, but the sample enables "},{"type":"codeVoice","code":"com.apple.security.smartcard"},{"type":"text","text":" and "},{"type":"codeVoice","code":"com.apple.security.device.usb"},{"type":"text","text":" so the same target builds cleanly for both platforms."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Where to Customize","level":2,"type":"heading","anchor":"Where-to-Customize"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Which requests get intercepted."}]},{"type":"text","text":" Edit "},{"type":"codeVoice","code":"shouldIntercept"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Interceptor.js"},{"type":"text","text":" to scope by hint, RP ID, or any other heuristic."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Origin verification."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"WebAuthnHandler"},{"type":"text","text":" builds a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Origin","isActive":true},{"type":"text","text":" from "},{"type":"codeVoice","code":"window.location.origin"},{"type":"text","text":". Replace the "},{"type":"codeVoice","code":"isPublicSuffix"},{"type":"text","text":" closure passed to "},{"type":"codeVoice","code":"FidoUI"},{"type":"text","text":" with a real public-suffix-list check before shipping."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"UI."}]},{"type":"text","text":" Swap or restyle the panels in "},{"type":"codeVoice","code":"FidoUI\/Sources\/FidoUI\/Views\/"},{"type":"text","text":" — the rest of the module is UI-agnostic."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit"]]},"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client":{"abstract":[{"type":"text","text":"Client for performing WebAuthn passkey operations."}],"type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"title":"WebAuthn.Client","url":"\/documentation\/yubikit\/webauthn\/client","navigatorTitle":[{"kind":"identifier","text":"Client"}],"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Registration/Options":{"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Options"}],"url":"\/documentation\/yubikit\/webauthn\/registration\/options","role":"symbol","title":"WebAuthn.Regist
e":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"type":"text","text":" and the request, response, and"},{"type":"text","text":" "},{"type":"text","text":"data-model types defined by the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/"},{"type":"text","text":" "},{"type":"text","text":"specification."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A passkey client and the W3C Web Authentication data model, mediated by a YubiKey."}],"type":"paragraph"},{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"WebAuthn"},{"type":"text","text":" namespace provides a high-level passkey client ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client"},{"type":"text","text":") that runs"},{"type":"text","text":" "},{"type":"reference","overridingTitle":"Web Authentication Level 3","overridingTitleInlineContent":[{"text":"Web Authentication Level 3","type":"text"}],"isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/webauthn-3\/"},{"type":"text","text":" ceremonies against a"},{"type":"text","text":" "},{"type":"text","text":"YubiKey, plus the request and response types defined by the WebAuthn specification."}],"type":"paragraph"},{"inlineContent":[{"text":"A WebAuthn ceremony involves three parties: the ","type":"text"},{"inlineContent":[{"text":"authenticator","type":"text"}],"type":"strong"},{"text":" (a YubiKey), the","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"client"}]},{"type":"text","text":" (your app, via "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"text":"), and the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"relying party"}]},{"text":" (your server, which","type":"text"},{"text":" ","type":"text"},{"text":"verifies what the authenticator returns). The client is the communication path between","type":"text"},{"text":" ","type":"text"},{"text":"authenticator and relying party — and it verifies the relying party’s identity against","type":"text"},{"text":" ","type":"text"},{"text":"the origin it’s bound to, so it can refuse to sign for a fraudulent site.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There are two ceremonies. "},{"type":"strong","inlineContent":[{"type":"text","text":"Registration"}]},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/makeCredential(_:authorization:)","isActive":true},{"type":"text","text":") creates a new credential and supplies its"},{"type":"text","text":" "},{"type":"text","text":"public key to the relying party for account association. "},{"type":"strong","inlineContent":[{"type":"text","text":"Authentication"}]},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client\/getAssertion(_:authorization:)","isActive":true},{"type":"text","text":") proves to the relying party that the"},{"type":"text","text":" "},{"type":"text","text":"YubiKey is the one registered for the user. Both ceremonies follow the same mechanical"},{"type":"text","text":" "},{"type":"text","text":"shape: the relying party supplies a challenge, the authenticator signs it together"},{"type":"text","text":" "},{"type":"text","text":"with the relying-party identifier, and the signature goes back to the relying party"},{"type":"text","text":" "},{"type":"text","text":"for verification."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The pieces fit together as: a connection carries CTAP2 traffic, a "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true},{"type":"text","text":" "},{"type":"text","text":"sits on top, and "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true},{"type":"text","text":" runs ceremonies on that session. Connections come in"},{"type":"text","text":" "},{"type":"text","text":"three flavours that all work for WebAuthn: "},{"type":"codeVoice","code":"YubiKit\/HIDFIDOConnection"},{"type":"text","text":" on macOS,"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/NFCSmartCardConnection","isActive":true},{"type":"text","text":" for tap-to-auth on iOS, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/USBSmartCardConnection","isActive":true},{"type":"text","text":" on either platform. Pick the one that matches"},{"type":"text","text":" "},{"type":"text","text":"your platform and form factor."}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ macOS — USB HID FIDO","let connection = try await HIDFIDOConnection()","\/\/ iOS — tap-to-auth over NFC:","\/\/ let connection = try await NFCSmartCardConnection()","","let session = try await CTAP2.Session.makeSession(connection: connection)","let client = WebAuthn.Client(","    session: session,","    origin: try .init(\"https:\/\/example.com\"),","    isPublicSuffix: { publicSuffixList.contains($0) }",")","","\/\/ Register a new passkey","let registration = try await client.makeCredential(","    .init(","        challenge: challenge,","        rp: .init(id: \"example.com\", name: \"Example\"),","        user: .init(id: userId, name: \"alice@example.com\")","    ),","    authorization: .pin(\"1234\")",").value","","\/\/ Authenticate","let assertions = try await client.getAssertion(","    .init(challenge: challenge, rpId: \"example.com\"),","    authorization: .pin(\"1234\")",").value"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most apps start with "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Client","isActive":true,"type":"reference"},{"type":"text","text":". For lower-level CTAP2 access — raw "},{"code":"makeCredential","type":"codeVoice"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"getAssertion"},{"type":"text","text":", credential management, bio enrollment — use "},{"identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/CTAP2\/Session","isActive":true,"type":"reference"},{"type":"text","text":" directly."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yubikit\/webauthn"]}],"metadata":{"title":"WebAuthn","symbolKind":"enum","roleHeading":"Enumeration","navigatorTitle":[{"kind":"identifier","text":"WebAuthn"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"WebAuthn"}],"modules":[{"name":"YubiKit"}],"role":"symbol","externalID":"s:7YubiKit8WebAuthnO"},"references":{"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Status":{"title":"WebAuthn.Status","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Status","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/yubikit-swift.YubiKit\/documentation\/YubiKit\/WebAuthn\/Status","kind":"symbol","abstract":[{"type":"text","text":"Status updates during WebAuthn operations."}],"navigatorTitle":[{"text":"Status","kind":"identifier"}],"type":"topic","url":"\/documentation\/yubikit\/webauthn\/status"},"doc://yubikit-swift.YubiKit/documentation/YubiKit/WebAuthn/Client/makeCredential(_:authorization:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"te